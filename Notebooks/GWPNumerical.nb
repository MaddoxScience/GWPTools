Cell[TextData[{
 "Next, we verify the First Law of (Quantum) Thermodynamics along the \
numerical trajectory by extracting the instantaneous internal energy and \
decomposing its rate of change into reversible mechanical work and \
dissipative heat exchange with the bath.\n\nIn the coordinate representation \
of RDM1D, the macroscopic thermodynamic observables of the open oscillator \
are governed directly by the second-moment phase-space variances, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalSigma]", "xx"], "(", "t", ")"}], TraditionalForm]],
  ExpressionUUID->"ebdcf3f4-b17b-4774-aa1b-b91ea7edfe48"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalSigma]", "pp"], "(", "t", ")"}], TraditionalForm]],
  ExpressionUUID->"86644f80-c976-4b90-ac94-2e8c86fa4d8a"],
 ". While the spatial variance depends solely on the real width parameter, \
the momentum variance combines contributions from the spatial compression, \
the phase chirp, and the thermal decoherence parameter.  "
}], "Text",
 CellChangeTimes->{
  4.001263555177199*^9, {4.0015317050058537`*^9, 4.001531713007577*^9}, {
   4.0015330645696573`*^9, 4.001533066395872*^9}, {4.0015331050574827`*^9, 
   4.0015331338928213`*^9}},ExpressionUUID->"0ec22aef-e9b0-4cc7-a1c6-\
ca139ade8d9a"],

Cell["\<\
Using these two variances, the instantaneous internal energy \
\>", "Text",
 CellChangeTimes->{
  4.00153313636724*^9},ExpressionUUID->"7dee870d-581f-4af7-a22a-489a9ded474e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"U", "(", "t", ")"}], "=", 
     RowBox[{
      RowBox[{"\[LeftAngleBracket]", 
       RowBox[{
        OverscriptBox["H", "^"], "(", "t", ")"}], "\[RightAngleBracket]"}], "=", 
      RowBox[{"Tr", "(", 
       RowBox[{
        OverscriptBox["H", "^"], 
        RowBox[{
         OverscriptBox["\[Rho]", "^"], "(", "t", ")"}]}]}]}]}], 
    "\[RightAngleBracket]"}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", "m"}]], 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["p", "t", "2"], "+", 
       RowBox[{
        SubscriptBox["\[CapitalSigma]", "pp"], "(", "t", ")"}]}], ")"}]}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["V", "2"], "(", "t", ")"}], 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["x", "t", "2"], "+", 
       RowBox[{
        SubscriptBox["\[CapitalSigma]", "xx"], "(", "t", ")"}]}], ")"}]}]}]}],
   TraditionalForm]], "Text",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
   4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
   4.001167030269079*^9}, {4.001168402809308*^9, 4.001168426499454*^9}, {
   4.001195461673896*^9, 4.001195503258028*^9}, {4.001195834433279*^9, 
   4.001195998998259*^9}, {4.0011976314556*^9, 4.00119771342379*^9}, {
   4.001199104101141*^9, 4.001199115942663*^9}, {4.001199321428568*^9, 
   4.001199331465453*^9}, 4.001199392445671*^9, 4.001199467206645*^9, {
   4.001199563032137*^9, 4.001199583014041*^9}, {4.001203465471712*^9, 
   4.0012035255169*^9}, {4.001264251805689*^9, 4.0012642661539392`*^9}, {
   4.0013318278236923`*^9, 4.0013318316543007`*^9}, {4.001331917778775*^9, 
   4.001331919395858*^9}, {4.0014052911153917`*^9, 4.0014053358551207`*^9}, {
   4.001438800761121*^9, 4.001438835485734*^9}, {4.0014441785552053`*^9, 
   4.0014442534145613`*^9}, {4.001531113878029*^9, 4.001531123236321*^9}, {
   4.001537658356645*^9, 
   4.001537681356921*^9}},ExpressionUUID->"6ee75484-0b22-4b4c-a79d-\
a47c015964ee"],

Cell["\<\
can be differentiated with respect to time (see GWPEngineRDM1D appendix) to \
separate the total energy change into two physically distinct fluxes.\
\>", "Text",
 CellChangeTimes->{{4.0014442626788883`*^9, 4.001444300661437*^9}, {
  4.001597210309663*^9, 4.0015972156999903`*^9}, {4.00170049774229*^9, 
  4.001700500503807*^9}, {4.001700536424603*^9, 
  4.001700543366527*^9}},ExpressionUUID->"755157f2-8f24-48a5-a4e2-\
3b63c29adb63"],

Cell["The mechanical power", "Text",
 CellChangeTimes->{{4.001444313365365*^9, 
  4.001444318077314*^9}},ExpressionUUID->"acd12634-2110-41fb-820d-\
e9e27061a179"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      OverscriptBox["W", "."], "(", "t", ")"}], "=", 
     RowBox[{"Tr", "(", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{
         OverscriptBox["H", "^"], "(", "t", ")"}]}], 
       RowBox[{
        OverscriptBox["\[Rho]", "^"], "(", "t", ")"}]}]}]}], 
    "\[RightAngleBracket]"}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      OverscriptBox["V", "."], "2"], "(", "t", ")"}], 
    RowBox[{"(", 
     RowBox[{
      SubsuperscriptBox["x", "t", "2"], "+", 
      RowBox[{
       SubscriptBox["\[CapitalSigma]", "xx"], "(", "t", ")"}]}], ")"}]}]}], 
  TraditionalForm]], "Text",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
   4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
   4.001167030269079*^9}, {4.001168402809308*^9, 4.001168426499454*^9}, {
   4.001195461673896*^9, 4.001195503258028*^9}, {4.001195834433279*^9, 
   4.001195998998259*^9}, {4.0011976314556*^9, 4.00119771342379*^9}, {
   4.001199104101141*^9, 4.001199115942663*^9}, {4.001199321428568*^9, 
   4.001199331465453*^9}, 4.001199392445671*^9, 4.001199467206645*^9, {
   4.001199563032137*^9, 4.001199583014041*^9}, {4.001203465471712*^9, 
   4.0012035255169*^9}, {4.001264251805689*^9, 4.0012642661539392`*^9}, {
   4.0013318278236923`*^9, 4.0013318316543007`*^9}, {4.001331917778775*^9, 
   4.001331919395858*^9}, {4.0014052911153917`*^9, 4.0014053358551207`*^9}, {
   4.001438800761121*^9, 4.001438835485734*^9}, {4.0014441785552053`*^9, 
   4.0014442534145613`*^9}, {4.0014443274979897`*^9, 4.00144434968614*^9}, {
   4.001531143351192*^9, 4.0015311452453203`*^9}, {4.001537595347501*^9, 
   4.00153761579783*^9}},ExpressionUUID->"43b8e7c0-623b-4614-907b-\
cc42bcc02832"],

Cell["\<\
measures the rate of reversible mechanical work performed on the oscillator \
by stiffening the external trap curvature.\
\>", "Text",
 CellChangeTimes->{{4.001444357415897*^9, 
  4.001444386367202*^9}},ExpressionUUID->"e885f862-39ed-4aa3-b12e-\
4f952ad5d2ed"],

Cell["The bath heat flux", "Text",
 CellChangeTimes->{{4.001444389342524*^9, 
  4.001444393479405*^9}},ExpressionUUID->"bd448eba-f329-4767-b6ad-\
5af335d1710f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["Q", "."], "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{"Tr", "(", 
     RowBox[{
      RowBox[{
       OverscriptBox["H", "^"], "(", "t", ")"}], 
      FractionBox[
       RowBox[{"\[PartialD]", 
        RowBox[{
         OverscriptBox["\[Rho]", "^"], "(", "t", ")"}]}], 
       RowBox[{"\[PartialD]", "t"}]]}], ")"}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Gamma]", "d"], "(", "t", ")"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox["k", "B"], 
        RowBox[{"T", "(", "t", ")"}]}], "-", 
       FractionBox[
        RowBox[{
         SubsuperscriptBox["p", "t", "2"], "+", 
         RowBox[{
          SubscriptBox["\[CapitalSigma]", "pp"], "(", "t", ")"}]}], "m"]}], 
      ")"}]}]}]}], TraditionalForm]], "Text",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
   4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
