   4.001600008717351*^9}},ExpressionUUID->"5cd3420e-7eef-4c50-8e27-\
17df3c7c2982"],

Cell[TextData[{
 "At thermal equilibrium in the high-temperature Caldeira\[Dash]Leggett \
regime, the purity reduces to the ratio of the trap quantum to the thermal \
energy, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[ScriptCapitalP]", "eq"], "=", 
    FractionBox[
     RowBox[{"\[HBar]", " ", "\[Omega]"}], 
     RowBox[{"2", 
      SubscriptBox["k", "B"], "T"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "89bba286-56b5-40ef-8d1d-16aad4afa485"],
 ". Because our protocol doubles both the trap frequency (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Omega]", "f"], "/", 
     SubscriptBox["\[Omega]", "i"]}], "=", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "016a669f-91fe-4474-9019-9e6b84a3d016"],
 ") and the bath temperature (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["T", "f"], "/", 
     SubscriptBox["T", "i"]}], "=", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "adeb537b-7fa0-4ab1-9354-eef9f4abfec5"],
 "), mechanical spatial compression exactly compensates thermal momentum \
broadening, resulting in iso-entropic equilibrium endpoints where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[ScriptCapitalP]", "(", "0", ")"}], "=", 
    RowBox[{
     RowBox[{"\[ScriptCapitalP]", "(", "50", ")"}], "=", "0.3125"}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a894abde-49bf-4c55-a5f4-ae015c9c2192"],
 ". During the finite-time ramp around ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "0"], "=", "10"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "184e8b1a-ccd6-4f1e-8aa3-a647df43a8a7"],
 ", however, the open oscillator lags behind the instantaneous Gibbs state, \
causing ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptCapitalP]", "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "afaedb4a-69de-42e0-8faa-bede2c820640"],
 " to dip transiently before recovering to 0.3125 (whereas the isolated \
unitary purity remains strictly frozen at all times)."
}], "Text",
 CellChangeTimes->{{4.001600037540702*^9, 
  4.0016002111358137`*^9}},ExpressionUUID->"b0d9ac16-07bd-4f94-8a32-\
7c063985f72c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Quantum", " ", "Purity", " ", 
     RowBox[{"Tr", "[", 
      RowBox[{"rho", "^", "2"}], "]"}], " ", "and", " ", "System", " ", 
     "Entropy", " ", "S_sys", 
     RowBox[{"(", "t", ")"}]}], "=", 
    RowBox[{"-", 
     RowBox[{"Log", "[", 
      RowBox[{"Purity", 
       RowBox[{"(", "t", ")"}]}], "]"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"purity", "[", 
      RowBox[{"obj_", ",", "t_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ra", "=", 
          RowBox[{
           RowBox[{"obj", "[", "\"\<RealShape\>\"", "]"}], "[", "t", "]"}]}], 
         ",", 
         RowBox[{"th", "=", 
          RowBox[{
           RowBox[{"obj", "[", "\"\<Decoherence\>\"", "]"}], "[", "t", 
           "]"}]}]}], "}"}], ",", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"ra", "/", 
         RowBox[{"(", 
          RowBox[{"ra", "+", 
           RowBox[{"2", "*", "th"}]}], ")"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"entropySys", "[", 
      RowBox[{"obj_", ",", "t_"}], "]"}], ":=", 
     RowBox[{"-", 
      RowBox[{"Log", "[", 
       RowBox[{"purity", "[", 
        RowBox[{"obj", ",", "t"}], "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Exact", " ", "Algebraic", " ", "System", " ", "Entropy", " ", "Rate", " ", 
     RowBox[{"dS_sys", "/", "dt"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"entropyRateSys", "[", 
      RowBox[{"obj_", ",", "t_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ra", "=", 
          RowBox[{
           RowBox[{"obj", "[", "\"\<RealShape\>\"", "]"}], "[", "t", "]"}]}], 
         ",", 
         RowBox[{"th", "=", 
          RowBox[{
           RowBox[{"obj", "[", "\"\<Decoherence\>\"", "]"}], "[", "t", 
           "]"}]}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"gammaRamp", "[", "t", "]"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"gammaRamp", "[", "t", "]"}], "*", "m", "*", 
           RowBox[{"kTRamp", "[", "t", "]"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"hbar", "^", "2"}], "*", 
           RowBox[{"(", 
            RowBox[{"ra", "+", 
             RowBox[{"2", "*", "th"}]}], ")"}]}], ")"}]}]}]}], "]"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Surroundings", " ", "Entropy", " ", 
      RowBox[{"Rate", ":", 
       RowBox[{"dS_surr", "/", "dt"}]}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"dQ", "/", "dt"}], ")"}]}], "/", "kT"}], 
      RowBox[{"(", "t", ")"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"entropyRateSurr", "[", 
      RowBox[{"obj_", ",", "t_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"heatRate", "[", 
        RowBox[{"obj", ",", "t"}], "]"}]}], "/", 
      RowBox[{"kTRamp", "[", "t", "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Total", " ", "Universe", " ", "Entropy", " ", "Production", " ", 
      RowBox[{"Rate", ":", 
       RowBox[{"dS_univ", "/", "dt"}]}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"dS_sys", "/", "dt"}], "+", 
       RowBox[{"dS_surr", "/", "dt"}]}], ">=", "0"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"entropyRateUniv", "[", 
      RowBox[{"obj_", ",", "t_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"entropyRateSys", "[", 
       RowBox[{"obj", ",", "t"}], "]"}], "+", 
      RowBox[{"entropyRateSurr", "[", 
       RowBox[{"obj", ",", "t"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "Purity", " ", "and", " ", "Entropy", " ", "Rates"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"purity", "[", 
        RowBox[{"rdmCL", ",", "t"}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"purity", "[", 
        RowBox[{"rdmUnitary", ",", "t"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "tMin", ",", 
       RowBox[{"tMax", "/", "2"}]}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", "Dashed"}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{".29", ",", ".33"}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Open (NumericalCL)\>\"", 
        ",", "\"\<Isolated (Numerical)\>\""}], "}"}]}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<t\>\"", 
        ",", "\"\<Purity Tr(\!\(\*SuperscriptBox[\(\[Rho]\), \(2\)]\))\>\""}],
        "}"}]}], ",", 
     RowBox[{"BaseStyle", "->", 
      RowBox[{"FontSize", "->", "12"}]}]}], "]"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"entropyRateUniv", "[", 
        RowBox[{"rdmCL", ",", "t"}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"entropyRateSys", "[", 
        RowBox[{"rdmCL", ",", "t"}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"entropyRateSurr", "[", 
        RowBox[{"rdmCL", ",", "t"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "tMin", ",", 
       RowBox[{"tMax", "/", "2"}]}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<\!\(\*SubscriptBox[OverscriptBox[\(S\), \(.\)], \(univ\)]\
\)\[GreaterEqual]0\>\"", 
        ",", "\"\<\!\(\*SubscriptBox[OverscriptBox[\(S\), \(.\)], \
\(sys\)]\)\>\"", 
        ",", "\"\<\!\(\*SubscriptBox[OverscriptBox[\(S\), \(.\)], \(surr\)]\)\
\>\""}], "}"}]}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<t\>\"", ",", "\"\<Entropy Rate\>\""}], "}"}]}], ",", 
     RowBox[{"BaseStyle", "->", 
      RowBox[{"FontSize", "->", "12"}]}]}], "]"}]}]}]], "Input",
