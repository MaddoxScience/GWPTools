Cell[TextData[{
 "Integrating the entropy fluxes across the interval 0 to 50 confirms the \
Second Law of (Quantum) Thermodynamics.  Because the initial and final \
equilibrium states share the identical purity ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[ScriptCapitalP]", "(", "0", ")"}], "=", 
    RowBox[{
     RowBox[{"\[ScriptCapitalP]", "(", "50", ")"}], "=", "0.3125"}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "095f111d-a136-42c0-8fc2-1246ec3ec5ed"],
 ", the net change in the state function ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "sys"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "98d023b1-98ef-455b-b521-fa3941ae4024"],
 " vanishes up to the tiny residual relaxation tail at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "max"], "=", "50"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3970fbc9-d44c-4acc-b930-89a345311ccc"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]S", "sys"], "=", 
    RowBox[{"4.05", "\[Times]", 
     SuperscriptBox["10", 
      RowBox[{"-", "7"}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3a26d8bb-05e1-441b-8a95-7e79727a3b34"],
 "). Meanwhile, as the excess mechanical compression work (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", "Q", "\[RightAngleBracket]"}], "=", 
    RowBox[{"-", "0.116886"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8b8e288e-84f9-46cb-a724-9abbf09c6ca2"],
 ") is dissipated into the reservoir, the surroundings absorb a net entropy \
increase of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]S", "surr"], "=", 
    RowBox[{"+", "0.0686707"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9e010544-49bd-42ac-b6ae-0943327d2257"],
 ". Thus, all irreversible entropy generated during the finite-time \
transition is exported to the thermal bath, yielding a strictly positive \
total entropy production for the universe of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]S", "univ"], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[CapitalDelta]S", "sys"], "+", 
      SubscriptBox["\[CapitalDelta]S", "surr"]}], "=", 
     RowBox[{
      RowBox[{"+", "0.0686711"}], ">", "0"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c39d2dcc-842a-4856-bb08-281dafa21531"],
 "."
}], "Text",
 CellChangeTimes->{{4.0016018313890457`*^9, 4.001602059455762*^9}, {
  4.001702534945737*^9, 
  4.0017025576645813`*^9}},ExpressionUUID->"6c2d4b28-b317-4147-8fcb-\
dc6603e14436"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Integrate", " ", "to", " ", "Verify", " ", "the", " ", "Second", " ", 
     RowBox[{"Law", ":", 
      RowBox[{"Delta", " ", "S_univ"}]}]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Delta", " ", "S_sys"}], "+", 
      RowBox[{"Delta", " ", "S_surr"}]}], ">=", "0"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"deltaSsys", "=", 
     RowBox[{
      RowBox[{"entropySys", "[", 
       RowBox[{"rdmCL", ",", "tMax"}], "]"}], "-", 
      RowBox[{"entropySys", "[", 
       RowBox[{"rdmCL", ",", "tMin"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"deltaSsurr", "=", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"entropyRateSurr", "[", 
        RowBox[{"rdmCL", ",", "t"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tMin", ",", "tMax"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"deltaSuniv", "=", 
     RowBox[{"deltaSsys", "+", "deltaSsurr"}]}], ";"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Initial Purity P(0) vs Final Purity P(tMax) = \>\"", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"purity", "[", 
         RowBox[{"rdmCL", ",", "tMin"}], "]"}], ",", 
        RowBox[{"purity", "[", 
         RowBox[{"rdmCL", ",", "tMax"}], "]"}]}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<System Entropy Change Delta S_sys           = \>\"", ",", 
      "deltaSsys"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Surroundings Entropy Change Delta S_surr    = \>\"", ",", 
      "deltaSsurr"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total Universe Entropy Change Delta S_univ  = \>\"", ",", 
      "deltaSuniv", ",", "\"\< (>= 0, Second Law Verified!)\>\""}], "]"}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{4.0016017793163433`*^9, 4.0016017793164167`*^9}, {
  4.00170257617808*^9, 4.001702576497549*^9}},
 CellLabel->
  "In[564]:=",ExpressionUUID->"ec5a8c18-58ef-49c4-8a87-2c384e3ff0ba"],

