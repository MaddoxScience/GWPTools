Cell[TextData[{
 "The diagonal population density snapshots at t = 0 (initial), 12 (midway), \
and 50 (final) illustrate a counterintuitive thermodynamic interplay between \
mechanical confinement and thermal heating. Although the bath temperature \
doubles during the ramp (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["T", "f"], "/", 
     SubscriptBox["T", "i"]}], "=", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "69dbbb4d-69db-4fb6-8500-5ff07b9d7b74"],
 ")\[LongDash]which by itself would thermally broaden the position \
distribution\[LongDash]the trap frequency simultaneously doubles, quadrupling \
the restoring curvature (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Omega]", "f", "2"], "/", 
     SubsuperscriptBox["\[Omega]", "i", "2"]}], "=", "4"}], TraditionalForm]],
  
  FormatType->TraditionalForm,ExpressionUUID->
  "ff5d73d7-ae48-49fc-97e0-e648deb06fad"],
 "). Because the equilibrium inverse spatial variance scales as"
}], "Text",
 CellChangeTimes->{{4.001438545463497*^9, 4.001438702887629*^9}, {
   4.001438743530222*^9, 4.001438749754669*^9}, 4.001438793665401*^9, {
   4.0014388427201242`*^9, 4.0014388430496397`*^9}, {4.0014430526791677`*^9, 
   4.001443054269415*^9}, {4.0015302739239798`*^9, 4.001530274450083*^9}, {
   4.001530328150797*^9, 
   4.001530343766485*^9}},ExpressionUUID->"5a6c7601-2eb3-4dba-b1c9-\
0edfffa4da00"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Re", "(", 
    SubscriptBox["\[Alpha]", "eq"], ")"}], "=", " ", 
   FractionBox[
    RowBox[{"m", " ", 
     SuperscriptBox["\[Omega]", "2"]}], 
    RowBox[{"4", " ", 
     SubscriptBox["k", "B"], "T"}]]}], TraditionalForm]], "Text",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
   4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
   4.001167030269079*^9}, {4.001168402809308*^9, 4.001168426499454*^9}, {
   4.001195461673896*^9, 4.001195503258028*^9}, {4.001195834433279*^9, 
   4.001195998998259*^9}, {4.0011976314556*^9, 4.00119771342379*^9}, {
   4.001199104101141*^9, 4.001199115942663*^9}, {4.001199321428568*^9, 
   4.001199331465453*^9}, 4.001199392445671*^9, 4.001199467206645*^9, {
   4.001199563032137*^9, 4.001199583014041*^9}, {4.001203465471712*^9, 
   4.0012035255169*^9}, {4.001264251805689*^9, 4.0012642661539392`*^9}, {
   4.0013318278236923`*^9, 4.0013318316543007`*^9}, {4.001331917778775*^9, 
   4.001331919395858*^9}, {4.0014052911153917`*^9, 4.0014053358551207`*^9}, {
   4.001438800761121*^9, 
   4.001438835485734*^9}},ExpressionUUID->"784f3a21-7e89-4f59-8bf5-\
edf03934e5d6"],

Cell[TextData[{
 "the four-fold stiffening overcomes the two-fold heating, doubling ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Re", "(", 
    SubscriptBox["\[Alpha]", "eq"], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ea801dce-db13-4eb1-b523-22a0cbcbd2d1"],
 " and compressing the final equilibrium spatial density by a net factor of \
",
 Cell[BoxData[
  FormBox[
   SqrtBox["2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "69e5c966-d394-4205-9b3d-31da33bc0e4a"],
 " relative to the initial state."
}], "Text",
 CellChangeTimes->{
  4.0014387969526663`*^9, {4.001438853462792*^9, 4.0014388728041687`*^9}, {
   4.001530362977632*^9, 
   4.001530371614234*^9}},ExpressionUUID->"12e64b6f-1d44-4e89-807e-\
7d1a8074dbdb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "3.", " ", "Visualize", " ", "Diagonal", " ", "Spatial", " ", 
    "Probability", " ", "Density", " ", "rho", 
    RowBox[{"(", 
     RowBox[{"x", ",", "x", ",", "t"}], ")"}], " ", "Before", " ", 
    RowBox[{"vs", ".", "After"}], " ", "Equilibration"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"rdmCL", "[", "\"\<DensityX\>\"", "]"}], "[", 
       RowBox[{"x", ",", "0"}], "]"}], ",", 
      RowBox[{
       RowBox[{"rdmCL", "[", "\"\<DensityX\>\"", "]"}], "[", 
       RowBox[{"x", ",", "12"}], "]"}], ",", 
      RowBox[{
       RowBox[{"rdmCL", "[", "\"\<DensityX\>\"", "]"}], "[", 
       RowBox[{"x", ",", "tMax"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
    RowBox[{"PlotLegends", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<t = 0 (Initial Eq)\>\"", 
       ",", "\"\<t = 12 (Mid-Transition)\>\"", 
       ",", "\"\<t = 50 (New Eq)\>\""}], "}"}]}], ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<x\>\"", ",", "\"\<\[Rho](x, x, t)\>\""}], "}"}]}], ",", 
    RowBox[{"BaseStyle", "->", 
     RowBox[{"FontSize", "->", "12"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{4.0014389327038813`*^9, 4.001438973812407*^9}},
 CellLabel->
  "In[533]:=",ExpressionUUID->"3e885ae5-974c-41f0-8a62-a5150c2177d4"],

