}, Open  ]],

Cell[TextData[{
 "The results above confirm the First Law of (Quantum) Thermodynamics (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[CapitalDelta]", " ", "U"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"\[LeftAngleBracket]", "W", "\[RightAngleBracket]"}], " ", "+", 
     " ", 
     RowBox[{"\[LeftAngleBracket]", "Q", "\[RightAngleBracket]"}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b090f121-d218-4c9d-b7bd-fed582558ada"],
 ") to within a numerical residual of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2.34", "\[Times]", 
    SuperscriptBox["10", 
     RowBox[{"-", "9"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7db8bd75-2bfb-4a99-9a6f-acad2db7e491"],
 ". Because the Caldeira\[Dash]Leggett master equation obeys classical \
equipartition at stationary thermal equilibrium  (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["U", "eq"], "=", 
    RowBox[{
     SubscriptBox["k", "B"], "T"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "38d56ee5-7a82-4a24-994f-dac24a2bb85f"],
 "), increasing the bath thermal energy from 4/5 to 8/5 requires a net \
internal energy increase of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]U", "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["k", "B"], "\[CapitalDelta]", " ", "T"}], "=", 
     RowBox[{"4", "/", "5"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1388890f-8378-4c16-9704-46420633d237"],
 ". \n\nNotably, although the bath is heated to twice its initial \
temperature, the net integrated heat exchange is negative ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", "Q", "\[RightAngleBracket]"}], "=", 
    RowBox[{"-", "0.116886"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5afa3cdc-70cf-4542-b8b7-c9c86f35af32"],
 ": the rapid fourfold stiffening of the harmonic trap around ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "0"], "=", "10"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5cbde78a-b4ed-42f3-9a06-a2bf07a47940"],
 " injects ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", "W", "\[RightAngleBracket]"}], "=", 
    RowBox[{"+", "0.916887"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3b1f4b83-5474-4127-baa4-fb47ef64a8eb"],
 " of mechanical compression work\[LongDash]exceeding the target equilibrium \
energy difference ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]U", "=", 
    RowBox[{"4", "/", "5"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ebe90582-45d6-4628-a6c4-169230d6d752"],
 " and transiently overheating the oscillator\[CloseCurlyQuote]s kinetic \
degree of freedom above the instantaneous bath temperature. The extra \
0.116886 of irreversible mechanical work is subsequently dissipated into the \
thermal reservoir as friction damps the breathing oscillations onto the final \
equilibrium plateau."
}], "Text",
 CellChangeTimes->{{4.001597620682914*^9, 4.001597978008891*^9}, {
  4.001598021843769*^9, 4.001598024499298*^9}, {4.0017023108454523`*^9, 
  4.001702312724895*^9}},ExpressionUUID->"6a9e471e-5f17-46d9-a6af-\
c409c607585a"],

Cell[TextData[{
 "Finally, we evaluate the quantum purity and instantaneous entropy rates of \
the system and surrounding reservoir to verify the Second Law of (Quantum) \
Thermodynamics (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]S", "univ"], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[CapitalDelta]S", "sys"], "+", 
      SubscriptBox["\[CapitalDelta]S", "surr"]}], ">=", "0"}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bc34b789-382b-4239-86d0-38191d48c341"],
 "). Because a Gaussian reduced density matrix is completely characterized by \
its second-moment covariance matrix, its quantum purity"
}], "Text",
 CellChangeTimes->{{4.001598403402627*^9, 4.0015984796440353`*^9}, {
  4.0017023766185102`*^9, 
  4.001702378360119*^9}},ExpressionUUID->"fc38c09f-5468-405e-909e-\
8877ccb707bf"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[ScriptCapitalP]", "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{"Tr", "(", 
     SuperscriptBox[
      RowBox[{
       OverscriptBox["\[Rho]", "^"], "(", "t", ")"}], "2"], ")"}], "=", 
    SqrtBox[
     FractionBox[
      RowBox[{"Re", "(", 
       SubscriptBox["\[Alpha]", "t"], ")"}], 
      RowBox[{
       RowBox[{"Re", "(", 
        SubscriptBox["\[Alpha]", "t"], ")"}], "+", 
       RowBox[{"2", 
        SubscriptBox["\[Theta]", "t"]}]}]]]}]}], TraditionalForm]], "Text",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
   4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
   4.001167030269079*^9}, {4.001168402809308*^9, 4.001168426499454*^9}, {
   4.001195461673896*^9, 4.001195503258028*^9}, {4.001195834433279*^9, 
   4.001195998998259*^9}, {4.0011976314556*^9, 4.00119771342379*^9}, {
   4.001199104101141*^9, 4.001199115942663*^9}, {4.001199321428568*^9, 
   4.001199331465453*^9}, 4.001199392445671*^9, 4.001199467206645*^9, {
   4.001199563032137*^9, 4.001199583014041*^9}, {4.001203465471712*^9, 
   4.0012035255169*^9}, {4.001264251805689*^9, 4.0012642661539392`*^9}, {
   4.0013318278236923`*^9, 4.0013318316543007`*^9}, {4.001331917778775*^9, 
   4.001331919395858*^9}, {4.0014052911153917`*^9, 4.0014053358551207`*^9}, {
   4.001438800761121*^9, 4.001438835485734*^9}, {4.0014441785552053`*^9, 
   4.0014442534145613`*^9}, {4.0014443274979897`*^9, 4.00144434968614*^9}, {
   4.001444403662971*^9, 4.001444455698333*^9}, {4.001448073835705*^9, 
   4.0014480816049223`*^9}, {4.00153115348689*^9, 4.001531156617498*^9}, {
   4.001532066028286*^9, 4.001532095649414*^9}, {4.0015985129686413`*^9, 
   4.001598541178443*^9}},ExpressionUUID->"a0a60736-59f3-4d51-9565-\
c9bee0f2604c"],

Cell[TextData[{
 "and thermodynamic R\[EAcute]nyi-2 system entropy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["S", "sys"], "(", "t", ")"}], "=", 
    RowBox[{
     RowBox[{"-", "ln"}], " ", 
     RowBox[{"\[ScriptCapitalP]", "(", "t", ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d645cd1e-d7fa-49a6-b9cd-da519b2b2f99"],
 " can be tracked analytically along the numerical trajectory. \
Differentiating ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "sys"], "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "30c2a5d8-4534-4941-909b-d3a010f35e63"],
 " and substituting the Caldeira\[Dash]Leggett equations of motion yields an \
exact algebraic expression (see GWPEngineRDM1D appendix) for the \
instantaneous system entropy rate in which the unitary chirp terms cancel \
identically:"
}], "Text",
 CellChangeTimes->{{4.001598564264325*^9, 4.001598626596677*^9}, {
  4.001702418926865*^9, 
  4.0017024315740356`*^9}},ExpressionUUID->"957e6532-e536-46e1-a84c-\
7be2df81475d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox["S", "."], "sys"], "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"\[Gamma]", "(", "t", ")"}]}], "+", 
    FractionBox[
     RowBox[{
      RowBox[{"\[Gamma]", "(", "t", ")"}], "m", " ", 
      SubscriptBox["k", "B"], 
      RowBox[{"T", "(", "t", ")"}]}], 
     RowBox[{
      SuperscriptBox["\[HBar]", "2"], "(", 
      RowBox[{
       RowBox[{"Re", "(", 
        SubscriptBox["\[Alpha]", "t"], ")"}], "+", 
       RowBox[{"2", 
        SubscriptBox["\[Theta]", "t"]}]}], ")"}]]}]}], 
  TraditionalForm]], "Text",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
   4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
