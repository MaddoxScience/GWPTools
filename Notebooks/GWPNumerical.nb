Cell[TextData[{
 "Turning to the quantum shape dynamics, the three driving protocols produce \
markedly different behavior in the position uncertainty ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", " ", 
    SubscriptBox["x", "t"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7e74faf7-f30b-44a6-8eb1-a97b6dab6751"],
 " and momentum uncertainty ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", " ", 
    SubscriptBox["p", "t"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d79f7be5-62ed-43bd-8206-477b5898941d"],
 "."
}], "Text",
 CellChangeTimes->{{4.001510465543741*^9, 4.0015105282281322`*^9}, {
  4.001510868771779*^9, 
  4.0015108691919813`*^9}},ExpressionUUID->"0d9ff6c4-a244-42a7-aab6-\
0e44e08d030c"],

Cell[TextData[{
 "Sudden Resonant Squeezing: The discontinuous turn-on slope ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      OverscriptBox["V", "."], "2"], "(", "0", ")"}], "!=", "0"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "03bcdafa-8b20-4fd0-8377-4887b869c38b"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b4fa3875-6c2a-424e-a3f3-3289944114d2"],
 " immediately initiates parametric squeezing, causing ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", " ", 
    SubscriptBox["x", "t"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a975f7c1-f9fc-4022-a484-1650d1a4cd82"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", " ", 
    SubscriptBox["p", "t"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3ecdeccf-94f8-4501-a9ac-17f1807a0807"],
 " to oscillate ",
 Cell[BoxData[
  FormBox["\[Pi]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "29e1725d-6b7c-4ef7-87cf-f8e4a2d4d346"],
 " out of phase with exponentially growing envelopes that periodically \
compress below the unperturbed coherent ground-state limit ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[CapitalDelta]", " ", 
     SubscriptBox["x", "0"]}], "=", 
    RowBox[{
     RowBox[{"\[CapitalDelta]", " ", 
      SubscriptBox["p", "0"]}], "=", 
     RowBox[{"1", "/", 
      SqrtBox["2"]}]}]}], TraditionalForm]],ExpressionUUID->
  "1d31d674-083d-4c4d-874e-ce152e8a6c96"],
 "."
}], "Text",
 CellChangeTimes->{
  4.001402804006968*^9, {4.001402948590352*^9, 4.00140303362324*^9}, {
   4.0014030667478247`*^9, 4.001403067228863*^9}, {4.001403110467609*^9, 
   4.0014031189481792`*^9}, {4.001403241573546*^9, 4.001403277990081*^9}, {
   4.0014033240909023`*^9, 4.001403340415937*^9}, {4.001510557171606*^9, 
   4.001510658413706*^9}, {4.001510791671268*^9, 4.0015107956228113`*^9}, {
   4.001510873081484*^9, 4.001510877043501*^9}, {4.0017047366859283`*^9, 
   4.001704736686105*^9}},ExpressionUUID->"9dcea84b-7a48-4097-99e7-\
83d7dc061f06"],

Cell[TextData[{
 "Smooth Resonant Turn-On: Because the modulation envelope ramps up gradually \
around ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "0"], "=", 
    RowBox[{"2", "\[Pi]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5c281e0e-e29a-4e32-b89b-9593e58abc77"],
 ", the initial coherent state remains completely stationary throughout the \
quiet pre-ramp window (",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "\[LessTilde]", "\[Pi]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "781f39fe-7b1e-4d4d-b9bb-8343b7dd1a1e"],
 ") before smoothly locking into exponential squeezing with a delayed phase \
relative to the sudden protocol."
}], "Text",
 CellChangeTimes->{
  4.001510568358971*^9, {4.001510671020403*^9, 4.001510682432005*^9}, {
   4.001510730980835*^9, 4.001510748522275*^9}, {4.00151080975616*^9, 
   4.00151083820185*^9}},ExpressionUUID->"e75f1ac1-cf44-43bd-b91c-\
8d3fd46c13b2"],

Cell[TextData[{
 "Off-Resonant Paul-Trap Stability: Shifting the drive frequency to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalOmega]", "=", 
    RowBox[{"6", 
     SubscriptBox["\[Omega]", "0"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "58064b0b-36c1-48f2-bb44-79f06b558358"],
 " moves the wavepacket outside the parametric instability regime. Rapid \
curvature modulations average out, leaving the spatial and momentum widths \
nearly constant aside from small, high-frequency ripples once the envelope \
turns on."
}], "Text",
 CellChangeTimes->{
  4.001510575153153*^9, {4.001510894744771*^9, 4.001510915451169*^9}, 
   4.001510950390265*^9, {4.001692809910091*^9, 
   4.0016928202228193`*^9}},ExpressionUUID->"be17a99b-f3dc-436d-8b41-\
646c2f596c86"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"opts", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"BaseStyle", "->", 
      RowBox[{"FontSize", "->", "12"}]}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{"0", ",", "2"}], "}"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"GraphicsRow", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"objResSudden", "[", "\"\<UX\>\"", "]"}], "[", "t", "]"}], ",", 
        RowBox[{
         RowBox[{"objResSmooth", "[", "\"\<UX\>\"", "]"}], "[", "t", "]"}], ",", 
