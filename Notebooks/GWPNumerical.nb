Cell[CellGroupData[{

Cell["1D Squeezed-State Benchmark Across All Six Parameters", "Subsection",
 CellChangeTimes->{4.001264150286723*^9, 4.0012727231906137`*^9, 
  4.001505503993836*^9},ExpressionUUID->"fe75264d-7794-415f-a2fc-\
2072c0054c0e"],

Cell["\<\
In this example, we validate the six-equation 1D numerical solver against the \
exact analytical harmonic oscillator for a non-stationary squeezed and \
displaced GWP.  We will compare the time-dependent residual errors across all \
six real wavepacket parameters using default machine precision versus \
30-digit arbitrary precision.   \
\>", "Text",
 CellChangeTimes->{{4.001264163020631*^9, 4.001264199219149*^9}, {
   4.001264711039309*^9, 4.001264721328865*^9}, {4.001272743684187*^9, 
   4.001272832301428*^9}, {4.001272869631659*^9, 4.00127288400539*^9}, {
   4.001275405429172*^9, 4.001275416046464*^9}, {4.001505498331504*^9, 
   4.001505524199542*^9}, 
   4.001689981495358*^9},ExpressionUUID->"3deaa45c-dfbc-4906-b6e3-\
48d9dd15d9ac"],

Cell[TextData[{
 "To rigorously test all six coupled equations of motion in GWPNumerical1D, \
we initialize a non-stationary GWP with a squeezed and chirped complex width \
parameter (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "0"], "=", 
    RowBox[{
     RowBox[{"3", "/", "2"}], "+", 
     RowBox[{"\[ImaginaryI]", "/", "2"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a1bff1cd-f7d4-465f-80db-a6583f7bf4bd"],
 ") and a displaced phase-space center (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "0"], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5de272a6-b5a8-48eb-9f04-6447f26c0267"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "0"], "=", 
    RowBox[{"1", "/", "2"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1bea949e-d03c-4dbf-aca1-6cfe4a9563b2"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "0"], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8803b71b-3fae-483e-bfbd-76dae77f01d6"],
 ") over five full harmonic periods ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", " ", "\[Element]", 
    RowBox[{"[", 
     RowBox[{"0", ",", 
      RowBox[{"10", "\[Pi]"}]}], "]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8325ff6c-f642-4922-96a1-a7b6100d6128"],
 "."
}], "Text",
 CellChangeTimes->{{4.001264315811576*^9, 4.001264470964711*^9}, 
   4.001264705760887*^9, {4.0012652296828413`*^9, 4.001265292298526*^9}, {
   4.0012729188778687`*^9, 4.0012730813630342`*^9}, 4.001273221633543*^9, {
   4.001276920401219*^9, 4.001277091110628*^9}, {4.0015055400681143`*^9, 
   4.001505566847672*^9}, {4.001690367024597*^9, 
   4.001690371910921*^9}},ExpressionUUID->"8c4e2e58-ace6-4d2e-b874-\
3f150ac1da92"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "Parameters", " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"omega0", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tMin", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tMax", "=", 
     RowBox[{"5", "*", "2", "*", "Pi"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Squeezed", "+", 
     RowBox[{
     "chirped", " ", "shape", " ", "and", " ", "displaced", " ", "phase"}], "-", 
     RowBox[{"space", " ", "center"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"a0", "=", 
     RowBox[{
      RowBox[{"3", "/", "2"}], "+", 
      RowBox[{"I", "/", "2"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"x0", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"p0", "=", 
     RowBox[{"1", "/", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"g0", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Static", " ", "quadratic", " ", "coefficient", " ", "V2", 
      RowBox[{"(", "t", ")"}]}], "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], " ", "m", " ", 
      RowBox[{"omega0", "^", "2"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"v0", "=", 
     RowBox[{"0", "&"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"v1", "=", 
     RowBox[{"0", "&"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"v2Static", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"1", "/", "2"}], "*", 
        RowBox[{"omega0", "^", "2"}]}], ")"}], "&"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Constuct", " ", "GWPs"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"objExact", "=", 
     RowBox[{
      RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
      RowBox[{"a0", ",", "x0", ",", "p0", ",", "g0", ",", 
       RowBox[{"\"\<Potential\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Harmonic\>\"", ",", "omega0"}], "}"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"objNumMach", "=", 
     RowBox[{
      RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
      RowBox[{"a0", ",", "x0", ",", "p0", ",", "g0", ",", 
       RowBox[{"\"\<Potential\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Numerical\>\"", ",", "v0", ",", "v1", ",", "v2Static", ",",
           "tMin", ",", "tMax"}], "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"objNumPrec30", "=", 
     RowBox[{
      RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
      RowBox[{"a0", ",", "x0", ",", "p0", ",", "g0", ",", 
       RowBox[{"\"\<Potential\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Numerical\>\"", ",", "v0", ",", "v1", ",", "v2Static", ",",
           "tMin", ",", "tMax", ",", 
          RowBox[{"WorkingPrecision", "->", "30"}]}], "}"}]}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{4.0012584259666367`*^9, 4.001258425966797*^9}, {
   4.00126452051838*^9, 4.00126453275324*^9}, {4.001265100253439*^9, 
   4.0012651221711483`*^9}, {4.001265192785993*^9, 4.001265197383422*^9}, {
   4.0012653110545387`*^9, 4.0012654335599203`*^9}, {4.001265664683731*^9, 
   4.0012656710667257`*^9}, {4.001265887302927*^9, 4.001265894797673*^9}, {
   4.0012668756194773`*^9, 4.001266881916795*^9}, {4.0012684207386627`*^9, 
   4.001268421055987*^9}, 4.001268467641385*^9, {4.001268714758471*^9, 
   4.001268720751972*^9}, {4.0012689226979923`*^9, 4.001268923145936*^9}, {
   4.001268982720005*^9, 4.0012689931704607`*^9}, {4.001270870542026*^9, 
   4.001270895379573*^9}, {4.00127179437535*^9, 4.001271794499236*^9}, {
   4.001271853522359*^9, 4.001271853708881*^9}, {4.001272069081791*^9, 
   4.001272123086039*^9}, {4.0012731028273563`*^9, 4.001273134479062*^9}, {
   4.0012732194886017`*^9, 4.001273223558831*^9}, {4.001273455038406*^9, 
   4.001273472636257*^9}, {4.001274372233157*^9, 4.0012743727861357`*^9}, {
   4.001274479652952*^9, 4.001274480849175*^9}, {4.001274744113291*^9, 
   4.0012747468045273`*^9}, {4.001274889882337*^9, 4.00127489028894*^9}, {
   4.0012749321875553`*^9, 4.001274932930326*^9}, {4.0012754725592813`*^9, 
   4.00127550635574*^9}, {4.001505605885798*^9, 4.001505672395797*^9}, {
   4.0016919217585793`*^9, 4.001691933059161*^9}},
 CellLabel->"In[87]:=",ExpressionUUID->"b3b5be19-1ba2-4d67-919d-e54a63002f54"],

Cell["\<\
Each of the six real dynamical parameters exhibits a distinct physical \
signature across the five-period window.  Governed by Ehrenfest\
\[CloseCurlyQuote]s theorem, the position and momentum centers execute simple \
harmonic motion at the fundamental trap frequency. Because the initial shape \
parameter does not match the stationary ground-state width, the wavepacket \
undergoes periodic spatial \[OpenCurlyDoubleQuote]breathing.\
\[CloseCurlyDoubleQuote] The real part oscillates strictly positively between \
its compressed and expanded turning points at twice the trap frequency. \
Simultaneously, the phase-chirp parameter oscillates between positive and \
negative values at twice the frequency, passing through zero precisely at the \
inner and outer turning points of real part, where the wavepacket is \
momentarily unchirped. The real phase accumulates a negative drift modulated \
by fast oscillatory ripples at twice the trap frequency arising from the \
alternating kinetic and potential energy of the classical Lagrangian.  The \
imaginary part of the phase oscillates periodically in lockstep with the real \
shape parameter to preserve the wavepacket norm, and in this case returns \
exactly to zero at the end of every breathing cycle. \
\>", "Text",
 CellChangeTimes->{{4.001276150239133*^9, 4.0012761844929333`*^9}, {
   4.0012771219851303`*^9, 4.001277169286606*^9}, {4.001277519268117*^9, 
   4.001277770957382*^9}, {4.001277897483296*^9, 4.0012779121193113`*^9}, {
   4.001281366089066*^9, 4.001281370375647*^9}, {4.001281427702896*^9, 
   4.001281486024447*^9}, 4.001281520116743*^9, {4.001281552512664*^9, 
   4.001281552864921*^9}, {4.001690223302751*^9, 4.001690235647318*^9}, {
   4.001690404087446*^9, 
   4.001690406930811*^9}},ExpressionUUID->"322c92d0-3075-4501-a84f-\
e4ec9e1aad27"],

