         RowBox[{
          RowBox[{"objNumPrec30", "[", "\"\<IA\>\"", "]"}], "[", "t", "]"}]}],
         "]"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"errRX", "[", "t_", "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
