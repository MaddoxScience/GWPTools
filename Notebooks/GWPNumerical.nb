Cell[TextData[{
 "Numerically integrating both rates across the simulation interval confirms \
that the sum of the integrated mechanical work ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", "W", "\[RightAngleBracket]"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cc049e09-f87e-4301-a07d-d7a0f4b312f8"],
 " and dissipated heat ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftAngleBracket]", "Q", "\[RightAngleBracket]"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "950e16e6-bd91-4de4-8a46-2d947870ba13"],
 " matches the net internal energy change ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[CapitalDelta]", " ", "U"}], "=", 
    RowBox[{
     RowBox[{"U", "(", 
      SubscriptBox["t", "max"], ")"}], "-", 
     RowBox[{"U", "(", "0", ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "83505e11-5ae9-4db0-a870-9627e136a5ae"],
 " to high numerical precision, satisfying the First Law of Quantum \
Thermodynamics and recovering the exact classical equipartition difference ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[CapitalDelta]", " ", "U"}], "=", 
    RowBox[{
     SubscriptBox["k", "B"], " ", "\[CapitalDelta]", " ", "T"}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3e5f5957-3cac-4492-80bf-7e276b6dccdc"],
 "."
}], "Text",
 CellChangeTimes->{
  4.001597288882678*^9},ExpressionUUID->"7ba00766-a62b-4098-bde1-\
24406a21a1ad"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Integrate", " ", 
     RowBox[{"Over", "[", 
      RowBox[{"tMin", ",", "tMax"}], "]"}], " ", "to", " ", "Verify", " ", 
     "the", " ", "First", " ", 
     RowBox[{"Law", ":", 
      RowBox[{"Delta", " ", "U"}]}]}], "=", 
    RowBox[{"W", "+", "Q"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"totalWork", "=", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"workRate", "[", 
        RowBox[{"rdmCL", ",", "t"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tMin", ",", "tMax"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"totalHeat", "=", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"heatRate", "[", 
        RowBox[{"rdmCL", ",", "t"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tMin", ",", "tMax"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"deltaU", "=", 
     RowBox[{
      RowBox[{"internalEnergy", "[", 
       RowBox[{"rdmCL", ",", "tMax"}], "]"}], "-", 
      RowBox[{"internalEnergy", "[", 
       RowBox[{"rdmCL", ",", "tMin"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Exact", " ", "Equipartition", " ", 
      RowBox[{"Difference", ":", 
       RowBox[{
        RowBox[{"U", 
         RowBox[{"(", "tMax", ")"}]}], "-", 
        RowBox[{"U", 
         RowBox[{"(", "0", ")"}]}]}]}]}], "=", 
     RowBox[{"kT_F", "-", "kT_I"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"exactDeltaU", "=", 
     RowBox[{"kTF", "-", "kTI"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Integrated Mean Work <W>          = \>\"", ",", 
      "totalWork"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Integrated Mean Heat <Q>          = \>\"", ",", 
      "totalHeat"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Sum <W> + <Q>                     = \>\"", ",", 
      RowBox[{"totalWork", "+", "totalHeat"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Actual Internal Energy Change dU  = \>\"", ",", "deltaU"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Exact Equipartition Change (kTF - kTI) = \>\"", ",", 
      "exactDeltaU"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<First Law Residual |dU - (W + Q)| = \>\"", ",", 
      RowBox[{"Abs", "[", 
       RowBox[{"deltaU", "-", 
        RowBox[{"(", 
         RowBox[{"totalWork", "+", "totalHeat"}], ")"}]}], "]"}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{4.001263573212943*^9, 4.00126357321313*^9}, 
   4.001435324028504*^9, {4.0014399459716*^9, 4.001439954125979*^9}, 
   4.0014479750932817`*^9, {4.001531182442587*^9, 4.001531403592609*^9}, {
   4.0015973087825813`*^9, 4.0015973272107077`*^9}},
 CellLabel->
  "In[540]:=",ExpressionUUID->"dc4c2b2c-ebc9-483e-bb6d-136993a285e1"],

