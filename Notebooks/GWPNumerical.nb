Cell[CellGroupData[{

Cell["\<\
Example 3: Incorrect potential specification (raw numbers passed)\
\>", "Subsubsection",
 CellChangeTimes->{{4.001502032642476*^9, 4.0015020543126173`*^9}, {
  4.001502096100617*^9, 
  4.0015020971499023`*^9}},ExpressionUUID->"80c54ae2-dc23-4863-92d1-\
5f820f2493c6"],

Cell["\<\
This illustrates incorrect usage where the potential parameters are not input \
using functions.\
\>", "Text",
 CellChangeTimes->{{4.0016840587605753`*^9, 
  4.001684115667831*^9}},ExpressionUUID->"1c7ccc22-f650-4a47-9b70-\
2a09862750b9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Incorrect", " ", "usage", " ", "of", " ", "raw", " ", "numbers"}],
    " ", "*)"}], "\n", 
  RowBox[{"obj", "=", 
   RowBox[{
    RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
    RowBox[{"\"\<Potential\>\"", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Numerical\>\"", ",", " ", "0", ",", " ", "0", ",", " ", 
       RowBox[{"1", "/", "2"}], ",", " ", "0", ",", " ", "10"}], "}"}]}], 
    "]"}]}]}]], "Code",
 InitializationCell->False,
 CellChangeTimes->{
