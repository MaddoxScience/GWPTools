Cell[CellGroupData[{

Cell["Example Problems", "Section",
 CellChangeTimes->{{4.001255246299382*^9, 4.0012552517257967`*^9}, {
  4.001505444393875*^9, 
  4.001505448295002*^9}},ExpressionUUID->"76a55d86-1310-4df2-bb29-\
