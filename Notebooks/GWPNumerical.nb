Cell[CellGroupData[{

Cell["Passing NDSolve Options", "Subsection",
 CellChangeTimes->{{4.0012006654553137`*^9, 4.001200666870288*^9}, {
  4.001200963602799*^9, 
  4.001200967767618*^9}},ExpressionUUID->"bf78ca4f-e9ed-42f2-a9e0-\
06e7544db476"],

Cell["\<\
All numerical potential templates accept trailing opts___ that are forwarded \
directly to NDSolveValue. For long-time integrations, stiff dissipative \
ramps, or high-precision energy/Jarzynski work calculations, users can append \
standard NDSolve options directly inside the potential list:\
\>", "Text",
 CellChangeTimes->{
  4.00120203642308*^9},ExpressionUUID->"5736e10c-7fdb-4c07-802d-faac67ea26ef"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"obj1", "=", 
   RowBox[{
    RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
    RowBox[{"\"\<Potential\>\"", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Numerical\>\"", " ", ",", 
       RowBox[{"0", "&"}], ",", 
       RowBox[{"0", "&"}], ",", 
       RowBox[{
        RowBox[{"1", "/", "2"}], "&"}], ",", "0", ",", 
       RowBox[{"2", "Pi"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"obj2", "=", 
   RowBox[{
    RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
    RowBox[{"\"\<Potential\>\"", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Numerical\>\"", " ", ",", 
       RowBox[{"0", "&"}], ",", 
       RowBox[{"0", "&"}], ",", 
       RowBox[{
        RowBox[{"1", "/", "2"}], "&"}], ",", "0", ",", 
       RowBox[{"2", "Pi"}], ",", 
       RowBox[{"WorkingPrecision", "->", "20"}]}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{4.0015022301276283`*^9, 4.001502321765522*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"a03fb13c-1e18-4230-bc24-4987bbcb51d0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"obj1", "[", "\"\<UX\>\"", "]"}], "[", "1", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"obj2", "[", "\"\<UX\>\"", "]"}], "[", "1", "]"}]}], "Input",
 CellChangeTimes->{{4.001502294323329*^9, 4.0015023310672894`*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"82803267-0103-4ecf-bfb9-bbdd5578ef89"],

Cell[BoxData["0.6847958137783096`"], "Output",
 CellChangeTimes->{4.00168968813653*^9, 4.002180358110359*^9, 
  4.002192018453692*^9},
 CellLabel->"Out[26]=",ExpressionUUID->"496cf064-29b1-4f6f-85ff-b2a9f1ff7121"],

Cell[BoxData["0.68479552763183567284895686744891135556`19.73246298372078"], \
"Output",
 CellChangeTimes->{4.00168968813653*^9, 4.002180358110359*^9, 
  4.002192018478469*^9},
 CellLabel->"Out[27]=",ExpressionUUID->"326ac410-72d0-46bf-a09c-aeddc67a00c9"]
}, Open  ]],

Cell["\<\
Notice that the options go INSIDE the curly bracket for the \
\[OpenCurlyDoubleQuote]Potential\[CloseCurlyDoubleQuote] options.  If you put \
it outside, the option won\[CloseCurlyQuote]t get passed and unfortunately \
there is no warning at this time (I will get to fixing that...eventually). \
\>", "Text",
 CellChangeTimes->{{4.001502480279477*^9, 4.001502558157672*^9}, {
  4.00168972877166*^9, 
  4.001689733960576*^9}},ExpressionUUID->"05e652b7-4795-4546-b787-\
a02e26272bec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"obj3", "=", 
   RowBox[{
    RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
    RowBox[{
     RowBox[{"\"\<Potential\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Numerical\>\"", " ", ",", 
        RowBox[{"0", "&"}], ",", 
        RowBox[{"0", "&"}], ",", 
        RowBox[{
         RowBox[{"1", "/", "2"}], "&"}], ",", "0", ",", 
        RowBox[{"2", "Pi"}]}], "}"}]}], ",", 
     RowBox[{"WorkingPrecision", "->", "20"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.001502567940784*^9, 4.001502572828669*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"19302d67-c29f-4640-9145-a50a783b9d72"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"obj3", "[", "\"\<UX\>\"", "]"}], "[", "1", "]"}]], "Input",
 CellChangeTimes->{{4.0015025776600847`*^9, 4.001502593315321*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"16e14076-2858-4ded-8615-c825209c0512"],

Cell[BoxData["0.6847958137783096`"], "Output",
 CellChangeTimes->{4.001689691541217*^9, 4.002180361448936*^9, 
  4.002192021336897*^9},
 CellLabel->"Out[29]=",ExpressionUUID->"615fc08c-5581-47ef-9615-a42ca0eccc22"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["NDSolveValue Memoization", "Subsection",
 CellChangeTimes->{{4.001200484770651*^9, 4.001200488913815*^9}, {
  4.001200645123568*^9, 
  4.0012006492803497`*^9}},ExpressionUUID->"70409f5f-b9ba-4518-8213-\
18b4de7e3d89"],

Cell["\<\
In interactive workflows (Manipulate, Animate, or Plot over time), a \
wavepacket property may be queried thousands of times for the same potential \
and initial state. To prevent NDSolveValue from re-integrating the \
differential equations at every time point, each numerical package caches its \
InterpolatingFunction list using Mathematica\[CloseCurlyQuote]s downvalue \
memoization idiom.\
\>", "Text",
 CellChangeTimes->{{4.0012005068427353`*^9, 4.001200514556584*^9}, {
  4.00150285852157*^9, 
  4.001502860887774*^9}},ExpressionUUID->"2a94f93b-f2b3-4fef-b793-\
64764df1c574"],

Cell[BoxData[
 RowBox[{
  RowBox[{"obj", "=", 
   RowBox[{
    RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
    RowBox[{"\"\<Potential\>\"", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Numerical\>\"", " ", ",", 
       RowBox[{"0", "&"}], ",", 
       RowBox[{
        RowBox[{"1", "/", "10"}], "&"}], ",", 
       RowBox[{
        RowBox[{"1", "/", "2"}], "&"}], ",", "0", ",", "10"}], "}"}]}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.00150286520547*^9, 4.001502891787882*^9}, {
  4.001502983618539*^9, 4.001502984719298*^9}},
 CellLabel->"In[30]:=",ExpressionUUID->"ab67cebf-3831-4220-b54c-3380781f2d63"],

Cell[TextData[{
 "First query at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "1"], "\[Element]", 
    RowBox[{"[", 
     RowBox[{
      SubscriptBox["t", "min"], ",", 
      SubscriptBox["t", "max"]}], "]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5343d5ff-6985-4181-af5d-9b9f3a7b3d30"],
 ": NDSolveValue integrates the ODEs across the full interval once and stores \
the resulting InterpolatingFunction objects in memory."
}], "Text",
 CellChangeTimes->{
  4.001200597860819*^9, {4.001502674453753*^9, 
   4.0015027020930977`*^9}},ExpressionUUID->"cada2994-1894-458a-bb91-\
519a82fe7933"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Timing", "[", 
  RowBox[{
   RowBox[{"obj", "[", "\"\<UX\>\"", "]"}], "[", "1", "]"}], "]"}]], "Input",
 CellChangeTimes->{{4.001502901715479*^9, 4.001502936766029*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"18cde851-24a8-4763-bb30-07c34457b9a1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.002286`", ",", "0.684795815008152`"}], "}"}]], "Output",
 CellChangeTimes->{4.001684223524805*^9, 4.0016897469946337`*^9, 
  4.00218038211008*^9, 4.002192025475113*^9},
 CellLabel->"Out[31]=",ExpressionUUID->"2767f283-6d88-4863-bbde-a7bdf2855324"]
}, Open  ]],

Cell[TextData[{
 "Subsequent queries at ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4d770032-014e-4525-bf36-a0ee0f400c32"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a601f144-55db-43af-adc4-16acc1f99368"],
 ", \[Ellipsis], etc.: The router retrieves the cached InterpolatingFunctions \
and evaluates them at those time values. "
}], "Text",
 CellChangeTimes->{
  4.001200611190765*^9, {4.0015027083473177`*^9, 
   4.0015027685509977`*^9}},ExpressionUUID->"91482546-dc7f-47cd-bb15-\
c1f464063208"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Timing", "[", 
  RowBox[{
   RowBox[{"obj", "[", "\"\<UX\>\"", "]"}], "[", "2", "]"}], "]"}]], "Input",
 CellChangeTimes->{{4.001684216202587*^9, 4.001684218338608*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"9db6215e-438b-45ff-87a4-f8d794626f95"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.000415`", ",", "0.6163467415424918`"}], "}"}]], "Output",
 CellChangeTimes->{{4.001684218912333*^9, 4.0016842262120934`*^9}, 
   4.001689749037588*^9, 4.002180383482823*^9, 4.00219202788463*^9},
 CellLabel->"Out[32]=",ExpressionUUID->"543b37ae-3406-4533-87b9-5ab8cdd922ae"]
}, Open  ]],

Cell["\<\
Notice the second evaluation was an order of magnitude faster.\
\>", "Text",
 CellChangeTimes->{{4.001502948141514*^9, 
  4.00150296796284*^9}},ExpressionUUID->"cff82d95-da97-4b0a-9d56-\
d35a711a9a4a"],

Cell[TextData[{
 "Domain bounds protection: Querying any numerical model at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "<", 
    SubscriptBox["t", "min"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "70261345-37aa-4709-8b54-df907303f9b9"],
 " or ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", ">", 
    SubscriptBox["t", "max"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "191d7c2d-ec3a-4fb3-9a68-917af07a7820"],
 " triggers the out of bounds message and safely aborts evaluation ($Failed) \
rather than extrapolating outside the integration window:"
}], "Text",
 CellChangeTimes->{
  4.001200622622456*^9, 4.0015028329605293`*^9, {4.001683401393754*^9, 
   4.0016834340763597`*^9}},ExpressionUUID->"47ddfd9d-08e6-48d2-859f-\
576c27a8b9ef"],

