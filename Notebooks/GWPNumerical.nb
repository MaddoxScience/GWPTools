   4.001532066028286*^9, 
   4.001532095649414*^9}},ExpressionUUID->"3b80fef1-785d-4ddf-81ad-\
7aefa266e207"],

Cell["\<\
measures the irreversible dissipative energy current flowing between the \
thermal reservoir and the oscillator\[CloseCurlyQuote]s kinetic degree of \
freedom.\
\>", "Text",
 CellChangeTimes->{{4.001444463927594*^9, 
  4.001444491794495*^9}},ExpressionUUID->"2714c6c4-6740-4f06-b1a7-\
2bcca9c27a7d"],

Cell[TextData[{
 "Plotting ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["W", "."], "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "57f46e39-a9cd-4328-b24d-200e07a0a4d0"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["Q", "."], "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "254b684a-1cb8-459e-8bfd-1e8abf9d9a2f"],
 " across the ramping window protocol reveals that both energy fluxes vanish \
in the stationary equilibrium regions and peak sharply around the switching \
center ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "0"], "=", "10"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "da4c31b3-be8c-4a1b-9f7b-8510811c22d8"],
 ". As the trap stiffens and compresses the wavepacket, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["W", "."], "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f93d90bc-98c2-486e-917c-cb1b39f762d3"],
 " spikes positively, injecting mechanical energy into the system, while ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["Q", "."], "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d2ae7330-407c-4d7a-88c0-60f991a9dc3a"],
 " responds to the instantaneous imbalance between the bath temperature and \
the oscillator\[CloseCurlyQuote]s doubled kinetic energy. "
}], "Text",
 CellChangeTimes->{{4.001447519253401*^9, 4.001447670578269*^9}, {
  4.0014477168654137`*^9, 4.001447872400332*^9}, {4.00144796448429*^9, 
  4.001447967745*^9}, {4.001530987304188*^9, 4.001531013110649*^9}, {
  4.001597266882637*^9, 4.0015972855065193`*^9}, {4.001597316413393*^9, 
  4.001597316748063*^9}},ExpressionUUID->"8a2f7aeb-ab30-46f5-a6f5-\
5a98e9a3aad1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Reconstruct", " ", "Phase"}], "-", 
    RowBox[{"Space", " ", "Variances", " ", "Sigma_xx", 
     RowBox[{"(", "t", ")"}], " ", "and", " ", "Sigma_pp", 
     RowBox[{"(", "t", ")"}], " ", "from", " ", "RDM1D", " ", 
     "Properties"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"sxx", "[", 
      RowBox[{"obj_", ",", "t_"}], "]"}], ":=", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"4", "*", 
        RowBox[{
         RowBox[{"obj", "[", "\"\<RealShape\>\"", "]"}], "[", "t", "]"}]}], 
       ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"spp", "[", 
      RowBox[{"obj_", ",", "t_"}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ra", "=", 
          RowBox[{
           RowBox[{"obj", "[", "\"\<RealShape\>\"", "]"}], "[", "t", "]"}]}], 
         ",", "\[IndentingNewLine]", 
         RowBox[{"ia", "=", 
          RowBox[{
           RowBox[{"obj", "[", "\"\<ImaginaryShape\>\"", "]"}], "[", "t", 
           "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"th", "=", 
          RowBox[{
           RowBox[{"obj", "[", "\"\<Decoherence\>\"", "]"}], "[", "t", 
           "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"hbar", "^", "2"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "*", "th"}], "+", "ra", "+", 
          RowBox[{
           RowBox[{"ia", "^", "2"}], "/", "ra"}]}], ")"}]}]}], "]"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Instantaneous", " ", "Internal", " ", "Energy", " ", "U", 
      RowBox[{"(", "t", ")"}]}], "=", " ", 
     RowBox[{"<", 
      RowBox[{"H", 
       RowBox[{"(", "t", ")"}]}], ">"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"internalEnergy", "[", 
      RowBox[{"obj_", ",", "t_"}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"xt", "=", 
          RowBox[{
           RowBox[{"obj", "[", "\"\<PositionCenter\>\"", "]"}], "[", "t", 
           "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"pt", "=", 
          RowBox[{
           RowBox[{"obj", "[", "\"\<MomentumCenter\>\"", "]"}], "[", "t", 
           "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"pt", "^", "2"}], "+", 
           RowBox[{"spp", "[", 
            RowBox[{"obj", ",", "t"}], "]"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", "m"}], ")"}]}], "+", 
        RowBox[{
         RowBox[{"v2Ramp", "[", "t", "]"}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"xt", "^", "2"}], "+", 
           RowBox[{"sxx", "[", 
            RowBox[{"obj", ",", "t"}], "]"}]}], ")"}]}]}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"Instantaneous", " ", "Work", " ", "Rate", " ", 
     RowBox[{"dW", "/", "dt"}], " ", "and", " ", "Heat", " ", "Flux", " ", 
     RowBox[{"dQ", "/", "dt"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"workRate", "[", 
      RowBox[{"obj_", ",", "t_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{"xt", "=", 
         RowBox[{
          RowBox[{"obj", "[", "\"\<PositionCenter\>\"", "]"}], "[", "t", 
          "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"v2Ramp", "'"}], "[", "t", "]"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"xt", "^", "2"}], "+", 
          RowBox[{"sxx", "[", 
           RowBox[{"obj", ",", "t"}], "]"}]}], ")"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"heatRate", "[", 
      RowBox[{"obj_", ",", "t_"}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pt", "=", 
         RowBox[{
          RowBox[{"obj", "[", "\"\<MomentumCenter\>\"", "]"}], "[", "t", 
          "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"gammaRamp", "[", "t", "]"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"kTRamp", "[", "t", "]"}], "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"pt", "^", "2"}], "+", 
             RowBox[{"spp", "[", 
              RowBox[{"obj", ",", "t"}], "]"}]}], ")"}], "/", "m"}]}], 
         ")"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "Instantaneous", " ", "Power", " ", 
     RowBox[{"(", 
      RowBox[{"dW", "/", "dt"}], ")"}], " ", "and", " ", "Heat", " ", "Flux", 
     " ", 
     RowBox[{"(", 
      RowBox[{"dQ", "/", "dt"}], ")"}], " ", "During", " ", "Transition"}], 
    "*)"}], "\n", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"workRate", "[", 
        RowBox[{"rdmCL", ",", "t"}], "]"}], ",", 
       RowBox[{"heatRate", "[", 
        RowBox[{"rdmCL", ",", "t"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "tMin", ",", 
       RowBox[{"tMax", "/", "2"}]}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Mechanical Power dW/dt\>\"", 
        ",", "\"\<Bath Heat Flux dQ/dt\>\""}], "}"}]}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", " ", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<time\>\"", ",", "\"\<Energy Rate\>\""}], "}"}]}], ",", 
     RowBox[{"BaseStyle", "->", 
      RowBox[{"FontSize", "->", "12"}]}]}], "]"}]}]}]], "Input",
 CellLabel->
  "In[534]:=",ExpressionUUID->"061266a9-1b7d-4a9e-9118-075884f9ab92"],

