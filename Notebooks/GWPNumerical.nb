  RowBox[{"(*", 
   RowBox[{
    RowBox[{"2.", " ", "Redefine", " ", 
     RowBox[{"v1", "[", "t", "]"}], " ", "in"}], "-", 
    RowBox[{
    "place", " ", "to", " ", "a", " ", "stronger", " ", "driving", " ", 
     "force"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"v1", "[", "t_", "]"}], ":=", 
     RowBox[{"1", "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
