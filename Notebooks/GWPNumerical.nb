Cell[TextData[{
 "At first glance, the rapid growth of the envelope of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", " ", 
    SubscriptBox["x", "t"], "\[CapitalDelta]", " ", 
    SubscriptBox["p", "t"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2a2cb7d9-d6c6-4fbe-8b9f-3efbae3d613b"],
 " during resonant squeezing might suggest that the wavepacket is losing \
purity or undergoing effective heating. However, examining the symmetrized \
position\[Dash]momentum covariance COVXP(t) alongside the \
Robertson\[Dash]Schr\[ODoubleDot]dinger generalized uncertainty invariant,"
}], "Text",
 CellChangeTimes->{
  4.0015110224362783`*^9, {4.001511095340185*^9, 
   4.001511119359262*^9}},ExpressionUUID->"9329f2cc-9a88-4fea-96c5-\
fcdae5d66ba4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"det", " ", 
    RowBox[{
     StyleBox["\[CapitalSigma]",
      FontWeight->"Bold"], "(", "t", ")"}]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"\[CapitalDelta]", " ", 
         SubscriptBox["x", "t"]}], ")"}], "2"], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"\[CapitalDelta]", " ", 
         SubscriptBox["p", "t"]}], ")"}], "2"]}], "-", 
     SubsuperscriptBox[
      RowBox[{"Cov", "(", 
       RowBox[{"x", ",", "p"}], ")"}], "t", "2"]}], "=", 
    FractionBox[
     SuperscriptBox["\[HBar]", "2"], "4"]}]}], TraditionalForm]], "Text",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
   4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
   4.001167030269079*^9}, {4.001168402809308*^9, 4.001168426499454*^9}, {
   4.001195461673896*^9, 4.001195503258028*^9}, {4.001195834433279*^9, 
   4.001195998998259*^9}, {4.0011976314556*^9, 4.00119771342379*^9}, {
   4.001199104101141*^9, 4.001199115942663*^9}, {4.001199321428568*^9, 
   4.001199331465453*^9}, 4.001199392445671*^9, 4.001199467206645*^9, {
   4.001199563032137*^9, 4.001199583014041*^9}, {4.001203465471712*^9, 
   4.0012035255169*^9}, {4.001264251805689*^9, 4.0012642661539392`*^9}, {
   4.0013318278236923`*^9, 4.0013318316543007`*^9}, {4.001331917778775*^9, 
   4.001331919395858*^9}, 4.001509128224332*^9, {4.001511055716851*^9, 
   4.001511086603106*^9}},ExpressionUUID->"087c46b6-ed2d-45cd-aea0-\
1c10444073fe"],

Cell[TextData[{
 "reveals the underlying geometric mechanism. Whenever the squeezed \
wavepacket stretches between its turning points, strong \
position\[Dash]momentum correlations (COVXP(t)) build up as the phase-space \
uncertainty ellipse tilts diagonally in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", " ", "p"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "673ac7d3-74eb-4e83-9bac-112063306898"],
 "-plane.  As shown in the final pair of plots below, this growth in second \
term exactly compensates the first term, keeping the generalized uncertainty \
determinant locked at the minimum pure-state value of 1/4 across all three \
protocols. In accordance with Liouville\[CloseCurlyQuote]s theorem for \
unitary Gaussian evolution, parametric driving stretches and rotates the \
phase-space ellipse without altering its area\[LongDash]distinguishing \
coherent unitary squeezing from dissipative thermal broadening."
}], "Text",
 CellChangeTimes->{
  4.001511033221414*^9, {4.0015111486996307`*^9, 4.0015111849003057`*^9}, {
   4.001511216785638*^9, 
   4.001511252821941*^9}},ExpressionUUID->"098d5b97-ee6f-464e-ab9b-\
37b522d98831"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Robertson", "-", 
    RowBox[{"Schrodinger", " ", "Generalized", " ", "Uncertainty", " ", 
     RowBox[{"Invariant", ":", 
      RowBox[{
       RowBox[{
        RowBox[{"UX", "^", "2"}], "*", 
        RowBox[{"UP", "^", "2"}]}], "-", 
       RowBox[{"COVXP", "^", "2"}]}]}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"rsInvariant", "[", 
      RowBox[{"obj_", ",", "t_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"obj", "[", "\"\<UX\>\"", "]"}], "[", "t", "]"}], "^", "2"}],
        "*", 
       RowBox[{
        RowBox[{
         RowBox[{"obj", "[", "\"\<UP\>\"", "]"}], "[", "t", "]"}], "^", 
        "2"}]}], "-", 
      RowBox[{
       RowBox[{
        RowBox[{"obj", "[", "\"\<COVXP\>\"", "]"}], "[", "t", "]"}], "^", 
       "2"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"objResSudden", "[", "\"\<COVXP\>\"", "]"}], "[", "t", 
           "]"}], ",", 
          RowBox[{
           RowBox[{"objResSmooth", "[", "\"\<COVXP\>\"", "]"}], "[", "t", 
           "]"}], ",", 
          RowBox[{
           RowBox[{"objOffResSmooth", "[", "\"\<COVXP\>\"", "]"}], "[", "t", 
           "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "tMin", ",", "tMax"}], "}"}], ",", 
        RowBox[{"Evaluate", "@", "opts"}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<time\>\"", ",", "\"\<COVXP(t)\>\""}], "}"}]}], ",", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "2"}], ",", "2"}], "}"}]}]}], "]"}], ",", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"rsInvariant", "[", 
           RowBox[{"objResSudden", ",", "t"}], "]"}], ",", 
          RowBox[{"rsInvariant", "[", 
           RowBox[{"objResSmooth", ",", "t"}], "]"}], ",", 
          RowBox[{"rsInvariant", "[", 
           RowBox[{"objOffResSmooth", ",", "t"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "tMin", ",", "tMax"}], "}"}], ",", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "0.05"}], ",", "0.55"}], "}"}]}], ",", 
        RowBox[{"Evaluate", "@", "opts"}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<time\>\"", ",", "\"\<Det[Sigma]\>\""}], "}"}]}]}], 
       "]"}]}], "}"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{4.001510981935451*^9, 4.001510988810616*^9}, {
  4.001511264351985*^9, 4.001511285431652*^9}},
 CellLabel->
  "In[139]:=",ExpressionUUID->"e0ab9de2-8a14-401c-8a7c-e212bca88044"],

