Cell[CellGroupData[{

Cell["1D Paul Trap & Parametric Phase-Space Squeezing", "Subsection",
 CellChangeTimes->{{4.001287481188089*^9, 4.0012874833233213`*^9}, {
   4.001290381422467*^9, 4.001290382716032*^9}, 
   4.001506583853299*^9},ExpressionUUID->"31226936-14ea-4bfa-a3b0-\
e11b1b09fc4e"],

Cell["\<\
In this example, we simulate a coherent GWP in a parametrically modulated \
harmonic trap with time-dependent curvature\
\>", "Text",
 CellChangeTimes->{{4.0013318055622673`*^9, 4.001331813151903*^9}, {
   4.0015065909052277`*^9, 4.0015066229001713`*^9}, 4.001509202148752*^9, {
   4.001692025243197*^9, 
   4.0016920255945683`*^9}},ExpressionUUID->"cfd69b46-f510-4705-b834-\
4c977e261fa3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["V", "2"], "(", "t", ")"}], "=", 
   RowBox[{
    FractionBox["1", "2"], "m", " ", 
    RowBox[{
     SubsuperscriptBox["\[Omega]", "0", "2"], "(", 
     RowBox[{"1", "+", 
      RowBox[{"\[Epsilon]", " ", 
       RowBox[{"s", "(", "t", ")"}], 
       RowBox[{"sin", "(", 
        RowBox[{"\[CapitalOmega]", " ", "t"}], ")"}]}]}], ")"}]}]}], 
  TraditionalForm]], "Text",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
   4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
   4.001167030269079*^9}, {4.001168402809308*^9, 4.001168426499454*^9}, {
   4.001195461673896*^9, 4.001195503258028*^9}, {4.001195834433279*^9, 
   4.001195998998259*^9}, {4.0011976314556*^9, 4.00119771342379*^9}, {
   4.001199104101141*^9, 4.001199115942663*^9}, {4.001199321428568*^9, 
   4.001199331465453*^9}, 4.001199392445671*^9, 4.001199467206645*^9, {
   4.001199563032137*^9, 4.001199583014041*^9}, {4.001203465471712*^9, 
   4.0012035255169*^9}, {4.001264251805689*^9, 4.0012642661539392`*^9}, {
   4.0013318278236923`*^9, 4.0013318316543007`*^9}, {4.001331917778775*^9, 
   4.001331919395858*^9}, 
   4.001509128224332*^9},ExpressionUUID->"3b603abe-18c5-407d-bbbf-\
6af4b15fb304"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "de6c6669-b185-457b-8877-d7ca166498ec"],
 " is the unperturbed trap frequency, ",
 Cell[BoxData[
  FormBox["\[Epsilon]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ce8dc95b-cdb8-43d9-869d-5c514e2f43c4"],
 " is the modulation depth, ",
 Cell[BoxData[
  FormBox["\[CapitalOmega]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9b4abe11-a52a-4a07-b399-492c43601694"],
 " is the drive frequency, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"s", "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8e5267c8-1c58-4c72-acfe-646c19ff9be9"],
 " is a dimensionless switching envelope.  We compare three distinct physical \
driving protocols:"
}], "Text",
 CellChangeTimes->{{4.001509208670719*^9, 
  4.00150928444354*^9}},ExpressionUUID->"02dbf239-ca04-45ff-bd99-\
72efd9e0df39"],

Cell[TextData[{
 "(1) Sudden Resonant Modulation (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalOmega]", "=", 
    RowBox[{"2", 
     SubscriptBox["\[Omega]", "0"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5fa59211-0bb3-4ddd-95e5-92bee149c4d3"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"s", "(", "t", ")"}], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dec5b297-954a-4460-b6fd-d2b8c633dd83"],
 "): The modulation is active at full amplitude from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f2f0b0ff-9841-4463-a11e-aed6918a0280"],
 ".  Although the potential curvature starts at its unperturbed baseline ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["V", "2"], "(", "0", ")"}], "=", 
    RowBox[{
     FractionBox["1", "2"], "m", " ", 
     SubsuperscriptBox["\[Omega]", "0", "2"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9460163d-b8c3-4028-9f58-1b2a0522d43e"],
 ", its initial time derivative is discontinuous (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox[
      OverscriptBox["V", "."], "2"], "(", "0", ")"}], "!=", "0"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c92067a7-13fb-451f-9a09-2b867ae8ab36"],
 "), imparting an immediate parametric impulse at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f5fe28a8-4749-4990-a981-d591de903156"],
 "."
}], "Text",
 CellChangeTimes->{
  4.001331862311536*^9, {4.001331905381507*^9, 4.001331946475914*^9}, {
   4.001331976739794*^9, 4.001332041952918*^9}, 4.0014025907849207`*^9, {
   4.001506647947693*^9, 4.0015066488108263`*^9}, {4.001509299960658*^9, 
   4.001509380851087*^9}},ExpressionUUID->"3b39b44e-efe9-454e-90bd-\
56746f090e65"],

Cell[TextData[{
 "(2) Smooth Resonant Turn-On (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalOmega]", "=", 
    RowBox[{"2", 
     SubscriptBox["\[Omega]", "0"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "813bc613-b25f-49d5-8e42-a9bc3b357575"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"s", 
     RowBox[{"(", "t", ")"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"1", "/", "2"}], 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"tanh", 
        RowBox[{"(", 
         RowBox[{"\[Kappa]", "(", 
          RowBox[{"t", "-", 
           SubscriptBox["t", "0"]}], ")"}], ")"}]}]}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b330d62a-22c3-448b-95c7-6a9f05701fd8"],
 "): The modulation ramps up smoothly from zero around ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "0"], "=", 
    RowBox[{"2", "\[Pi]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4e4388c7-d7e7-4059-b18e-f4db27bf471a"],
 " (with switching rate ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Kappa]", "=", 
    RowBox[{"4", "/", "5"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "60065592-c420-4787-bc23-562856cd0e8c"],
 "), allowing the wavepacket to execute one full unperturbed oscillation \
before the drive engages.  Because the envelop ",
 Cell[BoxData[
  FormBox[
   RowBox[{"s", "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "39db655b-aea7-4ca6-9dc3-eb30b6bd0c5f"],
 " breaks strict time-periodicity during the ramp, closed-form Mathieu or \
Floquet analytical solutions no longer apply, necessitating numerical \
integration."
}], "Text",
 CellChangeTimes->{
  4.001331872113873*^9, {4.001332051887081*^9, 4.0013321097877007`*^9}, {
   4.001506650285551*^9, 4.0015066512082243`*^9}, {4.001506760114744*^9, 
   4.001506760499353*^9}, {4.001509174323543*^9, 4.001509175320635*^9}, {
   4.001509388714533*^9, 4.00150955524078*^9}, {4.001704881484634*^9, 
   4.001704882988229*^9}},ExpressionUUID->"39df40cf-4419-4640-91aa-\
8fee40631733"],

Cell[TextData[{
 "(3) Smooth Off-Resonant Paul Trap Regime (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalOmega]", "=", 
    RowBox[{"6", 
     SubscriptBox["\[Omega]", "0"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2f89afa6-db30-4eb5-9248-119b5f9768b3"],
 ", with the same ramp): Using the same smooth turn-on envelope, the trap is \
driven well above the fundamental parametric resonance. Operating in this \
stable Paul-trap regime avoids exponential parametric amplification, yielding \
bounded secular confinement dressed by high-frequency motion."
}], "Text",
 CellChangeTimes->{
  4.001331881426901*^9, {4.0014026095360727`*^9, 4.001402643205454*^9}, {
   4.001506652870623*^9, 4.0015066537020407`*^9}, {4.001509615778371*^9, 
   4.001509648972951*^9}, {4.001692966858268*^9, 
   4.0016929676554403`*^9}},ExpressionUUID->"29022b1f-ccef-4be3-b0ee-\
942d9f1779a3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Parameters", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"omega0", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"eps", "=", 
     RowBox[{"3", "/", "10"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kappa", "=", 
     RowBox[{"4", "/", "5"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"t0", "=", 
     RowBox[{"2", "*", "Pi"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tMin", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tMax", "=", 
     RowBox[{"3", "*", "2", "*", "Pi"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"1.", " ", "Sudden", " ", "Resonant", " ", "Drive", " ", 
     RowBox[{"(", 
      RowBox[{"Omega", "=", 
       RowBox[{"2", "*", "omega0"}]}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"v2ResSudden", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], "*", 
      RowBox[{"omega0", "^", "2"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"eps", "*", 
         RowBox[{"Sin", "[", 
          RowBox[{"2", "*", "omega0", "*", "t"}], "]"}]}]}], ")"}]}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "Smooth", " ", "Resonant", " ", "Drive", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Omega", "=", 
        RowBox[{"2", "*", "omega0"}]}], ",", 
       RowBox[{
        RowBox[{"centered", " ", "at", " ", "t0"}], "=", 
        RowBox[{"2", "*", "Pi"}]}]}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{
     RowBox[{"env", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"Tanh", "[", 
         RowBox[{"kappa", "*", 
          RowBox[{"(", 
           RowBox[{"t", "-", "t0"}], ")"}]}], "]"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"v2ResSmooth", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], "*", 
      RowBox[{"omega0", "^", "2"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"eps", "*", 
         RowBox[{"env", "[", "t", "]"}], "*", 
         RowBox[{"Sin", "[", 
          RowBox[{"2", "*", "omega0", "*", "t"}], "]"}]}]}], ")"}]}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"3.", " ", "Smooth", " ", "Off"}], "-", 
     RowBox[{"Resonant", " ", "Paul", " ", "Trap", " ", "Drive", " ", 
      RowBox[{"(", 
       RowBox[{"Omega", "=", 
        RowBox[{"6", "*", "omega0"}]}], ")"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"v2OffResSmooth", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], "*", 
      RowBox[{"omega0", "^", "2"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"eps", "*", 
         RowBox[{"env", "[", "t", "]"}], "*", 
         RowBox[{"Sin", "[", 
          RowBox[{"6", "*", "omega0", "*", "t"}], "]"}]}]}], ")"}]}]}], ";"}],
    "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Initialize", " ", "displaced", " ", "coherent"}], "-", 
     RowBox[{"state", " ", "wavepackets", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"alpha0", "=", 
         RowBox[{"1", "/", "2"}]}], ",", 
        RowBox[{"x0", "=", "1"}]}], ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"objResSudden", "=", 
     RowBox[{
      RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"1", "/", "2"}], ",", "1", ",", "0", ",", "0", ",", 
       RowBox[{"\"\<Potential\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Numerical\>\"", ",", 
          RowBox[{"0", "&"}], ",", 
          RowBox[{"0", "&"}], ",", "v2ResSudden", ",", "tMin", ",", "tMax"}], 
         "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"objResSmooth", "=", 
     RowBox[{
      RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"1", "/", "2"}], ",", "1", ",", "0", ",", "0", ",", 
       RowBox[{"\"\<Potential\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Numerical\>\"", ",", 
          RowBox[{"0", "&"}], ",", 
          RowBox[{"0", "&"}], ",", "v2ResSmooth", ",", "tMin", ",", "tMax"}], 
         "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"objOffResSmooth", "=", 
     RowBox[{
      RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"1", "/", "2"}], ",", "1", ",", "0", ",", "0", ",", 
       RowBox[{"\"\<Potential\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Numerical\>\"", ",", 
          RowBox[{"0", "&"}], ",", 
          RowBox[{"0", "&"}], ",", "v2OffResSmooth", ",", "tMin", ",", 
          "tMax"}], "}"}]}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.001288494356597*^9, 4.0012884943567333`*^9}, {
   4.001288625938581*^9, 4.0012886687080717`*^9}, {4.0012887028081427`*^9, 
   4.001288703438242*^9}, {4.0012887574302483`*^9, 4.001288758573886*^9}, {
   4.001289911597332*^9, 4.001289921250227*^9}, {4.0014026799955606`*^9, 
   4.001402687861298*^9}, {4.001402719820291*^9, 4.001402722296472*^9}, {
   4.001402885142077*^9, 4.0014029060105467`*^9}, {4.001506858578862*^9, 
   4.001506871491845*^9}, {4.001506913979567*^9, 4.0015069277706947`*^9}, {
   4.001506960087338*^9, 4.001506960320491*^9}, {4.001507120078405*^9, 
   4.001507151025196*^9}, {4.001507359938817*^9, 4.0015073605559607`*^9}, 
   4.001508504136743*^9, 4.001508577258411*^9, {4.00150867302906*^9, 
   4.0015086733805723`*^9}, 4.001509666795395*^9, {4.001692084103613*^9, 
   4.0016921638455057`*^9}, {4.001692251372669*^9, 4.00169226420153*^9}},
 CellLabel->
  "In[141]:=",ExpressionUUID->"474dca00-6254-4311-a3b8-06338fa41771"],

Cell[TextData[{
 "The figure below compares the time evolution of the quadratic curvature \
coefficient ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "2"], "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3db52dea-4f4e-4568-b1d6-0a5085f1728f"],
 " across the three protocols. Notice that the smooth resonant ramp remains \
nearly flat at the unperturbed value ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "2"], "=", 
    RowBox[{
     RowBox[{"m", " ", 
      RowBox[{
       SubscriptBox["\[Omega]", "0"], "/", "2"}]}], "=", 
     RowBox[{"1", "/", "2"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0a15f576-ac44-4d7c-bf7b-855532bd2464"],
 " during the first trap half-period (",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "\[LessTilde]", "\[Pi]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fa612bc5-9815-44d6-abb5-f9a937986aec"],
 ") and smoothly locks onto the sudden resonant curve for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "\[GreaterTilde]", "3"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9af0e6dd-bd80-423b-97a7-a794db1432f4"],
 ", whereas the off-resonant ramp oscillates at three times the frequency \
within the same switching envelope."
}], "Text",
 CellChangeTimes->{{4.001507255971201*^9, 4.001507288744231*^9}, {
  4.001508868381805*^9, 4.001508899175696*^9}, {4.0015089413875093`*^9, 
  4.001509034641884*^9}, {4.001509709083372*^9, 4.001509772708157*^9}, {
  4.0016923747982817`*^9, 4.001692377321916*^9}, {4.0017049202751007`*^9, 
  4.0017049202753572`*^9}, {4.001704961917165*^9, 
  4.0017049943520737`*^9}},ExpressionUUID->"b5af7fda-da42-4376-b0fc-\
67230e43a249"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"v2ResSudden", "[", "t", "]"}], ",", 
     RowBox[{"v2ResSmooth", "[", "t", "]"}], ",", 
     RowBox[{"v2OffResSmooth", "[", "t", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "tMin", ",", "tMax"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "/", "4"}], ",", 
      RowBox[{"3", "/", "4"}]}], "}"}]}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Time (t)\>\"", 
      ",", "\"\<\!\(\*SubscriptBox[\(V\), \(2\)]\)(t)\>\""}], "}"}]}], ",", 
   RowBox[{"BaseStyle", "->", 
    RowBox[{"{", 
     RowBox[{"FontSize", "->", "12"}], "}"}]}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Sudden resonant\>\"", ",", "\"\<Smooth resonant ramp\>\"", 
      ",", "\"\<Smooth off-resonant ramp\>\""}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{4.001507290544785*^9, 4.00150735459021*^9}, {
   4.001508679886964*^9, 4.001508680199565*^9}, {4.0015089162382*^9, 
   4.001508921213825*^9}, 4.001509683430566*^9, {4.001692177393162*^9, 
   4.001692179477934*^9}},
 CellLabel->
  "In[154]:=",ExpressionUUID->"d63c795b-48a9-47fa-a037-b48581a50260"],

