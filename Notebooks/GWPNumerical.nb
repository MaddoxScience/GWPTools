     RowBox[{"-", 
      FractionBox[
       RowBox[{"2", "\[HBar]"}], "m"]}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Re", "(", 
         SubscriptBox["\[Alpha]", 
          RowBox[{
           RowBox[{"x", " ", "y"}], ",", "t"}]], ")"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Re", "(", 
           SubscriptBox["\[Alpha]", 
            RowBox[{
             RowBox[{"x", " ", "x"}], ",", "t"}]], ")"}], "+", 
          RowBox[{"Re", "(", 
           SubscriptBox["\[Alpha]", 
            RowBox[{"yy", ",", "t"}]], ")"}]}], ")"}]}], "-", 
       RowBox[{
        RowBox[{"Im", "(", 
         SubscriptBox["\[Alpha]", 
          RowBox[{
           RowBox[{"x", " ", "y"}], ",", "t"}]], ")"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Im", "(", 
           SubscriptBox["\[Alpha]", 
            RowBox[{
             RowBox[{"x", " ", "x"}], ",", "t"}]], ")"}], "+", 
          RowBox[{"Im", "(", 
           SubscriptBox["\[Alpha]", 
            RowBox[{
             RowBox[{"y", " ", "y"}], ",", "t"}]], ")"}]}], ")"}]}]}], 
      ")"}]}], "+", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", "\[HBar]"}]], 
     RowBox[{
      SubscriptBox["V", "11"], "(", "t", ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
  4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
  4.001167030269079*^9}, {4.001168402809308*^9, 4.001168426499454*^9}, {
  4.001195461673896*^9, 4.001195503258028*^9}, {4.001195834433279*^9, 
  4.001195998998259*^9}, {4.001196046663755*^9, 4.001196132915935*^9}, {
  4.001196753335545*^9, 4.001196776489132*^9}, {4.0011969125355167`*^9, 
  4.0011969533036213`*^9}, {4.001196991980651*^9, 4.0011970333074636`*^9}, {
  4.001680460675295*^9, 4.001680473128907*^9}, {4.001682318493808*^9, 
  4.001682344127328*^9}},ExpressionUUID->"e67f4f80-9a2f-4ad5-a8ad-\
6c62efbce304"],

Cell["Finally, for the global phase, we have", "Text",
 CellChangeTimes->{{4.001197594649481*^9, 
  4.00119762003895*^9}},ExpressionUUID->"4129da58-7705-4a1d-8ffc-\
0bb6a9060a53"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Re", "(", 
    SubscriptBox[
     OverscriptBox["\[Gamma]", "."], "t"], ")"}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", "m"}]], 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["p", 
        RowBox[{"x", ",", "t"}], "2"], "+", 
       SubsuperscriptBox["p", 
        RowBox[{"y", ",", "t"}], "2"]}], ")"}]}], "-", 
    RowBox[{"V", "(", 
     RowBox[{
      SubscriptBox["x", "t"], ",", 
      SubscriptBox["y", "t"], ",", "t"}], ")"}], "-", 
    RowBox[{
     FractionBox[
      SuperscriptBox["\[HBar]", "2"], "m"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Re", "(", 
        SubscriptBox["\[Alpha]", 
         RowBox[{
          RowBox[{"x", " ", "x"}], ",", "t"}]], ")"}], "+", 
       RowBox[{"Re", "(", 
        SubscriptBox["\[Alpha]", 
         RowBox[{
          RowBox[{"y", " ", "y"}], ",", "t"}]], ")"}]}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
  4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
  4.001167030269079*^9}, {4.001168402809308*^9, 4.001168426499454*^9}, {
  4.001195461673896*^9, 4.001195503258028*^9}, {4.001195834433279*^9, 
  4.001195998998259*^9}, {4.0011976314556*^9, 4.00119771342379*^9}, {
  4.001680455170761*^9, 4.001680457796278*^9}, {4.001682370286289*^9, 
  4.001682371450165*^9}, {4.0016826419693117`*^9, 
  4.001682644402607*^9}},ExpressionUUID->"f4ac74fc-7931-48d9-8b39-\
5d6b8fef990d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Im", "(", 
    SubscriptBox[
     OverscriptBox["\[Gamma]", "."], "t"], ")"}], "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox["\[HBar]", "2"], "m"]}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Im", "(", 
       SubscriptBox["\[Alpha]", 
        RowBox[{
         RowBox[{"x", " ", "x"}], ",", "t"}]], ")"}], "+", 
      RowBox[{"Im", "(", 
       SubscriptBox["\[Alpha]", 
        RowBox[{
         RowBox[{"y", " ", "y"}], ",", "t"}]], ")"}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
  4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
