Cell["\<\
Next we define the superposition states.  For SS1D and MC1D, the initial \
wavepacket parameters are passed as component lists {A10, A20, ...}, {X10, \
X20, ...}, {P10, P20, ...}, {G10, G20, ...} along with the superposition \
weight option \[OpenCurlyDoubleQuote]C\[CloseCurlyDoubleQuote]:\
\>", "Text",
 CellChangeTimes->{{4.001512845441494*^9, 
  4.001512860150878*^9}},ExpressionUUID->"10525e07-fdeb-4c8e-b733-\
97476033693f"],

Cell[TextData[{
 "SS1D Two-State Cat Superposition: Specialized for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "=", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dd616374-830d-45b7-a11c-293aa7f888a7"],
 " states and parameterized by a single relative mixing coefficient (where \
\[OpenCurlyDoubleQuote]C\[CloseCurlyDoubleQuote] -> 1 creates an equal-weight \
symmetric cat state). Here, the two branches are initialized as displaced \
coherent states (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "0"], "=", 
    RowBox[{"1", "/", "2"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "18cfb291-d584-4bb6-8539-cf5f72910470"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "0"], "=", 
    RowBox[{"\[PlusMinus]", "2"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fa4db2c2-56b4-40c8-8ff3-1f10bb96e175"],
 ")."
}], "Text",
 CellChangeTimes->{{4.0015122558113813`*^9, 4.00151235377966*^9}, {
  4.001693347089655*^9, 
  4.001693349617404*^9}},ExpressionUUID->"12a28e11-ef70-4416-8050-\
21b2f3d79e25"],

Cell[TextData[{
 "MC1D Multi-Component Wavepacket Train: Supports an arbitrary number of \
basis states ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1a20d377-2258-4d49-b440-bd1567ee8b3d"],
 " and accepts a list of unnormalized mixing coefficients \
\[OpenCurlyDoubleQuote]C\[CloseCurlyDoubleQuote] -> {c1, c2, ...}. Here, \
three compressed Gaussian branches (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "0"], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5b7a1631-27b0-4f61-9511-a63d6bb6ced5"],
 ") are initialized at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "0"], "\[Element]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "5"}], "/", "2"}], ",", "0", ",", " ", 
      RowBox[{"5", "/", "2"}]}], "}"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "752f1dcd-75e4-4ded-895f-1eb9d37920cd"],
 "."
}], "Text",
 CellChangeTimes->{
  4.001512272112976*^9, {4.0015123556426086`*^9, 4.001512436494994*^9}, {
   4.001693379507316*^9, 
   4.0016933843473186`*^9}},ExpressionUUID->"cc306438-272a-4642-b2c1-\
3f36f94f27f0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Two", "-", 
    RowBox[{
    "State", " ", "Schr\[ODoubleDot]dinger", " ", "Cat", " ", "State", " ", 
     RowBox[{"(", "SS1D", ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"catSS1D", "=", 
     RowBox[{
      RowBox[{"GWP", "[", "\"\<SS1D\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "2"}], ",", 
         RowBox[{"1", "/", "2"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"\"\<C\>\"", "->", "1"}], ",", 
       RowBox[{"\"\<Potential\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Numerical\>\"", ",", 
          RowBox[{"0", "&"}], ",", "v1Pulse", ",", "v2Trap", ",", "tMin", ",",
           "tMax"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Three", "-", 
     RowBox[{"State", " ", "Coherent", " ", "Wavepacket", " ", "Train", " ", 
      RowBox[{"(", "MC1D", ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"trainMC1D", "=", 
     RowBox[{
      RowBox[{"GWP", "[", "\"\<MC1D\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "5"}], "/", "2"}], ",", "0", ",", 
         RowBox[{"5", "/", "2"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"\"\<C\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ",", 
       RowBox[{"\"\<Potential\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Numerical\>\"", ",", 
          RowBox[{"0", "&"}], ",", "v1Pulse", ",", "v2Trap", ",", "tMin", ",",
           "tMax"}], "}"}]}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.001512866192677*^9, 4.001512868130294*^9}, 
   4.001693316031156*^9, {4.0016934038216887`*^9, 4.001693408287222*^9}},
 CellLabel->
  "In[178]:=",ExpressionUUID->"f52d5688-1e46-45e1-9500-9fc8bf9ff40b"],

Cell[TextData[{
 "Both GWPNumericalSS1D and GWPNumericalMC1D integrate the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"6", "N"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3d348c65-a7de-4bd4-b909-bcfa1e040dac"],
 " pure-state ODEs in a single cached NDSolveValue call and algebraically \
reconstruct all ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"N", "(", 
     RowBox[{"N", "-", "1"}], ")"}], "/", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e574a1fa-694e-4fa6-add8-28357f87b925"],
 " off-diagonal interference cross-terms on the fly at time ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5abfea71-b4ea-4832-8c3a-2e92d160e147"],
 " via GWP1DPARAM12. Pre-binding the \[OpenCurlyDoubleQuote]RHOX\
\[CloseCurlyDoubleQuote] pure functions outside DensityPlot avoids repeated \
registry lookups across the plotting grid:"
}], "Text",
 CellChangeTimes->{
  4.0012631530048656`*^9, 4.00126319225674*^9, {4.001405913140101*^9, 
   4.0014059482843847`*^9}, {4.0015129011298847`*^9, 
   4.001512931687244*^9}},ExpressionUUID->"15759f3c-ed32-4bc6-ac34-\
bde8c950a52f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Pre", "-", 
    RowBox[{
    "bind", " ", "the", " ", "density", " ", "functions", " ", "once", " ", 
     "outside", " ", "the", " ", "plot", " ", "loop"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"rhoCat", "=", 
     RowBox[{"catSS1D", "[", "\"\<RHOX\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rhoTrain", "=", 
     RowBox[{"trainMC1D", "[", "\"\<RHOX\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"opts", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"PlotPoints", "->", "60"}], ",", 
       RowBox[{"PlotRange", "->", "Automatic"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<time\>\"", ",", "\"\<position\>\""}], "}"}]}], ",", 
       RowBox[{"BaseStyle", "->", 
        RowBox[{"FontSize", "->", "12"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{"{", "\n", 
     RowBox[{
      RowBox[{"DensityPlot", "[", 
       RowBox[{
        RowBox[{"Chop", "@", 
         RowBox[{"rhoCat", "[", 
          RowBox[{"x", ",", "t"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "tMin", ",", "tMax"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
        RowBox[{"Evaluate", "@", "opts"}]}], "]"}], ",", "\n", 
      RowBox[{"DensityPlot", "[", 
       RowBox[{
        RowBox[{"Chop", "@", 
         RowBox[{"rhoTrain", "[", 
          RowBox[{"x", ",", "t"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "tMin", ",", "tMax"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
        RowBox[{"Evaluate", "@", "opts"}]}], "]"}]}], "\[IndentingNewLine]", 
     "}"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{4.001415850052506*^9, 4.0014158829674053`*^9}, {
  4.0015129426906557`*^9, 4.001512947666469*^9}, {4.001513065683755*^9, 
  4.001513141126178*^9}, {4.001693423509882*^9, 4.001693454409133*^9}},
 CellLabel->
  "In[184]:=",ExpressionUUID->"31d4e1e9-314c-40c5-8a89-320d200b9821"],

