Cell[TextData[{
 "Modulating a harmonic trap at twice its natural frequency (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalOmega]", "=", 
    RowBox[{"2", 
     SubscriptBox["\[Omega]", "0"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7bdcbbc0-ec19-4bb8-8d33-4de209f73ed3"],
 ") places the oscillator inside the principal parametric resonance regime of \
the Mathieu equation, pumping mechanical energy continuously into both the \
classical trajectory and the quantum width oscillations. In the figure below, \
the classical position center ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "t"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c1812b51-c0fe-408b-a7b3-4da8b6f0dad6"],
 " and momentum center ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "t"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8f5401c3-c682-42db-9d41-243bdadf770b"],
 " under the sudden and smooth resonant drives undergo exponential parametric \
amplification, whereas the off-resonant Paul-trap drive (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalOmega]", "=", 
    RowBox[{"6", 
     SubscriptBox["\[Omega]", "0"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "720b7f2d-19f6-4659-a49e-321a176eeda6"],
 ") preserves stable, bounded harmonic oscillations dressed by faint \
high-frequency micromotion."
}], "Text",
 CellChangeTimes->{
  4.001403113740827*^9, {4.001508748739705*^9, 4.001508821124181*^9}, {
   4.0015100752615767`*^9, 4.001510127924162*^9}, {4.001510174788805*^9, 
   4.001510176061349*^9}, {4.001692482182147*^9, 
   4.00169249192492*^9}},ExpressionUUID->"e7974adf-8010-42df-a717-\
6ac363124268"],

