Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["A",
     FontWeight->"Bold",
     FontSlant->"Plain"], "t"], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Re", "(", 
      SubscriptBox[
       StyleBox["A",
        FontWeight->"Bold",
        FontSlant->"Plain"], "t"], ")"}], "+", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"Im", "(", 
       SubscriptBox[
        StyleBox["A",
         FontWeight->"Bold",
         FontSlant->"Plain"], "t"], ")"}]}]}], "=", 
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["\[Alpha]", 
         RowBox[{
          RowBox[{"x", " ", "x"}], ",", "t"}]], 
        SubscriptBox["\[Alpha]", 
         RowBox[{
          RowBox[{"x", " ", "y"}], ",", "t"}]]},
       {
        SubscriptBox["\[Alpha]", 
         RowBox[{
          RowBox[{"x", " ", "y"}], ",", "t"}]], 
        SubscriptBox["\[Alpha]", 
         RowBox[{
          RowBox[{"y", " ", "y"}], ",", "t"}]]}
      }], ")"}]}]}], TraditionalForm]], "DisplayFormula",
