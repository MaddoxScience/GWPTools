Cell[CellGroupData[{

Cell["Theoretical Background", "Section",
 CellChangeTimes->{{4.001159265406136*^9, 4.001159274500101*^9}, 
   4.001492453521246*^9, {4.001493078293255*^9, 4.0014930803100853`*^9}, {
   4.001494801387906*^9, 4.00149480311199*^9}, 4.001679300207135*^9, {
   4.00167933043963*^9, 
   4.0016793349717712`*^9}},ExpressionUUID->"205cadf3-0164-4648-989a-\
883082396f44"],

Cell["\<\
This section simply documents the equations of motion solved by the \
GWPNumerical package.  Further details can be found in the .nb files in the \
Notebooks directory of the GWPTools distribution.  Eventually, this \
information will make its way into the Documentation Center files for \
GWPTools.\
\>", "Text",
 CellChangeTimes->{{4.001679673648024*^9, 4.0016797235411863`*^9}, {
  4.001679913366884*^9, 4.001679918596738*^9}, {4.0016818762215*^9, 
  4.001681936164544*^9}, {4.0016897865931168`*^9, 4.0016897883894663`*^9}, {
  4.001699798150968*^9, 4.0016997990528393`*^9}, {4.00170258731758*^9, 
  4.001702650509109*^9}},ExpressionUUID->"241708b7-9b57-4909-9762-\
f906b2d72117"],

Cell[CellGroupData[{

Cell["1D GWP Equations of Motion", "Subsection",
 CellChangeTimes->{{4.001166744328843*^9, 4.001166751732067*^9}, {
  4.0016800531980658`*^9, 4.001680056934596*^9}, {4.001680201414873*^9, 
  4.001680204078438*^9}, {4.0016819440489388`*^9, 
  4.001681967977771*^9}},ExpressionUUID->"22f259fc-9a5b-4512-9551-\
7e59372e975b"],

Cell["A generalized 1D GWP is given by", "Text",
 CellChangeTimes->{{4.001678108519528*^9, 4.001678121857472*^9}, {
  4.0016785385485077`*^9, 
  4.001678546356203*^9}},ExpressionUUID->"0210503c-0c51-43cc-b232-\
47eb138daee3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Psi]", "(", 
    RowBox[{"x", ",", "t"}], ")"}], "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{"2", 
        RowBox[{"Re", "(", 
         SubscriptBox["\[Alpha]", "0"], ")"}]}], "\[Pi]"], ")"}], 
     RowBox[{"1", "/", "4"}]], 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      FractionBox["1", "\[HBar]"], 
      RowBox[{"Im", "(", 
       SubscriptBox["\[Gamma]", "0"], ")"}]}]], 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox[
        RowBox[{
         SubscriptBox["\[Alpha]", "t"], "(", 
         RowBox[{"x", "-", 
          SubscriptBox["x", "t"]}], ")"}], "2"]}], "+", 
      RowBox[{
       FractionBox["\[ImaginaryI]", "\[HBar]"], 
       RowBox[{
        SubscriptBox["p", "t"], "(", 
        RowBox[{"x", "-", 
         SubscriptBox["x", "t"]}], ")"}]}], "+", 
      RowBox[{
       FractionBox["\[ImaginaryI]", "\[HBar]"], 
       SubscriptBox["\[Gamma]", "t"]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.0011669056998796`*^9}, {
  4.0016781285483923`*^9, 4.00167817791695*^9}, {4.001678312191719*^9, 
  4.0016783271891117`*^9}, {4.001678376872489*^9, 4.00167839930969*^9}, {
  4.001679381749508*^9, 4.001679382072075*^9}, {4.001682169305438*^9, 
  4.0016821697514668`*^9}},ExpressionUUID->"09fa250f-2da3-45ea-81b2-\
b69cc3877368"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "t"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "73be4a30-835b-4a90-972f-289d6dedee08"],
 " is a complex-valued shape parameter, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "t"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b5c8e9ef-7ffb-4962-ad44-e4599e7cfd10"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "t"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e00d07cf-da9c-482f-9ad2-fc2b56908a62"],
 " are the position and momentum centers, respectively, and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "t"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2cdd9741-6065-4d0d-80b7-48fe5e72e215"],
 " is a complex-valued phase."
}], "Text",
 CellChangeTimes->{{4.001678556811108*^9, 
  4.0016786189346046`*^9}},ExpressionUUID->"c5480fa2-7590-4947-a7ae-\
cf38caf96cce"],

Cell[TextData[{
 "The GWP is an exact solution of the time-dependent Schr\[ODoubleDot]dinger \
equation for a particle of mass ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4797ecbd-9dc3-4cfd-8426-b3a0a3dabf46"],
 " subject to a quadratic external potential field"
}], "Text",
 CellChangeTimes->{{4.001678450594069*^9, 4.001678493130549*^9}, {
  4.001678550473112*^9, 4.0016785531007767`*^9}, {4.001678622201911*^9, 
  4.001678698533761*^9}},ExpressionUUID->"6a08658a-50c2-42b0-87b0-\
ebf096a07109"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"V", "(", 
    RowBox[{"x", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["V", "0"], "(", "t", ")"}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["V", "1"], "(", "t", ")"}], "x"}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["V", "2"], "(", "t", ")"}], 
     SuperscriptBox["x", "2"]}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.0011669056998796`*^9}, {
  4.0016781285483923`*^9, 4.00167817791695*^9}, {4.001678312191719*^9, 
  4.0016783271891117`*^9}, {4.001678376872489*^9, 4.00167839930969*^9}, {
  4.001678500320393*^9, 
  4.001678515652624*^9}},ExpressionUUID->"0f38b0a7-b1bb-45c1-a425-\
aa5968774666"],

Cell["\<\
GWPNumerical1D uses NDSolveValue to simultaneously integrate the six coupled \
first-order real ODEs for the GWP parameters from a given set of initial \
conditions:\
\>", "Text",
 CellChangeTimes->{{4.0011667648348*^9, 4.001166801387834*^9}, {
  4.0016799716396427`*^9, 
  4.001680034251655*^9}},ExpressionUUID->"354ff872-f6b0-4698-9cef-\
16366ebc1f52"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    OverscriptBox["x", "."], "t"], "=", 
   FractionBox[
    SubscriptBox["p", "t"], "m"]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.0011668128168173`*^9, 
  4.0011669056998796`*^9}},ExpressionUUID->"467d6fc5-d2fe-4dc8-846a-\
48c7e489e321"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    OverscriptBox["p", "."], "t"], "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{
      SubscriptBox["V", "1"], "(", "t", ")"}]}], "-", 
    RowBox[{"2", 
     RowBox[{
      SubscriptBox["V", "2"], "(", "t", ")"}], 
     SubscriptBox["x", "t"]}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.0011669201696787`*^9}, {
  4.001166953636941*^9, 4.0011669587874317`*^9}, {4.001682182332568*^9, 
  4.00168218257605*^9}},ExpressionUUID->"741a9d92-c263-4153-b9f2-\
580d1e2b56b0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Re", "(", 
    SubscriptBox[
     OverscriptBox["\[Alpha]", "."], "t"], ")"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"4", "\[HBar]"}], "m"], 
    RowBox[{"Re", "(", 
     SubscriptBox["\[Alpha]", "t"], ")"}], 
    RowBox[{"Im", "(", 
     SubscriptBox["\[Alpha]", "t"], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.001166856824904*^9}, {
  4.00167978951161*^9, 4.001679790691991*^9}, {4.001679875519182*^9, 
  4.001679900474576*^9}},ExpressionUUID->"31e83699-e5d0-49f6-959e-\
9a5564a104b1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Im", "(", 
    SubscriptBox[
     OverscriptBox["\[Alpha]", "."], "t"], ")"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"2", "\[HBar]"}], "m"]}], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"Re", "(", 
         SubscriptBox["\[Alpha]", "t"], ")"}], "2"], "-", 
       SuperscriptBox[
        RowBox[{"Im", "(", 
         SubscriptBox["\[Alpha]", "t"], ")"}], "2"]}], ")"}]}], "+", 
    FractionBox[
     RowBox[{
      SubscriptBox["V", "2"], "(", "t", ")"}], "\[HBar]"]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
  4.001679794579032*^9, 4.001679795599667*^9}, {4.001679878079226*^9, 
  4.001679897264505*^9}},ExpressionUUID->"536d3d5a-aafa-4ec9-a679-\
72e186254683"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Re", "(", 
    SubscriptBox[
     OverscriptBox["\[Gamma]", "."], "t"], ")"}], "=", 
   RowBox[{
    FractionBox[
     SubsuperscriptBox["p", "t", "2"], 
     RowBox[{"2", "m"}]], "-", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["V", "0"], "(", "t", ")"}], "+", 
      RowBox[{
       RowBox[{
        SubscriptBox["V", "1"], "(", "t", ")"}], 
       SubscriptBox["x", "t"]}], "+", 
      RowBox[{
       RowBox[{
        SubscriptBox["V", "2"], "(", "t", ")"}], 
       SubsuperscriptBox["x", "t", "2"]}]}], ")"}], "-", 
    RowBox[{
     FractionBox[
      SuperscriptBox["\[HBar]", "2"], "m"], 
     RowBox[{"Re", "(", 
      SubscriptBox["\[Alpha]", "t"], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.001166856824904*^9}, {
  4.001166968157076*^9, 4.0011670098689938`*^9}, {4.001679798727046*^9, 
  4.001679801246242*^9}, {4.001679881415429*^9, 4.001679893974514*^9}, {
  4.001682199246303*^9, 
  4.001682202503993*^9}},ExpressionUUID->"2f7114c1-a849-4117-b245-\
d88537318f23"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Im", "(", 
    SubscriptBox[
     OverscriptBox["\[Gamma]", "."], "t"], ")"}], "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox["\[HBar]", "2"], "m"]}], 
    RowBox[{"Im", "(", 
     SubscriptBox["\[Alpha]", "t"], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
  4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
  4.001167030269079*^9}, {4.001679807643468*^9, 4.001679809681148*^9}, {
  4.001679884694536*^9, 
  4.001679890585004*^9}},ExpressionUUID->"6f26d4bc-7f20-4a7c-bee2-\
1f464864e0fb"]
}, Closed]],

Cell[CellGroupData[{

Cell["1D Multi-component GWP superposition states", "Subsection",
 CellChangeTimes->{{4.0011670511153307`*^9, 4.001167058443569*^9}, {
  4.00149106959717*^9, 4.001491070931239*^9}, {4.001492117256041*^9, 
  4.001492137200725*^9}, {4.001680058626492*^9, 4.001680069179305*^9}, {
  4.0016802177895613`*^9, 4.001680234409237*^9}, {4.001681953000554*^9, 
  4.001681991838257*^9}},ExpressionUUID->"22fd9e88-a4ac-4e07-a7c8-\
d0557ac423bb"],

Cell[TextData[{
 "By the linearity of the time-dependent Schr\[ODoubleDot]dinger equation, a \
coherent superposition of ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0959e296-631e-4964-b829-96b28193f6bc"],
 " Gaussian wavepackets"
}], "Text",
 CellChangeTimes->{{4.001167076197545*^9, 
  4.001167105328456*^9}},ExpressionUUID->"dccd8580-a5c1-4df3-97d6-\
93a7d2a31370"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Psi]", "(", 
    RowBox[{"x", ",", "t"}], ")"}], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"k", "=", "1"}], "N"], 
    RowBox[{
     SubscriptBox["c", "k"], 
     RowBox[{
      SubscriptBox["\[Psi]", "k"], "(", 
      RowBox[{"x", ",", "t"}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
  4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
  4.001167030269079*^9}, {4.001168402809308*^9, 4.001168426499454*^9}, {
  4.001680097200396*^9, 
  4.00168010028224*^9}},ExpressionUUID->"3e50be96-6ebd-494a-8668-\
4e5e4c28e2c3"],

Cell[TextData[{
 "evolves such that each individual Gaussian wavepacket ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Psi]", "k"], "(", 
    RowBox[{"x", ",", "t"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a6842aa4-0bb3-437b-be3c-488559d10ee4"],
 " follows the six-equation system (above) independently from its own initial \
condition. "
}], "Text",
 CellChangeTimes->{{4.001168439785914*^9, 4.0011684509139767`*^9}, 
   4.001489391160294*^9, {4.0016800849001417`*^9, 4.00168010749734*^9}, {
   4.001680140271187*^9, 
   4.0016801462369843`*^9}},ExpressionUUID->"66910dac-a907-4fd1-b3a0-\
ed7657f628f9"],

Cell[TextData[{
 "For GWPNumericalSS1D, the number of states is fixed ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "=", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1abc5a5e-a6d5-4203-9d9f-478079b2bd02"],
 ", and the engine simultaneously integrates the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"6", "\[Times]", "2"}], "=", "12"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4c0c8029-4ab4-4674-ae2e-81757e0ae91c"],
 " coupled ODEs for wavepackets 1 and 2 in a single NDSolveValue call.  The \
code then dynamically reconstructs the parameters for the interference \
cross-terms (i.e., the component overlaps, which are also GWPs) at a given \
time ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e3abd27a-d059-41a5-9b66-83b70ae2a248"],
 ".  \n\nFor GWPNumericalMC1D, the number of states is determined by the user\
\[CloseCurlyQuote]s input, and the engine dynamically constructs and \
integrates the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"6", "N"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2c5de17e-ec8a-4dd5-a026-287222df2a17"],
 " ODE system for all ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f78c99d2-69b0-4784-9cb8-e6d33a6ae7ca"],
 " states and then populates the upper-triangle ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"N", "(", 
     RowBox[{"N", "+", "1"}], ")"}], "/", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "95f3ca41-90ad-4306-a52c-4c3042b0f86c"],
 " packed parameter bus for the component overlaps."
}], "Text",
 CellChangeTimes->{
  4.0011671072242413`*^9, {4.001168457053578*^9, 4.0011684984913673`*^9}, {
   4.001168540839966*^9, 4.0011686902127247`*^9}, {4.00119511061882*^9, 
   4.00119517580334*^9}, {4.001489415587286*^9, 4.0014894733861637`*^9}, {
   4.001489508788473*^9, 4.0014895760528097`*^9}, {4.0016780513894453`*^9, 
   4.001678051682255*^9}, {4.001680183944577*^9, 
   4.00168018431618*^9}},ExpressionUUID->"d351a538-f48a-4f16-8532-\
d2b66d28bf8e"]
}, Closed]],

Cell[CellGroupData[{

Cell["2D GWP Equations of Motion ", "Subsection",
 CellChangeTimes->{{4.001195200527286*^9, 4.001195215316885*^9}, {
  4.001680264784486*^9, 4.001680267615006*^9}, {4.001681996456373*^9, 
  4.001682006400565*^9}},ExpressionUUID->"e463d941-0dbe-49b0-8394-\
6a612c516de0"],

Cell["In two dimensions, the GWP ansatz is expressed as:", "Text",
 CellChangeTimes->{
  3.999605582729249*^9, {4.0010000074797153`*^9, 4.001000038971015*^9}, {
   4.0016805845248957`*^9, 
   4.001680591861629*^9}},ExpressionUUID->"e5cb79c2-17ee-4eed-b65a-\
3ea0c387ff88"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[CapitalPsi]", "(", 
    RowBox[{
     StyleBox["r",
      FontWeight->"Bold",
      FontSlant->"Plain"], ",", "t"}], ")"}], "=", 
   RowBox[{"N", " ", 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           StyleBox["r",
            FontWeight->"Bold",
            FontSlant->"Plain"], "-", 
           SubscriptBox[
            StyleBox["r",
             FontWeight->"Bold",
             FontSlant->"Plain"], "t"]}], ")"}], "T"]}], 
       RowBox[{
        SubscriptBox[
         StyleBox["A",
          FontWeight->"Bold",
          FontSlant->"Plain"], "t"], "(", 
        RowBox[{
         StyleBox["r",
          FontWeight->"Bold",
          FontSlant->"Plain"], "-", 
         SubscriptBox[
          StyleBox["r",
           FontWeight->"Bold",
           FontSlant->"Plain"], "t"]}], ")"}]}], "+", 
      RowBox[{
       FractionBox["\[ImaginaryI]", "\[HBar]"], 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["p",
          FontWeight->"Bold",
          FontSlant->"Plain"], "t", "T"], "(", 
        RowBox[{
         StyleBox["r",
          FontWeight->"Bold",
          FontSlant->"Plain"], "-", 
         SubscriptBox[
          StyleBox["r",
           FontWeight->"Bold",
           FontSlant->"Plain"], "t"]}], ")"}]}], "+", 
      RowBox[{
       FractionBox["\[ImaginaryI]", "\[HBar]"], 
       SubscriptBox["\[Gamma]", "t"]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}},ExpressionUUID->"f4c4c767-6a13-4d8d-b719-\
dda2e7fd08be"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r",
     FontWeight->"Bold",
     FontSlant->"Plain"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"x", ",", "y"}], ")"}], "T"]}], TraditionalForm]],
  ExpressionUUID->"a4e8d943-710b-41d2-936a-9517b13039a8"],
 " is the coordinate vector, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["r",
      FontWeight->"Bold",
      FontSlant->"Plain"], "t"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["x", "t"], ",", 
       SubscriptBox["y", "t"]}], ")"}], "T"]}], TraditionalForm]],
  ExpressionUUID->"b7827330-69e5-478f-91ed-60076e5ad3c4"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["p",
      FontWeight->"Bold",
      FontSlant->"Plain"], "t"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["p", 
        RowBox[{"x", ",", "t"}]], ",", 
       SubscriptBox["p", 
        RowBox[{"y", ",", "t"}]]}], ")"}], "T"]}], TraditionalForm]],
  ExpressionUUID->"182d9d8a-9bb6-4a49-bf2a-94ffa527e114"],
 " are the classical position and momentum vectors, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "t"], TraditionalForm]],ExpressionUUID->
  "53aa2c70-8623-4a3a-b0f6-7b93bd94784c"],
 " is the complex-valued spatially independent phase. The geometry and phase \
curvature of the packet are governed by the two-by-two complex shape matrix"
}], "Text",
 CellChangeTimes->{
  3.99960559401572*^9, {3.99960582456775*^9, 3.9996059434127007`*^9}, 
