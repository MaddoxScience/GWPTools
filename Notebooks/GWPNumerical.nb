Cell[CellGroupData[{

Cell["1D Driven Multi-State Superpositions & Quantum Interference", \
"Subsection",
 CellChangeTimes->{{4.0012630155956078`*^9, 4.0012630266653547`*^9}, 
   4.00140517727004*^9, 4.001511313183864*^9, 4.001514282990254*^9, {
   4.0016937126983137`*^9, 
   4.001693713759988*^9}},ExpressionUUID->"de69c60c-6fc3-4214-90b1-\
fee8b1dc37e8"],

Cell[TextData[{
 "In this example, we propagate a two-component Schr\[ODoubleDot]dinger cat \
state (SS1D) and a three-component coherent wavepacket train (MC1D) in a \
harmonic trap (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", "0"], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "61ca7a28-fad4-4ed2-a86f-0231c9749ece"],
 ") subjected to a transient, Gaussian-envelope dipole laser pulse:"
}], "Text",
 CellChangeTimes->{
  4.001263070376443*^9, {4.0014051910233097`*^9, 4.001405197165534*^9}, {
   4.0014053430845203`*^9, 4.0014053593152647`*^9}, {4.0015119001313353`*^9, 
   4.0015119023767242`*^9}, {4.001512132129541*^9, 
   4.0015121475252237`*^9}},ExpressionUUID->"bda80b54-10df-43fc-a400-\
ec4a0aa7dde7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["V", "1"], "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{"-", 
     SubscriptBox["F", "0"]}], 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", 
        SuperscriptBox["\[Tau]", "2"]]}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"t", "-", 
         SubscriptBox["t", "p"]}], ")"}], "2"]}]], 
    RowBox[{"cos", "(", 
     RowBox[{
      SubscriptBox["\[Omega]", "d"], "t"}], ")"}]}]}], 
  TraditionalForm]], "Text",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
   4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
   4.001167030269079*^9}, {4.001168402809308*^9, 4.001168426499454*^9}, {
   4.001195461673896*^9, 4.001195503258028*^9}, {4.001195834433279*^9, 
   4.001195998998259*^9}, {4.0011976314556*^9, 4.00119771342379*^9}, {
   4.001199104101141*^9, 4.001199115942663*^9}, {4.001199321428568*^9, 
   4.001199331465453*^9}, 4.001199392445671*^9, 4.001199467206645*^9, {
   4.001199563032137*^9, 4.001199583014041*^9}, {4.001203465471712*^9, 
   4.0012035255169*^9}, {4.001264251805689*^9, 4.0012642661539392`*^9}, {
   4.0013318278236923`*^9, 4.0013318316543007`*^9}, {4.001331917778775*^9, 
   4.001331919395858*^9}, {4.0014052911153917`*^9, 
   4.0014053358551207`*^9}},ExpressionUUID->"89edc31a-a412-4d75-88af-\
8978e08ae6e1"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "52904b68-a8b4-4e0b-92b8-1af97d69cfef"],
 " is the peak field amplitude, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "p"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f0eecc16-b0d1-4d37-993c-e261dda4714f"],
 " is the pulse center time, ",
 Cell[BoxData[
  FormBox["\[Tau]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e585e50f-7b68-4dc1-a573-3cfeb8ca6527"],
 " is the pulse duration, and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "d"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2cf88f55-3ad7-4ace-aaec-be9d9b7396dd"],
 " is the carrier frequency."
}], "Text",
 CellChangeTimes->{{4.0015121595801783`*^9, 
  4.001512207822361*^9}},ExpressionUUID->"5badbccd-f47d-4dab-81c8-\
42197b6e94c6"],

Cell["\<\
In the code below, we define and plot the time-dependent driving potential \
coefficient:\
\>", "Text",
 CellChangeTimes->{{4.0015127989436283`*^9, 
  4.0015128314963207`*^9}},ExpressionUUID->"46b35417-e664-4953-847e-\
1d963ee590c0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"External", " ", "Gaussian"}], "-", 
    RowBox[{
    "envelope", " ", "dipole", " ", "driving", " ", "field", " ", "V1", 
     RowBox[{"(", "t", ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"tMin", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tMax", "=", "20"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"f0", "=", 
     RowBox[{"4", "/", "5"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tp", "=", "6"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tau", "=", "2"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"omegaD", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"v1Pulse", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"-", "f0"}], "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"t", "-", "tp"}], ")"}], "^", "2"}]}], "/", 
        RowBox[{"tau", "^", "2"}]}], "]"}], "*", 
      RowBox[{"Cos", "[", 
       RowBox[{"omegaD", "*", "t"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"v2Trap", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], "&"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.001258527487885*^9, 4.0012585274880323`*^9}, {
  4.001258577844967*^9, 4.001258607021203*^9}, {4.001258831455737*^9, 
  4.001258852363246*^9}, {4.001405463737756*^9, 4.001405559255467*^9}, {
  4.001405835022966*^9, 4.001405842823681*^9}, {4.001511968523395*^9, 
  4.001511968800949*^9}, {4.0015119991495943`*^9, 4.001512024065406*^9}, {
  4.0015124710936203`*^9, 4.001512496826651*^9}, {4.0015127269043016`*^9, 
  4.001512745283327*^9}, {4.001693388722138*^9, 4.001693395780938*^9}},
 CellLabel->
  "In[169]:=",ExpressionUUID->"100cd7db-14cb-4930-88ab-021d35a44891"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Visualize", " ", "the", " ", "transient", " ", "dipole", " ", "driving", " ",
     "pulse", " ", "V1", 
    RowBox[{"(", "t", ")"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"v1Pulse", "[", "t", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "tMin", ",", "tMax"}], "}"}], ",", 
    RowBox[{"PlotRange", "->", "All"}], ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<time\>\"", ",", "\"\<V1(t)\>\""}], "}"}]}], ",", 
    RowBox[{"BaseStyle", "->", 
     RowBox[{"FontSize", "->", "12"}]}]}], "]"}]}]], "Input",
 CellLabel->
  "In[177]:=",ExpressionUUID->"fbf7d893-699d-4433-8c2f-8ac36b235501"],

