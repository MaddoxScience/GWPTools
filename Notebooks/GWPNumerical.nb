     RowBox[{
      OverscriptBox["Q", "."], "(", "t", ")"}], 
     RowBox[{
      SubscriptBox["k", "B"], 
      RowBox[{"T", "(", "t", ")"}]}]]}]}], TraditionalForm]], "Text",
