Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "3.", " ", "Flush", " ", "all", " ", "memoized", " ", "NDSolve", " ", 
    "caches", " ", "across", " ", "GWPNumerical"}], "*)"}], 
