Cell[CellGroupData[{

Cell["Clearing the Memoization Cache (GWPClearCache)", "Subsection",
 CellChangeTimes->{{4.002180537000099*^9, 
  4.002180553401005*^9}},ExpressionUUID->"04ea590b-0683-43fb-8f3d-\
eb20f6487d8f"],

Cell["\<\
Because memoized InterpolatingFunction objects persist in the kernel session\
\[CloseCurlyQuote]s DownValues, two situations call for explicitly flushing \
the cache:

Memory reclamation after large parameter sweeps or high-precision runs.\
\[LineSeparator]\[LineSeparator]In-place redefinition of named coefficient \
functions: When potential coefficients are passed as named functions (e.g., \
v1), the cache keys on the symbol v1 itself. Redefining v1[t_] in-place does \
not change the symbol name inside obj, so calling GWPClearCache[] is required \
to force NDSolveValue to re-integrate with the updated potential.\
\>", "Text",
 CellChangeTimes->{{4.002180570276696*^9, 
  4.0021805928300056`*^9}},ExpressionUUID->"7d8c4ec5-0206-4405-be1f-\
0985b2d151b6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Define", " ", "a", " ", "numerical", " ", "wavepacket", " ", 
    "using", " ", "a", " ", "named", " ", "linear", " ", "driving", " ", 
    "coefficient", " ", 
    RowBox[{"v1", "[", "t", "]"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"GWPClearCache", "[", "\"\<Quiet\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"v1", "[", "t_", "]"}], ":=", 
     RowBox[{"1", "/", "10"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"objNamed", "=", 
     RowBox[{
      RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
      RowBox[{"\"\<Potential\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<Numerical\>\"", ",", 
         RowBox[{"0", "&"}], ",", "v1", ",", 
         RowBox[{
          RowBox[{"1", "/", "2"}], "&"}], ",", "0", ",", "10"}], "}"}]}], 
      "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.002180623440748*^9, 4.002180626797069*^9}, {
  4.0021806897090693`*^9, 4.0021806958870163`*^9}, {4.002181015435814*^9, 
  4.002181016661996*^9}, {4.00219188744481*^9, 4.002191888840384*^9}},
 CellLabel->"In[34]:=",ExpressionUUID->"1784a03b-6a7c-4d20-af05-f31e408a30ec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "First", " ", "evaluation", " ", "integrates", " ", "the", " ", "ODEs", " ",
      "and", " ", "caches", " ", "the", " ", "result", " ", "for", " ", 
     RowBox[{"v1", "[", "t", "]"}]}], "=", 
    RowBox[{"1", "/", "10"}]}], "*)"}], "\n", 
  RowBox[{"Timing", "[", 
   RowBox[{
    RowBox[{"objNamed", "[", "\"\<RX\>\"", "]"}], "[", "2", "]"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{4.00218506092352*^9, 4.002185061372068*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"ed35b6dd-9e4f-491c-9c69-69fe7afbaefd"],

