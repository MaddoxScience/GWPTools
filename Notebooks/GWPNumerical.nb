  4.001680452151587*^9}, {4.0016823736136847`*^9, 
  4.001682375262203*^9}},ExpressionUUID->"3f4bf3a3-3042-4460-9608-\
21e3a98c5b1d"]
}, Closed]],

Cell[CellGroupData[{

Cell["1D GWP Equations of Motion for the Reduced Density Matrix", "Subsection",
 CellChangeTimes->{{4.001198317357995*^9, 4.001198339347316*^9}, {
  4.00119849656876*^9, 4.001198498160009*^9}, {4.001491897058443*^9, 
  4.001491898644755*^9}, {4.001492111920144*^9, 4.0014921154551563`*^9}, {
  4.001681116939289*^9, 4.00168112375844*^9}, {4.001682009485147*^9, 
  4.001682048414521*^9}},ExpressionUUID->"881e1a66-4c8d-413e-8e43-\
6554cb68df81"],

Cell["For open quantum systems governed by the CL master equation", "Text",
 CellChangeTimes->{{4.001198350676436*^9, 4.001198396572695*^9}, {
   4.0014920180569973`*^9, 4.001492026730166*^9}, 
   4.001681189254714*^9},ExpressionUUID->"9f73ed08-c81e-4c75-9d24-\
aced0d5dad72"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"\[PartialD]", "\[Rho]"}], 
    RowBox[{"\[PartialD]", "t"}]], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox["\[ImaginaryI]", "\[HBar]"]}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         FractionBox[
          SuperscriptBox["\[HBar]", "2"], 
          RowBox[{"2", "m"}]]}], 
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{
            SuperscriptBox["\[PartialD]", "2"], "\[Rho]"}], 
           RowBox[{"\[PartialD]", 
            SuperscriptBox["x", "2"]}]], "-", 
          FractionBox[
           RowBox[{
            SuperscriptBox["\[PartialD]", "2"], "\[Rho]"}], 
           RowBox[{"\[PartialD]", 
            SuperscriptBox["x", "\[Prime]2"]}]]}], ")"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"V", "(", 
           RowBox[{"x", ",", "t"}], ")"}], "-", 
          RowBox[{"V", "(", 
           RowBox[{
            SuperscriptBox["x", "\[Prime]"], ",", "t"}], ")"}]}], ")"}], 
        "\[Rho]"}]}], ")"}]}], "-", 
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{
      SubscriptBox["\[Gamma]", "d"], "(", 
      RowBox[{"x", "-", 
       SuperscriptBox["x", "\[Prime]"]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        RowBox[{"\[PartialD]", "\[Rho]"}], 
        RowBox[{"\[PartialD]", "x"}]], "-", 
       FractionBox[
        RowBox[{"\[PartialD]", "\[Rho]"}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", "\[Prime]"]}]]}], ")"}]}], "-", 
    RowBox[{
     FractionBox[
      RowBox[{"m", " ", 
       SubscriptBox["\[Gamma]", "d"], " ", 
       SubscriptBox["k", "B"], " ", 
       RowBox[{"T", "(", "t", ")"}]}], 
      SuperscriptBox["\[HBar]", "2"]], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"x", "-", 
        SuperscriptBox["x", "\[Prime]"]}], ")"}], "2"], "\[Rho]"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {4.001085975497222*^9, 
   4.001085990272448*^9}, {4.001681210101293*^9, 4.0016813043622303`*^9}, {
   4.00168147113085*^9, 4.0016815072582207`*^9}, 4.0016826839224854`*^9, {
   4.001682919279111*^9, 4.001682920136087*^9}, {4.001682973210421*^9, 
   4.001682975857457*^9}},ExpressionUUID->"156e45c3-a1e7-4df8-8812-\
d289c127756c"],

Cell["the GWP ansatz for the reduced density matrix is given by", "Text",
 CellChangeTimes->{{4.0016815325878067`*^9, 4.001681551443902*^9}, {
  4.001681697184033*^9, 
  4.001681701470763*^9}},ExpressionUUID->"7b384d13-6c2d-4ef5-b05b-\
52dafcc4ddc3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Rho]", "(", 
    RowBox[{"x", ",", 
     SuperscriptBox["x", "\[Prime]"], ",", "t"}], ")"}], "=", 
   RowBox[{"exp", "(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Re", "(", 
        SubscriptBox["\[Alpha]", "t"], ")"}]}], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "-", 
           SubscriptBox["x", "t"]}], ")"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["x", "\[Prime]"], "-", 
           SubscriptBox["x", "t"]}], ")"}], "2"]}], ")"}]}], "+", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"Im", "(", 
       SubscriptBox["\[Alpha]", "t"], ")"}], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "-", 
           SubscriptBox["x", "t"]}], ")"}], "2"], "-", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["x", "\[Prime]"], "-", 
           SubscriptBox["x", "t"]}], ")"}], "2"]}], ")"}]}], "-", 
     SuperscriptBox[
      RowBox[{
       SubscriptBox["\[Theta]", "t"], "(", 
       RowBox[{"x", "-", 
        SuperscriptBox["x", "\[Prime]"]}], ")"}], "2"], "+", 
     RowBox[{
      FractionBox["\[ImaginaryI]", "\[HBar]"], 
      RowBox[{
       SubscriptBox["p", "t"], "(", 
       RowBox[{"x", "-", 
        SuperscriptBox["x", "\[Prime]"]}], ")"}]}], "+", 
     RowBox[{"2", 
      RowBox[{"Re", "(", 
       SubscriptBox["\[Gamma]", "t"], ")"}]}]}], ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.9996063195605516`*^9, 
  3.999606459882854*^9}, {4.0004212208123503`*^9, 
  4.000421228773429*^9}},ExpressionUUID->"bf221e9a-4f1e-44d3-8a0f-\
754b049fb034"],

Cell[TextData[{
 "which introduces a new real-valued thermal decoherence parameter ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Theta]", "t"], ">", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b2061fbe-aaaa-496a-a2ae-b468cab712fa"],
 "."
}], "Text",
 CellChangeTimes->{{4.00168157029878*^9, 
  4.0016816633468924`*^9}},ExpressionUUID->"38605a48-d761-4fc1-9948-\
1ccc2d5c7ffa"],

Cell["\<\
Directly integrating the spatial density matrix parameters produces stiff \
nonlinear differential equations that can become numerically unstable during \
rapid thermal or mechanical ramps.  Instead, GWPNumericalRDM1D implements a \
three-stage linear covariance pipeline described below.\
\>", "Text",
 CellChangeTimes->{4.0016811923806667`*^9, 
  4.0016815280579853`*^9},ExpressionUUID->"880520dc-59a5-428b-b965-\
efc965591747"],

Cell[TextData[{
 "A key feature of this numerical protocol is that the friction coefficient \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "d"], "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "881839ac-2af8-4bcc-accf-fb88decb63d3"],
 " and thermal energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["k", "B"], 
    RowBox[{"T", "(", "t", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "08303568-23d1-49e0-841a-88395ce98fc3"],
 " are specified as callable functions of time rather than static scalars. \
Allowing simultaneous time dependence across the mechanical trap curvature ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "2"], "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "daf93fa8-4d25-45a4-854f-4afdf6b72631"],
 " and the environmental coupling parameters makes it possible to model \
arbitrary non-equilibrium thermodynamic protocols, while the underlying \
linear covariance formulation guarantees that rapid variations in ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "d"], "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a786efa5-ef4a-4342-8722-c50ae8901fea"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["k", "B"], 
    RowBox[{"T", "(", "t", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d3bae53b-3256-4bcc-b897-ff1b4f46e1df"],
 " are integrated smoothly without numerical stiffness."
}], "Text",
 CellChangeTimes->{{4.001491576234591*^9, 4.001491644965069*^9}, {
  4.001491748076105*^9, 4.001491809871477*^9}, {4.001492040900477*^9, 
  4.001492043159809*^9}, {4.001681730552362*^9, 
  4.001681731119343*^9}},ExpressionUUID->"3d5464d3-d093-4a11-bac4-\
e39511971d87"],

Cell[TextData[{
 "Stage (1) Pre-integration mapping:  The initial parameters for the shape \
and decoherence are mapped to the initial phase-space covariance elements of \
the ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[CapitalSigma]",
    FontWeight->"Bold"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "de40c063-7b22-4426-9c76-aef252dd47e6"],
 "-matrix:"
}], "Text",
 CellChangeTimes->{{4.001198449059333*^9, 4.0011986069069653`*^9}, {
  4.001489777899437*^9, 4.0014897783739767`*^9}, {4.00149082750054*^9, 
  4.00149083281633*^9}, {4.001491128395612*^9, 4.001491129305171*^9}, {
  4.001681778130599*^9, 
  4.001681784353732*^9}},ExpressionUUID->"26b9ae64-7baf-46e2-b9e1-\
231b05f83f2e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalSigma]", "xx"], "(", "0", ")"}], "=", 
   FractionBox["1", 
    RowBox[{"4", 
     RowBox[{"Re", "(", 
      SubscriptBox["\[Alpha]", "0"], ")"}]}]]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
  4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
  4.001167030269079*^9}, {4.001168402809308*^9, 4.001168426499454*^9}, {
  4.001195461673896*^9, 4.001195503258028*^9}, {4.001195834433279*^9, 
  4.001195998998259*^9}, {4.0011976314556*^9, 4.00119771342379*^9}, {
  4.001199104101141*^9, 4.001199115942663*^9}, {4.001490730332643*^9, 
  4.00149074676248*^9}},ExpressionUUID->"7969dcbc-5e4b-4797-80d4-\
5b8b28b48004"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalSigma]", "pp"], "(", "0", ")"}], "=", 
   RowBox[{
    SuperscriptBox["\[HBar]", "2"], "(", 
    RowBox[{
     RowBox[{"2", 
      SubscriptBox["\[Theta]", "0"]}], "+", 
     RowBox[{"Re", "(", 
      SubscriptBox["\[Alpha]", "0"], ")"}], "+", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"Im", "(", 
        SubscriptBox["\[Alpha]", "0"], ")"}], "2"], 
      RowBox[{"Re", "(", 
       SubscriptBox["\[Alpha]", "0"], ")"}]]}], ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
  4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
  4.001167030269079*^9}, {4.001168402809308*^9, 4.001168426499454*^9}, {
  4.001195461673896*^9, 4.001195503258028*^9}, {4.001195834433279*^9, 
  4.001196029726165*^9}, {4.0011976377472267`*^9, 4.0011976448409367`*^9}, {
  4.001197719662305*^9, 4.0011977484306593`*^9}, {4.0011991202655897`*^9, 
  4.001199148974835*^9}, {4.0014907507098103`*^9, 
  4.001490821645973*^9}},ExpressionUUID->"29837d2e-8a65-442c-9b86-\
d21fac4c72b7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalSigma]", "xp"], "(", "0", ")"}], "=", 
   FractionBox[
    RowBox[{"\[HBar]", " ", 
     RowBox[{"Im", "(", 
      SubscriptBox["\[Alpha]", "0"], ")"}]}], 
    RowBox[{"2", 
     RowBox[{"Re", "(", 
      SubscriptBox["\[Alpha]", "0"], ")"}]}]]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
  4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
  4.001167030269079*^9}, {4.001168402809308*^9, 4.001168426499454*^9}, {
  4.001195461673896*^9, 4.001195503258028*^9}, {4.001195834433279*^9, 
  4.001196029726165*^9}, {4.0011976377472267`*^9, 4.0011976448409367`*^9}, {
  4.001197719662305*^9, 4.0011977484306593`*^9}, {4.0011991202655897`*^9, 
  4.001199148974835*^9}, {4.0014907507098103`*^9, 
  4.0014907771111813`*^9}},ExpressionUUID->"44a8ee05-0fad-418e-a5be-\
cd13af7c9cfd"],

Cell["\<\
Stage (2) Linear Fokker-Planck ODE integration: The five ODEs for the \
classical trajectory and covariance matrix components are strictly linear \
\>", "Text",
 CellChangeTimes->{{4.001198853858533*^9, 4.0011988950648117`*^9}, {
  4.001198945045167*^9, 4.001198981282133*^9}, {4.00119903819499*^9, 
  4.0011990464043493`*^9}, {4.0011992695263453`*^9, 4.001199271611836*^9}, {
  4.0014908356004133`*^9, 4.001490846161037*^9}, {4.0014911430546923`*^9, 
  4.001491143503694*^9}, {4.001491200028737*^9, 4.0014912830956917`*^9}, {
  4.001683087537978*^9, 
  4.001683093062385*^9}},ExpressionUUID->"623fbf02-5540-49f0-a0ce-\
c43fad0ebf52"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    OverscriptBox["x", "."], "t"], "=", 
   FractionBox[
    SubscriptBox["p", "t"], "m"]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
  4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
  4.001167030269079*^9}, {4.001168402809308*^9, 4.001168426499454*^9}, {
  4.001195461673896*^9, 4.001195503258028*^9}, {4.001195834433279*^9, 
  4.001195998998259*^9}, {4.0011976314556*^9, 4.00119771342379*^9}, {
  4.001199104101141*^9, 
  4.001199115942663*^9}},ExpressionUUID->"ac898546-3c72-4e57-b51e-\
edafdc5a136b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    OverscriptBox["p", "."], "t"], "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{
      SubscriptBox["V", "1"], "(", "t", ")"}]}], "-", 
    RowBox[{"2", 
     RowBox[{
      SubscriptBox["V", "2"], "(", "t", ")"}], 
     SubscriptBox["x", "t"]}], "-", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Gamma]", "d"], "(", "t", ")"}], 
     SubscriptBox["p", "t"]}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
  4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
  4.001167030269079*^9}, {4.001168402809308*^9, 4.001168426499454*^9}, {
  4.001195461673896*^9, 4.001195503258028*^9}, {4.001195834433279*^9, 
  4.001196029726165*^9}, {4.0011976377472267`*^9, 4.0011976448409367`*^9}, {
  4.001197719662305*^9, 4.0011977484306593`*^9}, {4.0011991202655897`*^9, 
  4.001199148974835*^9}, {4.001491317228112*^9, 
  4.001491326253986*^9}},ExpressionUUID->"e12e9a49-40eb-4f24-82d8-\
433cd63d6a8e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
