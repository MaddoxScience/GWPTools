      "cached", " ", 
      RowBox[{"trajectory", "!"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"objNamed", "[", "\"\<RX\>\"", "]"}], "[", "2", 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{4.002180737043372*^9, 4.0021807398996773`*^9}, 
   4.002181039979165*^9, {4.00218506588006*^9, 4.002185066235379*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"0b2cdc53-a91d-4bae-8104-a92d0a247bb3"],

