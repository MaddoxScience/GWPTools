    RowBox[{"{", 
     RowBox[{"\"\<\!\(\*SubscriptBox[\(p\), \(x, t\)]\)\>\"", 
      ",", "\"\<\!\(\*SubscriptBox[\(p\), \(y, t\)]\)\>\""}], "}"}]}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", "\"\<momentum\>\""}], "}"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
