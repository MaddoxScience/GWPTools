Cell[CellGroupData[{

Cell["Example 2: Using function heads (symbol names)", "Subsubsection",
 CellChangeTimes->{{4.001501980867428*^9, 
  4.001502012278717*^9}},ExpressionUUID->"f324e072-4d6a-4979-991e-\
107ec9b4ff48"],

Cell["\<\
This example illustrates using proper function symbols to specify the \
potential coefficients.\
\>", "Text",
 CellChangeTimes->{{4.001683770295807*^9, 4.001683801055664*^9}, {
  4.0016840321279087`*^9, 
  4.0016840398582163`*^9}},ExpressionUUID->"8a8ce882-69bf-4fbd-85da-\
60867b71c695"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"v0", "[", "t_", "]"}], "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"v1", "[", "t_", "]"}], "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"v2Ramp", "[", "t_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"3", "/", "8"}], " ", "-", " ", 
    RowBox[{
     RowBox[{"1", "/", "8"}], " ", "*", " ", 
     RowBox[{"Tanh", "[", 
      RowBox[{"3", " ", "*", " ", 
       RowBox[{"(", 
        RowBox[{"t", " ", "-", " ", "4"}], ")"}]}], "]"}]}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"tMin", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tMax", "=", 
   RowBox[{"3", "*", "2", "*", "Pi"}]}], ";"}], "\n", 
 RowBox[{"Clear", "[", "obj", "]"}], "\n", 
 RowBox[{"obj", "=", 
  RowBox[{
   RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
   RowBox[{"\"\<Potential\>\"", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Numerical\>\"", ",", " ", "v0", ",", " ", "v1", ",", " ", 
      "v2Ramp", ",", " ", "tMin", ",", " ", "tMax"}], "}"}]}], 
   "]"}]}]}], "Code",
 InitializationCell->False,
 CellChangeTimes->{
  4.0011595115640717`*^9, {4.001159554120452*^9, 4.001159599496255*^9}, {
   4.001501130555072*^9, 4.0015011345214233`*^9}, {4.001501255045829*^9, 
