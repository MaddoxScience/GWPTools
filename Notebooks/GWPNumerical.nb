Cell["\<\
The following constructs the two GWPs for the dissipative and unitary \
dynamics:\
\>", "Text",
 CellChangeTimes->{{4.00144261684628*^9, 
  4.001442646992836*^9}},ExpressionUUID->"c755bc43-5e89-4df6-b3f2-\
972dc83d0923"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Open", "-", 
    RowBox[{"System", " ", "Caldeira"}], "-", 
    RowBox[{"Leggett", " ", "Evolution", " ", 
     RowBox[{"(", "\"\<NumericalCL\>\"", ")"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"rdmCL", "=", 
     RowBox[{
      RowBox[{"GWP", "[", "\"\<RDM1D\>\"", "]"}], "[", 
      RowBox[{
      "a0Eq", ",", "x0Eq", ",", "p0Eq", ",", "g0Eq", ",", "theta0Eq", ",", 
       RowBox[{"\"\<Potential\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<NumericalCL\>\"", ",", 
          RowBox[{"0", "&"}], ",", 
          RowBox[{"0", "&"}], ",", "v2Ramp", ",", "gammaRamp", ",", "kTRamp", 
          ",", "tMin", ",", "tMax", ",", 
          RowBox[{"AccuracyGoal", "->", "12"}], ",", 
          RowBox[{"PrecisionGoal", "->", "12"}], ",", 
          RowBox[{"MaxSteps", "->", "Infinity"}]}], "}"}]}], ",", 
       RowBox[{"\"\<HBAR\>\"", "->", "hbar"}], ",", 
       RowBox[{"\"\<MASS\>\"", "->", "m"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Isolated", " ", "Unitary", " ", "Evolution", " ", 
     RowBox[{"(", "\"\<Numerical\>\"", ")"}], " ", "from", " ", "the", " ", 
     "Same", " ", "Initial", " ", "Thermal", " ", "State"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rdmUnitary", "=", 
     RowBox[{
      RowBox[{"GWP", "[", "\"\<RDM1D\>\"", "]"}], "[", 
      RowBox[{
      "a0Eq", ",", "x0Eq", ",", "p0Eq", ",", "g0Eq", ",", "theta0Eq", ",", 
       RowBox[{"\"\<Potential\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Numerical\>\"", ",", 
          RowBox[{"0", "&"}], ",", 
          RowBox[{"0", "&"}], ",", "v2Ramp", ",", "tMin", ",", "tMax", ",", 
          RowBox[{"AccuracyGoal", "->", "12"}], ",", 
          RowBox[{"PrecisionGoal", "->", "12"}], ",", 
          RowBox[{"MaxSteps", "->", "Infinity"}]}], "}"}]}], ",", 
       RowBox[{"\"\<HBAR\>\"", "->", "hbar"}], ",", 
       RowBox[{"\"\<MASS\>\"", "->", "m"}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{4.0017002591744127`*^9},
 CellLabel->
  "In[529]:=",ExpressionUUID->"f26643cc-553d-433f-af0d-fd185ebdfa42"],

Cell[TextData[{
 "Comparing the open-system trajectory (\[OpenCurlyDoubleQuote]NumericalCL\
\[CloseCurlyDoubleQuote], solid blue curve) against an otherwise identical \
isolated evolution (\[OpenCurlyDoubleQuote]Numerical\[CloseCurlyDoubleQuote], \
solid orange curve) highlights the distinct physical roles of mechanical \
driving and environmental dissipation. Prior to the switching window (",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "<", "t", "\[LessTilde]", "7"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f63482df-ea7d-44db-b78b-927c8ff35359"],
 "), both systems remain stationary at the initial equilibrium shape and \
decoherence parameters.\n\nAs the trap stiffens around ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "0"], "=", "10"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bf5653c6-9fed-41f9-b72c-c9b160e5a852"],
 ", mechanical work is injected into the oscillator. In the isolated unitary \
system, this injected energy cannot be dissipated; the wavepacket is \
permanently excited into undamped parametric breathing oscillations while its \
quantum purity (as shown in later results) remains frozen.  Conversely, in \
the dissipative system, environmental friction dampens the transient \
breathing oscillations within a few relaxation times ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Tau]", "rel"], "~", 
    SubsuperscriptBox["\[Gamma]", "f", 
     RowBox[{"-", "1"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7a9e285a-e632-4f50-a15f-7465b654dbd6"],
 " guiding both the real shape parameter and the decoherence smoothly onto \
their new asymptotic equilibrium plateaus."
}], "Text",
 CellChangeTimes->{{4.00143908785319*^9, 4.0014392097079573`*^9}, {
   4.001439242796464*^9, 4.00143928942315*^9}, {4.00143933687871*^9, 
   4.001439468351316*^9}, {4.001442818956194*^9, 4.001442957019945*^9}, {
   4.0015291673211184`*^9, 4.001529175009137*^9}, {4.001529258210939*^9, 
   4.001529260752222*^9}, {4.0015298461359873`*^9, 4.001529852508374*^9}, {
   4.001530188217371*^9, 4.001530229674774*^9}, 4.0015302928846197`*^9, {
   4.001700300436781*^9, 
   4.001700326825152*^9}},ExpressionUUID->"f89ed148-a87b-4891-98f2-\
80d75093d7cf"],

