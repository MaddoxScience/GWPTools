Cell[CellGroupData[{

Cell["Nonequilibrium Quantum Thermodynamics", "Subsection",
 CellChangeTimes->{{4.001263298806704*^9, 4.0012633239372396`*^9}, {
  4.001527082116894*^9, 4.001527116412562*^9}, {4.00152814392467*^9, 
  4.001528148024424*^9}, {4.001693944536064*^9, 
  4.001693949335723*^9}},ExpressionUUID->"ad286aa7-a72e-40c8-b9c5-\
d367da4cb133"],

Cell[TextData[{
 "To demonstrate open-system quantum dynamics beyond pure-state wavepackets, \
this example evolves a one-dimensional Gaussian reduced density matrix \
coupled to an Ohmic thermal reservoir via the Caldeira\[Dash]Leggett master \
equation. Unlike a pure Gaussian state\[LongDash]whose spatial width and \
momentum spread are rigidly locked together\[LongDash]a mixed Gaussian \
density matrix incorporates an independent real decoherence parameter ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Theta]", "t"], ">", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1f253081-41fe-4aa4-bab1-3607734dc3d8"],
 " that suppresses spatial coherence. "
}], "Text",
 CellChangeTimes->{
  4.00126333514174*^9, {4.0014255327685833`*^9, 4.001425673249908*^9}, {
   4.001440915053178*^9, 4.0014410132351923`*^9}, 4.001441999043517*^9, {
   4.001442033752625*^9, 4.001442035489765*^9}, {4.001527016440879*^9, 
   4.0015270175005083`*^9}, 4.0015272758729753`*^9, 
   4.0015274743158493`*^9},ExpressionUUID->"62f0add4-8999-4e9a-bf22-\
7531c50a0d2e"],

Cell[TextData[{
 "Note that in the following, subscript ",
 Cell[BoxData[
  FormBox["i", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "459eecee-8440-44d1-837e-d4fdf85d9316"],
 " denotes initial thermodynamic state while ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "79001b52-a4a8-4b82-a33e-f4bb11463015"],
 " denotes the final thermodynamic state."
}], "Text",
 CellChangeTimes->{{4.001528242987962*^9, 4.001528302686401*^9}, {
  4.0015286647852907`*^9, 4.001528680954802*^9}, {4.0016998996875057`*^9, 
  4.001699901136105*^9}},ExpressionUUID->"3a5d66a1-168c-4a71-b912-\
cd7d4b13ea3c"],

Cell[TextData[{
 "We initialize the system in an exact stationary thermal Gibbs state at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "55e90392-3e70-488f-a324-d3225a5781df"],
 " corresponding to a weak harmonic trap ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", "i"], "=", 
    RowBox[{"1", "/", "2"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2d13b2a5-4133-4ae4-ac9f-0098c3780b1e"],
 " and a cold, weakly coupled bath (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", 
     RowBox[{"d", ",", "i"}]], "=", 
    RowBox[{"3", "/", "20"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d8060395-c288-48a0-8acf-da0601cca5ce"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["k", "B"], 
     SubscriptBox["T", "i"]}], "=", 
    RowBox[{"4", "/", "5"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "947f6921-7472-4ea9-9a5f-658fa8f89dd7"],
 "). Around ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "0"], "=", "10"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "12e62f84-aff1-4998-b219-877c245a79ad"],
 ", the trap curvature ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "2"], "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e02342ca-4d4b-425c-a3a8-a0a15d0826ce"],
 ", friction coefficient ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "d"], "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fe37aac7-642b-4cbb-9517-dd4f5407d6a2"],
 ", and bath temperature ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["k", "B"], "T"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0b7ab0ea-dd66-4151-98e3-b7f2f12bb932"],
 "(t) are simultaneously ramped via smooth hyperbolic-tangent switching \
functions to a stiffer, hotter target regime (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", "f"], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e00d4a18-6464-4b33-ae31-66c9f538dd27"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", 
     RowBox[{"d", ",", "f"}]], "=", 
    RowBox[{"1", "/", "4"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a75d63a2-e340-43a5-acd4-1323c9c4dba7"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["k", "B"], 
     SubscriptBox["T", "f"]}], "=", 
    RowBox[{"8", "/", "5"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cc255e6f-2d9e-49f9-9973-89184aac9ebd"],
 "), i.e., work will be done on the system under non-isothermal conditions.  \
Because all three control functions vary simultaneously over a finite \
switching window, the coupled nonlinear differential equations for the \
density matrix parameters admit no closed-form analytical solution, providing \
a stringent benchmark for the numerical open-system propagator."
}], "Text",
 CellChangeTimes->{{4.001441015626194*^9, 4.0014412210022097`*^9}, {
  4.0014421024396477`*^9, 4.001442150229067*^9}, {4.0015273199017572`*^9, 
  4.001527338204376*^9}, {4.001528197855027*^9, 4.001528209056353*^9}, {
  4.0015286878594427`*^9, 4.001528702534734*^9}, {4.001699946216523*^9, 
  4.001699974623537*^9}},ExpressionUUID->"cd3c0f25-d8a8-43f8-9058-\
2c07aca57943"],

Cell[TextData[{
 "First, we define the initial and final thermodynamic state parameters using \
natural units (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[HBar]", "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e4a49da8-2c3a-444d-acc3-14c4d8b099ed"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "328cfa16-978f-4c2c-9d72-85eac010dfa8"],
 "), along with the asymptotic equilibrium parameters:"
}], "Text",
 CellChangeTimes->{
  4.00126334412309*^9, {4.0014257181003838`*^9, 4.00142576161967*^9}, {
   4.001441295891345*^9, 4.001441296317164*^9}, {4.0014424452213297`*^9, 
   4.001442448183816*^9}, {4.00144268126678*^9, 4.001442692835404*^9}, {
   4.0015274029842367`*^9, 
   4.001527423017953*^9}},ExpressionUUID->"e626dc2d-44d5-4faf-b4b8-\
036000391340"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Natural", " ", "units"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"hbar", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"m", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Initial", " ", "Thermodynamic", " ", "State", " ", "Parameters", " ", 
     RowBox[{"(", 
      RowBox[{"t", "=", "0"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"omegaI", "=", 
     RowBox[{"1", "/", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gammaI", "=", 
     RowBox[{"3", "/", "20"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kTI", "=", 
     RowBox[{"4", "/", "5"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Final", " ", "Target", " ", "Thermodynamic", " ", "State", " ", 
     "Parameters", " ", 
     RowBox[{"(", 
      RowBox[{"t", "->", "tMax"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"omegaF", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gammaF", "=", 
     RowBox[{"1", "/", "4"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kTF", "=", 
     RowBox[{"8", "/", "5"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Exact", " ", "Stationary", " ", "Thermal", " ", "Equilibrium", " ", 
      "Parameters", " ", "at", " ", "t"}], "=", "0"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"a0Eq", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"m", "*", 
        RowBox[{"omegaI", "^", "2"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"4", "*", "kTI"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"x0Eq", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"p0Eq", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"g0Eq", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "4"}], ")"}], "*", 
      RowBox[{"Log", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", "*", "a0Eq"}], ")"}], "/", "Pi"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"theta0Eq", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"m", "*", "kTI"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", "*", 
         RowBox[{"hbar", "^", "2"}]}], ")"}]}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"m", "*", 
         RowBox[{"omegaI", "^", "2"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"8", "*", "kTI"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{"(*", 
    RowBox[{
    "Exact", " ", "Target", " ", "Asymptotic", " ", "Equilibrium", " ", 
     "Values", " ", "for", " ", "Comparison"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"aFinalEq", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"m", "*", 
        RowBox[{"omegaF", "^", "2"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"4", "*", "kTF"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"thetaFinalEq", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"m", "*", "kTF"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", "*", 
         RowBox[{"hbar", "^", "2"}]}], ")"}]}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"m", "*", 
         RowBox[{"omegaF", "^", "2"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"8", "*", "kTF"}], ")"}]}]}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.0012633526620283`*^9, 4.0012633526621733`*^9}, {
  4.001425680352229*^9, 4.001425692975321*^9}, {4.001441283660671*^9, 
  4.00144128696204*^9}, {4.001442157545014*^9, 4.001442182637862*^9}, {
  4.0014424662480392`*^9, 4.001442490146579*^9}, {4.001442696432671*^9, 
  4.001442725084963*^9}, {4.001527493650857*^9, 4.0015274938234797`*^9}},
 CellLabel->
  "In[503]:=",ExpressionUUID->"88cfe739-d265-4ccd-a602-faebfe97ea25"],

Cell[TextData[{
 "Next, we introduce smooth initial-to-final state transition ramps. We hold \
the system in its initial equilibrium until ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "0"], "=", "10"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "caddd773-3e44-466d-98a6-a8aefc76c1ba"],
 ", then smoothly ramp ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "2"], "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d231de49-efa1-4df4-9057-72bc87f851f3"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "d"], "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "167a8965-8f99-4f55-9f8e-1429aea3fcb9"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["k", "B"], 
    RowBox[{"T", "(", "t", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cee25c3a-fa0d-4abf-96ef-722b6b3d4948"],
 " to their new values at steepness ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Kappa]", "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e88ef8a0-66ab-4ce9-834f-1bcc3f836ccc"],
 ". For comparison, we also construct a unitary (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "d"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c2432a8d-baf8-4b9f-bb88-ff15cfa18d05"],
 "= 0) counterpart subjected to the same mechanical trap ramp ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "2"], "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "442f209b-8486-4f58-9ce5-8fdd7b702227"],
 "."
}], "Text",
 CellChangeTimes->{
  4.001263367222197*^9, {4.001425782693384*^9, 4.001425908944244*^9}, {
   4.001434899709816*^9, 4.001434900585759*^9}, {4.001442518500018*^9, 
   4.001442556544475*^9}, {4.001527360707066*^9, 
   4.001527361043041*^9}},ExpressionUUID->"247d8db7-a4af-4cce-891f-\
e894cbb305d0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Time", " ", "parameters"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"tMin", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tMax", "=", "50"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"t0", "=", "10"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kappa", "=", "1"}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Helper", " ", "for", " ", "smooth", " ", "Tanh", " ", "switching", " ", 
      "between", " ", "valI", " ", "and", " ", "valF", " ", "at", " ", "t"}], 
     "=", "t0"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"smoothRamp", "[", 
      RowBox[{"valI_", ",", "valF_", ",", "t_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"valI", "+", "valF"}], ")"}], "/", "2"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"valF", "-", "valI"}], ")"}], "/", "2"}], ")"}], "*", 
       RowBox[{"Tanh", "[", 
        RowBox[{"kappa", "*", 
         RowBox[{"(", 
          RowBox[{"t", "-", "t0"}], ")"}]}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Time", "-", 
       RowBox[{"dependent", " ", "Potential", " ", "Curvature", " ", "V2", 
        RowBox[{"(", "t", ")"}]}]}], "=", 
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", "m", " ", "omega", 
       RowBox[{
        RowBox[{"(", "t", ")"}], "^", "2"}]}]}], ",", "Damping", ",", 
     RowBox[{"and", " ", "Bath", " ", "Temperature"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"v2Ramp", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], "*", "m", "*", 
      RowBox[{"smoothRamp", "[", 
       RowBox[{
        RowBox[{"omegaI", "^", "2"}], ",", 
        RowBox[{"omegaF", "^", "2"}], ",", "t"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gammaRamp", "[", "t_", "]"}], ":=", 
     RowBox[{"smoothRamp", "[", 
      RowBox[{"gammaI", ",", "gammaF", ",", "t"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"kTRamp", "[", "t_", "]"}], ":=", 
     RowBox[{"smoothRamp", "[", 
      RowBox[{"kTI", ",", "kTF", ",", "t"}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.001263375598836*^9, 4.0012633755990677`*^9}, {
  4.001425916307095*^9, 4.001425937595785*^9}, {4.00144257264699*^9, 
  4.0014426258909683`*^9}, {4.001443004857609*^9, 4.001443005254479*^9}, {
