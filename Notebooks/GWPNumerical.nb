Cell["\<\
Comparing the classical trajectory centers alongside the second-moment \
spatial uncertainties highlights the three distinct stages of the protocol:\
\>", "Text",
 CellChangeTimes->{
  4.001263261282538*^9, {4.001417554358366*^9, 4.001417554944363*^9}, {
   4.001423954339919*^9, 4.001424254766361*^9}, {4.001522288164276*^9, 
   4.001522307934043*^9}, {4.0016947026726303`*^9, 
   4.0016947099806757`*^9}},ExpressionUUID->"d47b9e0e-82bb-4af4-91cd-\
690d78b2c0fe"],

Cell[TextData[{
 "Stage (1) Uncoupled Pre-Window Evolution (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "20"}], "<=", "t", "\[LessTilde]", "5"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c66f3b1b-2a84-494d-b1f7-26d2ba09bbda"],
 "): Prior to the coupling ramp, the two coordinates are dynamically \
independent. The classical center oscillates purely along the x-axis while ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "t"], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0a63a754-ac11-454c-87f0-2d59a8edb3f6"],
 " remains completely quiescent. Simultaneously, the compressed ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a9e98256-2c59-48f5-b8d8-dd786533ac35"],
 "-width breathes at twice the trap frequency ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubscriptBox["\[Omega]", "0"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fd605b0d-94f1-4917-8d6d-cae4c8445366"],
 ", the ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8815d62e-3676-4d76-b25f-4b8a512331bd"],
 "-width remains flat at its coherent ground-state value, and the cross-mode \
spatial covariance vanishes identically."
}], "Text",
 CellChangeTimes->{
  4.001522336092812*^9, {4.001522389201828*^9, 4.0015224303066177`*^9}, {
   4.0015224606822567`*^9, 4.0015224707703667`*^9}, {4.001522888913495*^9, 
   4.00152294627157*^9}, {4.001694725863215*^9, 4.001694775661112*^9}, {
   4.0016959758068323`*^9, 
   4.001695976570776*^9}},ExpressionUUID->"ef35bc08-5de4-43ad-9b41-\
050018e6ee6c"],

Cell[TextData[{
 "Stage (2) Active Hybridization and Elliptical Rotation (",
 Cell[BoxData[
  FormBox[
   RowBox[{"5", "<", "t", "\[LessTilde]", " ", "20"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4bad86c2-ceaa-48a1-ad6d-6235ef25a258"],
 "): As ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "11"], "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "759214f5-e4d3-472d-8822-a52a30219d60"],
 " ramps onto its plateau ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Kappa]", "xy"], "=", 
    RowBox[{"35", "/", "100"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "06882d0d-370e-4fea-b00b-eccd95b1bc7a"],
 ", the degenerate ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8d42ed22-ea22-4830-94e3-7916ac6e4898"],
 " and ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e2262c43-98a0-44d7-ac19-11ff29f33124"],
 " oscillators hybridize into symmetric and antisymmetric normal modes (",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "\[PlusMinus]", "y"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cec64def-06af-49d0-bbb9-819e881ed5e2"],
 ") with split frequencies"
}], "Text",
 CellChangeTimes->{
  4.001522347228508*^9, {4.0015229938017883`*^9, 4.001523111212574*^9}, {
   4.0015231574603863`*^9, 4.0015231581574593`*^9}, {4.001694788015497*^9, 
   4.001694795673748*^9}, {4.001694852015243*^9, 
   4.0016948772382727`*^9}},ExpressionUUID->"2c26093a-1647-4373-85a5-\
e167f6d0a6a4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Omega]", "\[PlusMinus]"], "=", 
   SqrtBox[
    RowBox[{
     SubsuperscriptBox["\[Omega]", "0", "2"], "\[PlusMinus]", 
     SubscriptBox["\[Kappa]", 
      RowBox[{"x", " ", "y"}]]}]]}], TraditionalForm]], "Text",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
   4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
   4.001167030269079*^9}, {4.001168402809308*^9, 4.001168426499454*^9}, {
   4.001195461673896*^9, 4.001195503258028*^9}, {4.001195834433279*^9, 
   4.001195998998259*^9}, {4.0011976314556*^9, 4.00119771342379*^9}, {
   4.001199104101141*^9, 4.001199115942663*^9}, {4.001199321428568*^9, 
   4.001199331465453*^9}, 4.001199392445671*^9, 4.001199467206645*^9, {
   4.001199563032137*^9, 4.001199583014041*^9}, {4.001203465471712*^9, 
   4.0012035255169*^9}, {4.001264251805689*^9, 4.0012642661539392`*^9}, {
   4.0013318278236923`*^9, 4.0013318316543007`*^9}, {4.001331917778775*^9, 
   4.001331919395858*^9}, {4.0014052911153917`*^9, 4.0014053358551207`*^9}, {
   4.0015211131336613`*^9, 4.001521147703455*^9}, {4.001523129796876*^9, 
   4.0015231522830677`*^9}},ExpressionUUID->"2781a133-b8b3-43f7-911e-\
b6d62f1f131e"],

Cell[TextData[{
 "This frequency splitting induces coherent Rabi-like normal-mode beating at \
the difference frequency ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]\[Omega]", "=", 
    RowBox[{
     SubscriptBox["\[Omega]", "+"], "-", 
     SubscriptBox["\[Omega]", "-"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "234e802b-61df-4644-8064-bb914de78d84"],
 ", transferring classical oscillation amplitude from ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "t"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "91bead17-33fb-44f1-8923-1019a29e72ef"],
 " into ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "t"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f74b1fa7-c289-4fc3-9c36-5fa5c657cdf8"],
 ".  At the quantum level, the off-diagonal shape matrix element ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", 
    RowBox[{
     RowBox[{"x", " ", "y"}], ",", "t"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "83031a1a-84ce-407c-b9e4-0f1d1d7df340"],
 " becomes non-zero, rotating the 2D Gaussian uncertainty ellipse in the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", " ", "y"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "710ee560-eb5a-4ab0-97e5-59b4d7f0de8a"],
 "-plane, generating strong inter-mode spatial correlations, and transferring \
parametric width breathing from the ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9321bdcd-12f0-4c6d-8187-1692195fd36c"],
 "-mode into the ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "969993f3-8501-410a-bf05-5e538017ee04"],
 "-mode."
}], "Text",
 CellChangeTimes->{
  4.0015223550644073`*^9, {4.0015231953905773`*^9, 4.001523272420081*^9}, 
   4.001694924705522*^9},ExpressionUUID->"e658d533-cdf8-4840-a4ff-\
0137ce096d38"],

Cell[TextData[{
 "Stage (3) Post-Window State Lock-In (",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "\[GreaterTilde]", "20"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d7f37e10-0aaf-4201-bf29-c76cfd88c24c"],
 "): Once the coupling window smoothly turns off after ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "2"], "=", "20"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2644a194-3fee-47dd-9574-413e63ee5d42"],
 ", the off-diagonal coupling vanishes (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", 
    RowBox[{"xy", ",", "t"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "81395fd5-bc16-474c-8afe-eaf0d5c1f01f"],
 " decouples in the Hamiltonian) and inter-mode energy exchange ceases. Both \
oscillators remain locked in their newly established classical amplitudes and \
correlated breathing states\[LongDash]realizing a controllable phonon \
beam-splitter or mode-swap gate in a 2D ion or optical trap."
}], "Text",
 CellChangeTimes->{
  4.0015223712872353`*^9, {4.001523395029207*^9, 4.0015234731058073`*^9}, {
   4.00169485567008*^9, 4.001694858376747*^9}, {4.001695928478629*^9, 
   4.001695928811245*^9}},ExpressionUUID->"3b0d6579-97ef-4b47-a8f4-\
8e76cc674933"],

