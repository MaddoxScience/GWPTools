Cell[TextData[{
 "Stage (3) Post-integration reconstruction:  The interpolated variances at \
time ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a263a312-4c08-4ee7-97bc-01739f2db02a"],
 " are used to algebraically reconstruct the shape and decoherence parameters \
and the real phase"
}], "Text",
