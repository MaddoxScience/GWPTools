        RowBox[{
         RowBox[{
          RowBox[{"objExact", "[", "\"\<RP\>\"", "]"}], "[", "t", "]"}], "-", 
         
         RowBox[{
          RowBox[{"objNumMach", "[", "\"\<RP\>\"", "]"}], "[", "t", "]"}]}], 
        "]"}], ",", 
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"objExact", "[", "\"\<RP\>\"", "]"}], "[", "t", "]"}], "-", 
         
         RowBox[{
          RowBox[{"objNumPrec30", "[", "\"\<RP\>\"", "]"}], "[", "t", "]"}]}],
         "]"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"errRG", "[", "t_", "]"}], ":=", 
     RowBox[{"{", 
