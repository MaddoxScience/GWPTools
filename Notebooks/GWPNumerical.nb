      ",", "\"\<\!\(\*SubscriptBox[\(\[CapitalDelta]y\), \(t\)]\)\>\"", 
      ",", "\"\<Cov(x,y\!\(\*SubscriptBox[\()\), \(t\)]\)\>\""}], "}"}]}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<time\>\"", ",", "\"\<shape observables\>\""}], "}"}]}]}], 
  "]"}]}], "Input",
