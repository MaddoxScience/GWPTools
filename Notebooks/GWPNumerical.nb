Cell[TextData[{
 "The space-time probability density plots (above) illustrate how macroscopic \
quantum superpositions respond to a resonant dipole pulse (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Omega]", "d"], "=", 
     RowBox[{
      SubscriptBox["\[Omega]", "0"], "=", "1"}]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d095a52f-d93a-4a70-bb6a-4f1288a4d9e7"],
 " centered at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "p"], "=", "6"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4a915be4-9d5f-4d96-ad09-c82b66ffb69a"],
 ". \n\nPrior to the laser pulse ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "\[LessTilde]", "4"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ae9135d6-d606-4739-8534-d0a32914de4a"],
 ", the wavepacket branches oscillate symmetrically about the trap center.  \
Every half-period, the counter-propagating branches cross at the origin, \
producing sharp interference fringes whose spatial wavelength is set by the \
relative momentum at the collision point. \n\nAs the resonant pulse peaks \
around ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "p"], "=", "6"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4cc2231c-8056-4697-aad1-fefdd059a387"],
 ", it imparts a coherent momentum kick to the entire superposition. In \
accordance with the generalized Kohn theorem for quadratic potentials, a \
spatially uniform linear drive ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "1"], "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6cb737d3-c4c4-450e-953b-a74585667e45"],
 " couples exclusively to the center-of-mass coordinate: for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", ">", "6"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8c02db9b-d175-4db2-baa4-6009ede820e7"],
 ", the entire interference pattern sweeps back and forth in large-amplitude \
collective oscillations without altering the relative phase-space separation \
or collision timing between the individual branches.\n\nIn the two-state cat \
superposition (SS1D), the stationary-width branches ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "0"], "=", 
    RowBox[{"1", "/", "2"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6c68e61f-7a5b-4085-8f55-89df18295156"],
 " maintain a constant envelope width while sweeping back and forth across \
the trap with periodic two-beam interference nodes at the turning points of \
their relative motion. In the three-state wavepacket train (MC1D), \
initializing compressed branches (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "0"], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a1c1c0fc-bf2c-46c4-b4f0-98937c56d0e4"],
 ") introduces simultaneous width breathing at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubscriptBox["\[Omega]", "0"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8226c0e9-ff4e-404c-a18e-d935379a2562"],
 " alongside three-wavepacket focal collisions.  At each collision, three \
pairwise momentum differences (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]p", "12"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b7f17648-05fa-4c6e-bea3-170215f542f9"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]p", "23"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9d1fa0fb-09ad-47fb-afe1-9ea091b42884"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[CapitalDelta]", " ", 
     SubscriptBox["p", "13"]}], "=", 
    RowBox[{"2", " ", "\[CapitalDelta]", " ", 
     SubscriptBox["p", "12"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "51d3fb14-b3da-4e27-9979-9468849347c5"],
 ") superpose with the breathing envelopes to weave a rich, multi-scale \
interference pattern along the driven center-of-mass trajectory."
}], "Text",
 CellChangeTimes->{{4.001416249338327*^9, 4.001416471463623*^9}, {
  4.001513205617062*^9, 4.001513205972645*^9}, {4.0015133339979467`*^9, 
  4.001513511674427*^9}, {4.001513588253344*^9, 4.001513622059869*^9}, {
  4.001513669640897*^9, 4.001513746809376*^9}, {4.001513795626102*^9, 
  4.0015138077607603`*^9}, {4.0015138458879004`*^9, 4.001513993924334*^9}, {
  4.001693515271936*^9, 4.001693515860456*^9}, {4.001693651212762*^9, 
  4.0016936526383677`*^9}},ExpressionUUID->"9b7b8595-71fe-41d6-b09b-\
d5bccb7fd357"]
}, Closed]],

Cell[CellGroupData[{

Cell["2D Time-Dependent Mode Mixing", "Subsection",
 CellChangeTimes->{{4.001263202906067*^9, 4.0012632142971153`*^9}, {
   4.001417240382512*^9, 4.001417241268817*^9}, 4.001516009678069*^9, {
   4.001693936306225*^9, 
   4.001693941223815*^9}},ExpressionUUID->"3f1620cb-549e-4b81-995e-\
409b6c7cd728"],

Cell[TextData[{
 "In this example, we model transient intramolecular vibrational energy \
redistribution (IVR) and coherent mode swapping in a two-dimensional harmonic \
potential. A 2D GWP\[LongDash]initially displaced and squeezed solely along \
the ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "52e78ee2-1697-4038-84c9-e2fad89ec2ff"],
 "-coordinate while sitting in its uncoupled ground state along ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9054ec83-b74e-477f-a605-b7e71a2448e3"],
 "\[LongDash]is subjected to a smoothly windowed bilinear coupling ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["V", "11"], "(", "t", ")"}], " ", "x", " ", "y"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4e20162f-c18c-4023-8ba0-11d09e466993"]
}], "Text",
 CellChangeTimes->{
  4.0012632252318373`*^9, {4.0014173003947268`*^9, 4.001417353445408*^9}, 
   4.001417427481948*^9, {4.001516034640592*^9, 4.001516036054948*^9}, {
   4.00152107709744*^9, 4.0015211102558002`*^9}, {4.001694621549521*^9, 
   4.0016946239210987`*^9}, {4.001694671354534*^9, 
   4.0016946755627317`*^9}},ExpressionUUID->"1d397d90-1ab4-4b06-881f-\
51090009abaa"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["V", "11"], "(", "t", ")"}], "=", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{
     SubscriptBox["\[Kappa]", "xy"], "(", 
     RowBox[{
      RowBox[{"tanh", "(", 
       RowBox[{"t", "-", 
        SubscriptBox["t", "1"]}], ")"}], "-", 
      RowBox[{"tanh", "(", 
       RowBox[{"t", "-", 
        SubscriptBox["t", "2"]}], ")"}]}], ")"}]}]}], 
  TraditionalForm]], "Text",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
   4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
   4.001167030269079*^9}, {4.001168402809308*^9, 4.001168426499454*^9}, {
   4.001195461673896*^9, 4.001195503258028*^9}, {4.001195834433279*^9, 
   4.001195998998259*^9}, {4.0011976314556*^9, 4.00119771342379*^9}, {
   4.001199104101141*^9, 4.001199115942663*^9}, {4.001199321428568*^9, 
   4.001199331465453*^9}, 4.001199392445671*^9, 4.001199467206645*^9, {
   4.001199563032137*^9, 4.001199583014041*^9}, {4.001203465471712*^9, 
   4.0012035255169*^9}, {4.001264251805689*^9, 4.0012642661539392`*^9}, {
   4.0013318278236923`*^9, 4.0013318316543007`*^9}, {4.001331917778775*^9, 
   4.001331919395858*^9}, {4.0014052911153917`*^9, 4.0014053358551207`*^9}, {
   4.0015211131336613`*^9, 
   4.001521147703455*^9}},ExpressionUUID->"2aff5637-788a-499c-bc84-\
a3191075dbe2"],

Cell[TextData[{
 "which temporarily hybridizes the two orthogonal oscillators during the \
interval ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "1"], "\[LessTilde]", "t", "\[LessTilde]", 
    SubscriptBox["t", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "870070f4-a250-4504-9fca-b0cb6b445983"],
 ", rotating the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c9710587-4252-48b4-9026-02ad981c8b8d"],
 " complex shape matrix ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["A",
     FontWeight->"Bold",
     FontSlant->"Plain"], "t"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "55f94f8e-9957-4f0a-9439-fc33916fa103"],
 " and transferring both classical momentum and quantum squeezing into the ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ef8da002-970f-46c8-b5ab-01fad470c4d4"],
 "-mode."
}], "Text",
 CellChangeTimes->{{4.0015211640615253`*^9, 
  4.0015212503481083`*^9}},ExpressionUUID->"0bf49cb3-ffbc-4606-aeb1-\
66034b1455b4"],

Cell[TextData[{
 "First, we define the coupling window and initialize the 2D wavepacket. \
Notice that for GWP[\[OpenCurlyDoubleQuote]2D\[CloseCurlyDoubleQuote]], the \
\[OpenCurlyDoubleQuote]Numerical\[CloseCurlyDoubleQuote] potential template \
takes six callable coefficient functions corresponding to the 2D Taylor \
expansion ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["V", "00"], ",", 
     SubscriptBox["V", "10"], ",", 
     SubscriptBox["V", "01"], ",", 
     SubscriptBox["V", "20"], ",", 
     SubscriptBox["V", "02"], ",", 
     SubscriptBox["V", "11"]}], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fe140ea9-6f61-4b78-86f9-b663893636d1"],
 ":"
}], "Text",
 CellChangeTimes->{
  4.001263240491275*^9, {4.0014174643067493`*^9, 4.0014174804043922`*^9}, {
   4.0015213406648617`*^9, 
   4.001521374556389*^9}},ExpressionUUID->"b3f2d3ab-54f6-40df-9ac4-\
bf06c5a6c064"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Parameters", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"tMin", "=", 
     RowBox[{"-", "20"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tMax", "=", "50"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Uncoupled", " ", "degenerate", " ", "harmonic", " ", 
      RowBox[{"frequencies", ":", "omegaX"}]}], "=", 
     RowBox[{"omegaY", "=", 
      RowBox[{
       RowBox[{"1", "->", "V20"}], "=", 
       RowBox[{"V02", "=", 
        RowBox[{"1", "/", "2"}]}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"v00", "=", 
     RowBox[{"0", "&"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"v10", "=", 
     RowBox[{"0", "&"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"v01", "=", 
     RowBox[{"0", "&"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"v20Func", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], "&"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"v02Func", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], "&"}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Smoothly", " ", "switch", " ", "on", " ", "bilinear", " ", "xy", " ", 
      "coupling", " ", "V11", 
      RowBox[{"(", "t", ")"}], " ", "between", " ", "t1"}], "=", 
     RowBox[{
      RowBox[{"5", " ", "and", " ", "t2"}], "=", "20"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"t1", "=", "5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"t2", "=", "20"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kappaXY", "=", 
     RowBox[{"35", "/", "100"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"v11Window", "[", "t_", "]"}], ":=", 
     RowBox[{"kappaXY", "*", 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Tanh", "[", 
         RowBox[{"t", "-", "t1"}], "]"}], "-", 
        RowBox[{"Tanh", "[", 
         RowBox[{"t", "-", "t2"}], "]"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Initial", " ", "shape", " ", 
      RowBox[{"matrix", ":", " ", 
       RowBox[{"squeezed", " ", "along", " ", "x"}]}]}], ",", 
     RowBox[{"ground", " ", "state", " ", "along", " ", "y"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"aMat0", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"r0", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"3", "/", "2"}], ",", "0"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"p0", "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Initialize", " ", "the", " ", "wavepacket"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"psi2D", "=", 
     RowBox[{
      RowBox[{"GWP", "[", "\"\<2D\>\"", "]"}], "[", 
      RowBox[{"aMat0", ",", "r0", ",", "p0", ",", "0", ",", 
       RowBox[{"\"\<Potential\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Numerical\>\"", ",", "v00", ",", "v10", ",", "v01", ",",
           "v20Func", ",", "v02Func", ",", "v11Window", ",", "tMin", ",", 
          "tMax"}], "}"}]}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.001263247623102*^9, 4.001263247623158*^9}, {
  4.001417484748619*^9, 4.001417493270987*^9}, {4.0015212855575542`*^9, 
  4.001521299802273*^9}, {4.0015213816778593`*^9, 4.00152157963375*^9}, {
  4.0015235647742357`*^9, 4.001523569177351*^9}, {4.001696166438232*^9, 
  4.001696183942444*^9}},ExpressionUUID->"aa88c10c-de69-4e89-b583-\
81b67bc73fca"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Visualize", " ", "the", " ", "bilinear", " ", "mode"}], "-", 
    RowBox[{"coupling", " ", "window", " ", "V11", 
     RowBox[{"(", "t", ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"v11Window", "[", "t", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "tMin", ",", "tMax"}], "}"}], ",", 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "0.05"}], ",", "0.55"}], "}"}]}], ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<time\>\"", ",", "\"\<V11(t)\>\""}], "}"}]}], ",", 
    RowBox[{"BaseStyle", "->", 
     RowBox[{"FontSize", "->", "12"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{4.0015213078353033`*^9, 4.001521308556151*^9}, {
  4.001521879336267*^9, 4.0015218982961073`*^9}},
 CellLabel->
  "In[255]:=",ExpressionUUID->"76da8177-13dc-4e6a-8490-c21038a3b854"],

