001d5eab28cc"],

Cell[TextData[{
 "If this were all we included, then the normalization procedure would divide \
out ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[ScriptCapitalN]", "2", "2"], TraditionalForm]],
  ExpressionUUID->"c14f6850-9d6e-4eca-96e3-fc0ac1db43d3"],
 " and the wave packet would be a good approximation to the second excited \
state."
}], "Text",
 CellChangeTimes->{{4.000943651227911*^9, 
  4.000943717323676*^9}},ExpressionUUID->"129e722d-471c-49bc-b00a-\
86f996f543ce"],

Cell[TextData[{
 "However, suppose that we added a fourth component (a coherent state with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "0"], "=", 
    RowBox[{"-", "6"}]}], TraditionalForm]],ExpressionUUID->
  "0a313182-b240-4c14-8f87-6f461ee1996d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "0"], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "8622145b-67c0-4d4f-866c-824805a8db9a"],
 " for instance) far to the left of the target state.  We will refer to as \
the \[OpenCurlyDoubleQuote]striker.\[CloseCurlyDoubleQuote]  We can define \
the total raw state as"
}], "Text",
 CellChangeTimes->{{4.000943719712924*^9, 4.000943769580686*^9}, {
  4.000943802896351*^9, 
  4.000943891453929*^9}},ExpressionUUID->"d25c2cda-9bba-4156-abe1-\
60452c545e7f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalPsi]", "raw"], "(", "x", ")"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[ScriptCapitalN]", "2"], 
      RowBox[{
       SubscriptBox["\[Psi]", "2"], "(", "x", ")"}]}], "+", 
     RowBox[{
      SubscriptBox["\[ScriptCapitalN]", "2"], 
      RowBox[{
       SubscriptBox["g", "striker"], "(", "x", ")"}]}]}], "=", 
    RowBox[{
     SubscriptBox["\[ScriptCapitalN]", "2"], "(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Psi]", "2"], "(", "x", ")"}], "+", 
      RowBox[{
       SubscriptBox["g", "striker"], "(", "x", ")"}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
