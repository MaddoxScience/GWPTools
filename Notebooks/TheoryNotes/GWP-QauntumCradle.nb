Cell["Let\[CloseCurlyQuote]s expand the sum for illustration", "Text",
 CellChangeTimes->{{4.000982819952416*^9, 
  4.0009828340235777`*^9}},ExpressionUUID->"9879ce71-90b9-49c4-99a0-\
dab453a30a60"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"g", "(", 
    RowBox[{
     RowBox[{"x", ";", 
      SubscriptBox["x", "k"]}], ",", 
     SubscriptBox["p", "k"], ",", 
     RowBox[{
      SubscriptBox["\[Gamma]", "k"], "=", 
      RowBox[{
       FractionBox["1", "2"], 
       SubscriptBox["x", "k"], 
       SubscriptBox["p", "k"]}]}]}], ")"}], "=", 
   RowBox[{
    RowBox[{"exp", "(", 
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["R", "2"], "4"]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Psi]", "0"], "(", "x", ")"}], "+", 
      RowBox[{
       FractionBox["R", 
        SqrtBox["2"]], " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["\[Theta]", "1"]}]], 
       RowBox[{
        SubscriptBox["\[Psi]", "1"], "(", "x", ")"}]}], "+", 
      RowBox[{
       FractionBox[
        SuperscriptBox["R", "2"], 
        SqrtBox["8"]], 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"2", "\[ImaginaryI]", " ", 
         SubscriptBox["\[Theta]", "2"]}]], 
       RowBox[{
        SubscriptBox["\[Psi]", "2"], "(", "x", ")"}]}], "+", 
      RowBox[{"\[CenterDot]", "\[CenterDot]", "\[CenterDot]"}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
   4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
   4.000921220003305*^9}, {4.0009708077413607`*^9, 4.000970836794525*^9}, 
   4.000970887577639*^9, {4.0009709474090548`*^9, 4.000970975205464*^9}, {
   4.000971017617157*^9, 4.000971069029745*^9}, {4.000971106167315*^9, 
   4.000971151557632*^9}, {4.000982114292671*^9, 4.0009821727152452`*^9}, {
   4.00098238163739*^9, 4.000982390528035*^9}, {4.000982849142778*^9, 
   4.000982972270032*^9}, 
   4.000983054253718*^9},ExpressionUUID->"6836e62b-a21b-481b-b8cd-\
995c42f3ed46"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "k"], TraditionalForm]],ExpressionUUID->
  "b0c2c566-2465-49a0-82c6-c39c092ab5c5"],
 " dependence is that of a pure Fourier harmonic and because each Gaussian on \
the circle has the exact same radius, the prefactor is identical for each \
Gaussian.  Each eigenstate has a different rotating phase factor."
}], "Text",
 CellChangeTimes->{{4.000932630967978*^9, 4.000932696173726*^9}, {
  4.000983156023995*^9, 
  4.000983198272291*^9}},ExpressionUUID->"a7286bdb-0625-4a2c-abd2-\
ed86b1af4811"],

Cell[TextData[{
 "To project out ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "n"], TraditionalForm]],ExpressionUUID->
  "f15e69de-29b7-48c1-ad3f-35bca42a39b5"],
 ", we sum the ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]],ExpressionUUID->
  "990bc2e2-250c-4d75-80f1-0ccb635b0510"],
 " Gaussians around the circle with complex Fourier weights (counter-rotating \
phase factor."
}], "Text",
 CellChangeTimes->{{4.000932718413554*^9, 4.000932760748416*^9}, {
  4.000983130154501*^9, 4.000983131845305*^9}, {4.00098318546528*^9, 
  4.000983210497388*^9}},ExpressionUUID->"0e5a1199-a1a8-4c44-9f79-\
1d002928deba"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["c", "k"], "=", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", "n", " ", 
      SubscriptBox["\[Theta]", "k"]}]], "=", 
    RowBox[{
     RowBox[{"cos", "(", 
      RowBox[{"n", " ", 
       SubscriptBox["\[Theta]", "k"]}], ")"}], "-", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"sin", "(", 
       RowBox[{"n", " ", 
        SubscriptBox["\[Theta]", "k"]}], ")"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
   4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
