Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"g", "(", 
    RowBox[{
     RowBox[{"x", ";", 
      SubscriptBox["x", "k"]}], ",", 
     SubscriptBox["p", "k"], ",", 
     RowBox[{
      SubscriptBox["\[Gamma]", "k"], "=", 
      RowBox[{
       FractionBox["1", "2"], 
       SubscriptBox["x", "k"], 
       SubscriptBox["p", "k"]}]}]}], ")"}], "=", 
   RowBox[{
    FractionBox["1", 
     SuperscriptBox["\[Pi]", 
      RowBox[{"1", "/", "4"}]]], 
    RowBox[{"exp", "(", "Z", ")"}]}]}], TraditionalForm]], "DisplayFormula",
