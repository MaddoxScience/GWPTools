Cell["Substituting the definitions above, we have", "Text",
 CellChangeTimes->{{4.000930024356604*^9, 
  4.000930034942767*^9}},ExpressionUUID->"86406ba5-f9f1-47f3-b645-\
bf8aca8408fb"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{"x", 
     SubscriptBox["\[Beta]", "k"]},
    "BraKet"], "=", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "4"]}], 
      SuperscriptBox["R", "2"]}]], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"m", "=", "0"}], "\[Infinity]"], " ", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["R", 
         SqrtBox["2"]], ")"}], "m"], 
      FractionBox["1", 
       SqrtBox[
        RowBox[{"m", "!"}]]], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", "m", " ", 
        SubscriptBox["\[Theta]", "k"]}]], 
      RowBox[{
       SubscriptBox["\[Psi]", "m"], "(", "x", ")"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
