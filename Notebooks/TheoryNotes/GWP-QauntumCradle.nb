Cell[BoxData[
 FormBox[
  RowBox[{"Z", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"x", "-", 
        SubscriptBox["x", "k"]}], ")"}], "2"]}], "+", 
    RowBox[{"\[ImaginaryI]", " ", 
