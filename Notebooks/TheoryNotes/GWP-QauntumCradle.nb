d7a0f1977656"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"g", "(", 
    RowBox[{
     RowBox[{"x", ";", 
      SubscriptBox["x", "k"]}], ",", 
     SubscriptBox["p", "k"], ",", 
     RowBox[{
      SubscriptBox["\[Gamma]", "k"], "=", 
      RowBox[{
       FractionBox["1", "2"], 
       SubscriptBox["x", "k"], 
       SubscriptBox["p", "k"]}]}]}], ")"}], "=", 
   RowBox[{
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "4"]}], 
      RowBox[{"(", 
       RowBox[{
        SubsuperscriptBox["x", "k", "2"], "+", 
        SubsuperscriptBox["p", "k", "2"]}], ")"}]}], ")"}], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"m", "=", "0"}], "\[Infinity]"], 
     RowBox[{
      FractionBox[
       SuperscriptBox["z", "m"], 
       RowBox[{"m", "!"}]], 
      FractionBox["1", 
       SuperscriptBox["\[Pi]", 
        RowBox[{"1", "/", "4"}]]], 
      RowBox[{
       SubscriptBox["H", "m"], "(", "x", ")"}], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", 
         FractionBox["1", "2"]}], 
        SuperscriptBox["x", "2"]}]]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
