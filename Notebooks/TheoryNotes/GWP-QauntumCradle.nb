Cell[CellGroupData[{

Cell["Code for Quantum Cradle", "Section",
 CellChangeTimes->{{4.000995287828329*^9, 
  4.000995296873445*^9}},ExpressionUUID->"3902b3e6-7805-4ec9-b257-\
f343557a0286"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "MakeQuantumCradleMC1D", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "MakeQuantumCradleMC1D", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Method\>\"", "->", "\"\<Stencil\>\""}], ",", 
      RowBox[{"(*", 
       RowBox[{"\"\<Stencil\>\"", " ", "or", " ", "\"\<Circle\>\""}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"\"\<RingPoints\>\"", "->", "6"}], ",", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "Number", " ", "of", " ", "Gaussians", " ", "M", " ", "on", " ", 
         "the", " ", "phase"}], "-", 
        RowBox[{"space", " ", "ring"}]}], "*)"}], 
      RowBox[{"\"\<HBAR\>\"", "->", "1"}], ",", 
      RowBox[{"\"\<MASS\>\"", "->", "1"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"MakeQuantumCradleMC1D", "[", 
    RowBox[{"n_Integer", ",", 
     RowBox[{"scale_", ":", 
      RowBox[{"1", "/", "10"}]}], ",", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"eps", " ", "for", " ", "\"\<Stencil\>\""}], ",", 
       RowBox[{"Rx", " ", "for", " ", "\"\<Circle\>\""}]}], "*)"}], 
     RowBox[{"strikerRule", ":", 
      RowBox[{"(", 
       RowBox[{"_Rule", "|", "None"}], ")"}], ":", "None"}], ",", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xIn", ",", "pIn"}], "}"}], "->", "relativeAmplitude"}], 
      "*)"}], 
     RowBox[{"opts", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"hbar", ",", "mass", ",", 
       RowBox[{"omega", "=", "1"}], ",", "a", ",", "method", ",", "M", ",", 
       "thetas", ",", "aa", ",", "xx", ",", "pp", ",", "gg", ",", "cc", ",", 
       "rawNorm", ",", "xIn", ",", "pIn", ",", "amp"}], "}"}], ",", 
     RowBox[{
      RowBox[{"hbar", "=", 
       RowBox[{"OptionValue", "[", "\"\<HBAR\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"mass", "=", 
       RowBox[{"OptionValue", "[", "\"\<MASS\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"method", "=", 
       RowBox[{"OptionValue", "[", "\"\<Method\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "Coherent", " ", "state", " ", "width", " ", "parameter", " ", "a"}], 
        "=", 
        RowBox[{"m", "*", 
         RowBox[{"omega", "/", 
          RowBox[{"(", 
           RowBox[{"2", "*", "hbar"}], ")"}]}]}]}], "*)"}], 
      RowBox[{"a", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"mass", "*", "omega"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", "*", "hbar"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"method", "===", "\"\<Circle\>\""}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
           RowBox[{"--", 
            RowBox[{"-", "Method"}]}], " ", "2"}], ":", 
          RowBox[{"Phase", "-", 
           RowBox[{"Space", " ", 
            RowBox[{"Ring", "--"}]}], "-"}]}], "*)"}], 
        RowBox[{
         RowBox[{"M", "=", 
          RowBox[{"Max", "[", 
           RowBox[{
            RowBox[{"OptionValue", "[", "\"\<RingPoints\>\"", "]"}], ",", 
            RowBox[{"n", "+", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"thetas", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"2", "*", "Pi", "*", 
             RowBox[{"k", "/", "M"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "0", ",", 
              RowBox[{"M", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"aa", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"a", ",", "M"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"xx", "=", 
          RowBox[{"scale", "*", 
           RowBox[{"Cos", "[", "thetas", "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"pp", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"2", "*", "a", "*", "hbar", "*", "scale"}], ")"}], "*", 
           RowBox[{"Sin", "[", "thetas", "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Scalar", " ", "displacement", " ", "phase", " ", "RG"}], "=", 
           RowBox[{
            RowBox[{
             RowBox[{"+", "1"}], "/", "2"}], "*", "x_k", "*", "p_k"}]}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"gg", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "/", "2"}], ")"}], "*", "xx", "*", "pp"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"cc", "=", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "I"}], "*", "n", "*", "thetas"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"rawNorm", "=", 
          RowBox[{"M", "*", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "a"}], "*", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"scale", "^", "2"}], ")"}], "/", "2"}]}], "]"}], "*", 
           RowBox[{"(", 
            RowBox[{"scale", "^", "n"}], ")"}], "*", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"a", "^", "n"}], ")"}], "/", 
             RowBox[{"(", 
              RowBox[{"n", "!"}], ")"}]}], "]"}]}]}], ";"}], ",", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
           RowBox[{"--", 
            RowBox[{"-", "Method"}]}], " ", "1"}], ":", 
          RowBox[{"Real", "-", 
           RowBox[{"Space", " ", "Finite"}], "-", 
           RowBox[{"Difference", " ", 
            RowBox[{"Stencil", "--"}]}], "-"}]}], "*)"}], 
        RowBox[{
         RowBox[{"aa", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"a", ",", 
            RowBox[{"n", "+", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"xx", "=", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "n"}], "/", "2"}], ",", 
             RowBox[{"n", "/", "2"}]}], "]"}], "*", "scale"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"pp", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", 
            RowBox[{"n", "+", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"gg", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0", ",", 
            RowBox[{"n", "+", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"cc", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"-", "1"}], ")"}], "^", 
              RowBox[{"(", 
               RowBox[{"n", "-", "k"}], ")"}]}], "*", 
             RowBox[{"Binomial", "[", 
              RowBox[{"n", ",", "k"}], "]"}], "*", 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"a", "/", "2"}], ")"}], "*", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"xx", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", "+", "1"}], "]"}], "]"}], "^", "2"}], ")"}]}],
               "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "0", ",", "n"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"rawNorm", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"scale", "^", "n"}], ")"}], "*", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"a", "^", "n"}], ")"}], "*", 
             RowBox[{"(", 
              RowBox[{"n", "!"}], ")"}]}], "]"}]}]}], ";"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Append", " ", "incoming", " ", "coherent", " ", "striker", " ", 
        "wavepacket", " ", "if", " ", "requested"}], "*)"}], 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"strikerRule", "=!=", "None"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"xIn", ",", "pIn"}], "}"}], "=", 
          RowBox[{"First", "[", "strikerRule", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"amp", "=", 
          RowBox[{"Last", "[", "strikerRule", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"aa", ",", "a"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"xx", ",", "xIn"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"pp", ",", "pIn"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"gg", ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "/", "2"}], ")"}], "*", "xIn", "*", "pIn"}]}], 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"cc", ",", 
           RowBox[{"amp", "*", "rawNorm"}]}], "]"}], ";"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"GWP", "[", "\"\<MC1D\>\"", "]"}], "[", 
       RowBox[{"aa", ",", "xx", ",", "pp", ",", "gg", ",", 
        RowBox[{"\"\<C\>\"", "->", "cc"}], ",", 
        RowBox[{"\"\<HBAR\>\"", "->", "hbar"}], ",", 
        RowBox[{"\"\<MASS\>\"", "->", "mass"}], ",", 
        RowBox[{"\"\<Potential\>\"", "->", "\"\<HO\>\""}]}], "]"}]}]}], 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.000993547857861*^9, 4.0009935478579397`*^9}, 
   4.0009937087067003`*^9, {4.000993804660474*^9, 4.000993816195588*^9}, {
   4.0009947921733723`*^9, 4.0009948108545094`*^9}, 
   4.000994881041111*^9},ExpressionUUID->"f5f37bfc-e935-42e3-be42-\
7007a7f30908"],

