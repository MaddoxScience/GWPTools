 CellChangeTimes->{{4.000982496355454*^9, 
  4.000982498740716*^9}},ExpressionUUID->"267a9b18-2028-4410-b87e-\
8e636ba09751"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"g", "(", 
    RowBox[{
     RowBox[{"x", ";", 
      SubscriptBox["x", "k"]}], ",", 
     SubscriptBox["p", "k"], ",", 
     RowBox[{
      SubscriptBox["\[Gamma]", "k"], "=", 
      RowBox[{
       FractionBox["1", "2"], 
       SubscriptBox["x", "k"], 
       SubscriptBox["p", "k"]}]}]}], ")"}], "=", 
   RowBox[{
    RowBox[{"exp", "(", 
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["R", "2"], "4"]}], ")"}], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"m", "=", "0"}], "\[Infinity]"], 
     RowBox[{
      FractionBox[
       RowBox[{
        SuperscriptBox["R", "m"], 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", "m", " ", 
          SubscriptBox["\[Theta]", "k"]}]]}], 
       SqrtBox[
        RowBox[{
         SuperscriptBox["2", "m"], 
         RowBox[{"m", "!"}]}]]], 
      RowBox[{
       SubscriptBox["\[Psi]", "m"], "(", "x", ")"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
