Cell["Theory for Quantum Cradle", "Section",
 CellChangeTimes->{{4.0009371714205*^9, 4.0009371752452917`*^9}, {
  4.0009953745339212`*^9, 
  4.00099538057164*^9}},ExpressionUUID->"ac06aad0-5b2e-4475-8327-\
0589e1d3d62d"],

Cell[CellGroupData[{

Cell["Setup", "Subsection",
 CellChangeTimes->{{4.000995211283132*^9, 
  4.0009952118711777`*^9}},ExpressionUUID->"eebfa909-ff50-4ed0-ad1b-\
d223b41efe38"],

Cell[TextData[{
 "Consider the 1D harmonic oscillator with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[HBar]", "=", 
    RowBox[{"m", "=", 
     RowBox[{"\[Omega]", "=", "1"}]}]}], TraditionalForm]],ExpressionUUID->
  "bd020bb6-d612-451c-aec5-bae7d472b79f"],
 ".  The Hamiltonian is given by "
}], "Text",
 CellChangeTimes->{{4.000920914283969*^9, 
  4.000920955631897*^9}},ExpressionUUID->"33ac846d-a111-48f1-8cf6-\
c197dacaa3ae"],

Cell[BoxData[
 FormBox[
  RowBox[{
   OverscriptBox["H", "^"], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        OverscriptBox["p", "^"], "2"], "+", 
       SuperscriptBox[
        OverscriptBox["q", "^"], "2"]}], ")"}]}], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       OverscriptBox["a", "^"], "\[Dagger]"], 
      OverscriptBox["a", "^"]}], "+", 
     FractionBox["1", "2"]}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
  4.0009951636733637`*^9, 
  4.000995164497891*^9}},ExpressionUUID->"9ef88abb-bee0-4639-824f-\
ed878883c69d"],

Cell["The normalized energy eigenstates (or Fock states) are", "Text",
 CellChangeTimes->{{4.0009210510502987`*^9, 
  4.000921073803096*^9}},ExpressionUUID->"7b2a88ab-b570-44b3-9faa-\
cef7c48de288"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Psi]", "n"], "(", "x", ")"}], "=", 
   RowBox[{
    TemplateBox[{"x", "n"},
     "BraKet"], "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{
       SuperscriptBox["\[Pi]", 
        RowBox[{"1", "/", "4"}]], 
       SqrtBox[
        RowBox[{
         SuperscriptBox["2", "n"], 
         RowBox[{"n", "!"}]}]]}]], 
     RowBox[{
      SubscriptBox["H", "n"], "(", "x", ")"}], 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"-", 
       FractionBox[
        SuperscriptBox["x", "2"], "2"]}]]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
  4.0009210779772367`*^9, 
  4.0009211268597927`*^9}},ExpressionUUID->"21d6fd6e-289b-47a7-ad55-\
92249b5415b4"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["E", "n"], "=", 
    RowBox[{"n", "+", 
     RowBox[{"1", "/", "2"}]}]}], TraditionalForm]],ExpressionUUID->
  "9cbd2645-df30-47f6-9b05-9ef1dbb2411e"],
 "."
}], "Text",
 CellChangeTimes->{{4.0009211309681683`*^9, 
  4.000921142987602*^9}},ExpressionUUID->"fc51522d-f6ed-49fe-99d1-\
b3a9f7cae758"],

Cell[TextData[{
 "Consider a single Gaussian component ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "0"], "=", 
    FractionBox["1", "2"]}], TraditionalForm]],ExpressionUUID->
  "5e267dda-1d90-4460-abcf-18953937a9bd"],
 ", centered at ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "72ba2d34-101e-4f5f-a298-112fbe108464"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "0"], TraditionalForm]],ExpressionUUID->
  "0ee67e70-f617-409e-bfa5-e382ce8c5768"],
 " with phase ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "0"], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"ee70f368-5b74-48db-9f3b-7780e7642b37"]
}], "Text",
 CellChangeTimes->{{4.0009212638847713`*^9, 
  4.000921307986517*^9}},ExpressionUUID->"082e163a-b5df-43e5-8c69-\
c7f0d6695ca6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"g", "(", 
    RowBox[{
     RowBox[{"x", ";", 
      SubscriptBox["x", "0"]}], ",", 
     SubscriptBox["p", "0"]}], ")"}], "=", 
   RowBox[{
    FractionBox["1", 
     SuperscriptBox["\[Pi]", 
      RowBox[{"1", "/", "4"}]]], 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "-", 
          SubscriptBox["x", "0"]}], ")"}], "2"]}], "+", 
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{
        SubscriptBox["p", "0"], "(", 
        RowBox[{"x", "-", 
         SubscriptBox["x", "0"]}], ")"}]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
  4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
  4.000921220003305*^9}},ExpressionUUID->"98009aaa-d130-457e-a05f-\
ad41027be0f9"],

Cell[TextData[{
 "This is a coherent state ",
 Cell[BoxData[
  FormBox[
   TemplateBox[{"\[Beta]"},
    "Ket"], TraditionalForm]],ExpressionUUID->
  "20c57141-e425-4f85-b703-50b2dd7e25b8"],
 " parameterized by a single complex number \[Beta] given by "
}], "Text",
 CellChangeTimes->{{4.000921224902712*^9, 4.000921230434574*^9}, {
  4.000921327733687*^9, 
  4.000921377159622*^9}},ExpressionUUID->"eaf7b042-387e-4e98-b9a5-\
048ad0df18a4"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Beta]", "=", 
   FractionBox[
    RowBox[{
     SubscriptBox["x", "0"], "+", 
     RowBox[{"\[ImaginaryI]", " ", 
      SubscriptBox["p", "0"]}]}], 
    SqrtBox["2"]]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
  4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
  4.000921220003305*^9}, {4.000921387564877*^9, 
  4.0009214004952297`*^9}},ExpressionUUID->"c27d9569-e2f9-44f1-9e57-\
5b12c2674c01"],

Cell["such that ", "Text",
 CellChangeTimes->{{4.0009214029333076`*^9, 
  4.000921404521246*^9}},ExpressionUUID->"28aa356b-6fd4-408c-831f-\
ae9e225442c2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["x", "0"], "=", 
   RowBox[{
    SqrtBox["2"], 
    RowBox[{"Re", "(", "\[Beta]", ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
  4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
  4.000921220003305*^9}, {4.000921387564877*^9, 
  4.000921423714855*^9}},ExpressionUUID->"f9fbb0b1-24e1-4f8e-a856-\
ce955283c362"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["p", "0"], "=", 
   RowBox[{
    SqrtBox["2"], 
    RowBox[{"Im", "(", "\[Beta]", ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
  4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
  4.000921220003305*^9}, {4.000921387564877*^9, 
  4.000921435123151*^9}},ExpressionUUID->"db88abd9-8797-49c4-9657-\
7f3ed91a7ff4"],

Cell["Note that ", "Text",
 CellChangeTimes->{{4.0009214733889627`*^9, 
  4.000921475674765*^9}},ExpressionUUID->"81170b77-b4a9-429b-8160-\
97ea5aa71d75"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["a", "^"], 
    TemplateBox[{"\[Beta]"},
     "Ket"]}], "=", 
   RowBox[{"\[Beta]", 
    TemplateBox[{"\[Beta]"},
     "Ket"]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
  4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
  4.000921220003305*^9}, {4.000921387564877*^9, 4.0009214004952297`*^9}, {
  4.000921484520772*^9, 
  4.000921497122423*^9}},ExpressionUUID->"c1c6590c-a987-4bf5-848b-\
8952d7823960"],

Cell[TextData[{
 "To relate g to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "n"], TraditionalForm]],ExpressionUUID->
  "9f69faf7-9c40-4f12-9e38-1b60e4cd288d"],
 ", we recall the generating function of the Hermite polynomials ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["H", "n"], "(", "x", ")"}], TraditionalForm]],ExpressionUUID->
  "ffec296b-e263-4102-b0cb-d0589cc2fddd"]
}], "Text",
 CellChangeTimes->{{4.000921509798552*^9, 
  4.000921537860461*^9}},ExpressionUUID->"09b8b586-2a71-4179-9321-\
103964f9a336"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"exp", "(", 
    RowBox[{
     RowBox[{"2", "x", " ", "z"}], "-", 
     SuperscriptBox["z", "2"]}], ")"}], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"n", "=", "0"}], "\[Infinity]"], 
    RowBox[{
     FractionBox[
      SuperscriptBox["z", "n"], 
      RowBox[{"n", "!"}]], 
     RowBox[{
      SubscriptBox["H", "n"], "(", "x", ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
  4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
  4.000921220003305*^9}, {4.000921387564877*^9, 4.0009214004952297`*^9}, {
  4.000921484520772*^9, 4.000921497122423*^9}, {4.00092154747018*^9, 
  4.0009215650951147`*^9}, {4.000921798085312*^9, 4.000921806370687*^9}, {
  4.000924275573888*^9, 
  4.000924279536215*^9}},ExpressionUUID->"fe21e047-f133-44f7-81ae-\
0bf8d60b5d6f"],

Cell[TextData[{
 "Starting with a purely real displacement ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "0"], "="}], TraditionalForm]],ExpressionUUID->
  "9e39cd26-d932-4287-9483-b1d81df814aa"],
 ", so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Beta]", "=", 
    RowBox[{
     SubscriptBox["x", "0"], "/", 
     SqrtBox["2"]}]}], TraditionalForm]],ExpressionUUID->
  "1b746835-02a6-4ac0-b730-e120a0e9f27e"],
 " is real, we can expand the exponent of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "(", 
    RowBox[{
     RowBox[{"x", ";", " ", 
      SubscriptBox["x", "0"]}], ",", "0"}], ")"}], TraditionalForm]],
  ExpressionUUID->"5d005e11-1f02-459a-9591-1e7fb13d3e47"]
}], "Text",
 CellChangeTimes->{{4.000922201637413*^9, 
  4.00092226518713*^9}},ExpressionUUID->"c55faefb-8afd-4370-baf1-\
0727b186a706"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"g", "(", 
    RowBox[{
     RowBox[{"x", ";", 
      SubscriptBox["x", "0"]}], ",", "0"}], ")"}], "=", 
   RowBox[{
    FractionBox["1", 
     SuperscriptBox["\[Pi]", 
      RowBox[{"1", "/", "4"}]]], 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"x", "-", 
         SubscriptBox["x", "0"]}], ")"}], "2"]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
  4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
  4.000921220003305*^9}, {4.000922277291098*^9, 
  4.000922334881833*^9}},ExpressionUUID->"5c66050b-e253-484e-8507-\
bc37bad80ae3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"g", "(", 
    RowBox[{
     RowBox[{"x", ";", 
      SubscriptBox["x", "0"]}], ",", "0"}], ")"}], "=", 
   RowBox[{
    FractionBox["1", 
     SuperscriptBox["\[Pi]", 
      RowBox[{"1", "/", "4"}]]], 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["x", "2"], "2"]}]], 
    RowBox[{"exp", "(", 
     RowBox[{
      FractionBox[
       SuperscriptBox["x", "2"], "2"], "-", 
      RowBox[{
       FractionBox["1", "2"], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "-", 
          SubscriptBox["x", "0"]}], ")"}], "2"]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
  4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
  4.000921220003305*^9}, {4.000922277291098*^9, 
  4.000922332774547*^9}},ExpressionUUID->"a71191b4-dd4b-4043-a7d0-\
820f282d0dbc"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"g", "(", 
    RowBox[{
     RowBox[{"x", ";", 
      SubscriptBox["x", "0"]}], ",", "0"}], ")"}], "=", 
   RowBox[{
    FractionBox["1", 
     SuperscriptBox["\[Pi]", 
      RowBox[{"1", "/", "4"}]]], 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["x", "2"], "2"]}]], 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"x", " ", 
       SubscriptBox["x", "0"]}], "-", 
      RowBox[{
       FractionBox["1", "2"], 
       SubsuperscriptBox["x", "0", "2"]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
  4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
  4.000921220003305*^9}, {4.000922277291098*^9, 
  4.000922385649426*^9}},ExpressionUUID->"94386dd1-27a5-4caa-9a6e-\
5d6dd40d398a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"g", "(", 
    RowBox[{
     RowBox[{"x", ";", 
      SubscriptBox["x", "0"]}], ",", "0"}], ")"}], "=", 
   RowBox[{
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "4"]}], 
      SubsuperscriptBox["x", "0", "2"]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      FractionBox["1", 
       SuperscriptBox["\[Pi]", 
        RowBox[{"1", "/", "4"}]]], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"-", 
        FractionBox[
         SuperscriptBox["x", "2"], "2"]}]], 
      RowBox[{"exp", "(", 
       RowBox[{
        RowBox[{"2", 
         RowBox[{"x", "(", " ", 
          FractionBox[
           SubscriptBox["x", "0"], "2"], ")"}]}], "-", 
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox[
           SubscriptBox["x", "0"], "2"], ")"}], "2"]}], ")"}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
  4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
  4.000921220003305*^9}, {4.000922277291098*^9, 4.000922458607655*^9}, {
  4.000922562343156*^9, 
  4.000922616112686*^9}},ExpressionUUID->"2c3d39f0-ff09-4753-bf06-\
ba2eb852caf2"],

Cell[TextData[{
 "Notice that if we let ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "=", 
    RowBox[{
     SubscriptBox["x", "0"], "/", "2"}]}], TraditionalForm]],ExpressionUUID->
  "bb67ea31-d503-49f1-b381-0bb1b34f9a11"],
 ", the the last exponential matches the Hermite generating function.  \
Therefore, we may write"
}], "Text",
 CellChangeTimes->{{4.000922647417101*^9, 
  4.000922713019706*^9}},ExpressionUUID->"a911778f-99fa-4605-91cc-\
c9dd57425bb4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"g", "(", 
    RowBox[{
     RowBox[{"x", ";", 
      SubscriptBox["x", "0"]}], ",", "0"}], ")"}], "=", 
   RowBox[{
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "4"]}], 
      SubsuperscriptBox["x", "0", "2"]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      FractionBox["1", 
       SuperscriptBox["\[Pi]", 
        RowBox[{"1", "/", "4"}]]], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"-", 
        FractionBox[
         SuperscriptBox["x", "2"], "2"]}]], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"n", "=", "0"}], "\[Infinity]"], 
       RowBox[{
        FractionBox[
         SubsuperscriptBox["x", "0", "n"], 
         RowBox[{
          SuperscriptBox["2", "n"], 
          RowBox[{"n", "!"}]}]], 
        RowBox[{
         SubscriptBox["H", "n"], "(", "x", ")"}]}]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
  4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
