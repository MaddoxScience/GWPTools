d62bd811d335"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"g", "(", 
    RowBox[{
     RowBox[{"x", ";", 
      SubscriptBox["x", "0"]}], ",", "0"}], ")"}], "=", 
   RowBox[{
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "4"]}], 
      SubsuperscriptBox["x", "0", "2"]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"n", "=", "0"}], "\[Infinity]"], 
      RowBox[{
       FractionBox["1", 
        SuperscriptBox["\[Pi]", 
         RowBox[{"1", "/", "4"}]]], 
       FractionBox[
        SubsuperscriptBox["x", "0", "n"], 
        RowBox[{
         SuperscriptBox["2", "n"], 
         RowBox[{"n", "!"}]}]], 
       RowBox[{
        SubscriptBox["H", "n"], "(", "x", ")"}], 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"-", 
         FractionBox[
          SuperscriptBox["x", "2"], "2"]}]]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
