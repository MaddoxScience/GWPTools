Cell[TextData[{
 "Now we can substitute in the definitions of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "k"], TraditionalForm]],ExpressionUUID->
  "2e2dbd1b-e856-4dcb-81fa-1f6553d56dd6"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "k"], TraditionalForm]],ExpressionUUID->
  "c2bcabcc-6046-4619-b83a-7b99f3467e9a"],
 " on the phase space circle"
}], "Text",
 CellChangeTimes->{{4.000982227472846*^9, 
  4.000982244297423*^9}},ExpressionUUID->"d62a0d83-b2cd-4c0f-a684-\
88ec9ae593d2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["x", "k", "2"], "+", 
    SubsuperscriptBox["p", "k", "2"]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["R", "2"], 
      SuperscriptBox["cos", "2"], 
      SubscriptBox["\[Theta]", "k"]}], "+", 
     RowBox[{
      SuperscriptBox["R", "2"], 
      SuperscriptBox["sin", "2"], 
      SubscriptBox["\[Theta]", "k"]}]}], "=", 
    SuperscriptBox["R", "2"]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
   4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
   4.000921220003305*^9}, {4.0009708077413607`*^9, 4.000970836794525*^9}, 
