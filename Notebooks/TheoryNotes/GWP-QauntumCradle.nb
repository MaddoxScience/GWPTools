Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"HOEigenCluster", ",", "MakeQuantumCradleMC1D"}], "]"}], ";"}], 
  "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Helper", ":", 
      RowBox[{
       RowBox[{
        RowBox[{"Generates", " ", 
         RowBox[{"{", 
          RowBox[{"aa", ",", "xx", ",", "pp", ",", "gg", ",", "cc"}], "}"}], " ",
          "for", " ", "a", " ", "unit"}], "-", 
        RowBox[{"norm", " ", "displaced", " ", "eigenstate"}]}], "|", "n"}]}],
      ";", "X0"}], ",", 
    RowBox[{"P0", ">"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HOEigenCluster", "[", 
     RowBox[{"n_Integer", ",", 
      RowBox[{"{", 
       RowBox[{"X0_", ",", "P0_"}], "}"}], ",", "amp_", ",", "scale_", ",", 
      "method_String", ",", "M_Integer", ",", "hbar_", ",", "mass_"}], "]"}], 
    ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"omega", "=", "1"}], ",", "a", ",", "useM", ",", "thetas", ",",
         "dx", ",", "dp", ",", "aa", ",", "xx", ",", "pp", ",", "gg", ",", 
        "cc", ",", "rawNorm"}], "}"}], ",", 
      RowBox[{
       RowBox[{"a", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"mass", "*", "omega"}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", "hbar"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Fast", "-", 
          RowBox[{"path", " ", "for", " ", "n"}]}], "=", 
         RowBox[{"0", " ", 
          RowBox[{"(", 
           RowBox[{
           "single", " ", "coherent", " ", "Gaussian", " ", "needs", " ", 
            "only", " ", "1", " ", "state"}], ")"}]}]}], "*)"}], 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"n", "==", "0"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", "a", "}"}], ",", 
            RowBox[{"{", "X0", "}"}], ",", 
            RowBox[{"{", "P0", "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "/", "2"}], ")"}], "*", "X0", "*", "P0"}], "}"}], 
            ",", 
            RowBox[{"{", "amp", "}"}]}], "}"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"method", "===", "\"\<Circle\>\""}], ",", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Method", " ", "2"}], ":", 
           RowBox[{
            RowBox[{"Displaced", " ", "Phase"}], "-", 
            RowBox[{"Space", " ", "Ring"}]}]}], "*)"}], 
         RowBox[{
          RowBox[{"useM", "=", 
           RowBox[{"Max", "[", 
            RowBox[{"M", ",", 
             RowBox[{"n", "+", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"thetas", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"2", "*", "Pi", "*", 
              RowBox[{"k", "/", "useM"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "0", ",", 
               RowBox[{"useM", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"dx", "=", 
           RowBox[{"scale", "*", 
            RowBox[{"Cos", "[", "thetas", "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"dp", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"2", "*", "a", "*", "hbar", "*", "scale"}], ")"}], "*", 
            RowBox[{"Sin", "[", "thetas", "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"aa", "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"a", ",", "useM"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"xx", "=", 
           RowBox[{"X0", "+", "dx"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"pp", "=", 
           RowBox[{"P0", "+", "dp"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"gg", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "/", "2"}], ")"}], "*", "X0", "*", "P0"}], "+", 
            RowBox[{"P0", "*", "dx"}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "/", "2"}], ")"}], "*", "dx", "*", "dp"}]}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"rawNorm", "=", 
           RowBox[{"useM", "*", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "a"}], "*", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"scale", "^", "2"}], ")"}], "/", "2"}]}], "]"}], "*", 
            
            RowBox[{"(", 
             RowBox[{"scale", "^", "n"}], ")"}], "*", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"a", "^", "n"}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"n", "!"}], ")"}]}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"cc", "=", 
           RowBox[{"amp", "*", 
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "I"}], "*", "n", "*", "thetas"}], "]"}], "/", 
             "rawNorm"}]}]}], ";"}], ",", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Method", " ", "1"}], ":", 
           RowBox[{
            RowBox[{"Displaced", " ", "Real"}], "-", 
            RowBox[{"Space", " ", "Stencil"}]}]}], "*)"}], 
         RowBox[{
          RowBox[{"dx", "=", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "n"}], "/", "2"}], ",", 
              RowBox[{"n", "/", "2"}]}], "]"}], "*", "scale"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"aa", "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"a", ",", 
             RowBox[{"n", "+", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"xx", "=", 
           RowBox[{"X0", "+", "dx"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"pp", "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"P0", ",", 
             RowBox[{"n", "+", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"gg", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "/", "2"}], ")"}], "*", "X0", "*", "P0"}], "+", 
            RowBox[{"P0", "*", "dx"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"rawNorm", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"scale", "^", "n"}], ")"}], "*", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"a", "^", "n"}], ")"}], "*", 
              RowBox[{"(", 
               RowBox[{"n", "!"}], ")"}]}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"cc", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"amp", "*", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"-", "1"}], ")"}], "^", 
               RowBox[{"(", 
                RowBox[{"n", "-", "k"}], ")"}]}], "*", 
              RowBox[{"Binomial", "[", 
               RowBox[{"n", ",", "k"}], "]"}], "*", 
              RowBox[{
               RowBox[{"Exp", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"a", "/", "2"}], ")"}], "*", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"dx", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "+", "1"}], "]"}], "]"}], "^", "2"}], 
                  ")"}]}], "]"}], "/", "rawNorm"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "0", ",", "n"}], "}"}]}], "]"}]}], ";"}]}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"aa", ",", "xx", ",", "pp", ",", "gg", ",", "cc"}], "}"}]}]}],
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Main", " ", 
    RowBox[{"Constructor", ":", 
     RowBox[{
     "Accepts", " ", "a", " ", "list", " ", "of", " ", "state", " ", 
      "specifications"}], ":", 
     RowBox[{"{", 
      RowBox[{"n", ",", 
       RowBox[{"{", 
        RowBox[{"X0", ",", "P0"}], "}"}], ",", "relativeWeight"}], "}"}]}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "MakeQuantumCradleMC1D", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Method\>\"", "->", "\"\<Stencil\>\""}], ",", 
      RowBox[{"\"\<Scale\>\"", "->", 
       RowBox[{"1", "/", "10"}]}], ",", 
      RowBox[{"\"\<RingPoints\>\"", "->", "6"}], ",", 
      RowBox[{"\"\<HBAR\>\"", "->", "1"}], ",", 
      RowBox[{"\"\<MASS\>\"", "->", "1"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"MakeQuantumCradleMC1D", "[", 
    RowBox[{"stateSpecs_List", ",", 
     RowBox[{"opts", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "method", ",", "scale", ",", "M", ",", "hbar", ",", "mass", ",", 
       "clusters", ",", "aa", ",", "xx", ",", "pp", ",", "gg", ",", "cc"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"method", "=", 
       RowBox[{"OptionValue", "[", "\"\<Method\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"scale", "=", 
       RowBox[{"OptionValue", "[", "\"\<Scale\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"M", "=", 
       RowBox[{"OptionValue", "[", "\"\<RingPoints\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"hbar", "=", 
       RowBox[{"OptionValue", "[", "\"\<HBAR\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"mass", "=", 
       RowBox[{"OptionValue", "[", "\"\<MASS\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"clusters", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"HOEigenCluster", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "#", "]"}], ">=", "3"}], ",", 
              RowBox[{"#", "[", 
               RowBox[{"[", "3", "]"}], "]"}], ",", "1"}], "]"}], ",", 
            "scale", ",", "method", ",", "M", ",", "hbar", ",", "mass"}], 
           "]"}], "&"}], ",", "stateSpecs"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"aa", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"clusters", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xx", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"clusters", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pp", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"clusters", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "3"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"gg", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"clusters", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "4"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"cc", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"clusters", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "5"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"GWP", "[", "\"\<MC1D\>\"", "]"}], "[", 
       RowBox[{"aa", ",", "xx", ",", "pp", ",", "gg", ",", 
        RowBox[{"\"\<C\>\"", "->", "cc"}], ",", 
        RowBox[{"\"\<HBAR\>\"", "->", "hbar"}], ",", 
        RowBox[{"\"\<MASS\>\"", "->", "mass"}], ",", 
        RowBox[{"\"\<Potential\>\"", "->", "\"\<HO\>\""}]}], "]"}]}]}], 
    "]"}]}], ";"}]}], "Input",
