Cell["Method 2: Phase-space ring", "Subsection",
 CellChangeTimes->{{4.000969816940638*^9, 
  4.000969824059565*^9}},ExpressionUUID->"688b0500-6de4-4d3f-a278-\
986be1ad088a"],

Cell[TextData[{
 "Now we consider the Fock state projection on a phase-ring approach (\
\[OpenCurlyDoubleQuote]circular cat states\[CloseCurlyDoubleQuote]), which \
involves placing the Gaussians evenly on a circle of radius ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]],ExpressionUUID->
  "6604ea25-bd0c-446f-8e40-048a0e15046b"],
 " in phase space ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["x", "0"], ",", 
     SubscriptBox["p", "0"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "9c36c97d-fc30-45e3-83ef-8e1ac573879a"],
 " with"
}], "Text",
