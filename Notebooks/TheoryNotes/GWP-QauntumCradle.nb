89e420a33035"],

Cell[TextData[{
 "and the whole thing is divided by ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    TemplateBox[{
      SubscriptBox["\[CapitalPsi]", "raw"], 
      SubscriptBox["\[CapitalPsi]", "raw"]},
     "BraKet"]], TraditionalForm]],ExpressionUUID->
  "8b1faaaa-a7fc-4177-a4a8-231fca0e549f"],
 "."
}], "Text",
 CellChangeTimes->{{4.000942919946563*^9, 
  4.000942979168796*^9}},ExpressionUUID->"accdcba5-1064-4b5f-8421-\
70130a8703a1"],

Cell[TextData[{
 "Now suppose that we build the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "2"}], TraditionalForm]],ExpressionUUID->
  "27a5ca46-6eef-4f8e-a3be-94d6714c9255"],
 " excited state at the origin using 3 Gaussians spaced by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Epsilon]", "=", 
    RowBox[{"1", "/", "10"}]}], TraditionalForm]],ExpressionUUID->
  "5bebbbc0-a796-4141-ae6a-ad458c739ac7"],
 ", which also controls their weights as defined above.  The Gaussians nearly \
cancel and what is left behind is "
}], "Text",
 CellChangeTimes->{{4.000943045963434*^9, 4.0009430753815203`*^9}, {
  4.000943377178031*^9, 
  4.0009434625206127`*^9}},ExpressionUUID->"5b4be785-3ec5-4fdf-b694-\
23b1df7f230c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalPsi]", 
     RowBox[{"target", ",", " ", "raw"}]], "(", "x", ")"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["c", "0"], 
      RowBox[{
       SubscriptBox["g", "0"], "(", "x", ")"}]}], "+", 
     RowBox[{
      SubscriptBox["c", "1"], 
      RowBox[{
       SubscriptBox["g", "1"], "(", "x", ")"}]}], "+", 
     RowBox[{
      SubscriptBox["c", "2"], 
      RowBox[{
       SubscriptBox["g", "2"], "(", "x", ")"}]}]}], "\[TildeTilde]", 
    RowBox[{
     SubscriptBox["\[ScriptCapitalN]", "2"], 
     RowBox[{
      SubscriptBox["\[Psi]", "2"], "(", "x", ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
