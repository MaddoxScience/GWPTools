   4.000927198195095*^9}, {4.000927887357052*^9, 4.0009279344139843`*^9}, {
   4.000928719073977*^9, 4.000928762766374*^9}, {4.0009292440668983`*^9, 
   4.000929351570664*^9}, {4.000929398654605*^9, 4.0009294435289*^9}, {
   4.0009295928064957`*^9, 4.000929697565448*^9}, {4.000932768652669*^9, 
   4.000932794875758*^9}},ExpressionUUID->"bea2c2d2-1386-4d5d-b264-\
b8aacf962730"],

Cell[TextData[{
 "so that the coefficient of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Psi]", "m"], "(", "x", ")"}], TraditionalForm]],
  ExpressionUUID->"98462279-4e30-4fce-a251-989e2bc55baa"],
 " is the discrete Fourier sum"
}], "Text",
 CellChangeTimes->{{4.000932822792551*^9, 
  4.00093284215803*^9}},ExpressionUUID->"28a5e08b-dbb7-4c0d-8bcd-\
dff073370474"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"k", "=", "0"}], 
     RowBox[{"M", "-", "1"}]], 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", "n", " ", 
       SubscriptBox["\[Theta]", "k"]}]], 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[ImaginaryI]", " ", "m", " ", 
       SubscriptBox["\[Theta]", "k"]}]]}]}], "=", 
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k", "=", "0"}], 
      RowBox[{"M", "-", "1"}]], 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"\[ImaginaryI]", "(", 
        RowBox[{"m", "-", "n"}], ")"}], 
       FractionBox[
        RowBox[{"2", "\[Pi]", " ", "k"}], "M"]}]]}], "=", 
    TagBox[GridBox[{
       {"\[Piecewise]", GridBox[{
          {"M", 
           RowBox[{
            RowBox[{"if", " ", "m"}], "-", 
            RowBox[{"n", " ", "is", " ", "a", " ", "multiple", " ", "M"}]}]},
          {"0", "otherwise"}
         },
         AllowedDimensions->{2, Automatic},
         Editable->True,
         GridBoxAlignment->{
          "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, 
           "Rows" -> {{Baseline}}, "RowsIndexed" -> {}},
         GridBoxItemSize->{
          "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, 
           "Rows" -> {{1.}}, "RowsIndexed" -> {}},
         GridBoxSpacings->{"Columns" -> {
             Offset[0.27999999999999997`], {
              Offset[0.84]}, 
             Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
             Offset[0.2], {
              Offset[0.4]}, 
             Offset[0.2]}, "RowsIndexed" -> {}},
         Selectable->True]}
      },
      GridBoxAlignment->{
       "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
        "RowsIndexed" -> {}},
      GridBoxItemSize->{
       "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}}, 
        "RowsIndexed" -> {}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.35]}, 
          Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}, "RowsIndexed" -> {}}],
     "Piecewise",
     DeleteWithContents->True,
     Editable->False,
     SelectWithContents->True,
     Selectable->False,
     StripWrapperBoxes->True]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
   4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
   4.000921220003305*^9}, {4.000922277291098*^9, 4.000922458607655*^9}, {
   4.000922562343156*^9, 4.000922616112686*^9}, {4.000922784994224*^9, 
   4.000922831512233*^9}, {4.000922876210958*^9, 4.000922923456134*^9}, {
   4.000923115587049*^9, 4.000923115984066*^9}, {4.000923494586967*^9, 
   4.000923521262611*^9}, {4.000923614761239*^9, 4.000923645359151*^9}, {
   4.0009243857838297`*^9, 4.0009243998546543`*^9}, 4.000924678019273*^9, {
   4.0009247177668047`*^9, 4.000924757701231*^9}, {4.000925583618717*^9, 
   4.000925590113758*^9}, {4.000925649272172*^9, 4.000925658703*^9}, {
   4.000925699394202*^9, 4.0009257228211803`*^9}, {4.0009265273120747`*^9, 
   4.0009266920889378`*^9}, {4.000926786383102*^9, 4.000926813198407*^9}, {
   4.000926852784754*^9, 4.000926956606064*^9}, {4.000927188177497*^9, 
   4.000927198195095*^9}, {4.000927887357052*^9, 4.0009279344139843`*^9}, {
   4.000928719073977*^9, 4.000928762766374*^9}, {4.0009292440668983`*^9, 
   4.000929351570664*^9}, {4.000929398654605*^9, 4.0009294435289*^9}, {
   4.0009295928064957`*^9, 4.000929697565448*^9}, {4.0009328644427*^9, 
   4.000932953843958*^9}},ExpressionUUID->"ad89114c-9970-48bf-9706-\
5de53ac7d73c"],

Cell[TextData[{
 "If we use ",
 Cell[BoxData[
  FormBox["M", TraditionalForm]],ExpressionUUID->
  "5fb5d98b-fe2e-4edd-acd9-6828a3080388"],
 " Gaussians on a circle of radius ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]],ExpressionUUID->
  "cbd1513f-0552-4860-9ed6-16f37f1469c0"],
 " with weights ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "k"], TraditionalForm]],ExpressionUUID->
  "95fcf131-d531-4e5d-a58b-a5261ddd7e9c"],
 ", every state from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "!=", "n"}], TraditionalForm]],ExpressionUUID->
  "53f04763-d6ee-41a8-b587-402c4a3d48de"],
 " from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "db46e952-259f-43b5-aa39-ced635100025"],
 " up to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "=", 
    RowBox[{"n", "+", "M", "-", "1"}]}], TraditionalForm]],ExpressionUUID->
  "f349f8e3-30f0-4fe1-89d3-8cc3f7e4a0b5"],
 " is annihilated to zero."
}], "Text",
 CellChangeTimes->{{4.000933300365477*^9, 
  4.0009333699108667`*^9}},ExpressionUUID->"f28ce755-a56a-4e72-81d7-\
c0f6beca53e1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Test", " ", "the", " ", "Phase"}], "-", 
     RowBox[{"Space", " ", "Circle", " ", "sum", " ", "for", " ", "n"}]}], "=", 
    RowBox[{
     RowBox[{"2", " ", "with", " ", "M"}], "=", 
     RowBox[{"6", " ", "Gaussians"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"circleTest", "[", 
     RowBox[{"m_", ",", "n_", ",", "M_"}], "]"}], ":=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], "*", "n", "*", 
          RowBox[{"(", 
           RowBox[{"2", " ", "Pi", " ", 
            RowBox[{"k", "/", "M"}]}], ")"}]}], "]"}], "*", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", "*", "m", "*", 
          RowBox[{"(", 
           RowBox[{"2", " ", "Pi", " ", 
            RowBox[{"k", "/", "M"}]}], ")"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", 
         RowBox[{"M", "-", "1"}]}], "}"}]}], "]"}], "]"}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Check", " ", "m"}], "=", "0"}], ",", "1", ",", "2", ",", "3", ",",
      "4", ",", "5", ",", "6", ",", "7", ",", 
     RowBox[{
      RowBox[{"8", " ", "for", " ", "target", " ", "state", " ", "n"}], "=", 
      RowBox[{
       RowBox[{"2", " ", "with", " ", "M"}], "=", "6"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"m", ",", 
        RowBox[{"circleTest", "[", 
         RowBox[{"m", ",", "2", ",", "6"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"m", ",", "0", ",", "8"}], "}"}]}], "]"}], "//", 
    "TableForm"}]}]}]], "Input",
 CellChangeTimes->{{4.000983665028261*^9, 4.000983665028359*^9}},
 CellLabel->
  "In[438]:=",ExpressionUUID->"ffc5fa0d-8017-4ffa-84df-3c6c27261488"],

Cell[TextData[{
 "For example to build the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "2"}], TraditionalForm]],ExpressionUUID->
  "db152315-d9d9-4f4a-b06a-71ba9498b3b3"],
 " state using ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", "=", "6"}], TraditionalForm]],ExpressionUUID->
  "137b18f7-3a3e-455c-9dbb-c88bac62e519"],
 " Gaussians on a phase-space circle, the states 0, 1, 3, 4, 5, 6, 7 have \
exact zero weight.  The first non-zero contamination term is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "=", 
    RowBox[{
     RowBox[{"n", "+", "M"}], "=", "8"}]}], TraditionalForm]],ExpressionUUID->
  "8abab290-f077-4a99-a65f-0d6d3041fcb1"],
 ", which is suppressed by the ratio"
}], "Text",
 CellChangeTimes->{{4.000933376012436*^9, 4.000933453228305*^9}, {
  4.0009334932140636`*^9, 
  4.000933496459443*^9}},ExpressionUUID->"367d10ec-25ca-4889-b4b0-\
f33b261e9cf3"],

Cell[BoxData[
 FormBox[
  RowBox[{" ", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox["R", 
        SqrtBox["2"]], ")"}], "8"], 
     RowBox[{
      FractionBox["1", 
       SqrtBox[
        RowBox[{"8", "!"}]]], "/", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["R", 
         SqrtBox["2"]], ")"}], "2"]}], 
     FractionBox["1", 
      SqrtBox[
       RowBox[{"2", "!"}]]]}], "\[TildeTilde]", 
    FractionBox[
     SuperscriptBox["R", "6"], "1135"]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
   4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
   4.000921220003305*^9}, {4.000922277291098*^9, 4.000922458607655*^9}, {
   4.000922562343156*^9, 4.000922616112686*^9}, {4.000922784994224*^9, 
   4.000922831512233*^9}, {4.000922876210958*^9, 4.000922923456134*^9}, {
   4.000923115587049*^9, 4.000923115984066*^9}, {4.000923494586967*^9, 
   4.000923521262611*^9}, {4.000923614761239*^9, 4.000923645359151*^9}, {
   4.0009243857838297`*^9, 4.0009243998546543`*^9}, 4.000924678019273*^9, {
   4.0009247177668047`*^9, 4.000924757701231*^9}, {4.000925583618717*^9, 
   4.000925590113758*^9}, {4.000925649272172*^9, 4.000925658703*^9}, {
   4.000925699394202*^9, 4.0009257228211803`*^9}, {4.0009265273120747`*^9, 
   4.0009266920889378`*^9}, {4.000926786383102*^9, 4.000926813198407*^9}, {
   4.000926852784754*^9, 4.000926956606064*^9}, {4.000927188177497*^9, 
   4.000927198195095*^9}, {4.000927887357052*^9, 4.0009279344139843`*^9}, {
   4.000928719073977*^9, 4.000928762766374*^9}, {4.0009292440668983`*^9, 
   4.000929351570664*^9}, {4.000929398654605*^9, 4.0009294435289*^9}, {
   4.0009295928064957`*^9, 4.000929697565448*^9}, {4.000933484981007*^9, 
   4.000933552032733*^9}},ExpressionUUID->"ef9a3d19-1a60-4fb3-a725-\
eb2022094041"],

Cell[TextData[{
 "which is very small even for a fairly large radius, e.g., ",
 Cell[BoxData[
  FormBox[
   RowBox[{"R", "=", 
    RowBox[{"1", "/", "2"}]}], TraditionalForm]],ExpressionUUID->
  "4d65b2bf-d522-4701-9841-ad39ba922cf4"],
 "."
}], "Text",
 CellChangeTimes->{{4.000933563612829*^9, 
  4.000933600354711*^9}},ExpressionUUID->"89640dd9-80e5-4922-915b-\
cacaa6fde392"],

Cell[TextData[{
 "For the harmonic oscillator, the Gaussians on the ring simply rotate \
clockwise around the circle with an angular frequency of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", "=", "1"}], TraditionalForm]],ExpressionUUID->
  "2fbc0a98-de09-4d7d-a58d-f3b4730a7567"],
 " without changing radius ",
 Cell[BoxData[
  FormBox["R", TraditionalForm]],ExpressionUUID->
  "4cbae0a0-1cd7-4ffb-94c3-9ad4ede77d20"],
 ".  For the previous method with all Gaussians along the x-axis with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "k"], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "d685903d-ad11-4404-a715-0d54771d36f5"],
 " which all Gaussians (n+1 of them) collapse through x=0 at t=\[Pi]/2 \
(becoming a momentum stencil along the p-axis) and then expand along x at t=\
\[Pi].   In the present method the Gaussian chase each other along the \
phase-space circle forever."
}], "Text",
 CellChangeTimes->{{4.000933633847341*^9, 4.000933706465107*^9}, {
  4.000934027644964*^9, 
  4.0009341905679617`*^9}},ExpressionUUID->"766b108c-d083-40ae-89a4-\
6d7996f23668"],

Cell["Summary of this method (phase-space circle).", "Text",
 CellChangeTimes->{{4.000937195035478*^9, 
  4.000937210210284*^9}},ExpressionUUID->"1b84d7b9-b72b-4858-aded-\
e4269128d7f9"],

Cell[TextData[{
 "Choose M>n Gaussians, say 4 or 6 for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "2"}], TraditionalForm]],ExpressionUUID->
  "8a26ad76-5369-425f-90ff-7c6c0e9c48f7"],
 ", with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "k"], TraditionalForm]],ExpressionUUID->
  "1c1a6cc0-74ff-45d6-bdb0-93e4b596f7af"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "k"], TraditionalForm]],ExpressionUUID->
  "17d80324-890c-401c-be28-3830275ad408"],
 ", and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "k"], TraditionalForm]],ExpressionUUID->
  "7794da7c-9d9c-4c97-aad0-523ad628af8e"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "k"], TraditionalForm]],ExpressionUUID->
  "3a5813d3-a796-48aa-aef1-f847baa548c8"],
 " defined above.  The first error term is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "+", "M"}], TraditionalForm]],ExpressionUUID->
  "2aa28ed5-5a2d-438c-ab90-787fb4e1ff5e"],
 " state.  The unnormalized norm for striker scaling is"
}], "Text",
 CellChangeTimes->{{4.0009372139645147`*^9, 4.000937252087414*^9}, {
   4.0009372873354597`*^9, 4.000937356700164*^9}, 
   4.000940382875969*^9},ExpressionUUID->"07e07a1e-a3a7-4b50-985f-\
024c94e9af15"],

Cell[BoxData[
 FormBox[
  RowBox[{"M", " ", 
   RowBox[{
    SuperscriptBox[
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["R", "2"]}], "/", "4"}]], "(", 
      RowBox[{"R", "/", 
       SqrtBox["2"]}], ")"}], "n"], "/", 
    SqrtBox[
     RowBox[{"n", "!"}]]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
   4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
   4.000921220003305*^9}, {4.000922277291098*^9, 4.000922458607655*^9}, {
   4.000922562343156*^9, 4.000922616112686*^9}, {4.000922784994224*^9, 
   4.000922831512233*^9}, {4.000922876210958*^9, 4.000922923456134*^9}, {
   4.000923115587049*^9, 4.000923115984066*^9}, {4.000923494586967*^9, 
   4.000923521262611*^9}, {4.000923614761239*^9, 4.000923645359151*^9}, {
   4.0009243857838297`*^9, 4.0009243998546543`*^9}, 4.000924678019273*^9, {
   4.0009247177668047`*^9, 4.000924757701231*^9}, {4.000925583618717*^9, 
   4.000925590113758*^9}, {4.000925649272172*^9, 4.000925658703*^9}, {
   4.000925699394202*^9, 4.0009257228211803`*^9}, {4.0009265273120747`*^9, 
   4.0009266920889378`*^9}, {4.000926786383102*^9, 4.000926813198407*^9}, {
   4.000926852784754*^9, 4.000926956606064*^9}, {4.000927188177497*^9, 
   4.000927198195095*^9}, {4.000927887357052*^9, 4.0009279344139843`*^9}, {
   4.000928719073977*^9, 4.000928762766374*^9}, {4.0009292440668983`*^9, 
   4.000929351570664*^9}, {4.000929398654605*^9, 4.0009294435289*^9}, {
   4.0009295928064957`*^9, 4.000929697565448*^9}, {4.000933484981007*^9, 
   4.000933552032733*^9}, {4.0009373654187937`*^9, 
   4.000937385033966*^9}},ExpressionUUID->"8ce39ace-5aa2-48b4-9aff-\
07052990fe45"]
}, Closed]],

Cell[CellGroupData[{

Cell["Generalized definition", "Subsection",
 CellChangeTimes->{{4.0009861225344143`*^9, 
  4.0009861266157007`*^9}},ExpressionUUID->"b3bfe178-79dc-4f56-99df-\
86102bd28818"],

Cell["So here we will consider the harmonic oscillator potential", "Text",
 CellChangeTimes->{{4.000986150028797*^9, 
  4.000986217104353*^9}},ExpressionUUID->"cf300946-b5d6-413b-a9f7-\
9322e7ff5d0c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"V", "(", "x", ")"}], "=", 
   RowBox[{
    FractionBox["1", "2"], "m", " ", 
    SuperscriptBox["\[Omega]", "2"], 
    SuperscriptBox["x", "2"]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
  4.0009861975970984`*^9, 
  4.000986207881235*^9}},ExpressionUUID->"f9d0fc9b-0569-44b7-b0d6-\
470c5bd1e8eb"],

Cell["\<\
where we introduce the coherent-state Gaussian shape parameter\
\>", "Text",
 CellChangeTimes->{{4.000986223273746*^9, 
  4.0009862848267393`*^9}},ExpressionUUID->"c0a3e6d7-a36c-4e54-a13a-\
f40d4843a6d1"],

Cell[BoxData[
 FormBox[
  RowBox[{"a", "=", " ", 
   FractionBox[
    RowBox[{"m", " ", "\[Omega]"}], 
    RowBox[{"2", "\[HBar]"}]]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
  4.0009861975970984`*^9, 4.000986207881235*^9}, {4.0009862414614964`*^9, 
  4.000986261862432*^9}},ExpressionUUID->"aed8fe06-cc40-49e6-8605-\
53216ba30426"],

Cell["The normalized eigenstates are", "Text",
 CellChangeTimes->{{4.00098629056075*^9, 
  4.000986294780884*^9}},ExpressionUUID->"d61ec51f-bc93-47fb-9d7f-\
3747a8392532"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Psi]", "n"], "(", "x", ")"}], "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{"2", "a"}], "\[Pi]"], ")"}], 
     RowBox[{"1", "/", "4"}]], 
    FractionBox["1", 
     SqrtBox[
      RowBox[{
       SuperscriptBox["2", "n"], 
       RowBox[{"n", "!"}]}]]], 
    RowBox[{
     SubscriptBox["H", "n"], "(", 
     RowBox[{
      SqrtBox[
       RowBox[{"2", "a"}]], "x"}], ")"}], 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", "a"}], " ", 
      SuperscriptBox["x", "2"]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
  4.0009861975970984`*^9, 4.000986207881235*^9}, {4.0009862414614964`*^9, 
  4.000986261862432*^9}, {4.000986300689509*^9, 
  4.0009863329791927`*^9}},ExpressionUUID->"12a6234a-dbd5-4ce0-bb2c-\
6dc227f6f77e"],

Cell["\<\
We will be representing the eigenstates using a superposition of generalized \
coherent Gaussian wave packet functions defined as\
\>", "Text",
 CellChangeTimes->{{4.000986352764633*^9, 4.000986373213489*^9}, {
  4.000986467625441*^9, 4.000986491347658*^9}, {4.000986584541432*^9, 
  4.000986586989997*^9}},ExpressionUUID->"117f9e89-4880-4be3-90b5-\
08201c2e3a8a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"g", "(", 
    RowBox[{
     RowBox[{"x", ";", " ", 
      SubscriptBox["\[Alpha]", "k"]}], ",", 
     SubscriptBox["x", "k"], ",", 
     SubscriptBox["p", "k"], ",", 
     SubscriptBox["\[Gamma]", "k"]}], ")"}], "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{"2", " ", 
        RowBox[{"Re", "(", 
         SubscriptBox["\[Alpha]", "k"], ")"}]}], "\[Pi]"], ")"}], 
     RowBox[{"1", "/", "4"}]], 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      FractionBox["1", "\[HBar]"], 
      RowBox[{"Im", "(", 
       SubscriptBox["\[Gamma]", "k"], ")"}]}]], 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox[
        RowBox[{"a", "(", 
         RowBox[{"x", "-", 
          SubscriptBox["x", "k"]}], ")"}], "2"]}], "+", 
      RowBox[{
       FractionBox["\[ImaginaryI]", "\[HBar]"], 
       RowBox[{
        SubscriptBox["p", "k"], "(", 
        RowBox[{"x", "-", 
         SubscriptBox["x", "k"]}], ")"}]}], "+", 
      RowBox[{
       FractionBox["\[ImaginaryI]", "\[HBar]"], 
       SubscriptBox["\[Gamma]", "k"]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
  4.0009861975970984`*^9, 4.000986207881235*^9}, {4.0009862414614964`*^9, 
  4.000986261862432*^9}, {4.000986300689509*^9, 4.0009863329791927`*^9}, {
  4.0009863773360567`*^9, 4.000986438309795*^9}, {4.0009865008490143`*^9, 
  4.0009865048550873`*^9}, {4.000986856903133*^9, 4.000986867605158*^9}, {
  4.000986966348852*^9, 
  4.000987022794283*^9}},ExpressionUUID->"1c6590ad-015f-407b-9da8-\
229982469a33"],

Cell[TextData[{
 "By choosing the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "k"], "=", "a"}], TraditionalForm]],
  ExpressionUUID->"91f0cc61-7eeb-49c9-9c32-fbfac5fdbfe1"],
 " and the phase to be that of a phase space displacement from the origin, \
i.e., ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "k"], "=", 
    RowBox[{
     FractionBox["1", "2"], 
     SubscriptBox["x", "k"], 
     SubscriptBox["p", "k"]}]}], TraditionalForm]],ExpressionUUID->
  "d361a143-3780-4e62-909c-571ecc1693f0"],
 ", we can formally rewrite the Gaussian as as a superposition of the \
harmonic oscillator eigenstates"
}], "Text",
 CellChangeTimes->{{4.000986576011559*^9, 4.0009865945320597`*^9}, {
  4.000986735225046*^9, 4.000986766583148*^9}, {4.0009868210288553`*^9, 
  4.000986842984305*^9}, {4.000987033737371*^9, 
  4.000987111521317*^9}},ExpressionUUID->"0cd3fb8f-f14f-4dff-966d-\
e4e31dec0d1d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"g", "(", 
    RowBox[{
     RowBox[{"x", ";", " ", "a"}], ",", 
     SubscriptBox["x", "k"], ",", 
     SubscriptBox["p", "k"], ",", 
     RowBox[{
      FractionBox["1", "2"], 
      SubscriptBox["x", "k"], 
      SubscriptBox["p", "k"]}]}], ")"}], "=", 
   RowBox[{
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        FractionBox["a", "2"]}], 
       SubsuperscriptBox["x", "k", "2"]}], "-", 
      FractionBox[
       SubsuperscriptBox["p", "k", "2"], 
       RowBox[{"8", "a", " ", 
        SuperscriptBox["\[HBar]", "2"]}]]}], ")"}], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"m", "=", "0"}], "\[Infinity]"], " ", 
     RowBox[{
      SqrtBox[
       FractionBox[
        SuperscriptBox["a", "m"], 
        RowBox[{"m", "!"}]]], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["x", "k"], "+", 
         RowBox[{
          FractionBox["\[ImaginaryI]", 
           RowBox[{"2", "a", " ", "\[HBar]"}]], 
          SubscriptBox["p", "k"]}]}], ")"}], "m"], 
      RowBox[{
       SubscriptBox["\[Psi]", "m"], "(", "x", ")"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
   4.0009861975970984`*^9, 4.000986207881235*^9}, {4.0009862414614964`*^9, 
   4.000986261862432*^9}, {4.000986300689509*^9, 4.0009863329791927`*^9}, {
   4.0009863773360567`*^9, 4.000986438309795*^9}, {4.0009865008490143`*^9, 
   4.0009865048550873`*^9}, {4.000986607358177*^9, 4.000986687377171*^9}, {
   4.000986719990896*^9, 4.000986730128098*^9}, {4.000986798657689*^9, 
   4.000986812925366*^9}, 
   4.000986846192636*^9},ExpressionUUID->"38a05a54-2366-4c0a-9cbf-\
1f1de5feca8c"],

Cell["We can approximately reconstruct the eigenstates as follows:", "Text",
 CellChangeTimes->{{4.000987137833819*^9, 
  4.000987152337173*^9}},ExpressionUUID->"070fd93d-9870-4550-9745-\
f53d121f7603"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Psi]", "n"], "(", "x", ")"}], "=", 
   RowBox[{"\[ScriptCapitalN]", " ", 
    RowBox[{
     UnderscriptBox["\[Sum]", "k"], 
     RowBox[{
      SubscriptBox["c", "k"], 
      RowBox[{"g", "(", 
       RowBox[{
        RowBox[{"x", ";", " ", 
         SubscriptBox["\[Alpha]", "k"]}], ",", 
        SubscriptBox["x", "k"], ",", 
        SubscriptBox["p", "k"], ",", 
        SubscriptBox["\[Gamma]", "k"]}], ")"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
   4.0009861975970984`*^9, 4.000986207881235*^9}, {4.0009862414614964`*^9, 
   4.000986261862432*^9}, {4.000986300689509*^9, 4.0009863329791927`*^9}, {
   4.0009863773360567`*^9, 4.000986438309795*^9}, {4.0009865008490143`*^9, 
   4.0009865048550873`*^9}, {4.000986607358177*^9, 4.000986687377171*^9}, {
   4.000986719990896*^9, 4.000986730128098*^9}, {4.000986798657689*^9, 
   4.000986812925366*^9}, 4.000986846192636*^9, {4.000987161982588*^9, 
   4.000987204097899*^9}},ExpressionUUID->"2534f44c-47a3-4a43-8d15-\
ecb4fc06c0de"],

Cell[TextData[{
 "Method 1 involves a generalized real-space finite-difference stencil (",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "=", 
    RowBox[{"n", "+", "1"}]}], TraditionalForm]],ExpressionUUID->
  "bbe9d9ec-6341-4af9-b634-49aadc50ed95"],
 " states) where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"k", "=", "0"}], ",", "1", ",", "\[Ellipsis]", ",", "n"}], 
   TraditionalForm]],ExpressionUUID->"07b34605-cf9e-46f6-98c8-c6e40e734fbb"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "k"], "=", "a"}], TraditionalForm]],
  ExpressionUUID->"6098670c-6eaf-48c7-92a6-ed0729f010ba"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "k"], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"k", "-", 
       RowBox[{"n", "/", "2"}]}], ")"}], "\[Epsilon]"}]}], TraditionalForm]],
  ExpressionUUID->"e674dde0-63ed-44fa-b8f7-a42b2b0e33ad"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "k"], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "e24f7756-32d2-46c8-9749-5779f0d3ecab"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "k"], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"48b493ce-049a-4f8e-9f68-fd3ce196be99"],
 ".  The parameter ",
 Cell[BoxData[
  FormBox["\[Epsilon]", TraditionalForm]],ExpressionUUID->
  "dd8b338b-8971-4e61-83b5-ad29cb8ee22c"],
 " is chosen such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox["a"], "\[Epsilon]", 
    RowBox[{"<<", "1"}]}], TraditionalForm]],ExpressionUUID->
  "40c28965-2faa-40b7-b4cc-f20ef99acf12"],
 ". "
}], "Text",
 CellChangeTimes->{{4.000987277470441*^9, 4.000987480547153*^9}, {
  4.0009877245663853`*^9, 
  4.000987755561821*^9}},ExpressionUUID->"a20931e5-8f98-4f3f-87ea-\
d793197cace5"],

Cell["The weights are given by", "Text",
 CellChangeTimes->{{4.000987486695952*^9, 
  4.000987491798624*^9}},ExpressionUUID->"a633ebc7-44fd-4b41-a280-\
cc5b36723bcf"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["c", "k"], "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"n", "-", "k"}]], 
    RowBox[{"(", GridBox[{
       {"n"},
       {"k"}
      }], ")"}], 
    RowBox[{"exp", "(", 
     RowBox[{
      FractionBox["a", "2"], 
      SubsuperscriptBox["x", "k", "2"]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
   4.0009861975970984`*^9, 4.000986207881235*^9}, {4.0009862414614964`*^9, 
   4.000986261862432*^9}, {4.000986300689509*^9, 4.0009863329791927`*^9}, {
   4.0009863773360567`*^9, 4.000986438309795*^9}, {4.0009865008490143`*^9, 
   4.0009865048550873`*^9}, {4.000986607358177*^9, 4.000986687377171*^9}, {
   4.000986719990896*^9, 4.000986730128098*^9}, {4.000986798657689*^9, 
   4.000986812925366*^9}, 4.000986846192636*^9, {4.000987161982588*^9, 
   4.000987204097899*^9}, {4.00098749762081*^9, 
   4.000987514516941*^9}},ExpressionUUID->"495e8677-b725-48d0-8be3-\
724cfa964e09"],

Cell["The unnormalized stencil Norm (for striker scaling) is", "Text",
 CellChangeTimes->{{4.0009875325300827`*^9, 4.000987593890077*^9}, {
  4.000987639414661*^9, 
  4.000987658381938*^9}},ExpressionUUID->"e532759d-8710-49e2-909e-\
f797b2639bd4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[ScriptCapitalN]", "raw", 
    RowBox[{"(", "1", ")"}]], "=", 
   RowBox[{
    SuperscriptBox["\[Epsilon]", "n"], 
    SqrtBox[
     RowBox[{
      SuperscriptBox["a", "n"], 
      RowBox[{"n", "!"}]}]]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
   4.0009861975970984`*^9, 4.000986207881235*^9}, {4.0009862414614964`*^9, 
   4.000986261862432*^9}, {4.000986300689509*^9, 4.0009863329791927`*^9}, {
   4.0009863773360567`*^9, 4.000986438309795*^9}, {4.0009865008490143`*^9, 
   4.0009865048550873`*^9}, {4.000986607358177*^9, 4.000986687377171*^9}, {
   4.000986719990896*^9, 4.000986730128098*^9}, {4.000986798657689*^9, 
   4.000986812925366*^9}, 4.000986846192636*^9, {4.000987161982588*^9, 
   4.000987204097899*^9}, {4.00098749762081*^9, 4.000987514516941*^9}, {
   4.0009876643690023`*^9, 
   4.000987683561565*^9}},ExpressionUUID->"867b0162-373e-4da9-8757-\
0b3bf37408c8"],

Cell[TextData[{
 "Method 2 involves a generalized phase-space ellipse/circle (",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "=", 
    RowBox[{"M", ">", "n"}]}], TraditionalForm]],ExpressionUUID->
  "f9dcf170-a724-4849-b1f4-3c04080c72c8"],
 " states).  If ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "x"], TraditionalForm]],ExpressionUUID->
  "d11682f7-4660-41d2-a62e-63b600699730"],
 " is the position radius of the ellipse, then ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", "p"], "=", 
    RowBox[{
     RowBox[{"2", "a", " ", "\[HBar]", " ", 
      SubscriptBox["R", "x"]}], "=", 
     RowBox[{"m", " ", "\[Omega]", " ", 
      SubscriptBox["R", "x"]}]}]}], TraditionalForm]],ExpressionUUID->
  "899f0bb7-da83-42a6-a395-02bdff707065"],
 " is the momentum radius, such that "
}], "Text",
 CellChangeTimes->{{4.000987708707601*^9, 4.000987751592267*^9}, {
  4.000992841434361*^9, 
  4.00099293108088*^9}},ExpressionUUID->"5fef9f9d-3210-40cc-a3b3-\
d018808ec777"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["x", "k"], "+", 
    RowBox[{
     FractionBox["\[ImaginaryI]", 
      RowBox[{"2", "a", " ", "\[HBar]"}]], 
     SubscriptBox["p", "k"]}]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["R", "x"], "cos", " ", 
      SubscriptBox["\[Theta]", "k"]}], "+", 
     RowBox[{
      FractionBox["\[ImaginaryI]", 
       RowBox[{"2", "a", " ", "\[HBar]"}]], " ", 
      SubscriptBox["R", "p"], "sin", " ", 
      SubscriptBox["\[Theta]", "k"]}]}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["R", "x"], "(", 
      RowBox[{
       RowBox[{"cos", " ", 
        SubscriptBox["\[Theta]", "k"]}], "+", 
       RowBox[{"\[ImaginaryI]", " ", "sin", " ", 
        SubscriptBox["\[Theta]", "k"]}]}], ")"}], "=", 
     RowBox[{
      SubscriptBox["R", "x"], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", 
        SubscriptBox["\[Theta]", "k"]}]]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
   4.0009861975970984`*^9, 4.000986207881235*^9}, {4.0009862414614964`*^9, 
   4.000986261862432*^9}, {4.000986300689509*^9, 4.0009863329791927`*^9}, {
   4.0009863773360567`*^9, 4.000986438309795*^9}, {4.0009865008490143`*^9, 
   4.0009865048550873`*^9}, {4.000986607358177*^9, 4.000986687377171*^9}, {
   4.000986719990896*^9, 4.000986730128098*^9}, {4.000986798657689*^9, 
   4.000986812925366*^9}, 4.000986846192636*^9, {4.000987161982588*^9, 
   4.000987204097899*^9}, {4.00099294076803*^9, 
   4.000993007869516*^9}},ExpressionUUID->"215449b9-65a7-48e5-ba35-\
c2eb62c6464e"],

Cell["Likewise, the Gaussian prefactor becomes", "Text",
 CellChangeTimes->{{4.000993021695179*^9, 
  4.000993028863797*^9}},ExpressionUUID->"2cca364c-e574-471b-8fea-\
fa19c75cc3fa"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"exp", "(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox["a", "2"]}], 
      SubsuperscriptBox["x", "k", "2"]}], "-", 
     FractionBox[
      SubsuperscriptBox["p", "k", "2"], 
      RowBox[{"8", "a", " ", 
       SuperscriptBox["\[HBar]", "2"]}]]}], ")"}], "=", 
   RowBox[{
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        FractionBox["a", "2"]}], 
       SubsuperscriptBox["R", "x", "2"], 
       SuperscriptBox["cos", "2"], 
       SubscriptBox["\[Theta]", "k"]}], "-", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"8", "a", " ", 
         SuperscriptBox["\[HBar]", "2"]}]], "4", 
       SuperscriptBox["a", "2"], 
       SuperscriptBox["\[HBar]", "2"], 
       SubsuperscriptBox["R", "x", "2"], 
       SuperscriptBox["sin", "2"], 
       SubscriptBox["\[Theta]", "k"]}]}], ")"}], "=", 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["a", "2"]}], 
      SubsuperscriptBox["R", "x", "2"]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
   4.0009861975970984`*^9, 4.000986207881235*^9}, {4.0009862414614964`*^9, 
   4.000986261862432*^9}, {4.000986300689509*^9, 4.0009863329791927`*^9}, {
   4.0009863773360567`*^9, 4.000986438309795*^9}, {4.0009865008490143`*^9, 
   4.0009865048550873`*^9}, {4.000986607358177*^9, 4.000986687377171*^9}, {
   4.000986719990896*^9, 4.000986730128098*^9}, {4.000986798657689*^9, 
   4.000986812925366*^9}, 4.000986846192636*^9, {4.000993036548395*^9, 
   4.000993142796315*^9}},ExpressionUUID->"8d721c01-062a-4369-a989-\
c378e8f4faec"],

Cell[TextData[{
 "The index ranges from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"k", "=", "0"}], ",", "1", ",", "\[Ellipsis]", ",", 
    RowBox[{"M", "-", "1"}]}], TraditionalForm]],ExpressionUUID->
  "ad936739-2d5e-44d9-bea8-5f598db5e151"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", ">", "n"}], TraditionalForm]],ExpressionUUID->
  "664a9195-aba8-43d8-aee9-f105b924b0a7"],
 ".  The angles are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Theta]", "k"], "=", 
    RowBox[{"2", "\[Pi]", " ", 
     RowBox[{"k", "/", "M"}]}]}], TraditionalForm]],ExpressionUUID->
  "67f101e2-6bd4-4fdf-8e60-41d663f3c574"],
 " and the widths are again ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "k"], "=", "a"}], TraditionalForm]],
  ExpressionUUID->"4465de20-709a-4fea-9272-41795ff4a3e1"],
 ".  The momenta are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "k"], "=", 
    RowBox[{
     RowBox[{"2", "a", " ", "\[HBar]", " ", 
      SubscriptBox["R", "x"], "sin", " ", 
      SubscriptBox["\[Theta]", "k"]}], "=", 
     RowBox[{"m", " ", "\[Omega]", " ", 
      SubscriptBox["R", "x"], "sin", " ", 
      SubscriptBox["\[Theta]", "k"]}]}]}], TraditionalForm]],ExpressionUUID->
  "a41eb817-7c9d-4fc4-80b7-4d89c15e9e10"],
 " and the phases are"
}], "Text",
 CellChangeTimes->{{4.000993157711135*^9, 
  4.000993264601592*^9}},ExpressionUUID->"7772b844-b76d-4cb5-b74a-\
ee1a1ce6ba51"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Gamma]", "k"], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], 
     SubscriptBox["x", "k"], 
     SubscriptBox["p", "k"]}], "=", 
    RowBox[{
     FractionBox["1", "2"], "a", " ", "\[HBar]", " ", 
     SubsuperscriptBox["R", "x", "2"], 
     RowBox[{"sin", "(", 
      RowBox[{"2", 
       SubscriptBox["\[Theta]", "k"]}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
   4.0009861975970984`*^9, 4.000986207881235*^9}, {4.0009862414614964`*^9, 
   4.000986261862432*^9}, {4.000986300689509*^9, 4.0009863329791927`*^9}, {
   4.0009863773360567`*^9, 4.000986438309795*^9}, {4.0009865008490143`*^9, 
   4.0009865048550873`*^9}, {4.000986607358177*^9, 4.000986687377171*^9}, {
   4.000986719990896*^9, 4.000986730128098*^9}, {4.000986798657689*^9, 
   4.000986812925366*^9}, 4.000986846192636*^9, {4.000993036548395*^9, 
   4.000993142796315*^9}, {4.000993271090577*^9, 
   4.000993294570765*^9}},ExpressionUUID->"748a811a-4d3a-4be5-8273-\
452bfbb876eb"],

Cell["The coefficients are", "Text",
 CellChangeTimes->{{4.0009932974930897`*^9, 
  4.0009933000499477`*^9}},ExpressionUUID->"ba4f88eb-6b4c-4cd2-ad6a-\
5608472e6958"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["c", "k"], "=", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", "n", " ", 
      SubscriptBox["\[Theta]", "k"]}]], "=", 
    RowBox[{
     RowBox[{"cos", "(", 
      RowBox[{"n", " ", 
       SubscriptBox["\[Theta]", "k"]}], ")"}], "-", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"sin", "(", 
       RowBox[{"n", " ", 
        SubscriptBox["\[Theta]", "k"]}], ")"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
   4.0009861975970984`*^9, 4.000986207881235*^9}, {4.0009862414614964`*^9, 
   4.000986261862432*^9}, {4.000986300689509*^9, 4.0009863329791927`*^9}, {
   4.0009863773360567`*^9, 4.000986438309795*^9}, {4.0009865008490143`*^9, 
   4.0009865048550873`*^9}, {4.000986607358177*^9, 4.000986687377171*^9}, {
   4.000986719990896*^9, 4.000986730128098*^9}, {4.000986798657689*^9, 
   4.000986812925366*^9}, 4.000986846192636*^9, {4.000993036548395*^9, 
   4.000993142796315*^9}, {4.000993308358486*^9, 
