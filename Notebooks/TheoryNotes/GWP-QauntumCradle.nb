Cell["which recovers the final result", "Text",
 CellChangeTimes->{{4.000982487646699*^9, 
  4.0009825028200207`*^9}},ExpressionUUID->"9e9ea016-9311-4946-8ca5-\
84223595a31b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[{"x", 
     SubscriptBox["\[Beta]", "k"]},
    "BraKet"], "=", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "4"]}], 
      SuperscriptBox["R", "2"]}]], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"m", "=", "0"}], "\[Infinity]"], " ", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["R", 
         SqrtBox["2"]], ")"}], "m"], 
      FractionBox["1", 
       SqrtBox[
        RowBox[{"m", "!"}]]], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", "m", " ", 
        SubscriptBox["\[Theta]", "k"]}]], 
      RowBox[{
       SubscriptBox["\[Psi]", "m"], "(", "x", ")"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
   4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
