     SubscriptBox["N", "states"]], 
    RowBox[{
     SubscriptBox["c", "i"], 
     RowBox[{
      SubscriptBox["g", "i"], "(", "x", ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
