Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"g", "(", 
    RowBox[{
     RowBox[{"x", ";", 
      SubscriptBox["x", "0"]}], ",", "0"}], ")"}], "=", 
   RowBox[{
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "4"]}], 
      SubsuperscriptBox["x", "0", "2"]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"n", "=", "0"}], "\[Infinity]"], 
      RowBox[{
       FractionBox[
        SubsuperscriptBox["x", "0", "n"], 
        SqrtBox[
         RowBox[{
          SuperscriptBox["2", "n"], 
          RowBox[{"n", "!"}]}]]], 
       FractionBox["1", 
        RowBox[{
         SuperscriptBox["\[Pi]", 
          RowBox[{"1", "/", "4"}]], 
         SqrtBox[
          RowBox[{
           SuperscriptBox["2", "n"], 
           RowBox[{"n", "!"}]}]]}]], 
       RowBox[{
        SubscriptBox["H", "n"], "(", "x", ")"}], 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"-", 
         FractionBox[
          SuperscriptBox["x", "2"], "2"]}]]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
  4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
  4.000921220003305*^9}, {4.000922277291098*^9, 4.000922458607655*^9}, {
  4.000922562343156*^9, 4.000922616112686*^9}, {4.000922784994224*^9, 
  4.000922831512233*^9}, {4.000922876210958*^9, 4.0009228968980227`*^9}, {
  4.0009231117313757`*^9, 
  4.000923112129506*^9}},ExpressionUUID->"8743235b-e766-42f4-8df3-\
ee4a497223e7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"g", "(", 
    RowBox[{
     RowBox[{"x", ";", 
      SubscriptBox["x", "0"]}], ",", "0"}], ")"}], "=", 
   RowBox[{
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "4"]}], 
      SubsuperscriptBox["x", "0", "2"]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"n", "=", "0"}], "\[Infinity]"], 
      RowBox[{
       FractionBox[
        SubsuperscriptBox["x", "0", "n"], 
        SqrtBox[
         RowBox[{
          SuperscriptBox["2", "n"], 
          RowBox[{"n", "!"}]}]]], 
       RowBox[{
        SubscriptBox["\[Psi]", "n"], "(", "x", ")"}]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
  4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
  4.000921220003305*^9}, {4.000922277291098*^9, 4.000922458607655*^9}, {
  4.000922562343156*^9, 4.000922616112686*^9}, {4.000922784994224*^9, 
  4.000922831512233*^9}, {4.000922876210958*^9, 4.000922923456134*^9}, {
  4.000923115587049*^9, 
  4.000923115984066*^9}},ExpressionUUID->"da9f9344-5017-4a79-a7cf-\
20479c10e771"],

Cell[TextData[{
 "This reveals that the single GWP is an infinite superposition of all \
harmonic oscillator eigenstates, and that the weight is proportional to ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["x", "0", "n"], TraditionalForm]],ExpressionUUID->
  "cb5d3dc5-d9b8-4a6b-be99-324dd8bc2fe3"],
 "."
}], "Text",
 CellChangeTimes->{{4.0009229940751743`*^9, 4.0009230498807983`*^9}, {
  4.000923325144718*^9, 
  4.000923356110363*^9}},ExpressionUUID->"fac397d8-9ee4-4e98-a8bb-\
fa5d74d36641"],

Cell[TextData[{
 "There is an overall Gaussian prefactor proportional to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", 
      SubsuperscriptBox["x", "0", "2"]}], "/", "4"}]], TraditionalForm]],
  ExpressionUUID->"d1810754-3c22-4f1f-bc4f-85ed31d10e3a"],
 " that depends on the displacement."
}], "Text",
 CellChangeTimes->{{4.0009233593908243`*^9, 
  4.0009234050337753`*^9}},ExpressionUUID->"8117e484-a7c0-402e-8f70-\
9d67b081d5c2"],

Cell["Removing this prefactor gives a pure power series", "Text",
 CellChangeTimes->{{4.000923449014235*^9, 
  4.000923477484065*^9}},ExpressionUUID->"3b1aacf6-44da-4559-9353-\
be27d5f5984b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["g", "~"], "(", 
    RowBox[{
     RowBox[{"x", ";", 
      SubscriptBox["x", "0"]}], ",", "0"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"exp", "(", 
      RowBox[{
       FractionBox["1", "4"], 
       SubsuperscriptBox["x", "0", "2"]}], ")"}], 
     RowBox[{"g", "(", 
      RowBox[{
       RowBox[{"x", ";", 
        SubscriptBox["x", "0"]}], ",", "0"}], ")"}]}], "=", 
    RowBox[{
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"n", "=", "0"}], "\[Infinity]"], 
      RowBox[{
       FractionBox[
        SubsuperscriptBox["x", "0", "n"], 
        SqrtBox[
         RowBox[{
          SuperscriptBox["2", "n"], 
          RowBox[{"n", "!"}]}]]], 
       RowBox[{
        SubscriptBox["\[Psi]", "n"], "(", "x", ")"}]}]}], "=", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Psi]", "0"], "(", "x", ")"}], "+", 
      RowBox[{
       FractionBox[
        SubscriptBox["x", "0"], 
        SqrtBox["2"]], 
       RowBox[{
        SubscriptBox["\[Psi]", "1"], "(", "x", ")"}]}], "+", 
      RowBox[{"\[CenterDot]", "\[CenterDot]", "\[CenterDot]"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
  4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
  4.000921220003305*^9}, {4.000922277291098*^9, 4.000922458607655*^9}, {
  4.000922562343156*^9, 4.000922616112686*^9}, {4.000922784994224*^9, 
  4.000922831512233*^9}, {4.000922876210958*^9, 4.000922923456134*^9}, {
  4.000923115587049*^9, 4.000923115984066*^9}, {4.000923494586967*^9, 
  4.000923521262611*^9}, {4.000923614761239*^9, 
  4.000923645359151*^9}},ExpressionUUID->"a347069d-47dd-4a57-bce5-\
3bacdc3185b7"],

Cell[TextData[{
 "The next step is to take a discrete sum of only a few Gaussians and isolate \
a single term involving ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Psi]", "n"], "(", "x", ")"}], TraditionalForm]],
  ExpressionUUID->"f6075136-9d14-49e2-a086-b603c5c063c3"],
 "."
}], "Text",
 CellChangeTimes->{{4.000923567263212*^9, 4.0009236095443697`*^9}, {
  4.000923651628071*^9, 
  4.000923669350753*^9}},ExpressionUUID->"219cf357-1254-4d01-a024-\
f5cbc30698c1"],

Cell["There are two classic methods:", "Text",
 CellChangeTimes->{{4.000923689049798*^9, 
  4.000923695719842*^9}},ExpressionUUID->"500719c3-2acc-4dfd-b32d-\
07ce714a4377"],

Cell[TextData[{
 "(1) Differentiation/Finite differences on the real line: Take the ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "248ca6c0-8fd2-4bf6-a5d9-e7b6f7705562"],
 "-th derivative with respect to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "e5440d22-c6b4-47ce-9b47-2a3a79ffaaaf"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "0"], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "db197fa0-a6f4-4784-9eb1-4ad4150ad969"],
 "."
}], "Text",
 CellChangeTimes->{{4.00092398095172*^9, 4.0009240284808903`*^9}, {
  4.000924192194268*^9, 
  4.000924194867733*^9}},ExpressionUUID->"cc3c8dee-cdad-4290-b766-\
3c619d7c586a"],

Cell[TextData[{
 "(2) Cauchy contour integration/Discrete fourier transform on a phase-space \
circle: Integrate around a circle in the complex plane ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Beta]", "=", 
    RowBox[{"R", " ", 
     RowBox[{"exp", "(", 
      RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"e377acdc-5f28-468a-9023-753120c873a1"],
 " with phase weight ",
 Cell[BoxData[
  FormBox[
   RowBox[{"exp", "(", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", "n", " ", "\[Theta]"}], ")"}], 
   TraditionalForm]],ExpressionUUID->"2920c6b7-5be6-4822-8360-a1a5d3e30236"],
 ". "
}], "Text",
 CellChangeTimes->{{4.0009240405268908`*^9, 4.00092404196367*^9}, {
  4.000924093924944*^9, 
  4.000924197683055*^9}},ExpressionUUID->"3d692dbd-9acc-466a-bd3f-\
644ec4892cfb"]
}, Closed]],

Cell[CellGroupData[{

Cell["Method 1: Gaussians along the real-axis", "Subsection",
 CellChangeTimes->{{4.000969767413374*^9, 
  4.000969786283066*^9}},ExpressionUUID->"3a7b914c-22b1-463d-b622-\
52a1a49fb0a7"],

Cell[TextData[{
 "Starting with (1) and consider the power series (switching to index ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],ExpressionUUID->
  "78e05f1b-1db2-497e-82bb-35e3b2b86cae"],
 ")"
}], "Text",
 CellChangeTimes->{{4.0009242017552557`*^9, 4.000924206704795*^9}, {
  4.0009243537843533`*^9, 
  4.000924369994883*^9}},ExpressionUUID->"cde86a78-559e-42ea-a99b-\
f88a85b14d55"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["g", "~"], "(", 
    RowBox[{
     RowBox[{"x", ";", 
      SubscriptBox["x", "0"]}], ",", "0"}], ")"}], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"m", "=", "0"}], "\[Infinity]"], 
    RowBox[{
     FractionBox[
      SubsuperscriptBox["x", "0", "m"], 
      SqrtBox[
       RowBox[{
        SuperscriptBox["2", "m"], 
        RowBox[{"m", "!"}]}]]], 
     RowBox[{
      SubscriptBox["\[Psi]", "m"], "(", "x", ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
  4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
  4.000921220003305*^9}, {4.000922277291098*^9, 4.000922458607655*^9}, {
  4.000922562343156*^9, 4.000922616112686*^9}, {4.000922784994224*^9, 
  4.000922831512233*^9}, {4.000922876210958*^9, 4.000922923456134*^9}, {
  4.000923115587049*^9, 4.000923115984066*^9}, {4.000923494586967*^9, 
  4.000923521262611*^9}, {4.000923614761239*^9, 4.000923645359151*^9}, {
  4.0009243857838297`*^9, 
  4.0009243998546543`*^9}},ExpressionUUID->"776ac06b-6350-4c8b-9d30-\
f1881213549c"],

Cell[TextData[{
 "and differentiate ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "adcfe870-ebbb-494a-a2ee-b1058e83c936"],
 " times with respect to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "769da1d1-9a28-4cef-bec6-0d69d577a1f3"],
 " and evaluate at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "0"], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "65dec1f8-e011-497d-9fb7-5559d160eaf9"],
 "."
}], "Text",
 CellChangeTimes->{{4.000924416678145*^9, 
  4.000924447801227*^9}},ExpressionUUID->"d1529d38-eb55-4e1f-be0c-\
2980c1eafda0"],

Cell[TextData[{
 "Every term with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "<", "n"}], TraditionalForm]],ExpressionUUID->
  "85d6a50c-e4cf-4ca1-9354-d80a4fb35b73"],
 " differentiates to zero, i.e., ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[DifferentialD]", 
      SubscriptBox["x", "0"], "n"], 
     SubsuperscriptBox["x", "0", "m"]}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"3850ec14-7cae-4cca-a22f-3aaa86223b72"],
 "."
}], "Text",
 CellChangeTimes->{{4.000924474164288*^9, 
  4.00092454617548*^9}},ExpressionUUID->"b61a10ce-4cd5-4f2c-b49e-\
39f7c6cf8c0b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox[
     SuperscriptBox["\[DifferentialD]", "n"], 
     RowBox[{"\[DifferentialD]", 
      SubsuperscriptBox["x", "0", "n"]}]], 
    SubsuperscriptBox["x", "0", "m"]}], "=", "0"}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
  4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
  4.000921220003305*^9}, {4.000922277291098*^9, 4.000922458607655*^9}, {
  4.000922562343156*^9, 4.000922616112686*^9}, {4.000922784994224*^9, 
  4.000922831512233*^9}, {4.000922876210958*^9, 4.000922923456134*^9}, {
  4.000923115587049*^9, 4.000923115984066*^9}, {4.000923494586967*^9, 
  4.000923521262611*^9}, {4.000923614761239*^9, 4.000923645359151*^9}, {
  4.0009243857838297`*^9, 4.0009243998546543`*^9}, {4.000924678019273*^9, 
  4.0009247057902117`*^9}},ExpressionUUID->"b6bb0eef-11af-4378-9e50-\
9113a04f4f19"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "=", "n"}], TraditionalForm]],ExpressionUUID->
  "530a82d6-5a64-4c51-a05b-9bd3ac4316b2"],
 " term differentiates to"
}], "Text",
 CellChangeTimes->{{4.00092456223374*^9, 4.000924675651785*^9}, {
  4.0009247670681267`*^9, 
  4.000924767910137*^9}},ExpressionUUID->"f6aff817-6467-49ed-83c8-\
225b9a8cc754"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox[
     SuperscriptBox["\[DifferentialD]", "n"], 
     RowBox[{"\[DifferentialD]", 
      SubsuperscriptBox["x", "0", "n"]}]], 
    SubsuperscriptBox["x", "0", "n"]}], "=", 
   RowBox[{
    RowBox[{"n", " ", 
     RowBox[{
      FractionBox[
       SuperscriptBox["\[DifferentialD]", 
        RowBox[{"n", "-", "1"}]], 
       RowBox[{"\[DifferentialD]", 
        SubsuperscriptBox["x", "0", 
         RowBox[{"n", "-", "1"}]]}]], 
      SubsuperscriptBox["x", "0", 
       RowBox[{"n", "-", "1"}]]}]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"n", "(", 
       RowBox[{"n", "-", "1"}], ")"}], 
      RowBox[{
       FractionBox[
        SuperscriptBox["\[DifferentialD]", 
         RowBox[{"n", "-", "2"}]], 
        RowBox[{"\[DifferentialD]", 
         SubsuperscriptBox["x", "0", 
          RowBox[{"n", "-", "2"}]]}]], 
       SubsuperscriptBox["x", "0", 
        RowBox[{"n", "-", "2"}]]}]}], "=", 
     RowBox[{
      RowBox[{"\[CenterDot]", "\[CenterDot]", "\[CenterDot]"}], "=", 
      RowBox[{"n", "!"}]}]}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
   4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
   4.000921220003305*^9}, {4.000922277291098*^9, 4.000922458607655*^9}, {
   4.000922562343156*^9, 4.000922616112686*^9}, {4.000922784994224*^9, 
   4.000922831512233*^9}, {4.000922876210958*^9, 4.000922923456134*^9}, {
   4.000923115587049*^9, 4.000923115984066*^9}, {4.000923494586967*^9, 
   4.000923521262611*^9}, {4.000923614761239*^9, 4.000923645359151*^9}, {
   4.0009243857838297`*^9, 4.0009243998546543`*^9}, 4.000924678019273*^9, {
   4.0009247177668047`*^9, 
   4.000924757701231*^9}},ExpressionUUID->"57638547-23c0-40c3-973f-\
959db64f4667"],

Cell["so that the term is ", "Text",
 CellChangeTimes->{{4.0009247794253893`*^9, 
  4.000924796957687*^9}},ExpressionUUID->"aaa5a15a-9211-4c8e-8042-\
af21e7059adb"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SqrtBox[
    FractionBox[
     RowBox[{"n", "!"}], 
     SuperscriptBox["2", "n"]]], 
   RowBox[{
    SubscriptBox["\[Psi]", "n"], "(", "x", ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
   4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
   4.000921220003305*^9}, {4.000922277291098*^9, 4.000922458607655*^9}, {
   4.000922562343156*^9, 4.000922616112686*^9}, {4.000922784994224*^9, 
   4.000922831512233*^9}, {4.000922876210958*^9, 4.000922923456134*^9}, {
   4.000923115587049*^9, 4.000923115984066*^9}, {4.000923494586967*^9, 
   4.000923521262611*^9}, {4.000923614761239*^9, 4.000923645359151*^9}, {
   4.0009243857838297`*^9, 4.0009243998546543`*^9}, 4.000924678019273*^9, {
   4.0009247177668047`*^9, 4.000924757701231*^9}, {4.000924807408105*^9, 
   4.0009248213830643`*^9}},ExpressionUUID->"2a270216-a26a-4f02-98e9-\
e00091653031"],

Cell[TextData[{
 "Every term with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", ">", "n"}], TraditionalForm]],ExpressionUUID->
  "11e13fe9-60c8-4698-a808-a0b116768741"],
 " retains a positive power of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "8fe715cf-9e59-45a2-83eb-4d4fd9a61510"],
 " that vanishes at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "0"], "\[Rule]", "0"}], TraditionalForm]],
  ExpressionUUID->"c665e00f-f8d0-4af0-9ca6-76c8fbff8fea"],
 "."
}], "Text",
 CellChangeTimes->{{4.000924836149929*^9, 4.000924874040965*^9}, {
  4.000925220180689*^9, 
  4.00092522812597*^9}},ExpressionUUID->"3e717d75-2743-4dc9-b014-\
4669deafe364"],

Cell[TextData[{
 "We can approximate the ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "35092d4e-8dc8-4e2d-83dd-b49cb07a50e3"],
 "-th derivative at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "0"], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "b0fc8e98-6ac2-4130-bee0-7545ba366383"],
 " using a central finite-difference stencil of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "+", "1"}], TraditionalForm]],ExpressionUUID->
  "47f15707-573d-49db-ba07-c8ed03d7fe62"],
 " points spaced by a small step ",
 Cell[BoxData[
  FormBox["\[Epsilon]", TraditionalForm]],ExpressionUUID->
  "479d9886-f2d6-4fff-ac77-971c9185691f"]
}], "Text",
 CellChangeTimes->{{4.000925481490612*^9, 
  4.000925572182767*^9}},ExpressionUUID->"1f091d45-f142-465c-9155-\
9def0cbda9da"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["x", "k"], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"k", "-", 
      FractionBox["n", "2"]}], ")"}], "\[Epsilon]"}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
   4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
   4.000921220003305*^9}, {4.000922277291098*^9, 4.000922458607655*^9}, {
   4.000922562343156*^9, 4.000922616112686*^9}, {4.000922784994224*^9, 
   4.000922831512233*^9}, {4.000922876210958*^9, 4.000922923456134*^9}, {
   4.000923115587049*^9, 4.000923115984066*^9}, {4.000923494586967*^9, 
   4.000923521262611*^9}, {4.000923614761239*^9, 4.000923645359151*^9}, {
   4.0009243857838297`*^9, 4.0009243998546543`*^9}, 4.000924678019273*^9, {
   4.0009247177668047`*^9, 4.000924757701231*^9}, {4.000925583618717*^9, 
   4.000925590113758*^9}},ExpressionUUID->"75229895-54d8-4d01-8e1d-\
3429bf96a530"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"k", "=", "0"}], ",", "1", ",", "\[Ellipsis]", ",", "n"}], 
   TraditionalForm]],ExpressionUUID->"65e2801e-1f70-4018-8ebf-ae1e01a43976"],
 " using the standard binomial finite-difference weights multiplied by the \
Gaussian factor"
}], "Text",
