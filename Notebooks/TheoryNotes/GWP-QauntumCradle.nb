   4.000982309600404*^9}},ExpressionUUID->"3459b473-ed54-4117-a2d2-\
45bbcf61bf68"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["x", "k"], "+", 
      RowBox[{"\[ImaginaryI]", " ", 
       SubscriptBox["p", "k"]}]}], ")"}], "m"], "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"R", " ", "cos", " ", 
        SubscriptBox["\[Theta]", "k"]}], "+", 
       RowBox[{"\[ImaginaryI]", " ", "R", " ", "sin", " ", 
        SubscriptBox["\[Theta]", "k"]}]}], ")"}], "m"], "=", 
    RowBox[{
     SuperscriptBox["R", "m"], 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[ImaginaryI]", " ", "m", " ", 
       SubscriptBox["\[Theta]", "k"]}]]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
