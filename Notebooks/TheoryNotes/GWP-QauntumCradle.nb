   RowBox[{"m", "=", 
    RowBox[{"n", "+", "1"}]}], TraditionalForm]],ExpressionUUID->
  "35fc84a2-7a23-466c-9a62-a88686c32fb2"],
 ", the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"n", "+", "1"}], ")"}], TraditionalForm]],ExpressionUUID->
  "e9555252-b17d-4593-8722-e4e1d4e11a87"],
 "-th term vanishes, by symmetry of the points around ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "9b8362c9-c5ef-49b3-aed8-4c82b21b979e"],
 "."
}], "Text",
 CellChangeTimes->{{4.000927597059819*^9, 
  4.0009276760884953`*^9}},ExpressionUUID->"c65adb75-6112-456e-9cd5-\
967d5f8bb9d7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"test", "[", 
    RowBox[{
     RowBox[{"#", "+", "1"}], ",", "#"}], "]"}], "&"}], "/@", 
  RowBox[{"Range", "[", 
   RowBox[{"1", ",", "10"}], "]"}]}]], "Input",
 CellChangeTimes->{{4.000927679744125*^9, 4.000927699148074*^9}},
 CellLabel->
  "In[433]:=",ExpressionUUID->"48d025bc-d1e8-4e66-a317-9d05776c97b3"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "=", 
    RowBox[{"n", "+", "2"}]}], TraditionalForm]],ExpressionUUID->
  "c5ff5669-af55-45e8-b949-0d151473c9b5"],
 ", the first nonzero term is proportional to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Epsilon]", 
    RowBox[{"n", "+", "2"}]], TraditionalForm]],ExpressionUUID->
  "ae04517e-b1a0-42f1-86b2-a44a008698d3"]
}], "Text",
 CellChangeTimes->{{4.000927714824841*^9, 
  4.0009277606531353`*^9}},ExpressionUUID->"8426fe1a-b60e-4615-b110-\
fef08a1d295c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"test", "[", 
    RowBox[{
     RowBox[{"#", "+", "2"}], ",", "#"}], "]"}], "&"}], "/@", 
  RowBox[{"Range", "[", 
   RowBox[{"1", ",", "10"}], "]"}]}]], "Input",
 CellChangeTimes->{{4.000927768906629*^9, 4.000927828675007*^9}},
 CellLabel->
  "In[437]:=",ExpressionUUID->"ea4e2415-445a-49b2-a7cf-845b061dd43c"],

Cell["So we may write", "Text",
 CellChangeTimes->{{4.000927855290173*^9, 
  4.000927857835094*^9}},ExpressionUUID->"6001973c-7b9a-4c3c-b327-\
de247de615b7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Psi]", "stencil"], "(", "x", ")"}], "=", " ", 
   RowBox[{
    SuperscriptBox["\[Epsilon]", "n"], 
    SqrtBox[
     FractionBox[
      RowBox[{"n", "!"}], 
      SuperscriptBox["2", "n"]]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[Psi]", "n"], "(", "x", ")"}], "+", 
      RowBox[{
       RowBox[{"\[ScriptCapitalO]", "(", 
        SuperscriptBox["\[Epsilon]", "2"], ")"}], 
       RowBox[{
        SubscriptBox["\[Psi]", 
         RowBox[{"n", "+", "2"}]], "(", "x", ")"}]}], "+", 
      RowBox[{"\[CenterDot]", "\[CenterDot]", "\[CenterDot]"}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
   4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
   4.000921220003305*^9}, {4.000922277291098*^9, 4.000922458607655*^9}, {
   4.000922562343156*^9, 4.000922616112686*^9}, {4.000922784994224*^9, 
   4.000922831512233*^9}, {4.000922876210958*^9, 4.000922923456134*^9}, {
   4.000923115587049*^9, 4.000923115984066*^9}, {4.000923494586967*^9, 
   4.000923521262611*^9}, {4.000923614761239*^9, 4.000923645359151*^9}, {
   4.0009243857838297`*^9, 4.0009243998546543`*^9}, 4.000924678019273*^9, {
   4.0009247177668047`*^9, 4.000924757701231*^9}, {4.000925583618717*^9, 
   4.000925590113758*^9}, {4.000925649272172*^9, 4.000925658703*^9}, {
   4.000925699394202*^9, 4.0009257228211803`*^9}, {4.0009265273120747`*^9, 
   4.0009266920889378`*^9}, {4.000926786383102*^9, 4.000926813198407*^9}, {
   4.000926852784754*^9, 4.000926956606064*^9}, {4.000927188177497*^9, 
   4.000927198195095*^9}, {4.000927887357052*^9, 4.0009279344139843`*^9}, {
   4.000942570362028*^9, 
   4.000942570884408*^9}},ExpressionUUID->"3674bfc8-c158-4368-af7b-\
a848c5c0e847"],

Cell[TextData[{
 "By normalized ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Psi]", "stencil"], "(", "x", ")"}], TraditionalForm]],
  ExpressionUUID->"76fe8257-18b3-459c-9e3c-b77c832485bf"],
 ", i.e., dividing by the prefactor, we get ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Psi]", "n"], "(", "x", ")"}], TraditionalForm]],
  ExpressionUUID->"4dfe3a65-a10d-45d5-960b-21f305c502f9"],
 " up to a small ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptCapitalO]", "(", 
    SuperscriptBox["\[Epsilon]", "2"], ")"}], TraditionalForm]],
  ExpressionUUID->"f7fe7fe3-fac4-46ab-ab99-a48b3f83cb6f"],
 " admixture of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Psi]", 
     RowBox[{"n", "+", "2"}]], "(", "x", ")"}], TraditionalForm]],
  ExpressionUUID->"10f0ad40-23fb-45c3-b650-44d0e32ef863"],
 "."
}], "Text",
 CellChangeTimes->{{4.000927998630878*^9, 
  4.000928080670887*^9}},ExpressionUUID->"219c5457-92f4-44e3-a9e3-\
c3ffff13fadf"],

Cell["\<\
To better understand the above results one may appeal to the canonical \
central finite difference formula\
\>", "Text",
 CellChangeTimes->{{4.000941091930999*^9, 4.000941157039434*^9}, {
  4.00094163337916*^9, 
  4.000941638435677*^9}},ExpressionUUID->"32cfbcdb-d7d6-4283-a463-\
3829ca304f2f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalDelta]", "\[Epsilon]"], 
    RowBox[{"f", "(", "x", ")"}]}], "=", 
   RowBox[{
    RowBox[{"f", "(", 
     RowBox[{"x", "+", 
      FractionBox["\[Epsilon]", "2"]}], ")"}], "-", 
    RowBox[{"f", "(", 
     RowBox[{"x", "-", 
      FractionBox["\[Epsilon]", "2"]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
   4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
   4.000921220003305*^9}, {4.000922277291098*^9, 4.000922458607655*^9}, {
   4.000922562343156*^9, 4.000922616112686*^9}, {4.000922784994224*^9, 
   4.000922831512233*^9}, {4.000922876210958*^9, 4.000922923456134*^9}, {
   4.000923115587049*^9, 4.000923115984066*^9}, {4.000923494586967*^9, 
   4.000923521262611*^9}, {4.000923614761239*^9, 4.000923645359151*^9}, {
   4.0009243857838297`*^9, 4.0009243998546543`*^9}, 4.000924678019273*^9, {
   4.0009247177668047`*^9, 4.000924757701231*^9}, {4.000925583618717*^9, 
   4.000925590113758*^9}, {4.000925649272172*^9, 4.000925658703*^9}, {
   4.000925699394202*^9, 4.0009257228211803`*^9}, {4.0009265273120747`*^9, 
   4.0009266920889378`*^9}, {4.000926786383102*^9, 4.000926813198407*^9}, {
   4.000926852784754*^9, 4.000926956606064*^9}, {4.0009270689575644`*^9, 
   4.000927071460546*^9}, {4.000927266267354*^9, 4.0009272853666153`*^9}, {
   4.000941166499812*^9, 
   4.0009411850625753`*^9}},ExpressionUUID->"6c1b38b6-3899-40ec-8e67-\
a5e8e8e7a010"],

Cell[TextData[{
 "Applying this to a polynomial of degree m, i.e., ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "m"], TraditionalForm]],ExpressionUUID->
  "5c842ba9-8dd2-48e9-af4a-ef36b453ca8d"],
 ", we would have the leading terms cancel, leaving"
}], "Text",
 CellChangeTimes->{{4.0009412007360487`*^9, 4.000941226794207*^9}, {
  4.0009412705019817`*^9, 
  4.0009412819273252`*^9}},ExpressionUUID->"d9e9dc58-1562-4149-bc6b-\
33a9fa276c48"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalDelta]", "\[Epsilon]"], 
    RowBox[{"f", "(", "x", ")"}]}], "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"x", "+", 
        FractionBox["\[Epsilon]", "2"]}], ")"}], "m"], "-", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"x", "-", 
        FractionBox["\[Epsilon]", "2"]}], ")"}], "m"]}], "=", 
    RowBox[{
     RowBox[{"m", " ", "\[Epsilon]", " ", 
      SuperscriptBox["x", 
       RowBox[{"m", "-", "1"}]]}], "+", 
     RowBox[{"\[ScriptCapitalO]", "(", 
      RowBox[{
       SuperscriptBox["\[Epsilon]", "3"], 
       SuperscriptBox["x", 
        RowBox[{"m", "-", "3"}]]}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
   4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
   4.000921220003305*^9}, {4.000922277291098*^9, 4.000922458607655*^9}, {
   4.000922562343156*^9, 4.000922616112686*^9}, {4.000922784994224*^9, 
   4.000922831512233*^9}, {4.000922876210958*^9, 4.000922923456134*^9}, {
   4.000923115587049*^9, 4.000923115984066*^9}, {4.000923494586967*^9, 
   4.000923521262611*^9}, {4.000923614761239*^9, 4.000923645359151*^9}, {
   4.0009243857838297`*^9, 4.0009243998546543`*^9}, 4.000924678019273*^9, {
   4.0009247177668047`*^9, 4.000924757701231*^9}, {4.000925583618717*^9, 
   4.000925590113758*^9}, {4.000925649272172*^9, 4.000925658703*^9}, {
   4.000925699394202*^9, 4.0009257228211803`*^9}, {4.0009265273120747`*^9, 
   4.0009266920889378`*^9}, {4.000926786383102*^9, 4.000926813198407*^9}, {
   4.000926852784754*^9, 4.000926956606064*^9}, {4.0009270689575644`*^9, 
   4.000927071460546*^9}, {4.000927266267354*^9, 4.0009272853666153`*^9}, {
   4.000941166499812*^9, 4.0009411850625753`*^9}, {4.0009412384383507`*^9, 
   4.00094130724581*^9}},ExpressionUUID->"611e804f-1025-44f0-8ece-\
56b284a75a22"],

Cell[TextData[{
 "where each application of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", "\[Epsilon]"], TraditionalForm]],
  ExpressionUUID->"d6babfee-bb3f-4316-9beb-eb5a5c37f0d2"],
 " lowers the degree of a polynomial by 1 (i.e., just like a derivative)."
}], "Text",
 CellChangeTimes->{{4.000941334156995*^9, 
  4.000941362958396*^9}},ExpressionUUID->"49726b9d-1971-4125-91f5-\
dde1c44318fb"],

Cell[TextData[{
 "Applying the different ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "4504f647-6ed1-4f81-8199-c36446e743a8"],
 " times at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "eb2caf99-72d3-4bb7-aa5d-a8a91a6ca550"],
 ", is "
}], "Text",
 CellChangeTimes->{{4.0009414748388453`*^9, 
  4.000941525313829*^9}},ExpressionUUID->"a1347d19-af92-42c8-9207-\
56442173ecae"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["\[CapitalDelta]", "\[Epsilon]", "n"], 
    RowBox[{"f", "(", "x", ")"}]}], "=", 
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k", "=", "0"}], "n"], 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{"n", "-", "k"}]], 
      RowBox[{"(", GridBox[{
         {"n"},
         {"k"}
        }], ")"}], 
      RowBox[{"f", "(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"k", "-", 
          FractionBox["n", "2"]}], ")"}], "\[Epsilon]"}], ")"}]}]}], "=", 
    "0"}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
   4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
   4.000921220003305*^9}, {4.000922277291098*^9, 4.000922458607655*^9}, {
   4.000922562343156*^9, 4.000922616112686*^9}, {4.000922784994224*^9, 
   4.000922831512233*^9}, {4.000922876210958*^9, 4.000922923456134*^9}, {
   4.000923115587049*^9, 4.000923115984066*^9}, {4.000923494586967*^9, 
   4.000923521262611*^9}, {4.000923614761239*^9, 4.000923645359151*^9}, {
   4.0009243857838297`*^9, 4.0009243998546543`*^9}, 4.000924678019273*^9, {
   4.0009247177668047`*^9, 4.000924757701231*^9}, {4.000925583618717*^9, 
   4.000925590113758*^9}, {4.000925649272172*^9, 4.000925658703*^9}, {
   4.000925699394202*^9, 4.0009257228211803`*^9}, {4.0009265273120747`*^9, 
   4.0009266920889378`*^9}, {4.000926786383102*^9, 4.000926813198407*^9}, {
   4.000926852784754*^9, 4.000926956606064*^9}, {4.0009270689575644`*^9, 
   4.000927071460546*^9}, {4.000927266267354*^9, 4.0009272853666153`*^9}, {
   4.000941166499812*^9, 4.0009411850625753`*^9}, {4.0009412384383507`*^9, 
   4.00094130724581*^9}, {4.00094153539218*^9, 
   4.000941567895465*^9}},ExpressionUUID->"8ea4cdaf-5fa5-41cc-a6a1-\
0ec98808f316"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "x", ")"}], "=", 
    SuperscriptBox["x", "m"]}], TraditionalForm]],ExpressionUUID->
  "fa2ffb31-8723-4b97-a560-4f2b62e958df"],
 "."
}], "Text",
 CellChangeTimes->{{4.000941578928787*^9, 
  4.000941597812854*^9}},ExpressionUUID->"9043a6a4-e0f7-4193-8ea3-\
98f4984c6dc7"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "<", "n"}], TraditionalForm]],ExpressionUUID->
  "7fa9d774-6cc8-4b3f-8931-bad24fda542b"],
 ", and each application lowers the polynomial by 1 degree, then after m \
steps, we would have a constant and then the next step would be identically \
zero.  If ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "=", "n"}], TraditionalForm]],ExpressionUUID->
  "313b03fb-78a9-4d44-9d9b-909efc675fc3"],
 ", and each step brings down the exponent (i.e., first n, then n-1, then \
n-2, and so on down to 1) along with a factor or \[Epsilon] (repeated n \
times), then the remaining constant is n! ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Epsilon]", "n"], TraditionalForm]],ExpressionUUID->
  "13a2c7b2-7c24-4b75-b925-cdd88a341298"],
 ".  If ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "=", 
    RowBox[{"n", "+", "1"}]}], TraditionalForm]],ExpressionUUID->
  "4cf23b61-947a-4872-b0cb-3a2b88f59429"],
 ", the function is odd, i.e., ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", 
    RowBox[{"n", "+", "1"}]], TraditionalForm]],ExpressionUUID->
  "b1fe88c8-50e4-4b95-91ce-c9225c3939dd"],
 ", and since the stencil is symmetric about ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "5ebb992e-7bdb-4166-a850-8c3c0b81a40d"],
 ", the left and right halves cancel by parity."
}], "Text",
 CellChangeTimes->{{4.000941700427615*^9, 4.000941777312709*^9}, {
  4.0009418436627407`*^9, 4.0009419553301764`*^9}, {4.0009422468162413`*^9, 
  4.000942342427202*^9}},ExpressionUUID->"09fbd7c8-a18f-4874-b9f2-\
e4c5edf7cbc6"],

Cell["Summary of this approach (i.e., the real-space stencil):", "Text",
 CellChangeTimes->{{4.000936930044882*^9, 4.000936951404709*^9}, {
  4.0009423541483583`*^9, 
  4.000942356971973*^9}},ExpressionUUID->"fd5a3b96-4d6f-4564-b6de-\
9824b66f8289"],

Cell[TextData[{
 "The nth eigenstate requires a minimum of n+1 Gaussians.  The centers are \
spaced as ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "k"], TraditionalForm]],ExpressionUUID->
  "517c0c9d-b6b9-4307-9949-020b04be13dc"],
 " (see above) with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "k"], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "0c04e6aa-51bb-4bad-a95d-ba24d1fa3351"],
 ".  The phases ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "k"], TraditionalForm]],ExpressionUUID->
  "e02a7c67-5860-4f47-81ea-7f31d8347446"],
 " are also zero.  The coefficients are ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", "k"], TraditionalForm]],ExpressionUUID->
  "0f2a4f8b-ddd7-4120-aac4-5747b3f47960"],
 " (above), and the first error term is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "+", "2"}], TraditionalForm]],ExpressionUUID->
  "fc690613-db4a-4e07-8d05-b15ad2dd4267"],
 ".  "
}], "Text",
 CellChangeTimes->{{4.00093695580329*^9, 4.000937017847184*^9}, {
  4.000937059890279*^9, 4.0009371537011633`*^9}, {4.000942364301486*^9, 
  4.000942370864335*^9}, {4.000942429823374*^9, 
  4.000942438260832*^9}},ExpressionUUID->"12854420-f7d1-49be-a4df-\
2530000e2393"],

Cell["\<\
If we wish to include an incoming additional coherent wavepacket, the \
unnormalized coefficient should be\
\>", "Text",
 CellChangeTimes->{{4.000942444997574*^9, 
  4.000942511676445*^9}},ExpressionUUID->"11205c4f-1dc2-4119-ade6-\
695c1a9003a0"],

Cell[BoxData[
 FormBox[
  RowBox[{" ", 
   RowBox[{
    SuperscriptBox["\[Epsilon]", "n"], 
    SqrtBox[
     FractionBox[
      RowBox[{"n", "!"}], 
      SuperscriptBox["2", "n"]]]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
   4.0009210779772367`*^9, 4.0009211268597927`*^9}, {4.000921182168779*^9, 
   4.000921220003305*^9}, {4.000922277291098*^9, 4.000922458607655*^9}, {
   4.000922562343156*^9, 4.000922616112686*^9}, {4.000922784994224*^9, 
   4.000922831512233*^9}, {4.000922876210958*^9, 4.000922923456134*^9}, {
   4.000923115587049*^9, 4.000923115984066*^9}, {4.000923494586967*^9, 
   4.000923521262611*^9}, {4.000923614761239*^9, 4.000923645359151*^9}, {
   4.0009243857838297`*^9, 4.0009243998546543`*^9}, 4.000924678019273*^9, {
   4.0009247177668047`*^9, 4.000924757701231*^9}, {4.000925583618717*^9, 
   4.000925590113758*^9}, {4.000925649272172*^9, 4.000925658703*^9}, {
   4.000925699394202*^9, 4.0009257228211803`*^9}, {4.0009265273120747`*^9, 
   4.0009266920889378`*^9}, {4.000926786383102*^9, 4.000926813198407*^9}, {
   4.000926852784754*^9, 4.000926956606064*^9}, {4.000927188177497*^9, 
   4.000927198195095*^9}, {4.000927887357052*^9, 4.0009279344139843`*^9}, {
   4.0009424085061398`*^9, 4.000942411160686*^9}, {4.0009425855564547`*^9, 
   4.000942585968523*^9}},ExpressionUUID->"c0613ec9-974f-4253-b7bc-\
1990e0c0d520"],

Cell["\<\
This is due to how our code normalizes the multi-component superposition \
state, which is as follows.  The raw state is defined as \
\>", "Text",
 CellChangeTimes->{{4.00094262129883*^9, 4.000942646401442*^9}, {
  4.0009428542233467`*^9, 4.0009428724835167`*^9}, {4.000942926545066*^9, 
  4.000942937380764*^9}},ExpressionUUID->"b99e8f25-5454-4f1e-a47f-\
67fae1411961"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalPsi]", "raw"], "(", "x", ")"}], "=", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
