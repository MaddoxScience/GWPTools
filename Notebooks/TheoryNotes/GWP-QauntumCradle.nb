         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"Pi", "/", "4"}], ",", 
           RowBox[{"Pi", "/", "2"}], ",", 
           RowBox[{"3", " ", 
            RowBox[{"Pi", "/", "4"}]}]}], "}"}]}], "}"}]}], "]"}]}]}], "]"}], 
  ";"}]}], "Input",
