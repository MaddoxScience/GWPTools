   4.0009294435289*^9}},ExpressionUUID->"89a79809-482c-41f1-aedc-\
42424234f2cb"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "k"], "=", 
    RowBox[{
     FractionBox["1", "2"], 
     SubscriptBox["x", "k"], 
     SubscriptBox["p", "k"]}]}], TraditionalForm]],ExpressionUUID->
  "72e781f6-dedb-4023-a2b1-057fe4529e92"],
 " is the phase factor associated with the displacement and"
}], "Text",
 CellChangeTimes->{{4.0009294615494747`*^9, 
  4.00092953250073*^9}},ExpressionUUID->"6792a088-85b9-4bf9-93fc-\
ae71562da938"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Beta]", "k"], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", 
      SqrtBox["2"]], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["x", "k"], "+", 
       RowBox[{"\[ImaginaryI]", " ", 
        SubscriptBox["p", "k"]}]}], ")"}]}], "=", 
    RowBox[{
     FractionBox["1", 
      SqrtBox["2"]], "R", " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[ImaginaryI]", " ", 
       SubscriptBox["\[Theta]", "k"]}]]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.000920963170034*^9, 4.0009210384693937`*^9}, {
