Cell[CellGroupData[{
Cell["Unfinished examples", "Title",
 CellChangeTimes->{{4.0016991609138947`*^9, 
  4.0016991645055723`*^9}},ExpressionUUID->"bd7537fc-cb3b-4c1d-8cf1-\
3d0d672641b5"],

Cell[CellGroupData[{

Cell["Unfinished Interferometry Example", "Section",
 CellChangeTimes->{{4.001514923653892*^9, 4.001514926270195*^9}, {
  4.001515661309003*^9, 4.001515666504324*^9}, {4.001515999620384*^9, 
  4.001516001077066*^9}},ExpressionUUID->"93b6f18a-0578-4684-be7f-\
d079a2dedc7d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"1.", " ", "Curvature", " ", "V2", 
      RowBox[{"(", "t", ")"}]}], ":", 
     RowBox[{"Harmonic", " ", 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}]}]}], "->", 
    RowBox[{
     RowBox[{"Inverted", " ", "Barrier", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "/", "2"}], ")"}], " ", 
      RowBox[{"on", "[", 
       RowBox[{"2", ",", "4"}], "]"}]}], "->", 
     RowBox[{"Harmonic", " ", 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}]}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"v2Interferometer", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Tanh", "[", 
          RowBox[{"4", "*", 
           RowBox[{"(", 
            RowBox[{"t", "-", "2"}], ")"}]}], "]"}], "-", 
         RowBox[{"Tanh", "[", 
          RowBox[{"4", "*", 
           RowBox[{"(", 
            RowBox[{"t", "-", "4"}], ")"}]}], "]"}]}], ")"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "Weak", " ", "Linear", " ", "Tilt", " ", "V1", 
     RowBox[{"(", "t", ")"}], " ", "applied", " ", "ONLY", " ", "while", " ", 
     "the", " ", "arms", " ", "are", " ", "separated", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"around", " ", "t"}], "=", "4.5"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"v1Tilt", "[", "f0_", "]"}], "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"-", "f0"}], "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"t", "-", "4.5"}], ")"}], "^", "2"}]}], "/", 
        RowBox[{"0.8", "^", "2"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Initialize", " ", "First", " ", "Excited", " ", "HO", " ", 
     "State", " ", "Approximation", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Antisymmetric", ":", "\"\<C\>\""}], "->", 
        RowBox[{"-", "1"}]}], ",", 
       RowBox[{"x0", "=", 
        RowBox[{"+", 
         RowBox[{"/", 
          RowBox[{"-", "0.25"}]}]}]}]}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tMin", "=", "0"}], ";", 
    RowBox[{"tMax", "=", "10"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"x0Split", "=", "0.25"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Unperturbed", " ", "Reference", " ", "Interferometer", " ", 
     RowBox[{"(", 
      RowBox[{"f0", "=", "0"}], ")"}], " ", 
     RowBox[{"vs", ".", "Tilted"}], " ", "Interferometer", " ", 
     RowBox[{"(", 
      RowBox[{"f0", "=", "0.35"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"intRef", "=", 
     RowBox[{
      RowBox[{"GWP", "[", "\"\<SS1D\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "2"}], ",", 
         RowBox[{"1", "/", "2"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "x0Split"}], ",", "x0Split"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"\"\<C\>\"", "->", 
        RowBox[{"-", "1"}]}], ",", 
       RowBox[{"\"\<Potential\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Numerical\>\"", ",", 
          RowBox[{"0", "&"}], ",", 
          RowBox[{"v1Tilt", "[", "0.0", "]"}], ",", "v2Interferometer", ",", 
          "tMin", ",", "tMax"}], "}"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"intTilt", "=", 
     RowBox[{
      RowBox[{"GWP", "[", "\"\<SS1D\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "2"}], ",", 
         RowBox[{"1", "/", "2"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "x0Split"}], ",", "x0Split"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"\"\<C\>\"", "->", 
        RowBox[{"-", "1"}]}], ",", 
       RowBox[{"\"\<Potential\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Numerical\>\"", ",", 
          RowBox[{"0", "&"}], ",", 
          RowBox[{"v1Tilt", "[", "0.35", "]"}], ",", "v2Interferometer", ",", 
          "tMin", ",", "tMax"}], "}"}]}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.001514927992312*^9, 4.001514927992449*^9}, 
   4.0015155841319933`*^9, {4.001515812992352*^9, 4.0015158153807297`*^9}},
 CellLabel->
  "In[188]:=",ExpressionUUID->"67a5ef1e-2fa1-4c68-afa3-7becbd74340c"],

