Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Visualize", " ", "the", " ", "bilinear", " ", "mode"}], "-", 
    RowBox[{"coupling", " ", "window", " ", "V11", 
     RowBox[{"(", "t", ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
