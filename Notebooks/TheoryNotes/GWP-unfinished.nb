Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Clear", " ", "memoized", " ", "NDSolve", " ", "trajectories", " ", 
     "before", " ", "re"}], "-", "evaluating"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"GWPClearCache", "[", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Symbolic", " ", "pi"}], "-", 
      RowBox[{
      "swap", " ", "coupling", " ", "formula", " ", "as", " ", "a", " ", 
       "function", " ", "of", " ", "window", " ", "duration", " ", "dt"}]}], "=", 
     RowBox[{"t2", "-", 
      RowBox[{"t1", " ", "and", " ", "ramp", " ", "slope", " ", "s"}]}]}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"kappaSwap", "[", 
      RowBox[{"dt_", ",", "s_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Pi", "/", "dt"}], ")"}], "*", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"1", "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Pi", "/", 
            RowBox[{"(", 
             RowBox[{"2", "*", "dt"}], ")"}]}], ")"}], "^", "2"}]}], "]"}]}], 
      "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"3", "*", 
         RowBox[{"Pi", "^", "3"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"16", "*", "s", "*", 
         RowBox[{"dt", "^", "4"}]}], ")"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Pi", "^", "5"}], "*", 
         RowBox[{"(", 
          RowBox[{"162", "-", 
           RowBox[{"41", "*", "s", "*", "dt"}]}], ")"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"1536", "*", 
         RowBox[{"s", "^", "2"}], "*", 
         RowBox[{"dt", "^", "7"}]}], ")"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", "Parameters", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tMin", "=", 
     RowBox[{"-", "20"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tMax", "=", "70"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"t1", "=", "10"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"t2", "=", "35"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"s", "=", 
     RowBox[{"1", "/", "2"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Gentler", " ", "ramp", " ", "slope", " ", "s"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", "suppresses", " ", "non"}], "-", 
      RowBox[{"adiabatic", " ", "turn"}], "-", 
      RowBox[{"on", " ", "kick"}]}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"v00", "=", 
     RowBox[{"0", "&"}]}], ";", 
    RowBox[{"v10", "=", 
     RowBox[{"0", "&"}]}], ";", 
    RowBox[{"v01", "=", 
     RowBox[{"0", "&"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"v20Func", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], "&"}]}], ";", 
    RowBox[{"v02Func", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], "&"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Exact", " ", "symbolic", " ", "kappaXY", " ", "for", " ", "the", " ", 
     "chosen", " ", 
     RowBox[{"(", 
      RowBox[{"t1", ",", "t2", ",", "s"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kappaXY", "=", 
     RowBox[{"kappaSwap", "[", 
      RowBox[{
       RowBox[{"t2", "-", "t1"}], ",", "s"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"v11Window", "[", "t_", "]"}], ":=", 
     RowBox[{"kappaXY", "*", 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Tanh", "[", 
         RowBox[{"s", "*", 
          RowBox[{"(", 
           RowBox[{"t", "-", "t1"}], ")"}]}], "]"}], "-", 
        RowBox[{"Tanh", "[", 
         RowBox[{"s", "*", 
          RowBox[{"(", 
           RowBox[{"t", "-", "t2"}], ")"}]}], "]"}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Initial", " ", 
      RowBox[{"state", ":", 
       RowBox[{"squeezed", "+", 
        RowBox[{"displaced", " ", "along", " ", "x"}]}]}]}], ",", 
     RowBox[{"ground", " ", "state", " ", "along", " ", "y"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"aMat0", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"r0", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"3", "/", "2"}], ",", "0"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"p0", "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"psi2D", "=", 
     RowBox[{
      RowBox[{"GWP", "[", "\"\<2D\>\"", "]"}], "[", 
      RowBox[{"aMat0", ",", "r0", ",", "p0", ",", "0", ",", 
       RowBox[{"\"\<Potential\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Numerical\>\"", ",", "v00", ",", "v10", ",", "v01", ",",
           "v20Func", ",", "v02Func", ",", "v11Window", ",", "tMin", ",", 
          "tMax", ",", 
          RowBox[{"AccuracyGoal", "->", "12"}], ",", 
          RowBox[{"PrecisionGoal", "->", "12"}]}], "}"}]}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{4.001695814376122*^9, 4.001695814376272*^9}, 
   4.001695875442054*^9, {4.0016960023475103`*^9, 4.001696003094185*^9}, {
