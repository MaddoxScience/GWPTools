Cell[TextData[{
 "and is parameterized  by the shape parameter ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "t"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "70984638-f5f6-4cde-811c-685def7bc566"],
 ", thermal decoherence ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Theta]", "t"], ">", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "23ef762e-6688-4bb2-841a-98779a771677"],
 ", classical phase-space centers ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["x", "t"], ",", 
     SubscriptBox["p", "t"]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3501eeb7-d8b6-4788-ab70-1776f7b6de06"],
 ", and trace-normalization exponent"
}], "Text",
