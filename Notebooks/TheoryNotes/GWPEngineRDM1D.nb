Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Tr", "(", 
    RowBox[{
     OverscriptBox["A", "^"], 
     RowBox[{
      OverscriptBox["\[Rho]", "^"], "(", "t", ")"}]}], ")"}], "=", 
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
    RowBox[{
     UnderscriptBox["lim", 
      RowBox[{
       SuperscriptBox["x", "\[Prime]"], "->", "x"}]], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"A", "(", 
         RowBox[{"x", ",", 
          RowBox[{
           RowBox[{"-", "\[ImaginaryI]\[HBar]"}], 
           SubscriptBox["\[PartialD]", "x"]}]}], ")"}], 
        RowBox[{"\[Rho]", "(", 
         RowBox[{"x", ",", 
          SuperscriptBox["x", "\[Prime]"], ",", "t"}], ")"}]}], ")"}], 
      RowBox[{"\[DifferentialD]", "x"}]}]}]}]}], TraditionalForm]], "Text",
