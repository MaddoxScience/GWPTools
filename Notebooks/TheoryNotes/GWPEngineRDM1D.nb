Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[ScriptCapitalL]", "fric"], "(", "\[Rho]", ")"}], "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      RowBox[{
       SubscriptBox["\[Gamma]", "d"], "(", "t", ")"}], "2"]}], 
    RowBox[{"(", 
     RowBox[{"x", "-", 
      SuperscriptBox["x", "\[Prime]"]}], ")"}], 
