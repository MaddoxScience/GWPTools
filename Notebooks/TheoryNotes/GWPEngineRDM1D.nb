Cell[CellGroupData[{

Cell["Dissipative Harmonic oscillator", "Subsubsection",
 CellChangeTimes->{{4.001091643261496*^9, 
  4.001091649540868*^9}},ExpressionUUID->"ada8e4d4-6908-4a09-9013-\
91623227b819"],

Cell[TextData[{
 "For a damped harmonic oscillator, there are three dynamical regimes based \
on the discriminant ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"4", 
     SuperscriptBox["\[Omega]", "2"]}], "-", 
    SubsuperscriptBox["\[Gamma]", "d", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "49079d7a-a4bf-41e0-a542-f6b3e189f7fb"],
 ":"
}], "Text",
 CellChangeTimes->{{4.001091945624857*^9, 
  4.001092004121496*^9}},ExpressionUUID->"7a80538d-87c3-4946-b26a-\
ee028a686b7c"],

Cell["\<\
It is is helpful to define the initial unperturbed total mechanical energy \
moment\
\>", "Text",
 CellChangeTimes->{{4.001098376156001*^9, 
  4.0010984298747587`*^9}},ExpressionUUID->"18ae86e4-ef57-41ff-9f03-\
49c85182ce88"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[ScriptCapitalE]", "0"], "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox["m", "2"], 
     SuperscriptBox["\[Omega]", "2"], 
     RowBox[{
      SubscriptBox["\[CapitalSigma]", "xx"], "(", "0", ")"}]}], "+", 
    RowBox[{
     SubscriptBox["\[CapitalSigma]", "pp"], "(", "0", ")"}], "+", 
    RowBox[{"m", " ", 
     SubscriptBox["\[Gamma]", "d"], 
     RowBox[{
      SubscriptBox["\[CapitalSigma]", "xp"], "(", "0", ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {4.000421938323202*^9, 
   4.00042195783239*^9}, {4.0004222272255993`*^9, 4.000422355929029*^9}, {
   4.001087951363468*^9, 4.001088000874812*^9}, {4.0010880631173162`*^9, 
   4.001088097510171*^9}, {4.001088621856681*^9, 4.0010886653871727`*^9}, {
