Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[ScriptCapitalP]", "(", "t", ")"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"\[HBar]", "/", "2"}], 
     SqrtBox[
      RowBox[{"det", "(", 
       RowBox[{
        StyleBox["\[CapitalSigma]",
         FontWeight->"Bold"], "(", "t", ")"}], ")"}]]], "=", 
    SqrtBox[
     FractionBox[
      RowBox[{"Re", "(", 
       SubscriptBox["\[Alpha]", "t"], ")"}], 
      RowBox[{
       RowBox[{"Re", "(", 
        SubscriptBox["\[Alpha]", "t"], ")"}], "+", 
       RowBox[{"2", 
        SubscriptBox["\[Theta]", "t"]}]}]]]}]}], TraditionalForm]], "Text",
