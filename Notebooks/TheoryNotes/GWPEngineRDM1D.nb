Cell[CellGroupData[{

Cell["\<\
Equivalence to the Roberson-Schr\[ODoubleDot]dinger Covariance determinant\
\>", "Subsection",
 CellChangeTimes->{{4.0016037349732313`*^9, 
  4.001603780627522*^9}},ExpressionUUID->"1c586078-9fb7-46f8-bf35-\
21092faac1f2"],

Cell[TextData[{
 "In phase space, the purity of any single-mode Gaussian state is determined \
by the determinant of its covariance matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["\[CapitalSigma]",
     FontWeight->"Bold"], "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "41a86980-6111-4128-bb34-80cb62275fe7"],
 "."
}], "Text",
 CellChangeTimes->{{4.001603788725841*^9, 
  4.001603820213255*^9}},ExpressionUUID->"508947d8-a32e-43b8-8554-\
2709251acf93"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"det", "(", 
    RowBox[{
     StyleBox["\[CapitalSigma]",
      FontWeight->"Bold"], "(", "t", ")"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[CapitalSigma]", "xx"], "(", "t", ")"}], 
     RowBox[{
      SubscriptBox["\[CapitalSigma]", "pp"], "(", "t", ")"}]}], "-", 
    SuperscriptBox[
     RowBox[{
      SubscriptBox["\[CapitalSigma]", "xp"], "(", "t", ")"}], "2"]}]}], 
  TraditionalForm]], "Text",
