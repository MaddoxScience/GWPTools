Cell[TextData[{
 "Comparing this directly with the coordinate-space expression for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptCapitalP]", "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "331c20df-dc8f-46b7-bd26-ac782a8cf263"],
 " yields the fundamental Gaussian purity identity"
}], "Text",
 CellChangeTimes->{{4.001603969935844*^9, 
  4.0016040027496033`*^9}},ExpressionUUID->"ee13cc81-b68c-440e-9c64-\
