Cell[CellGroupData[{

Cell["Regime of validity and low-temperature positivity", "Subsubsection",
 CellChangeTimes->{{4.0010960086958733`*^9, 
  4.001096023226902*^9}},ExpressionUUID->"58346b67-c308-4cb0-8406-\
a5ce3627274e"],

Cell[TextData[{
 "Because the standard CL diffusion coefficient is derived in the classical \
high-temperature limit ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      SubscriptBox["k", "B"], "T"}], ">>", 
     RowBox[{"\[HBar]", " ", "\[Omega]"}]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "092dd392-b84d-445d-80e8-8fa605698be3"],
 ", the asymptotic covariance determinant of the damped harmonic oscillator \
approaches"
}], "Text",
 CellChangeTimes->{{4.001096001131577*^9, 
  4.001096087916829*^9}},ExpressionUUID->"f4127709-8b26-4ba2-9739-\
82003831af17"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"det", "(", 
    SubscriptBox[
     StyleBox["\[CapitalSigma]",
      FontWeight->"Bold"], "\[Infinity]"], ")"}], "=", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox[
      RowBox[{
       SubscriptBox["k", "B"], "T"}], "\[Omega]"], ")"}], "2"]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {4.000421938323202*^9, 
