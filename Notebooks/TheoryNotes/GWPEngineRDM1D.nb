Cell[TextData[{
 "The thermal bath noise matrix is obtained by integrating the inhomogeneous \
thermal diffusion term ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["D",
     FontWeight->"Bold",
     FontSlant->"Plain"], "=", 
    RowBox[{"diag", "(", 
     RowBox[{"0", ",", "D"}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "58edeb8b-373c-4f2e-84ab-ec7b5722e1ca"],
 " via the Green\[CloseCurlyQuote]s matrix convolution"
}], "Text",
 CellChangeTimes->{{4.001143759361787*^9, 
  4.001143818020055*^9}},ExpressionUUID->"14490f9f-36e5-4c99-b557-\
d4aa62878717"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox["N",
     FontWeight->"Bold",
     FontSlant->"Plain"], "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Integral]", "0", "t"], 
     RowBox[{
      RowBox[{
       StyleBox["G",
        FontWeight->"Bold",
        FontSlant->"Plain"], "(", 
       RowBox[{"t", "-", 
        SuperscriptBox["t", "\[Prime]"]}], ")"}], 
      StyleBox["D",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      StyleBox[" ",
       FontWeight->"Bold",
       FontSlant->"Plain"], 
      RowBox[{
       SuperscriptBox[
        StyleBox["G",
         FontWeight->"Bold",
         FontSlant->"Plain"], "T"], "(", 
       RowBox[{"t", "-", 
        SuperscriptBox["t", "\[Prime]"]}], ")"}], 
      RowBox[{"\[DifferentialD]", 
       SuperscriptBox["t", "\[Prime]"]}]}]}], "=", 
    RowBox[{"D", 
     RowBox[{
      SubsuperscriptBox["\[Integral]", "0", "t"], 
      RowBox[{
       RowBox[{"(", GridBox[{
          {
           RowBox[{
            SubsuperscriptBox["G", "xp", "2"], "(", "\[Tau]", ")"}], 
           RowBox[{
            RowBox[{
             SubscriptBox["G", "xp"], "(", "\[Tau]", ")"}], 
            RowBox[{
             SubscriptBox["G", "pp"], "(", "\[Tau]", ")"}]}]},
          {
           RowBox[{
            RowBox[{
             SubscriptBox["G", "xp"], "(", "\[Tau]", ")"}], 
            RowBox[{
             SubscriptBox["G", "pp"], "(", "\[Tau]", ")"}]}], 
           RowBox[{
            SubsuperscriptBox["G", "pp", "2"], "(", "\[Tau]", ")"}]}
         }], ")"}], 
       RowBox[{"\[DifferentialD]", "\[Tau]"}]}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {4.000421938323202*^9, 
   4.00042195783239*^9}, {4.0004222272255993`*^9, 4.000422355929029*^9}, {
