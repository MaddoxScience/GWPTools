Cell[CellGroupData[{

Cell["\<\
Derivation of the System Entropy and Instantaneous Entropy Production Rate\
\>", "Subsection",
 CellChangeTimes->{{4.001604064256003*^9, 
  4.001604096297014*^9}},ExpressionUUID->"b0a5ed04-9856-4e49-8a76-\
51d28056066a"],

Cell[TextData[{
 "The thermodynamic R\[EAcute]nyi-2 entropy (which equals the negative \
logarithm of the phase-space purity up to an additive constant) is defined in \
natural units (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["k", "B"], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "26dea4ff-02d6-4f98-a41c-0351de4f5220"],
 ") as:"
}], "Text",
 CellChangeTimes->{{4.001604105677752*^9, 
  4.001604166331622*^9}},ExpressionUUID->"ba71f0b6-aa7d-4454-bb4a-\
88c3fdc92c48"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["S", "sys"], "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "ln"}], " ", 
     RowBox[{"\[ScriptCapitalP]", "(", "t", ")"}]}], "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"ln", "(", 
       RowBox[{
        FractionBox["4", 
         SuperscriptBox["\[HBar]", "2"]], 
        RowBox[{"det", "(", 
         RowBox[{
          StyleBox["\[CapitalSigma]",
           FontWeight->"Bold"], "(", "t", ")"}], ")"}]}], ")"}]}], "=", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"ln", "(", 
       FractionBox[
        RowBox[{
         RowBox[{"Re", "(", 
          SubscriptBox["\[Alpha]", "t"], ")"}], "+", 
         RowBox[{"2", 
          SubscriptBox["\[Theta]", "t"]}]}], 
        RowBox[{"Re", "(", 
         SubscriptBox["\[Alpha]", "t"], ")"}]], ")"}]}]}]}]}], 
  TraditionalForm]], "Text",
