  4.0010874872820673`*^9, 
  4.001087496699915*^9}},ExpressionUUID->"5668f057-6ff4-4d22-a487-\
b2038ab5db1e"],

Cell[TextData[{
 "At ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6fa113c9-560e-40bf-b49d-7b8558c2bfa6"],
 ", the initial shape and decoherence parameters map algebraically to the \
initial variances via"
}], "Text",
 CellChangeTimes->{{4.001087556027369*^9, 
  4.001087588018969*^9}},ExpressionUUID->"106c36f1-ec55-4195-9cc7-\
4fbfbcf9f75e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalSigma]", 
     RowBox[{"x", " ", "x"}]], "(", "0", ")"}], "=", 
   FractionBox["1", 
    RowBox[{"4", 
     RowBox[{"Re", "(", 
      SubscriptBox["\[Alpha]", "0"], ")"}]}]]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {4.001085975497222*^9, 
  4.001085990272448*^9}, {4.0010864091998587`*^9, 4.001086421052217*^9}, {
  4.001086451410576*^9, 4.001086460398189*^9}, {4.0010866389634943`*^9, 
  4.001086675288883*^9}, {4.0010868355772543`*^9, 4.0010868590459013`*^9}, {
  4.001087598484191*^9, 
  4.001087614239464*^9}},ExpressionUUID->"feaafc3a-f4f9-43aa-943f-\
891c1433fddb"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalSigma]", 
     RowBox[{"p", " ", "p"}]], "(", "0", ")"}], "=", 
   RowBox[{
    SuperscriptBox["\[HBar]", "2"], "(", 
    RowBox[{
     RowBox[{"2", 
      SubscriptBox["\[Theta]", "0"]}], "+", 
     RowBox[{"Re", "(", 
      SubscriptBox["\[Alpha]", "0"], ")"}], "+", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"Im", "(", 
        SubscriptBox["\[Alpha]", "0"], ")"}], "2"], 
      RowBox[{"Re", "(", 
       SubscriptBox["\[Alpha]", "0"], ")"}]]}], ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {4.001085975497222*^9, 
  4.001085990272448*^9}, {4.0010864091998587`*^9, 4.001086421052217*^9}, {
  4.001086451410576*^9, 4.001086460398189*^9}, {4.0010866389634943`*^9, 
  4.001086675288883*^9}, {4.00108687901897*^9, 4.0010868931280613`*^9}, {
  4.001087600042344*^9, 
  4.001087648817649*^9}},ExpressionUUID->"5f2ab1ce-7c56-4acd-aabc-\
f516284fc1de"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalSigma]", 
     RowBox[{"x", " ", "p"}]], "(", "0", ")"}], "=", 
   RowBox[{
    FractionBox["\[HBar]", "2"], 
    FractionBox[
     RowBox[{"Im", "(", 
      SubscriptBox["\[Alpha]", "0"], ")"}], 
     RowBox[{"Re", "(", 
      SubscriptBox["\[Alpha]", "0"], ")"}]]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {4.001085975497222*^9, 
  4.001085990272448*^9}, {4.0010864091998587`*^9, 4.001086421052217*^9}, {
  4.001086451410576*^9, 4.001086460398189*^9}, {4.0010866389634943`*^9, 
  4.001086675288883*^9}, {4.001086872322529*^9, 4.00108690304447*^9}, {
  4.0010874872820673`*^9, 4.001087496699915*^9}, {4.001087604639135*^9, 
  4.001087604839764*^9}, {4.001087652812603*^9, 
  4.001087664993834*^9}},ExpressionUUID->"383a04e2-1caa-4eac-bf12-\
f2cdbdd3e46f"],

Cell["\<\
In phase-space coordinates, the Caldeira-Legget master equation transforms \
into the quantum Fokker-Planck (Kramers) equation.  Taking the first and \
second phase-space moments decouples the dynamics into two strictly linear \
ODE systems:\
\>", "Text",
 CellChangeTimes->{{4.0010876801599894`*^9, 
  4.0010877317750607`*^9}},ExpressionUUID->"3b378c1b-5763-494c-b475-\
f0815877c8f9"],

Cell["A damped classical trajectory center", "Text",
 CellChangeTimes->{{4.0010877363122787`*^9, 
  4.001087745190124*^9}},ExpressionUUID->"58973170-10cc-4704-aaf7-\
89869215e357"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    OverscriptBox["x", "."], "t"], "=", 
   FractionBox[
    SubscriptBox["p", "t"], "m"]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {4.001085975497222*^9, 
  4.001085990272448*^9}, {4.0010864091998587`*^9, 4.001086421052217*^9}, {
  4.001086451410576*^9, 4.001086460398189*^9}, {4.0010866389634943`*^9, 
  4.001086675288883*^9}, {4.001086872322529*^9, 4.00108690304447*^9}, {
  4.0010874872820673`*^9, 4.001087496699915*^9}, {4.001087604639135*^9, 
  4.001087604839764*^9}, {4.001087652812603*^9, 4.001087664993834*^9}, {
  4.001087753659935*^9, 
  4.001087764861671*^9}},ExpressionUUID->"dbe70324-78f3-4d14-813a-\
12d118db8a6c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    OverscriptBox["p", "."], "t"], "=", 
   RowBox[{
    RowBox[{"-", 
     SubscriptBox["V", "1"]}], "-", 
    RowBox[{"2", 
     SubscriptBox["V", "2"], 
     SubscriptBox["x", "t"]}], "-", 
    RowBox[{
     SubscriptBox["\[Gamma]", "d"], 
     SubscriptBox["p", "t"]}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {4.001085975497222*^9, 
  4.001085990272448*^9}, {4.0010864091998587`*^9, 4.001086421052217*^9}, {
  4.001086451410576*^9, 4.001086460398189*^9}, {4.0010866389634943`*^9, 
  4.001086675288883*^9}, {4.001086872322529*^9, 4.00108690304447*^9}, {
  4.0010874872820673`*^9, 4.001087496699915*^9}, {4.001087604639135*^9, 
  4.001087604839764*^9}, {4.001087652812603*^9, 4.001087664993834*^9}, {
  4.001087753659935*^9, 
  4.001087788910102*^9}},ExpressionUUID->"777c08d0-91d6-456b-9e78-\
1160c10e362e"],

Cell["and a linear covariance evolution", "Text",
 CellChangeTimes->{{4.0010877925312653`*^9, 
  4.001087801997456*^9}},ExpressionUUID->"fd967623-a535-455c-91b2-\
c5c5c9746a1c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    OverscriptBox["\[CapitalSigma]", "."], "xx"], "=", 
   RowBox[{
    FractionBox["2", "m"], 
    SubscriptBox["\[CapitalSigma]", "xp"]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {4.000421938323202*^9, 
  4.000422049068529*^9}},ExpressionUUID->"791e541c-762d-40d6-99b7-\
beb396df6e75"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    OverscriptBox["\[CapitalSigma]", "."], "pp"], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "4"}], 
     SubscriptBox["V", "2"], 
     SubscriptBox["\[CapitalSigma]", "xp"]}], "-", 
    RowBox[{"2", 
     SubscriptBox["\[Gamma]", "d"], " ", 
     SubscriptBox["\[CapitalSigma]", "pp"]}], "+", 
    RowBox[{"2", "m", " ", 
     SubscriptBox["\[Gamma]", "d"], " ", "k", " ", "T"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {4.000421938323202*^9, 
  4.000422147369232*^9}, {4.001087832344528*^9, 
  4.001087837169798*^9}},ExpressionUUID->"bc557208-7f26-4346-a362-\
18ce034ef54a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    OverscriptBox["\[CapitalSigma]", "."], "xp"], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "m"], 
     SubscriptBox["\[CapitalSigma]", "pp"]}], "-", 
    RowBox[{"2", 
     SubscriptBox["V", "2"], 
     SubscriptBox["\[CapitalSigma]", "xx"]}], "-", 
    RowBox[{
     SubscriptBox["\[Gamma]", "d"], " ", 
     SubscriptBox["\[CapitalSigma]", "xp"]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {4.000421938323202*^9, 
  4.000422108925255*^9}, {4.0010878388852043`*^9, 
  4.001087839184157*^9}},ExpressionUUID->"254eae5a-693a-4a18-a845-\
083b7670f61c"],

Cell[TextData[{
 "Once the covariance elements are evaluated at time ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "526f08d8-f899-43c8-827e-b857af69824d"],
 ", they may be algebraically rearranged to reconstruct the spatial density \
matrix parameters without quadrature:"
}], "Text",
 CellChangeTimes->{{4.001087870113769*^9, 
  4.0010879248475037`*^9}},ExpressionUUID->"5d0fe511-f91c-439e-ba97-\
4f959d61f4ac"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Re", "(", 
    SubscriptBox["\[Alpha]", "t"], ")"}], "=", 
   FractionBox["1", 
    RowBox[{"4", 
     RowBox[{
      SubscriptBox["\[CapitalSigma]", "xx"], "(", "t", ")"}]}]]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {4.000421938323202*^9, 
  4.00042195783239*^9}, {4.0004222272255993`*^9, 4.0004222414761047`*^9}, {
  4.001087938183716*^9, 
  4.001087938859942*^9}},ExpressionUUID->"93048b29-5a4b-42d2-b8dd-\
70559ae8bc03"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Im", "(", 
    SubscriptBox["\[Alpha]", "t"], ")"}], "=", 
   FractionBox[
    RowBox[{
     SubscriptBox["\[CapitalSigma]", "xp"], "(", "t", ")"}], 
    RowBox[{"2", "\[HBar]", " ", 
     RowBox[{
      SubscriptBox["\[CapitalSigma]", "xx"], "(", "t", ")"}]}]]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {4.000421938323202*^9, 
  4.00042195783239*^9}, {4.0004222272255993`*^9, 4.000422266484042*^9}, {
  4.0010879431439257`*^9, 
  4.001087947376378*^9}},ExpressionUUID->"767980df-513c-4b72-bae8-\
131cfa325b9c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Theta]", "t"], "=", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["\[CapitalSigma]", "xx"], "(", "t", ")"}], 
        RowBox[{
         SubscriptBox["\[CapitalSigma]", "pp"], "(", "t", ")"}]}], "-", 
       RowBox[{
        SubsuperscriptBox["\[CapitalSigma]", "xp", "2"], "(", "t", ")"}]}], 
      RowBox[{"2", 
       SuperscriptBox["\[HBar]", "2"], " ", 
       RowBox[{
        SubscriptBox["\[CapitalSigma]", "xx"], "(", "t", ")"}]}]], "-", 
     FractionBox["1", 
      RowBox[{"8", 
       RowBox[{
        SubscriptBox["\[CapitalSigma]", "xx"], "(", "t", ")"}]}]]}], "=", 
    FractionBox[
     RowBox[{
      RowBox[{"det", "(", 
       SubscriptBox[
        StyleBox["\[CapitalSigma]",
         FontWeight->"Bold"], "t"], ")"}], "-", 
      FractionBox[
       SuperscriptBox["\[HBar]", "2"], "4"]}], 
     RowBox[{"2", 
      SuperscriptBox["\[HBar]", "2"], 
      RowBox[{
       SubscriptBox["\[CapitalSigma]", "xx"], "(", "t", ")"}]}]]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {4.000421938323202*^9, 
  4.00042195783239*^9}, {4.0004222272255993`*^9, 4.000422355929029*^9}, {
  4.001087951363468*^9, 
  4.001088000874812*^9}},ExpressionUUID->"157a2190-bfdf-4a61-8be1-\
b380636a4e56"],

Cell[TextData[{
 "where this final form highlights the physical meaning of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "t"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6ca78eee-b3f1-4651-8987-824ecaa18f61"],
 " via the Roberson-Schr\[ODoubleDot]dinger uncertainty relation"
}], "Text",
 CellChangeTimes->{{4.001088016429195*^9, 
  4.0010880539134293`*^9}},ExpressionUUID->"3de267f2-2d85-416a-b533-\
f2bec871bc81"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"det", "(", 
    SubscriptBox[
     StyleBox["\[CapitalSigma]",
      FontWeight->"Bold"], "t"], ")"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[CapitalSigma]", "xx"], 
      SubscriptBox["\[CapitalSigma]", "pp"]}], "-", 
     SubsuperscriptBox["\[CapitalSigma]", "xp", "2"]}], ">=", 
    FractionBox[
     SuperscriptBox["\[HBar]", "2"], "4"]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {4.000421938323202*^9, 
  4.00042195783239*^9}, {4.0004222272255993`*^9, 4.000422355929029*^9}, {
  4.001087951363468*^9, 4.001088000874812*^9}, {4.0010880631173162`*^9, 
  4.001088097510171*^9}},ExpressionUUID->"431e53b9-5656-4cdf-ad88-\
74b688ae98dd"],

Cell[TextData[{
 "For any pure Gaussian state ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Theta]", "t"], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9102169c-cc77-448a-b50f-aef392430c35"],
 ", the generalized uncertainty relation is saturated and the above equality \
is satisfied.  Under dissipative evolution ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Theta]", "t"], ">", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fe3dbdfd-a96d-47c5-abbf-bfb312747588"],
 ", thermal fluctuations inflate the phase-space area and the inequality is \
satisfied.  Likewise, the quantum state purity decays"
}], "Text",
 CellChangeTimes->{{4.0010884874630537`*^9, 
  4.001088613157324*^9}},ExpressionUUID->"65cfd287-1df3-4c2c-9f12-\
9670fee53957"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[ScriptCapitalP]", "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{"Tr", "(", 
     SuperscriptBox[
      OverscriptBox["\[Rho]", "^"], "2"], ")"}], "=", 
    RowBox[{
     FractionBox["\[HBar]", 
      RowBox[{"2", 
       SqrtBox[
        RowBox[{"det", "(", 
         SubscriptBox[
          StyleBox["\[CapitalSigma]",
           FontWeight->"Bold"], "t"], ")"}]]}]], "=", 
     FractionBox["1", 
      SqrtBox[
       RowBox[{"1", "+", 
        FractionBox[
         RowBox[{"2", 
          SubscriptBox["\[Theta]", "t"]}], 
         RowBox[{"Re", "(", 
          SubscriptBox["\[Alpha]", "t"], ")"}]]}]]]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {4.000421938323202*^9, 
  4.00042195783239*^9}, {4.0004222272255993`*^9, 4.000422355929029*^9}, {
  4.001087951363468*^9, 4.001088000874812*^9}, {4.0010880631173162`*^9, 
  4.001088097510171*^9}, {4.001088621856681*^9, 
  4.0010886653871727`*^9}},ExpressionUUID->"0b4976f1-962c-4417-b293-\
9c64451b7d86"],

Cell[CellGroupData[{

Cell["Unitary free particle", "Subsubsection",
 CellChangeTimes->{{4.00108917773746*^9, 
  4.001089215464589*^9}},ExpressionUUID->"621d1ca3-4b43-4200-bb20-\
08b68d8c25f2"],

Cell["\<\
For an isolated free particle, the momentum and moment variance are conserved \
while the position and phase-space covariance grow ballistically.\
\>", "Text",
 CellChangeTimes->{{4.001089341267188*^9, 4.001089370323522*^9}, {
  4.001089879548567*^9, 
  4.001089886587837*^9}},ExpressionUUID->"ff90671f-4c54-491d-9c2f-\
8539191c2e03"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["x", "t"], "=", 
   RowBox[{
    SubscriptBox["x", "0"], "+", 
    RowBox[{
     FractionBox[
      SubscriptBox["p", "0"], "m"], "t"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {4.000421938323202*^9, 
  4.00042195783239*^9}, {4.0004222272255993`*^9, 4.000422355929029*^9}, {
  4.001087951363468*^9, 4.001088000874812*^9}, {4.0010880631173162`*^9, 
  4.001088097510171*^9}, {4.001088621856681*^9, 4.0010886653871727`*^9}, {
  4.001089379522028*^9, 4.001089407124345*^9}, {4.001089460701277*^9, 
  4.001089471364339*^9}},ExpressionUUID->"1dd28124-f68f-4894-8fc7-\
d9b7070fd236"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["p", "t"], "=", 
   SubscriptBox["p", "0"]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {4.000421938323202*^9, 
  4.00042195783239*^9}, {4.0004222272255993`*^9, 4.000422355929029*^9}, {
  4.001087951363468*^9, 4.001088000874812*^9}, {4.0010880631173162`*^9, 
  4.001088097510171*^9}, {4.001088621856681*^9, 4.0010886653871727`*^9}, {
  4.001089379522028*^9, 
  4.001089384806481*^9}},ExpressionUUID->"6cb6971d-b505-491a-9f53-\
f9c25cdfa1cd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalSigma]", "xx"], "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[CapitalSigma]", "xx"], "(", "0", ")"}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{"2", 
       RowBox[{
        SubscriptBox["\[CapitalSigma]", "xp"], "(", "0", ")"}]}], "m"], "t"}],
     "+", 
    RowBox[{
     FractionBox[
      RowBox[{
       SubscriptBox["\[CapitalSigma]", "pp"], "(", "0", ")"}], "m"], 
     SuperscriptBox["t", "2"]}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {4.000421938323202*^9, 
  4.00042195783239*^9}, {4.0004222272255993`*^9, 4.000422355929029*^9}, {
  4.001087951363468*^9, 4.001088000874812*^9}, {4.0010880631173162`*^9, 
  4.001088097510171*^9}, {4.001088621856681*^9, 4.0010886653871727`*^9}, {
  4.001089379522028*^9, 4.001089407124345*^9}, {4.001089485670513*^9, 
  4.0010895335631027`*^9}},ExpressionUUID->"a2cb50c8-f591-4ebc-94fb-\
0e3abd35b354"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalSigma]", "pp"], "(", "t", ")"}], "=", 
   RowBox[{
    SubscriptBox["\[CapitalSigma]", "pp"], "(", "0", ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {4.000421938323202*^9, 
  4.00042195783239*^9}, {4.0004222272255993`*^9, 4.000422355929029*^9}, {
  4.001087951363468*^9, 4.001088000874812*^9}, {4.0010880631173162`*^9, 
