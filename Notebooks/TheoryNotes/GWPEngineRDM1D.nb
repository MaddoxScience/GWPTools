Cell["Next, we integrate both sides", "Text",
 CellChangeTimes->{{4.001587498207387*^9, 
  4.0015875040894003`*^9}},ExpressionUUID->"7f549925-77de-47c8-bbef-\
7a2a1049372a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
    RowBox[{
     FractionBox[
      RowBox[{"\[DifferentialD]", 
       RowBox[{"F", "(", "x", ")"}]}], 
      RowBox[{"\[DifferentialD]", "x"}]], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], "=", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
     RowBox[{
      SubscriptBox[
       RowBox[{"(", 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[PartialD]", "2"], "\[Rho]"}], 
         RowBox[{"\[PartialD]", 
          SuperscriptBox["x", "2"]}]], ")"}], 
       RowBox[{
        SuperscriptBox["x", "\[Prime]"], "=", "x"}]], 
      RowBox[{"\[DifferentialD]", "x"}]}]}], "+", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
     RowBox[{
      SubscriptBox[
       RowBox[{"(", 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[PartialD]", "2"], "\[Rho]"}], 
         RowBox[{
          RowBox[{"\[PartialD]", "x"}], 
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", "\[Prime]"]}]}]], ")"}], 
       RowBox[{
        SuperscriptBox["x", "\[Prime]"], "=", "x"}]], 
      RowBox[{"\[DifferentialD]", "x"}]}]}]}]}], TraditionalForm]], "Text",
