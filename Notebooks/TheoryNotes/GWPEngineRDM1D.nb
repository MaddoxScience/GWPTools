  4.001105281411213*^9}},ExpressionUUID->"0798b5a8-a9bc-4f0f-b131-\
0e7e76cf041a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["x", "t"], "=", 
