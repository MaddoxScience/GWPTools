   4.001096290364564*^9}},ExpressionUUID->"fc369a5a-b5d5-4db1-a446-\
972779415371"],

Cell[TextData[{
 "users can simply pass the quantum-corrected effective thermal energy in for \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["k", "B"], "T"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "edc8fdfb-9367-4926-bb7a-16929bc70e20"]
}], "Text",
 CellChangeTimes->{{4.00109629881419*^9, 
  4.001096323082862*^9}},ExpressionUUID->"0562f6cf-fe4c-46e5-ae80-\
f707a653301a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["k", "B"], "T"}], ")"}], "eff"], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"\[HBar]", " ", "\[Omega]"}], "2"], 
    RowBox[{"coth", "(", 
     FractionBox[
      RowBox[{"\[HBar]", " ", "\[Omega]"}], 
      RowBox[{"2", 
       SubscriptBox["k", "B"], "T"}]], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {4.000421938323202*^9, 
   4.00042195783239*^9}, {4.0004222272255993`*^9, 4.000422355929029*^9}, {
   4.001087951363468*^9, 4.001088000874812*^9}, {4.0010880631173162`*^9, 
   4.001088097510171*^9}, {4.001088621856681*^9, 4.0010886653871727`*^9}, {
   4.001089379522028*^9, 4.001089407124345*^9}, {4.001091166130054*^9, 
   4.0010912129902554`*^9}, 4.001091391261121*^9, {4.001091486974721*^9, 
   4.0010915026822567`*^9}, {4.001095559611475*^9, 4.001095579289102*^9}, {
   4.0010957252885227`*^9, 4.001095806261395*^9}, {4.001095966832601*^9, 
   4.001095974883708*^9}, {4.001096095231681*^9, 4.001096125714559*^9}, {
   4.001096232966847*^9, 4.001096290364564*^9}, {4.0010963325687428`*^9, 
   4.001096352430357*^9}},ExpressionUUID->"b976f66a-0aec-499d-8e7e-\
7afcf38193d0"],

Cell[TextData[{
 "which smoothly interpolates from the zero-point quantum vaccuum limit ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[HBar]\[Omega]", "/", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c285b907-37ec-4076-be40-25d4f88fa749"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", "->", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "774d93d5-6b56-4009-9660-a833f62e3ac4"],
 ", (where the oscillator relaxes to its pure ground states with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Theta]", "\[Infinity]"], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9ba76ed7-2857-40f0-9b2a-8b02e2336d88"],
 ") to the classical equipartition limit ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["k", "B"], "T"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e346ecd2-f0db-45fe-9ec5-1ec3e863c451"],
 " at high temperatures."
}], "Text",
 CellChangeTimes->{{4.0010963549830217`*^9, 
  4.001096418661358*^9}},ExpressionUUID->"c26587db-3893-4325-af3d-\
b1500039b0d6"]
}, Closed]],

