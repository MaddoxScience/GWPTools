c1e06d80865f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalSigma]", "xp"], "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["G", "xx"], "(", "t", ")"}], 
