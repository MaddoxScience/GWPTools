    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[Omega]"}], " ", "t"}]], "(", 
    RowBox[{
     RowBox[{
      SubscriptBox["x", "0"], "(", 
      RowBox[{"1", "+", 
       RowBox[{"\[Omega]", " ", "t"}]}], ")"}], "+", 
     RowBox[{
      FractionBox[
       SubscriptBox["p", "0"], "m"], "t"}]}], ")"}]}], 
  TraditionalForm]], "DisplayFormula",
