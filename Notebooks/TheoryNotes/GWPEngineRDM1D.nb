        RowBox[{"det", "(", 
         RowBox[{
          StyleBox["\[CapitalSigma]",
           FontWeight->"Bold"], "(", "t", ")"}], ")"}]], "-", "1"}], 
      ")"}]}]}]}], TraditionalForm]], "Text",
