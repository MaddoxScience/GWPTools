Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"F", "(", "x", ")"}], "=", 
   SubscriptBox[
    RowBox[{"(", 
     FractionBox[
      RowBox[{"\[PartialD]", 
       RowBox[{"\[Rho]", "(", 
        RowBox[{"x", ",", 
         SuperscriptBox["x", "\[Prime]"], ",", "t"}], ")"}]}], 
      RowBox[{"\[PartialD]", "x"}]], ")"}], 
    RowBox[{
     SuperscriptBox["x", "\[Prime]"], "=", "x"}]]}], TraditionalForm]], "Text",\

