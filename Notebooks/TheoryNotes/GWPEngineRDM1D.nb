Cell[TextData[{
 "Taking the limit ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "\[Prime]"], "->", "x"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2e003009-bd63-4870-9cb4-ece4e5254ce2"],
 ", the second term vanishes, which leaves only the following integral to be \
calculated"
}], "Text",
 CellChangeTimes->{{4.001579459722247*^9, 4.00157947110513*^9}, {
  4.001579776953259*^9, 4.001579793825575*^9}, {4.001579923520124*^9, 
