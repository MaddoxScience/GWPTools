eb47803820c2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["W", "."], "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      OverscriptBox["V", "."], "0"], "(", "t", ")"}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox[
       OverscriptBox["V", "."], "1"], "(", "t", ")"}], 
     SubscriptBox["x", "t"]}], "+", 
