Cell[TextData[{
 "Taking the diagonal limit ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "\[Prime]"], "->", "x"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d215d9cf-4dad-4f66-b3e2-1136f0f09bc7"],
 " makes the last two terms vanish, and the first term integrates to a value \
