   4.001098475356763*^9}},ExpressionUUID->"23e5d9fd-ecdf-4857-aac9-\
efbcd3b4c2fd"],

Cell[TextData[{
 "For the underdamped case ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "d"], "<", 
    RowBox[{"2", "\[Omega]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f0aaa5a7-addd-4181-8306-ed630dbe6536"],
 ", we define a shifted frequency"
}], "Text",
 CellChangeTimes->{{4.001092006823194*^9, 4.0010920389969053`*^9}, {
  4.001095550292396*^9, 
  4.001095551453802*^9}},ExpressionUUID->"bcfc71a3-62a6-4dd4-81c9-\
bb139e9aae2b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Omega]", "1"], "=", 
   SqrtBox[
    RowBox[{
     RowBox[{"4", 
      SuperscriptBox["\[Omega]", "2"]}], "-", 
     SubsuperscriptBox["\[Gamma]", "d", "2"]}]]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
