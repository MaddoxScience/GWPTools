ba4949170437"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["p", "t"], "=", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], 
      SubscriptBox["\[Gamma]", "d"], "t"}]], "(", 
    RowBox[{
     RowBox[{
      SubscriptBox["p", "0"], 
      RowBox[{"cos", "(", 
       FractionBox[
        RowBox[{
         SubscriptBox["\[Omega]", "1"], "t"}], "2"], ")"}]}], "-", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{
         SubscriptBox["\[Gamma]", "d"], 
         SubscriptBox["p", "0"]}], "+", 
