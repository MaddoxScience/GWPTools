Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Rho]", "(", 
    RowBox[{"x", ",", "x", ",", "t"}], ")"}], "=", 
   RowBox[{
    SqrtBox[
     FractionBox[
      RowBox[{"2", 
       RowBox[{"Re", "(", 
        SubscriptBox["\[Alpha]", "t"], ")"}]}], "\[Pi]"]], 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", "2"}], 
      RowBox[{"Re", "(", 
       SubscriptBox["\[Alpha]", "t"], ")"}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"x", "-", 
         SubscriptBox["x", "t"]}], ")"}], "2"]}], ")"}]}]}], 
  TraditionalForm]], "Text",
