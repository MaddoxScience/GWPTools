   4.001095754097608*^9}, {4.001095794558099*^9, 4.001095801545218*^9}, {
   4.001098589012927*^9, 4.001098599545628*^9}, {4.001098699070067*^9, 
   4.001098703737835*^9}, 4.001099602253721*^9, {4.00110488346447*^9, 
   4.001105015222589*^9}},ExpressionUUID->"a857febe-7087-43de-b6f6-\
7d1c637d44f0"],

Cell[TextData[{
 "For the overdamped oscillator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "d"], ">", 
    RowBox[{"2", "\[Omega]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f2586bb5-a5f9-4574-8ba4-c60fa7b15441"],
 " when strong environmental friction dominates the harmonic restoring force, \
the frequency parameter becomes hyperbolic"
}], "Text",
 CellChangeTimes->{{4.001099399952924*^9, 
  4.0010994544843197`*^9}},ExpressionUUID->"04d6b404-ceed-4adb-95c3-\
a66111246974"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Omega]", "1"], "=", 
   SqrtBox[
    RowBox[{
     SubsuperscriptBox["\[Gamma]", "d", "2"], "-", 
     RowBox[{"4", 
      SuperscriptBox["\[Omega]", "2"]}]}]]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {4.000421938323202*^9, 
   4.00042195783239*^9}, {4.0004222272255993`*^9, 4.000422355929029*^9}, {
   4.001087951363468*^9, 4.001088000874812*^9}, {4.0010880631173162`*^9, 
   4.001088097510171*^9}, {4.001088621856681*^9, 4.0010886653871727`*^9}, {
   4.001089379522028*^9, 4.001089407124345*^9}, {4.001091166130054*^9, 
   4.0010912129902554`*^9}, 4.001091391261121*^9, {4.001091486974721*^9, 
   4.0010915026822567`*^9}, {4.001095559611475*^9, 4.001095579289102*^9}, {
   4.001099466811186*^9, 
   4.001099470048809*^9}},ExpressionUUID->"5b1a8d50-2c0e-4776-8356-\
31506871311a"],

Cell[TextData[{
 "Mathematically, this corresponds to analytical continuation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", "1"], "->", 
    RowBox[{"\[ImaginaryI]", " ", 
     SubscriptBox["\[Omega]", "1"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "980747f3-2550-4db2-87bf-569db74efd47"],
 " of the underdamped expressions converting cosines and sines to hyperbolic \
cosines and hyperbolic sines, respectively."
}], "Text",
 CellChangeTimes->{{4.001105040215003*^9, 
  4.001105122779653*^9}},ExpressionUUID->"15e05c40-c175-4d14-a862-\
3e763538df2a"],

Cell["We illustrate this for the phase space center", "Text",
 CellChangeTimes->{{4.001099491766795*^9, 4.001099533267996*^9}, {
  4.001105132442898*^9, 
  4.001105148311995*^9}},ExpressionUUID->"686d7922-7fd5-4f62-968b-\
943b016fe95b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["x", "t"], "=", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], 
      SubscriptBox["\[Gamma]", "d"], "t"}]], "(", 
    RowBox[{
     RowBox[{
      SubscriptBox["x", "0"], 
      RowBox[{"cosh", "(", 
       FractionBox[
        RowBox[{
         SubscriptBox["\[Omega]", "1"], "t"}], "2"], ")"}]}], "+", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"2", 
         SubscriptBox["p", "0"]}], "+", 
        RowBox[{"m", " ", 
         SubscriptBox["\[Gamma]", "d"], 
         SubscriptBox["x", "0"]}]}], 
       RowBox[{"m", " ", 
        SubscriptBox["\[Omega]", "1"]}]], 
      RowBox[{"sinh", "(", 
       FractionBox[
        RowBox[{
         SubscriptBox["\[Omega]", "1"], "t"}], "2"], ")"}]}]}], ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {4.000421938323202*^9, 
   4.00042195783239*^9}, {4.0004222272255993`*^9, 4.000422355929029*^9}, {
