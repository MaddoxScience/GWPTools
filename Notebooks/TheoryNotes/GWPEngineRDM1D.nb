Cell[CellGroupData[{

Cell["Mechanical Power", "Subsubsection",
 CellChangeTimes->{{4.001588944897682*^9, 4.001588947386058*^9}, {
  4.001589013995489*^9, 
  4.001589015519697*^9}},ExpressionUUID->"2b039609-ce00-44b2-96c1-\
a23b8fea73c5"],

Cell["To evaluate the mechanical power, we first evaluate ", "Text",
 CellChangeTimes->{{4.0015437171934958`*^9, 4.0015437209067593`*^9}, {
   4.001543946098946*^9, 4.001543988270955*^9}, {4.001574800945203*^9, 
   4.001574848333954*^9}, {4.00157495971145*^9, 4.0015749670961037`*^9}, 
   4.001575019322322*^9, {4.0015956791045933`*^9, 
   4.001595679732287*^9}},ExpressionUUID->"240fed11-7e4d-4e33-9769-\
aee13e004177"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"\[PartialD]", 
     RowBox[{
      OverscriptBox["H", "^"], "(", "t", ")"}]}], 
    RowBox[{"\[PartialD]", "t"}]], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      RowBox[{"V", "(", 
       RowBox[{
        OverscriptBox["x", "^"], ",", "t"}], ")"}]}], 
     RowBox[{"\[PartialD]", "t"}]], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox[
       OverscriptBox["V", "."], "0"], "(", "t", ")"}], "+", 
     RowBox[{
      RowBox[{
       SubscriptBox[
        OverscriptBox["V", "."], "1"], "(", "t", ")"}], 
      OverscriptBox["x", "^"]}], "+", 
     RowBox[{
      RowBox[{
       SubscriptBox[
        OverscriptBox["V", "."], "2"], "(", "t", ")"}], 
      SuperscriptBox[
       OverscriptBox["x", "^"], "2"]}]}]}]}], TraditionalForm]], "Text",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
   4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
   4.001167030269079*^9}, {4.001168402809308*^9, 4.001168426499454*^9}, {
   4.001195461673896*^9, 4.001195503258028*^9}, {4.001195834433279*^9, 
   4.001195998998259*^9}, {4.0011976314556*^9, 4.00119771342379*^9}, {
   4.001199104101141*^9, 4.001199115942663*^9}, {4.001199321428568*^9, 
   4.001199331465453*^9}, 4.001199392445671*^9, 4.001199467206645*^9, {
   4.001199563032137*^9, 4.001199583014041*^9}, {4.001203465471712*^9, 
   4.0012035255169*^9}, {4.001264251805689*^9, 4.0012642661539392`*^9}, {
   4.0013318278236923`*^9, 4.0013318316543007`*^9}, {4.001331917778775*^9, 
   4.001331919395858*^9}, {4.0014052911153917`*^9, 4.0014053358551207`*^9}, {
   4.001438800761121*^9, 4.001438835485734*^9}, {4.0014441785552053`*^9, 
   4.0014442534145613`*^9}, {4.0014443274979897`*^9, 4.00144434968614*^9}, {
