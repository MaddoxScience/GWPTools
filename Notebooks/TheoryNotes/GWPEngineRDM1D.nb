Notebook[{

Cell[CellGroupData[{
Cell["GWPEngineRDM1D Theory Reference ", "Title",
 CellChangeTimes->{{4.001661701486515*^9, 4.001661702075182*^9}, {
   4.0016617668416967`*^9, 4.0016617702113113`*^9}, 4.00166180780577*^9, {
   4.0016618445306273`*^9, 4.001661855190873*^9}, {4.001662163022293*^9, 
   4.001662164427318*^9}},ExpressionUUID->"4996d736-0148-4180-9e4b-\
19c13f29fc23"],

Cell["Jeremy B. Maddox", "Author",
 CellChangeTimes->{{3.988201532003448*^9, 
  3.988201536787407*^9}},ExpressionUUID->"1d62c94e-a762-409d-997b-\
6696b3d84f5c"],

Cell["\<\
Department of Chemistry and Biochemistry
Western Kentucky University
Bowling Green, KY 42101-1079
Email: jeremy.maddox@wku.edu\
\>", "Affiliation",
 CellChangeTimes->{{3.988201549259402*^9, 
  3.988201579115401*^9}},ExpressionUUID->"bf5f2cba-ea96-42a8-b059-\
068d751a800f"],

Cell[CellGroupData[{

Cell["Theory", "Section",
 CellChangeTimes->{{4.000998324030892*^9, 
  4.000998325097651*^9}},ExpressionUUID->"40ae9b34-1121-41f7-9934-\
1f1111009560"],

Cell["\<\
To evaluate dynamics within dissipative environments, the framework \
propagates the reduced density matrix\
\>", "Text",
 CellChangeTimes->{
  3.999605445579239*^9, {3.999606067993577*^9, 3.99960608079461*^9}, {
   3.9996062836103277`*^9, 3.999606307779269*^9}, 4.000421603601069*^9, 
   4.0010852159753304`*^9},ExpressionUUID->"0455fcec-2f63-4df0-8631-\
eeffbbc1cf94"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Rho]", "(", 
    RowBox[{"x", ",", 
     SuperscriptBox["x", "\[Prime]"], ",", "t"}], ")"}], "=", 
   RowBox[{
    TemplateBox[{"x"},
     "Bra"], 
    OverscriptBox["\[Rho]", "^"], 
    TemplateBox[{
      SuperscriptBox["x", "\[Prime]"]},
     "Ket"]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.9996063195605516`*^9, 
  3.999606459882854*^9}, {4.0004212208123503`*^9, 4.000421228773429*^9}, {
  4.001085226272963*^9, 
  4.001085243190312*^9}},ExpressionUUID->"83d1118f-c97c-4128-9af4-\
21f1e48cdfe2"],

Cell["\<\
rather than a pure state wavefunction.  The RDM1D engine defines the \
continuous, time-dependent generalized Gaussian density matrix ansatz as:\
\>", "Text",
 CellChangeTimes->{4.00108521825773*^9, 
  4.001085257793889*^9},ExpressionUUID->"1fb544fd-92cd-419d-b5d2-\
87a2c8b10e3e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Rho]", "(", 
    RowBox[{"x", ",", 
     SuperscriptBox["x", "\[Prime]"], ",", "t"}], ")"}], "=", 
   RowBox[{"exp", "(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Re", "(", 
        SubscriptBox["\[Alpha]", "t"], ")"}]}], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "-", 
           SubscriptBox["x", "t"]}], ")"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["x", "\[Prime]"], "-", 
           SubscriptBox["x", "t"]}], ")"}], "2"]}], ")"}]}], "+", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"Im", "(", 
       SubscriptBox["\[Alpha]", "t"], ")"}], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "-", 
           SubscriptBox["x", "t"]}], ")"}], "2"], "-", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["x", "\[Prime]"], "-", 
           SubscriptBox["x", "t"]}], ")"}], "2"]}], ")"}]}], "-", 
     SuperscriptBox[
      RowBox[{
       SubscriptBox["\[Theta]", "t"], "(", 
       RowBox[{"x", "-", 
        SuperscriptBox["x", "\[Prime]"]}], ")"}], "2"], "+", 
     RowBox[{
      FractionBox["\[ImaginaryI]", "\[HBar]"], 
      RowBox[{
       SubscriptBox["p", "t"], "(", 
       RowBox[{"x", "-", 
        SuperscriptBox["x", "\[Prime]"]}], ")"}]}], "+", 
     RowBox[{"2", 
      RowBox[{"Re", "(", 
       SubscriptBox["\[Gamma]", "t"], ")"}]}]}], ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.9996063195605516`*^9, 
  3.999606459882854*^9}, {4.0004212208123503`*^9, 
  4.000421228773429*^9}},ExpressionUUID->"9e4d1ecd-4dff-409a-bdd7-\
a135fe9e781f"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "t"], TraditionalForm]],ExpressionUUID->
  "6312e947-dcd1-4919-842c-27e5a3db8bd0"],
 " is the complex-valued shape parameter, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "t"], TraditionalForm]],ExpressionUUID->
  "531f01bf-c8cf-4d2f-bdb2-7bbd68c76d38"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "t"], TraditionalForm]],ExpressionUUID->
  "19b4c672-5c4e-4e12-962f-1127c1956086"],
 " are the classical position and momentum centers, and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "t"], TraditionalForm]],ExpressionUUID->
  "b0062d92-0f83-4167-be4e-a956eee90384"],
 " is the global amplitude maintaining the trace. Setting ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "\[Prime]"], "=", "x"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7c7a037b-e4bd-4059-81d9-266fd560ac6d"],
 " yields the diagonal spatial probability density"
}], "Text",
 CellChangeTimes->{
  3.999606482905965*^9, {3.99960654992815*^9, 3.999606674452158*^9}, {
   4.001085287644743*^9, 4.001085290173908*^9}, {4.001085445586021*^9, 
   4.001085487216172*^9}},ExpressionUUID->"36ce0102-cab1-447e-b41d-\
f110e73fa738"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Rho]", "(", 
    RowBox[{"x", ",", "x", ",", "t"}], ")"}], "=", 
   RowBox[{"exp", "(", 
    RowBox[{
     RowBox[{"-", "2"}], 
     RowBox[{"Re", "(", 
      SubscriptBox["\[Alpha]", "t"], ")"}], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "-", 
          SubscriptBox["x", "t"]}], ")"}], "2"], "+", 
       RowBox[{"2", 
        RowBox[{"Re", "(", 
         SubscriptBox["\[Gamma]", "t"], ")"}]}]}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.9996063195605516`*^9, 
  3.999606459882854*^9}, {4.0004212208123503`*^9, 4.000421228773429*^9}, {
  4.001085489750081*^9, 
  4.001085501838829*^9}},ExpressionUUID->"1a36ca4d-0dbc-40f0-a8b5-\
ff1e65995ed9"],

Cell["\<\
Because the total probability is conserved across open-system evolution, the \
trace condition\
\>", "Text",
 CellChangeTimes->{{4.001085512497684*^9, 
  4.001085532051218*^9}},ExpressionUUID->"bb42d180-51f5-4e00-84ce-\
ebfcf65c0ae3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Tr", "(", 
    OverscriptBox["\[Rho]", "^"], ")"}], "=", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
     RowBox[{
      RowBox[{"\[Rho]", "(", 
       RowBox[{"x", ",", "x", ",", "t"}], ")"}], 
      RowBox[{"\[DifferentialD]", "x"}]}]}], "=", "1"}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.9996063195605516`*^9, 
  3.999606459882854*^9}, {4.0004212208123503`*^9, 4.000421228773429*^9}, {
  4.001085489750081*^9, 4.001085501838829*^9}, {4.001085554217772*^9, 
  4.001085585573547*^9}},ExpressionUUID->"1dd3b12e-079c-422e-85dc-\
2bb31a383930"],

Cell[TextData[{
 "locks ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Re", "(", 
    SubscriptBox["\[Gamma]", "t"], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d314df6a-6104-4ab0-ae56-423f6c6c606d"],
 " directly to the instantaneous spatial width parameter"
}], "Text",
 CellChangeTimes->{{4.001085587671598*^9, 
  4.0010856144511547`*^9}},ExpressionUUID->"86c16047-365a-4ce3-ab6a-\
7f737c2c4cff"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Re", "(", 
    SubscriptBox["\[Gamma]", "t"], ")"}], "=", 
   RowBox[{
    FractionBox["1", "4"], 
    RowBox[{"ln", "(", 
     FractionBox[
      RowBox[{"2", 
       RowBox[{"Re", "(", 
        SubscriptBox["\[Alpha]", "t"], ")"}]}], "\[Pi]"], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.9996063195605516`*^9, 
  3.999606459882854*^9}, {4.0004212208123503`*^9, 4.000421228773429*^9}, {
  4.001085489750081*^9, 4.001085501838829*^9}, {4.001085554217772*^9, 
  4.001085585573547*^9}, {4.0010856262141037`*^9, 
  4.001085656744813*^9}},ExpressionUUID->"b038bc1d-fdce-4ba2-9c7c-\
3844358d78e4"],

Cell[TextData[{
 "Crucially, the ansatz introduces ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Theta]", "t"], ">", "0"}], TraditionalForm]],
  ExpressionUUID->"4cca9a6a-b9dc-47c5-b798-6334dd2317d0"],
 ", the real-valued thermal decoherence parameter. When ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Theta]", "t"], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"fd7dcb4c-b4b0-431c-bf9f-08a2ccacec84"],
 ", the state factors perfectly into a pure state, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[CapitalPsi]", "(", 
     RowBox[{"x", ",", "t"}], ")"}], 
    RowBox[{
     SuperscriptBox["\[CapitalPsi]", "*"], "(", 
     RowBox[{
      SuperscriptBox["x", "\[Prime]"], ",", "t"}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"723e839a-13b9-4a48-be69-ec0d2a814cac"],
 ".  As environmental interactions drive ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Theta]", "t"], ">", "0"}], TraditionalForm]],
  ExpressionUUID->"5bf67843-1951-4a52-be7f-89ec30a20605"],
 ", the off-diagonal elements (",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "!=", 
    SuperscriptBox["x", "\[Prime]"]}], TraditionalForm]],ExpressionUUID->
  "000f29b2-20a9-4052-a536-35af70163456"],
 ") decay exponentially with separation ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[LeftBracketingBar]", 
    RowBox[{"x", " ", "-", 
     SuperscriptBox["x", "\[Prime]"]}], "\[RightBracketingBar]"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f2166f75-d50c-43a0-8fab-7d999d25ebec"],
 ", suppressing quantum interference while leaving the diagonal population \
intact. "
}], "Text",
 CellChangeTimes->{
  4.001085447957882*^9, {4.0010856927846813`*^9, 
   4.00108583355089*^9}},ExpressionUUID->"225472c0-250b-44ec-917e-\
a413de838036"],

Cell[TextData[{
 "To model a system coupled to a thermal reservoir, the framework maps the \
Caldeira-Leggett master equation onto this ansatz. For a particle of mass ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6bbf6bd6-f32e-4ecf-928c-1e709c9bb73f"],
 " moving in a quadratic potential and coupled to a high-temperature Ohmic \
bath with damping (friction) rate ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "d"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8200d7aa-6037-4014-8b8c-5b499ed3b8c2"],
 " and thermal energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["k", "B"], "T"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7d0a3ef6-8d45-4506-a906-4d1a801a57a3"],
 ", the time evolution of the reduced density matrix is governed by:"
}], "Text",
 CellChangeTimes->{
  3.999606300458763*^9, 3.999606495980214*^9, {4.001085853973856*^9, 
   4.0010859679371*^9}},ExpressionUUID->"b9b0c040-b437-488f-9194-\
683b123ff337"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"\[PartialD]", "\[Rho]"}], 
    RowBox[{"\[PartialD]", "t"}]], "=", 
   RowBox[{
    RowBox[{"-", 
     SubscriptBox[
      RowBox[{
       FractionBox["\[ImaginaryI]", "\[HBar]"], "[", 
       RowBox[{
        SubscriptBox[
         OverscriptBox["H", "^"], "0"], ",", "\[Rho]"}], "]"}], 
      RowBox[{"x", ",", 
       SuperscriptBox["x", "\[Prime]"]}]]}], "-", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Gamma]", "d"], "(", 
      RowBox[{"x", "-", 
       SuperscriptBox["x", "\[Prime]"]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        RowBox[{"\[PartialD]", "\[Rho]"}], 
        RowBox[{"\[PartialD]", "x"}]], "-", 
       FractionBox[
        RowBox[{"\[PartialD]", "\[Rho]"}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", "\[Prime]"]}]]}], ")"}]}], "-", 
    RowBox[{
     FractionBox[
      RowBox[{"2", 
       SubscriptBox["m\[Gamma]", "d"], " ", 
       SubscriptBox["k", "B"], " ", "T"}], 
      SuperscriptBox["\[HBar]", "2"]], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"x", "-", 
        SuperscriptBox["x", "\[Prime]"]}], ")"}], "2"], "\[Rho]"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {4.001085975497222*^9, 
  4.001085990272448*^9}},ExpressionUUID->"f40177ee-5d8d-4ca0-b4a5-\
e7a7823ab594"],

Cell["\<\
Each of the three terms on the right-hand side plays a distinct physical \
role.  The first term (the Liouville-von Neumann evolution) drives coherent \
wavepacket dispersion and classical acceleration.  The second term introduces \
dissipative friction (relaxation) that damps the momentum center and extracts \
mechanical energy from the system.  The last term introduced thermal \
decoherence (diffusion), governed by the momentum diffusion constant\
\>", "Text",
 CellChangeTimes->{{4.0010860047673798`*^9, 4.001086129039954*^9}, {
   4.0010863471842613`*^9, 4.0010864027800817`*^9}, 
   4.001086456960114*^9},ExpressionUUID->"443e154c-62cf-4b39-a424-\
2ced4205a1a1"],

Cell[BoxData[
 FormBox[
  RowBox[{"D", "=", 
   RowBox[{"2", 
    SubscriptBox["m\[Gamma]", "d"], 
    SubscriptBox["k", "B"], "T"}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {4.001085975497222*^9, 
  4.001085990272448*^9}, {4.0010864091998587`*^9, 4.001086421052217*^9}, {
  4.001086451410576*^9, 
  4.001086460398189*^9}},ExpressionUUID->"1507b76d-8652-421c-9db8-\
5bd633bff141"],

Cell["\<\
destroys spatial coherence at a rate proportional to temperature and \
coherence separation squared.\
\>", "Text",
 CellChangeTimes->{{4.001086463561854*^9, 
  4.001086521468457*^9}},ExpressionUUID->"4e515cd0-6736-4663-9b9b-\
95a2c2c6f099"],

Cell["\<\
Substituting the spatial ansatz directly into the Caldeira-Legget PDE \
produces a stiff, nonlinearly coupled system of differential equations for \
the GWP parameters.  To achieve closed-form analytical integration and \
numerical stability, the framework maps the spatial parameters onto the \
phase-space covariance matrix:\
\>", "Text",
 CellChangeTimes->{{4.001086542460154*^9, 4.0010866183729258`*^9}, 
   4.001086702863781*^9},ExpressionUUID->"b668bf51-dc07-4c8c-b25f-\
d264547d933b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["\[CapitalSigma]",
     FontWeight->"Bold"], "t"], "=", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{
        SubscriptBox["\[CapitalSigma]", 
         RowBox[{"x", " ", "x"}]], "(", "t", ")"}], 
       RowBox[{
        SubscriptBox["\[CapitalSigma]", 
         RowBox[{"x", " ", "p"}]], "(", "t", ")"}]},
      {
       RowBox[{
        SubscriptBox["\[CapitalSigma]", 
         RowBox[{"x", " ", "p"}]], "(", "t", ")"}], 
       RowBox[{
        SubscriptBox["\[CapitalSigma]", 
         RowBox[{"p", " ", "p"}]], "(", "t", ")"}]}
     }], ")"}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {4.001085975497222*^9, 
  4.001085990272448*^9}, {4.0010864091998587`*^9, 4.001086421052217*^9}, {
  4.001086451410576*^9, 4.001086460398189*^9}, {4.0010866389634943`*^9, 
  4.001086675288883*^9}},ExpressionUUID->"60fda419-01d1-4208-ae0b-\
01f74ce82d9f"],

Cell[TextData[{
 "where the symmetrized second central moments are defined via the \
corresponding Wigner distribution of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "(", 
    RowBox[{"x", ",", 
     SuperscriptBox["x", "\[Prime]"], ",", "t"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "af53bb88-19cc-440d-992d-fda3d0dd97cb"],
 " as"
}], "Text",
 CellChangeTimes->{{4.0010867068436213`*^9, 4.001086710444091*^9}, {
  4.001086803431877*^9, 4.001086818389009*^9}, {4.001087519094811*^9, 
  4.0010875364395523`*^9}},ExpressionUUID->"a38c6ca7-6b7c-4d06-b045-\
4f824c682192"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalSigma]", 
     RowBox[{"x", " ", "x"}]], "(", "t", ")"}], "=", 
   RowBox[{"\[LeftAngleBracket]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       OverscriptBox["x", "^"], "-", 
       SubscriptBox["x", "t"]}], ")"}], "2"], "\[RightAngleBracket]"}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {4.001085975497222*^9, 
  4.001085990272448*^9}, {4.0010864091998587`*^9, 4.001086421052217*^9}, {
  4.001086451410576*^9, 4.001086460398189*^9}, {4.0010866389634943`*^9, 
  4.001086675288883*^9}, {4.0010868355772543`*^9, 
  4.0010868590459013`*^9}},ExpressionUUID->"33b14266-e9e2-4253-85ef-\
98d38d317d4c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalSigma]", 
     RowBox[{"p", " ", "p"}]], "(", "t", ")"}], "=", 
   RowBox[{"\[LeftAngleBracket]", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       OverscriptBox["p", "^"], "-", 
       SubscriptBox["p", "t"]}], ")"}], "2"], "\[RightAngleBracket]"}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {4.001085975497222*^9, 
  4.001085990272448*^9}, {4.0010864091998587`*^9, 4.001086421052217*^9}, {
  4.001086451410576*^9, 4.001086460398189*^9}, {4.0010866389634943`*^9, 
  4.001086675288883*^9}, {4.00108687901897*^9, 
  4.0010868931280613`*^9}},ExpressionUUID->"9fef1193-98ec-4417-9afe-\
72a143174bf4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalSigma]", 
     RowBox[{"x", " ", "p"}]], "(", "t", ")"}], "=", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        OverscriptBox["x", "^"], "-", 
        SubscriptBox["x", "t"]}], ",", 
       RowBox[{
        OverscriptBox["p", "^"], "-", 
        SubscriptBox["p", "t"]}]}], "}"}], "\[RightAngleBracket]"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {4.001085975497222*^9, 
  4.001085990272448*^9}, {4.0010864091998587`*^9, 4.001086421052217*^9}, {
  4.001086451410576*^9, 4.001086460398189*^9}, {4.0010866389634943`*^9, 
