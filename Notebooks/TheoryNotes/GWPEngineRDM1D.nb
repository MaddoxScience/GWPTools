1c312508b0bf"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["p", "t"], "=", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[Omega]"}], " ", "t"}]], "(", 
    RowBox[{
     RowBox[{
      SubscriptBox["p", "0"], "(", 
      RowBox[{"1", "-", 
       RowBox[{"\[Omega]", " ", "t"}]}], ")"}], "-", 
