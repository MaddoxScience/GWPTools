Cell["\<\
Expanding this out yields the three universal scalar covariance equations \
that are valid for all damping regimes:\
\>", "Text",
 CellChangeTimes->{{4.001116150220291*^9, 
  4.001116180428488*^9}},ExpressionUUID->"7f784ea9-6ff1-44d8-9d9e-\
c8971ce50790"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalSigma]", "xx"], "(", "t", ")"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{
      SubscriptBox["k", "B"], "T"}], 
     RowBox[{"m", " ", 
      SuperscriptBox["\[Omega]", "2"]}]], "+", 
    RowBox[{
     RowBox[{
      SubsuperscriptBox["G", "xx", "2"], "(", "t", ")"}], "\[CapitalDelta]", " ", 
     SubscriptBox["\[CapitalSigma]", "xx"]}], "+", 
    RowBox[{"2", 
     RowBox[{
      SubscriptBox["G", "xx"], "(", "t", ")"}], 
     RowBox[{
      SubscriptBox["G", "xp"], "(", "t", ")"}], 
     SubscriptBox["\[CapitalDelta]\[CapitalSigma]", "xp"]}], "+", 
    RowBox[{
     RowBox[{
      SubsuperscriptBox["G", "xp", "2"], "(", "t", ")"}], 
     SubscriptBox["\[CapitalDelta]\[CapitalSigma]", "pp"]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {4.000421938323202*^9, 
