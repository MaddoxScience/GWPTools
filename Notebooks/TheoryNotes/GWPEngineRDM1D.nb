Cell["\<\
The second moments relax toward thermal equilibrium at twice the rate while \
oscillating at the covariance frequency\
\>", "Text",
 CellChangeTimes->{{4.0010986339988937`*^9, 
  4.0010986698591137`*^9}},ExpressionUUID->"43100474-4ab7-4123-8f28-\
150e777468b3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalSigma]", "xx"], "(", "t", ")"}], "=", 
   RowBox[{
    FractionBox["D", 
     RowBox[{"2", 
      SuperscriptBox["m", "2"], 
      SubscriptBox["\[Gamma]", "d"], 
      SuperscriptBox["\[Omega]", "2"]}]], "+", 
    RowBox[{
     FractionBox[
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", 
         SubscriptBox["\[Gamma]", "d"]}], "t"}]], 
      RowBox[{"2", 
       SuperscriptBox["m", "2"], 
       SubscriptBox["\[Gamma]", "d"], 
       SuperscriptBox["\[Omega]", "2"], 
       SubsuperscriptBox["\[Omega]", "1", "2"]}]], 
     RowBox[{"(", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"4", 
        RowBox[{
         SuperscriptBox["\[Omega]", "2"], "(", 
         RowBox[{
          RowBox[{
           SubscriptBox["\[Gamma]", "d"], 
           SubscriptBox["\[ScriptCapitalE]", "0"]}], "-", "D"}], ")"}]}], 
       "\[IndentingNewLine]", "+", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Gamma]", "d"], "(", 
         RowBox[{
          RowBox[{"D", " ", 
           SubscriptBox["\[Gamma]", "d"]}], "-", 
          RowBox[{"4", 
           RowBox[{
            SuperscriptBox["\[Omega]", "2"], "(", 
            RowBox[{
             RowBox[{
              SubscriptBox["\[CapitalSigma]", "pp"], "(", "0", ")"}], "+", 
             RowBox[{
              SubscriptBox["m\[Gamma]", "d"], 
              RowBox[{
               SubscriptBox["\[CapitalSigma]", "xp"], "(", "0", ")"}]}]}], 
            ")"}]}], "-", 
          RowBox[{"2", 
           SuperscriptBox["m", "2"], 
           RowBox[{
            SuperscriptBox["\[Omega]", "2"], "(", 
            RowBox[{
             SubsuperscriptBox["\[Gamma]", "d", "2"], "-", 
             RowBox[{"2", 
              SuperscriptBox["\[Omega]", "2"]}]}], ")"}], 
           RowBox[{
            SubscriptBox["\[CapitalSigma]", "xx"], "(", "0", ")"}]}]}], ")"}], 
        RowBox[{"cos", "(", 
         RowBox[{
          SubscriptBox["\[Omega]", "1"], "t"}], ")"}]}], 
       "\[IndentingNewLine]", "+", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Gamma]", "d"], "(", 
         RowBox[{
          RowBox[{"2", 
           RowBox[{
            SuperscriptBox["m\[Omega]", "2"], "(", 
            RowBox[{
             RowBox[{"2", 
              RowBox[{
               SubscriptBox["\[CapitalSigma]", "xp"], "(", "0", ")"}]}], "+", 
             
             RowBox[{
              SubscriptBox["m\[Gamma]", "d"], 
              RowBox[{
               SubscriptBox["\[CapitalSigma]", "xx"], "(", "0", ")"}]}]}], 
            ")"}]}], "-", "D"}], ")"}], 
        RowBox[{"sin", "(", 
         RowBox[{
          SubscriptBox["\[Omega]", "1"], "t"}], ")"}]}]}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {4.000421938323202*^9, 
