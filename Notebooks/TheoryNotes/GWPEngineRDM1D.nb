Cell[TextData[{
 "from the left on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[Rho]", "."], "(", 
    RowBox[{"x", ",", 
     SuperscriptBox["x", "\[Prime]"], ",", "t"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "363ca4fe-cc75-449f-a5bb-f9ec0eaa703b"],
 ", then we set ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "\[Prime]"], "->", "x"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d50b892a-2bf9-41c6-a6e1-9feab01c32c7"],
 " and integrate over ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8c296c6a-2c39-4988-a9ea-07724076db69"],
 "."
}], "Text",
