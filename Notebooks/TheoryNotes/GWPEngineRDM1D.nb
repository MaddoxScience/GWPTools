Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox[
     RowBox[{"\[CapitalDelta]", 
      StyleBox["\[CapitalSigma]",
       FontWeight->"Bold"]}]], "(", "0", ")"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      StyleBox["\[CapitalSigma]",
       FontWeight->"Bold"], "(", "0", ")"}], "-", 
     RowBox[{
      StyleBox["\[CapitalSigma]",
       FontWeight->"Bold"], "(", "\[Infinity]", ")"}]}], "=", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{
         RowBox[{
          SubscriptBox["\[CapitalSigma]", "xx"], "(", "0", ")"}], "-", 
         FractionBox[
          RowBox[{
           SubscriptBox["k", "B"], "T"}], 
          RowBox[{"m", " ", 
           SuperscriptBox["\[Omega]", "2"]}]]}], 
        RowBox[{
         SubscriptBox["\[CapitalSigma]", "xp"], "(", "0", ")"}]},
       {
        RowBox[{
         SubscriptBox["\[CapitalSigma]", "xp"], "(", "0", ")"}], 
        RowBox[{
         RowBox[{
          SubscriptBox["\[CapitalSigma]", "pp"], "(", "0", ")"}], "-", 
         RowBox[{"m", " ", 
          SubscriptBox["k", "B"], "T"}]}]}
      }], ")"}]}]}], TraditionalForm]], "DisplayFormula",
