Cell[TextData[{
 "and take the diagonal limit ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "\[Prime]"], "->", "x"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b209c0d8-6fe8-4ad8-b812-23e203423694"],
 " and integrate over ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "96289c2a-a0f3-4459-b45e-c4092a5d546a"],
 ", which yields"
}], "Text",
 CellChangeTimes->{{4.001575254476142*^9, 4.00157533544805*^9}, {
  4.0015754412681026`*^9, 
  4.001575464871416*^9}},ExpressionUUID->"c431d6fd-3c54-4b6c-887c-\
33e4fc0afa4e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["W", "."], "(", "t", ")"}], "=", 
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox[
         OverscriptBox["V", "."], "0"], "(", "t", ")"}], "+", 
       RowBox[{
        RowBox[{
         SubscriptBox[
          OverscriptBox["V", "."], "1"], "(", "t", ")"}], "x"}], "+", 
       RowBox[{
        RowBox[{
         SubscriptBox[
          OverscriptBox["V", "."], "2"], "(", "t", ")"}], 
        SuperscriptBox["x", "2"]}]}], ")"}], 
     RowBox[{"\[Rho]", "(", 
      RowBox[{"x", ",", "x", ",", "t"}], ")"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}]}], TraditionalForm]], "Text",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
