Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox[
     SuperscriptBox["\[PartialD]", "2"], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "2"]}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", "-", 
        SuperscriptBox["x", "\[Prime]"]}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{"\[PartialD]", "\[Rho]"}], 
         RowBox[{"\[PartialD]", "x"}]], "-", " ", 
        FractionBox[
         RowBox[{"\[PartialD]", "\[Rho]"}], 
         RowBox[{"\[PartialD]", 
          SuperscriptBox["x", "\[Prime]"]}]]}], ")"}]}], ")"}]}], "=", 
   RowBox[{
    FractionBox["\[PartialD]", 
     RowBox[{"\[PartialD]", "x"}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{"\[PartialD]", "\[Rho]"}], 
         RowBox[{"\[PartialD]", "x"}]], "-", " ", 
        FractionBox[
         RowBox[{"\[PartialD]", "\[Rho]"}], 
         RowBox[{"\[PartialD]", 
          SuperscriptBox["x", "\[Prime]"]}]]}], ")"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x", "-", 
         SuperscriptBox["x", "\[Prime]"]}], ")"}], 
       RowBox[{
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", "x"}]], 
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{"\[PartialD]", "\[Rho]"}], 
           RowBox[{"\[PartialD]", "x"}]], "-", " ", 
          FractionBox[
           RowBox[{"\[PartialD]", "\[Rho]"}], 
           RowBox[{"\[PartialD]", 
            SuperscriptBox["x", "\[Prime]"]}]]}], ")"}]}]}]}], ")"}]}]}], 
  TraditionalForm]], "Text",
