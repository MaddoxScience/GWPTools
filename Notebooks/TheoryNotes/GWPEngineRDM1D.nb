   4.0015750140664473`*^9}},ExpressionUUID->"3c2433ef-dd70-46af-a4f6-\
99bd7e862da8"],

Cell["\<\
Then, applying the trace rules above, we form the matrix element\
\>", "Text",
 CellChangeTimes->{{4.0015751224087067`*^9, 4.001575192337137*^9}, {
  4.001595682846302*^9, 
  4.001595696706674*^9}},ExpressionUUID->"c4b7c7f6-65d0-4b1d-ad8d-\
bf8b494a3bd8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{"x"},
     "Bra"], 
    FractionBox[
     RowBox[{"\[PartialD]", 
      RowBox[{
       OverscriptBox["H", "^"], "(", "t", ")"}]}], 
     RowBox[{"\[PartialD]", "t"}]], 
    RowBox[{
     OverscriptBox["\[Rho]", "^"], "(", "t", ")"}], 
    TemplateBox[{
      SuperscriptBox["x", "\[Prime]"]},
     "Ket"]}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox[
        OverscriptBox["V", "."], "0"], "(", "t", ")"}], "+", 
      RowBox[{
       RowBox[{
        SubscriptBox[
         OverscriptBox["V", "."], "1"], "(", "t", ")"}], "x"}], "+", 
      RowBox[{
       RowBox[{
        SubscriptBox[
         OverscriptBox["V", "."], "2"], "(", "t", ")"}], 
       SuperscriptBox["x", "2"]}]}], ")"}], 
    RowBox[{"\[Rho]", "(", 
     RowBox[{"x", ",", 
      SuperscriptBox["x", "\[Prime]"], ",", "t"}], ")"}]}]}], 
  TraditionalForm]], "Text",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
   4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
