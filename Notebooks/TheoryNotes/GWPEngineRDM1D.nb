Cell[CellGroupData[{

Cell["Heat Bath Flux", "Subsubsection",
 CellChangeTimes->{{4.001589005421727*^9, 
  4.001589010093165*^9}},ExpressionUUID->"0059d757-7857-4f78-a7f4-\
abd8b137ca15"],

Cell["\<\
To evaluate the heat bath flux, we use the Caldeira-Leggett master equation\
\>", "Text",
 CellChangeTimes->{{4.001575695335228*^9, 
  4.0015757283995934`*^9}},ExpressionUUID->"9ff1f26d-9974-4722-9be6-\
753049cbbec5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["\[Rho]", "."], "(", 
    RowBox[{"x", ",", 
     SuperscriptBox["x", "\[Prime]"], ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[ScriptCapitalL]", "U"], "(", "\[Rho]", ")"}], "+", 
    RowBox[{
     SubscriptBox["\[ScriptCapitalL]", "fric"], "(", "\[Rho]", ")"}], "+", 
    RowBox[{
     SubscriptBox["\[ScriptCapitalL]", "diff"], "(", "\[Rho]", ")"}]}]}], 
  TraditionalForm]], "Text",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
   4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
   4.001167030269079*^9}, {4.001168402809308*^9, 4.001168426499454*^9}, {
   4.001195461673896*^9, 4.001195503258028*^9}, {4.001195834433279*^9, 
   4.001195998998259*^9}, {4.0011976314556*^9, 4.00119771342379*^9}, {
