a92684d90293"],

Cell[TextData[{
 "coupled to a non-stationary Ohmic thermal bath with time-dependent damping \
coefficient ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "d"], "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c600fec6-0eee-4e15-bcf7-a71b12c49cad"],
 " and thermal energy ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["k", "B"], 
    RowBox[{"T", "(", "t", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "10f3323c-2168-4e03-970c-348ca6219d62"],
 ".  "
}], "Text",
 CellChangeTimes->{{4.0015908421681547`*^9, 4.001590909748953*^9}, {
  4.0015945429269953`*^9, 
  4.00159455304641*^9}},ExpressionUUID->"c85dca03-0b50-429f-8085-\
6402006dd324"],

Cell[TextData[{
 "For any quantum observable ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["A", "^"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7fa603e0-acaa-497d-8754-bfe7e01159c2"],
 ", its expectation value is given by the operator trace"
}], "Text",
 CellChangeTimes->{
  4.001594555045988*^9},ExpressionUUID->"113c6f33-4189-4bda-a0af-\
8e31fc3c1397"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[LeftAngleBracket]", 
    OverscriptBox["A", "^"], "\[RightAngleBracket]"}], "=", 
   RowBox[{
    RowBox[{"Tr", "(", 
     RowBox[{
      OverscriptBox["A", "^"], 
      OverscriptBox["\[Rho]", "^"]}], ")"}], "=", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
     RowBox[{
      TemplateBox[{"x"},
       "Bra"], 
      OverscriptBox["A", "^"], 
      RowBox[{
       OverscriptBox["\[Rho]", "^"], "(", "t", ")"}], 
      TemplateBox[{"x"},
       "Ket"], 
      RowBox[{"\[DifferentialD]", "x"}]}]}]}]}], TraditionalForm]], "Text",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
   4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
