   4.001095579289102*^9}},ExpressionUUID->"b0e7b038-77ea-4d71-b4de-\
c77ed2ce7150"],

Cell["\<\
The classical position and momentum centers oscillate at half the covariance \
frequency beneath an exponential damping envelope\
\>", "Text",
 CellChangeTimes->{{4.0010956015090322`*^9, 4.001095649311544*^9}, {
  4.001095683506925*^9, 4.001095684408771*^9}, {4.001098527663845*^9, 
  4.0010985785609503`*^9}},ExpressionUUID->"0a548173-ae6b-40fe-9f95-\
9ab250198ffd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["x", "t"], "=", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], 
      SubscriptBox["\[Gamma]", "d"], "t"}]], "(", 
    RowBox[{
     RowBox[{
      SubscriptBox["x", "0"], 
      RowBox[{"cos", "(", 
       FractionBox[
        RowBox[{
         SubscriptBox["\[Omega]", "1"], "t"}], "2"], ")"}]}], "+", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"2", 
         SubscriptBox["p", "0"]}], "+", 
        RowBox[{"m", " ", 
         SubscriptBox["\[Gamma]", "d"], 
         SubscriptBox["x", "0"]}]}], 
       RowBox[{"m", " ", 
        SubscriptBox["\[Omega]", "1"]}]], 
      RowBox[{"sin", "(", 
       FractionBox[
        RowBox[{
         SubscriptBox["\[Omega]", "1"], "t"}], "2"], ")"}]}]}], ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {4.000421938323202*^9, 
   4.00042195783239*^9}, {4.0004222272255993`*^9, 4.000422355929029*^9}, {
   4.001087951363468*^9, 4.001088000874812*^9}, {4.0010880631173162`*^9, 
   4.001088097510171*^9}, {4.001088621856681*^9, 4.0010886653871727`*^9}, {
   4.001089379522028*^9, 4.001089407124345*^9}, {4.001091166130054*^9, 
   4.0010912129902554`*^9}, 4.001091391261121*^9, {4.001091486974721*^9, 
