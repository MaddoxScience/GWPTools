Cell[TextData[{
 "Because ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[Rho]", "^"], "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f6269a52-288a-4e4c-9382-a2cb9ef3af6e"],
 " is Hermitian, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Rho]", "(", 
     RowBox[{
      SuperscriptBox["x", "\[Prime]"], ",", "x", ",", "t"}], ")"}], "=", 
    RowBox[{
     SuperscriptBox["\[Rho]", "*"], "(", 
     RowBox[{"x", ",", 
      SuperscriptBox["x", "\[Prime]"], ",", "t"}], ")"}]}], TraditionalForm]],
  
  FormatType->TraditionalForm,ExpressionUUID->
  "b5e1c07d-1d86-4ae9-bd8c-c24e94dcecd8"],
 ", meaning the integrand is simply the squared modulus ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    RowBox[{"\[Rho]", "(", 
     RowBox[{"x", ",", 
      SuperscriptBox["x", "\[Prime]"], ",", "t"}], ")"}], 
    SuperscriptBox["|", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "74292c91-cd58-4c4d-b100-b81314b639a2"],
 ".  Substituting the Gaussian ansatz with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[CapitalDelta]", " ", "x"}], "=", 
    RowBox[{"x", "-", 
     SubscriptBox["x", "t"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d4ad0926-b241-4d2f-95e3-4744ff45faff"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[CapitalDelta]", " ", 
     SuperscriptBox["x", "\[Prime]"]}], "=", 
    RowBox[{
     SuperscriptBox["x", "\[Prime]"], "-", 
     SubscriptBox["x", "t"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "629ed2af-e2a2-4d09-b55b-a84a7d64583f"]
}], "Text",
 CellChangeTimes->{{4.001602630811558*^9, 
  4.001602753003852*^9}},ExpressionUUID->"10b52b6f-46ad-442b-a8eb-\
888caed4e24a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Rho]", "(", 
    RowBox[{"x", ",", 
     SuperscriptBox["x", "\[Prime]"], ",", "t"}], ")"}], "=", 
   RowBox[{
    SqrtBox[
     FractionBox[
      RowBox[{"2", 
       RowBox[{"Re", "(", 
        SubscriptBox["\[Alpha]", "t"], ")"}]}], "\[Pi]"]], 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Re", "(", 
         SubscriptBox["\[Alpha]", "t"], ")"}]}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[CapitalDelta]", " ", 
          SuperscriptBox["x", "2"]}], "+", 
         RowBox[{"\[CapitalDelta]", " ", 
          SuperscriptBox["x", "\[Prime]2"]}]}], ")"}]}], "+", 
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{"Im", "(", 
        SubscriptBox["\[Alpha]", "t"], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[CapitalDelta]", " ", 
          SuperscriptBox["x", "2"]}], "-", 
         RowBox[{"\[CapitalDelta]", " ", 
          SuperscriptBox["x", "\[Prime]2"]}]}], ")"}]}], "+", 
      RowBox[{
       FractionBox["\[ImaginaryI]", "\[HBar]"], 
       RowBox[{
        SubscriptBox["p", "t"], "(", 
        RowBox[{
         RowBox[{"\[CapitalDelta]", " ", "x"}], "-", 
         RowBox[{"\[CapitalDelta]", " ", 
          SuperscriptBox["x", "\[Prime]"]}]}], ")"}]}], "-", 
      SuperscriptBox[
       RowBox[{"\[Theta]", "(", 
        RowBox[{
         RowBox[{"\[CapitalDelta]", " ", "x"}], "-", 
         RowBox[{"\[CapitalDelta]", " ", 
          SuperscriptBox["x", "\[Prime]"]}]}], ")"}], "2"]}], ")"}]}]}], 
  TraditionalForm]], "Text",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
   4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
