Cell[TextData[{
 "All partial derivatives with respect to x must be evaluated before taking \
the diagonal limit ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "\[Prime]"], "->", "x"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b75d305e-f4b9-46c0-8bd0-85bfcee6f72f"],
