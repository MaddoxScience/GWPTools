Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalSigma]", "pp"], "(", "t", ")"}], "=", 
   RowBox[{
    FractionBox["D", 
     RowBox[{"2", 
      SubscriptBox["\[Gamma]", "d"]}]], "+", 
    RowBox[{
     FractionBox[
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", 
         SubscriptBox["\[Gamma]", "d"]}], "t"}]], 
      RowBox[{"2", 
       SubscriptBox["\[Gamma]", "d"], 
       SubsuperscriptBox["\[Omega]", "1", "2"]}]], 
     RowBox[{"(", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"4", 
        RowBox[{
         SuperscriptBox["\[Omega]", "2"], "(", 
         RowBox[{
          RowBox[{
           SubscriptBox["\[Gamma]", "d"], 
           SubscriptBox["\[ScriptCapitalE]", "0"]}], "-", "D"}], ")"}]}], 
       "\[IndentingNewLine]", "+", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Gamma]", "d"], "(", 
         RowBox[{
          RowBox[{"D", " ", 
           SubscriptBox["\[Gamma]", "d"]}], "-", 
          RowBox[{"2", 
           RowBox[{"(", 
            RowBox[{
             SubsuperscriptBox["\[Gamma]", "d", "2"], "-", 
             RowBox[{"2", 
              SuperscriptBox["\[Omega]", "2"]}]}], ")"}], 
