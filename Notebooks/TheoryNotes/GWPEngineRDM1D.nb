Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[ScriptCapitalP]", "(", "t", ")"}], "=", 
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
     RowBox[{
      RowBox[{"\[Rho]", "(", 
       RowBox[{"x", ",", 
        SuperscriptBox["x", "\[Prime]"], ",", "t"}], ")"}], 
      RowBox[{"\[Rho]", "(", 
       RowBox[{
        SuperscriptBox["x", "\[Prime]"], ",", "x", ",", "t"}], ")"}], 
      RowBox[{"\[DifferentialD]", "x"}], 
      RowBox[{"\[DifferentialD]", 
       SuperscriptBox["x", "\[Prime]"]}]}]}]}]}], TraditionalForm]], "Text",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
   4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
