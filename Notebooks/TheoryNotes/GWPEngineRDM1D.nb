           RowBox[{
            SuperscriptBox["\[PartialD]", "2"], "\[Rho]"}], 
           RowBox[{
            RowBox[{"\[PartialD]", "x"}], 
            RowBox[{"\[PartialD]", 
             SuperscriptBox["x", "\[Prime]"]}]}]]}], ")"}], 
        RowBox[{
         SuperscriptBox["x", "\[Prime]"], "->", "x"}]], 
       RowBox[{"\[DifferentialD]", "x"}]}]}]}]}]}], TraditionalForm]], "Text",\

