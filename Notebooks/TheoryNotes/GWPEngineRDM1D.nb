e2f8e6c2dda7"],

Cell["\<\
In coordinate space, the reduced density matrix for a GWP is described by\
\>", "Text",
 CellChangeTimes->{{4.0015416660979443`*^9, 4.001541687776664*^9}, {
  4.0015425039520893`*^9, 
  4.0015425087926273`*^9}},ExpressionUUID->"e5108783-d043-4238-b50c-\
e39a3e3b32b0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Rho]", "(", 
    RowBox[{"x", ",", 
     SuperscriptBox["x", "\[Prime]"], ",", "t"}], ")"}], "=", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"2", 
      RowBox[{"Re", "(", 
       SubscriptBox["\[Gamma]", "t"], ")"}]}]], 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Re", "(", 
         SubscriptBox["\[Alpha]", "t"], ")"}]}], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"x", "-", 
            SubscriptBox["x", "t"]}], ")"}], "2"], "+", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["x", "\[Prime]"], "-", 
            SubscriptBox["x", "t"]}], ")"}], "2"]}], ")"}]}], "+", 
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{"Im", "(", 
        SubscriptBox["\[Alpha]", "t"], ")"}], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"x", "-", 
            SubscriptBox["x", "t"]}], ")"}], "2"], "-", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["x", "\[Prime]"], "-", 
            SubscriptBox["x", "t"]}], ")"}], "2"]}], ")"}]}], "+", 
      RowBox[{
       FractionBox["\[ImaginaryI]", "\[HBar]"], 
       RowBox[{
        SubscriptBox["p", "t"], "(", 
        RowBox[{"x", "-", 
         SuperscriptBox["x", "\[Prime]"]}], ")"}]}], "-", 
      SuperscriptBox[
       RowBox[{
        SubscriptBox["\[Theta]", "t"], "(", 
        RowBox[{"x", "-", 
         SuperscriptBox["x", "\[Prime]"]}], ")"}], "2"]}], ")"}]}]}], 
  TraditionalForm]], "Text",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
   4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
   4.001167030269079*^9}, {4.001168402809308*^9, 4.001168426499454*^9}, {
   4.001195461673896*^9, 4.001195503258028*^9}, {4.001195834433279*^9, 
   4.001195998998259*^9}, {4.0011976314556*^9, 4.00119771342379*^9}, {
   4.001199104101141*^9, 4.001199115942663*^9}, {4.001199321428568*^9, 
   4.001199331465453*^9}, 4.001199392445671*^9, 4.001199467206645*^9, {
   4.001199563032137*^9, 4.001199583014041*^9}, {4.001203465471712*^9, 
   4.0012035255169*^9}, {4.001264251805689*^9, 4.0012642661539392`*^9}, {
   4.0013318278236923`*^9, 4.0013318316543007`*^9}, {4.001331917778775*^9, 
   4.001331919395858*^9}, {4.0014052911153917`*^9, 4.0014053358551207`*^9}, {
   4.001438800761121*^9, 4.001438835485734*^9}, {4.0014441785552053`*^9, 
   4.0014442534145613`*^9}, {4.0014443274979897`*^9, 4.00144434968614*^9}, {
   4.001444403662971*^9, 4.001444455698333*^9}, {4.001448073835705*^9, 
   4.0014480816049223`*^9}, {4.00153115348689*^9, 4.001531156617498*^9}, {
   4.001532066028286*^9, 4.001532095649414*^9}, {4.0015417048413467`*^9, 
   4.001541857112092*^9}, {4.001541898500866*^9, 
   4.00154189900229*^9}},ExpressionUUID->"8fc322df-20ce-4f43-8fbf-\
8db56d9772af"],

Cell[TextData[{
 "where the sign of the chirp term ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Im", "(", 
    SubscriptBox["\[Alpha]", "t"], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7f1397f0-bdc1-4724-836f-442b75a8a1a1"],
 " corresponds to the positive position-momentum covariance condition"
}], "Text",
 CellChangeTimes->{{4.001541871769713*^9, 4.001541891785159*^9}, {
  4.001541956187167*^9, 
  4.0015419863834333`*^9}},ExpressionUUID->"82511330-699f-41be-932b-\
1bd6c8499f26"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalSigma]", "xp"], "(", "t", ")"}], "=", 
   RowBox[{
    FractionBox["\[HBar]", "2"], " ", 
    FractionBox[
     RowBox[{"Im", "(", 
      SubscriptBox["\[Alpha]", "t"], ")"}], 
     RowBox[{"Re", "(", 
      SubscriptBox["\[Alpha]", "t"], ")"}]]}]}], TraditionalForm]], "Text",
