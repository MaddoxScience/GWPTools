   4.001096125714559*^9}},ExpressionUUID->"ce3f2e88-ef52-4ae4-8610-\
58b397a9b77d"],

Cell[TextData[{
 "To preserve physical positivity of the density matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["\[Rho]", "^"], ">=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3ff9a0cd-35c4-4717-bbdb-676162e33194"],
 ", which requires "
}], "Text",
 CellChangeTimes->{{4.001096134167153*^9, 4.001096161923915*^9}, {
  4.001096194190817*^9, 
  4.001096194190879*^9}},ExpressionUUID->"fcd0862e-9ad0-478d-8a89-\
9fa48d7a05c1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"det", "(", 
    SubscriptBox[
     StyleBox["\[CapitalSigma]",
      FontWeight->"Bold"], "t"], ")"}], ">=", 
   FractionBox[
    SuperscriptBox["\[HBar]", "2"], "4"]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
