Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["N", "px"], "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{"D", 
     RowBox[{
      SubsuperscriptBox["\[Integral]", "0", "t"], 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["G", "pp", "2"], "(", "\[Tau]", ")"}], 
       RowBox[{"\[DifferentialD]", "\[Tau]"}]}]}]}], "=", 
    RowBox[{
     RowBox[{
      FractionBox["D", 
