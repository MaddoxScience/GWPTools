   4.001595790243163*^9}},ExpressionUUID->"5a87529d-87c1-4482-b2ed-\
98bd809e0ef7"],

Cell["\<\
The unitary evolution term vanishes by virtue of the cyclic invariance of the \
trace\
\>", "Text",
 CellChangeTimes->{{4.0015788450039062`*^9, 4.001578902240026*^9}, {
  4.001596185070694*^9, 
  4.001596187997167*^9}},ExpressionUUID->"ced508d6-c406-47df-8a32-\
2a65814fa40d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Tr", "[", 
    RowBox[{
     OverscriptBox["H", "^"], 
     RowBox[{
      SubscriptBox["\[ScriptCapitalL]", "U"], "(", "\[Rho]", ")"}]}], "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox["\[ImaginaryI]", "\[HBar]"]}], 
     RowBox[{"Tr", "(", 
      RowBox[{
       OverscriptBox[
        RowBox[{"H", " "}], "^"], " ", "[", 
       RowBox[{
        OverscriptBox["H", "^"], ",", 
        OverscriptBox["\[Rho]", "^"]}], "]"}], ")"}]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox["\[ImaginaryI]", "\[HBar]"]}], 
      RowBox[{"Tr", "(", 
       RowBox[{
        RowBox[{
         OverscriptBox[
          RowBox[{"H", " "}], "^"], " ", 
         OverscriptBox["H", "^"], 
         OverscriptBox["\[Rho]", "^"]}], "-", 
        RowBox[{
         OverscriptBox[
          RowBox[{"H", " "}], "^"], " ", 
         OverscriptBox["\[Rho]", "^"], 
         OverscriptBox["H", "^"]}]}], ")"}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        FractionBox["\[ImaginaryI]", "\[HBar]"]}], 
       RowBox[{"Tr", "(", 
        RowBox[{
         RowBox[{
          OverscriptBox[
           RowBox[{"H", " "}], "^"], " ", 
          OverscriptBox["H", "^"], 
          OverscriptBox["\[Rho]", "^"]}], "-", 
         RowBox[{
          OverscriptBox["H", "^"], 
          OverscriptBox[
           RowBox[{"H", " "}], "^"], " ", 
          OverscriptBox["\[Rho]", "^"]}]}], ")"}]}], "=", "0"}]}]}]}], 
  TraditionalForm]], "Text",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
   4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
