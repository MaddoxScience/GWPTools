Cell["\<\
For this case, the covariance elements evolve with quadratic time polynomials \
under the a decaying envelope\
\>", "Text",
 CellChangeTimes->{{4.001100076517749*^9, 4.001100090649413*^9}, {
  4.0011001495262136`*^9, 
  4.001100194475585*^9}},ExpressionUUID->"27d14a54-3c49-4895-a08e-\
667d69e79511"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalSigma]", "xx"], "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["D", 
      RowBox[{"4", "m", " ", 
       SuperscriptBox["\[Omega]", "3"]}]], 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "2"}], "\[Omega]", " ", "t"}]], "(", 
        RowBox[{"1", "+", 
         RowBox[{"2", "\[Omega]", " ", "t"}], "+", 
         RowBox[{"2", 
          SuperscriptBox["\[Omega]", "2"], 
          SuperscriptBox["t", "2"]}]}], ")"}]}], ")"}]}], "+", 
    RowBox[{
     FractionBox[
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "2"}], "\[Omega]", " ", "t"}]], 
      SuperscriptBox["m", "2"]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["m", "2"], 
        RowBox[{
         SubscriptBox["\[CapitalSigma]", "xx"], "(", "0", ")"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"\[Omega]", " ", "t"}]}], ")"}], "2"]}], "+", 
       RowBox[{"2", "m", " ", 
        RowBox[{
         SubscriptBox["\[CapitalSigma]", "xp"], "(", "0", ")"}], 
        RowBox[{"t", "(", 
         RowBox[{"1", "+", 
          RowBox[{"\[Omega]", " ", "t"}]}], ")"}]}], "+", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[CapitalSigma]", "pp"], "(", "0", ")"}], 
        SuperscriptBox["t", "2"]}]}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {4.000421938323202*^9, 
   4.00042195783239*^9}, {4.0004222272255993`*^9, 4.000422355929029*^9}, {
   4.001087951363468*^9, 4.001088000874812*^9}, {4.0010880631173162`*^9, 
   4.001088097510171*^9}, {4.001088621856681*^9, 4.0010886653871727`*^9}, {
   4.001089379522028*^9, 4.001089407124345*^9}, {4.001091166130054*^9, 
   4.0010912129902554`*^9}, 4.001091391261121*^9, {4.001091486974721*^9, 
   4.0010915026822567`*^9}, {4.001095559611475*^9, 4.001095579289102*^9}, {
   4.001095657775998*^9, 4.00109572170932*^9}, {4.001095753299487*^9, 
   4.001095754097608*^9}, {4.001095794558099*^9, 4.001095801545218*^9}, {
   4.001098589012927*^9, 4.001098599545628*^9}, {4.0010986829268847`*^9, 
   4.001098687388616*^9}, 4.0010995952032537`*^9, {4.0011063180331783`*^9, 
   4.001106417574417*^9}},ExpressionUUID->"11b935b5-2ae2-4d97-9ba2-\
3f9ca5696a92"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalSigma]", "pp"], "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["D", 
      RowBox[{"4", "\[Omega]"}]], 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "2"}], "\[Omega]", " ", "t"}]], "(", 
        RowBox[{"1", "-", 
         RowBox[{"2", "\[Omega]", " ", "t"}], "+", 
         RowBox[{"2", 
          SuperscriptBox["\[Omega]", "2"], 
          SuperscriptBox["t", "2"]}]}], ")"}]}], ")"}]}], "+", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "2"}], "\[Omega]", " ", "t"}]], "(", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[CapitalSigma]", "pp"], "(", "0", ")"}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"\[Omega]", " ", "t"}]}], ")"}], "2"]}], "-", 
      RowBox[{"2", "m", " ", 
       SuperscriptBox["\[Omega]", "2"], 
       RowBox[{
        SubscriptBox["\[CapitalSigma]", "xp"], "(", "0", ")"}], 
       RowBox[{"t", "(", 
        RowBox[{"1", "-", 
         RowBox[{"\[Omega]", " ", "t"}]}], ")"}]}], "+", 
      RowBox[{
       SuperscriptBox["m", "2"], 
       SuperscriptBox["\[Omega]", "4"], 
       RowBox[{
        SubscriptBox["\[CapitalSigma]", "xx"], "(", "0", ")"}], 
       SuperscriptBox["t", "2"]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {4.000421938323202*^9, 
