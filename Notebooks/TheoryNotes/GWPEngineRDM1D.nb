Cell[TextData[{
 "Setting ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "->", 
    SuperscriptBox["x", "\[Prime]"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bfd8b8fb-9d7c-4624-afd0-7c47d623b125"],
