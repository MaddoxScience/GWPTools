89986140d31f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["p", "t"], "=", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], 
      SubscriptBox["\[Gamma]", "d"], "t"}]], "(", 
    RowBox[{
     RowBox[{
      SubscriptBox["p", "0"], 
      RowBox[{"cosh", "(", 
       FractionBox[
        RowBox[{
         SubscriptBox["\[Omega]", "1"], "t"}], "2"], ")"}]}], "-", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{
         SubscriptBox["\[Gamma]", "d"], 
         SubscriptBox["p", "0"]}], "+", 
        RowBox[{"2", "m", " ", 
         SuperscriptBox["\[Omega]", "2"], 
         SubscriptBox["x", "0"]}]}], 
       SubscriptBox["\[Omega]", "1"]], 
      RowBox[{"sinh", "(", 
       FractionBox[
        RowBox[{
         SubscriptBox["\[Omega]", "1"], "t"}], "2"], ")"}]}]}], ")"}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
