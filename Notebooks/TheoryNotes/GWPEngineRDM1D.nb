Cell["For the diffusion term, we have", "Text",
 CellChangeTimes->{{4.001588160695898*^9, 
  4.001588166064797*^9}},ExpressionUUID->"bf1cd865-cd63-4d56-bbb3-\
b6ca9d220841"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox["\[HBar]", "2"], 
      RowBox[{"2", "m"}]]}], 
    RowBox[{
     FractionBox[
      SuperscriptBox["\[PartialD]", "2"], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "2"]}]], 
     RowBox[{
      SubscriptBox["\[ScriptCapitalL]", "diff"], "(", "\[Rho]", ")"}]}]}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["\[HBar]", "2"], " ", 
      SubscriptBox["\[Gamma]", "d"], 
      RowBox[{"(", "t", ")"}], 
      SubscriptBox["k", "B"], "T", 
      RowBox[{"(", "t", ")"}]}], "2"], 
    RowBox[{
     FractionBox[
      SuperscriptBox["\[PartialD]", "2"], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "2"]}]], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "-", 
          SuperscriptBox["x", "\[Prime]"]}], ")"}], "2"], "\[Rho]"}], 
      ")"}]}]}]}], TraditionalForm]], "Text",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
