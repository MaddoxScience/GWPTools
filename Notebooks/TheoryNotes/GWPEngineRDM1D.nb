Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox[
     SuperscriptBox["\[PartialD]", "2"], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "2"]}]], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"x", "-", 
         SuperscriptBox["x", "\[Prime]"]}], ")"}], "2"], 
      RowBox[{"\[Rho]", "(", 
       RowBox[{"x", ",", 
        SuperscriptBox["x", "\[Prime]"], ",", "t"}], ")"}]}], ")"}]}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["\[PartialD]", 
      RowBox[{"\[PartialD]", "x"}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{"x", "-", 
          SuperscriptBox["x", "\[Prime]"]}], ")"}], "\[Rho]"}], "+", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "-", 
           SuperscriptBox["x", "\[Prime]"]}], ")"}], "2"], 
        FractionBox[
         RowBox[{"\[PartialD]", "\[Rho]"}], 
         RowBox[{"\[PartialD]", "x"}]]}]}], ")"}]}], "=", 
    RowBox[{
     RowBox[{"2", "\[Rho]"}], "+", 
     RowBox[{"4", 
      RowBox[{"(", 
       RowBox[{"x", "-", 
        SuperscriptBox["x", "\[Prime]"]}], ")"}], 
      FractionBox[
       RowBox[{"\[PartialD]", "\[Rho]"}], 
       RowBox[{"\[PartialD]", "x"}]]}], "+", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"x", "-", 
         SuperscriptBox["x", "\[Prime]"]}], ")"}], "2"], 
      FractionBox[
       RowBox[{
        SuperscriptBox["\[PartialD]", "2"], "\[Rho]"}], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", "2"]}]]}]}]}]}], TraditionalForm]], "Text",
