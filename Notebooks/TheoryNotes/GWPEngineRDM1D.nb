Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Thermal", " ", "Equilibrium", " ", "Initial", " ", "Parameters", " ", 
    "for", " ", "HarmonicCL"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"aaEq", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"m", "*", 
        RowBox[{"omega", "^", "2"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"4", "*", "kT"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xxEq", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ppEq", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ggEq", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "4"}], ")"}], "*", 
      RowBox[{"Log", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", "*", "aaEq"}], ")"}], "/", "Pi"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"thetaEq", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"m", "*", "kT"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", "*", 
         RowBox[{"hbar", "^", "2"}]}], ")"}]}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"m", "*", 
         RowBox[{"omega", "^", "2"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"8", "*", "kT"}], ")"}]}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Construct", " ", "the", " ", "stationary", " ", "thermal", " ", 
     "state"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"GWPRDM1DPARAM", "[", 
    RowBox[{"aaEq", ",", "xxEq", ",", "ppEq", ",", "ggEq", ",", "thetaEq", ",", 
     RowBox[{"\"\<HBAR\>\"", "->", "hbar"}], ",", 
     RowBox[{"\"\<MASS\>\"", "->", "m"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{4.001111842695779*^9, 
  4.001111846450561*^9}},ExpressionUUID->"c256292e-eec2-49ca-a24e-\
f7f666a1ba98"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Green\[CloseCurlyQuote]s function approach to CL for harmonic \
oscillator", "Section",
 CellChangeTimes->{{4.001113240475816*^9, 4.0011132507824163`*^9}, {
  4.001113282582778*^9, 
  4.0011132869955177`*^9}},ExpressionUUID->"a0787c20-c366-4bdb-85ea-\
a8f560a4db15"],

Cell["\<\
For a harmonic oscillator coupled to a Caldeira\[Dash]Leggett thermal bath, \
both the classical phase-space trajectory and the phase-space covariance \
matrix are governed by the same underlying linear dynamical operator. \
Consequently, the complete time evolution across all three damping regimes\
\[LongDash]underdamped, overdamped, and critically damped\[LongDash]can be \
unified through a single classical Green\[CloseCurlyQuote]s matrix.\
\>", "Text",
 CellChangeTimes->{
  4.0011135123894157`*^9, {4.001113658090324*^9, 
   4.0011136739031067`*^9}},ExpressionUUID->"f1aa68f3-83f3-4a63-bc38-\
372ffe10d366"],

Cell["\<\
The homogeneous equations of motion for the damped classical position and \
momentum centers are linear:\
\>", "Text",
 CellChangeTimes->{{4.0011139467102613`*^9, 
  4.001113950968465*^9}},ExpressionUUID->"2bd01768-7b8f-4ca9-b74e-\
6c48a3aaabf6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox["\[DifferentialD]", 
     RowBox[{"\[DifferentialD]", "t"}]], 
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["x", "t"]},
       {
        SubscriptBox["p", "t"]}
      }], ")"}]}], "=", 
   RowBox[{
    RowBox[{"(", GridBox[{
       {"0", 
        FractionBox["1", "m"]},
       {
        RowBox[{
         RowBox[{"-", "m"}], " ", 
         SuperscriptBox["\[Omega]", "2"]}], 
        RowBox[{"-", 
         SubscriptBox["\[Gamma]", "d"]}]}
      }], ")"}], 
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["x", "t"]},
       {
        SubscriptBox["p", "t"]}
      }], ")"}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {4.000421938323202*^9, 
   4.00042195783239*^9}, {4.0004222272255993`*^9, 4.000422355929029*^9}, {
   4.001087951363468*^9, 4.001088000874812*^9}, {4.0010880631173162`*^9, 
   4.001088097510171*^9}, {4.001088621856681*^9, 4.0010886653871727`*^9}, {
   4.001089379522028*^9, 4.001089407124345*^9}, {4.001091166130054*^9, 
   4.0010912129902554`*^9}, 4.001091391261121*^9, {4.001091486974721*^9, 
   4.0010915026822567`*^9}, {4.001095559611475*^9, 4.001095579289102*^9}, {
   4.0010957252885227`*^9, 4.001095806261395*^9}, {4.001095966832601*^9, 
   4.001095974883708*^9}, {4.001096095231681*^9, 4.001096125714559*^9}, {
   4.001096232966847*^9, 4.001096290364564*^9}, {4.0010963325687428`*^9, 
   4.001096352430357*^9}, {4.0011114935177526`*^9, 4.001111551729865*^9}, {
   4.0011115951743097`*^9, 4.001111787687873*^9}, {4.001113968024612*^9, 
   4.001114012974532*^9}},ExpressionUUID->"c65f9565-11fd-4bee-967e-\
b9dadb48e5b0"],

Cell["\<\
For any initial phase-space coordinate, the solution is propagated by the \
Green\[CloseCurlyQuote]s matrix (fundamental matrizant):\
\>", "Text",
 CellChangeTimes->{{4.001114037317836*^9, 
  4.001114052942273*^9}},ExpressionUUID->"00628daf-36df-439d-9d74-\
84e7fe9bdeed"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"(", GridBox[{
      {
       SubscriptBox["x", "t"]},
      {
       SubscriptBox["p", "t"]}
     }], ")"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      StyleBox["G",
       FontWeight->"Bold",
       FontSlant->"Plain"], "(", "t", ")"}], 
     RowBox[{"(", GridBox[{
        {
         SubscriptBox["x", "0"]},
        {
         SubscriptBox["p", "0"]}
       }], ")"}]}], "=", 
    RowBox[{
     RowBox[{"(", GridBox[{
        {
         RowBox[{
          SubscriptBox["G", "xx"], "(", "t", ")"}], 
         RowBox[{
          SubscriptBox["G", "xp"], "(", "t", ")"}]},
        {
         RowBox[{
          SubscriptBox["G", "px"], "(", "t", ")"}], 
         RowBox[{
          SubscriptBox["G", "pp"], "(", "t", ")"}]}
       }], ")"}], 
     RowBox[{"(", GridBox[{
        {
         SubscriptBox["x", "0"]},
        {
         SubscriptBox["p", "0"]}
       }], ")"}]}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {4.000421938323202*^9, 
   4.00042195783239*^9}, {4.0004222272255993`*^9, 4.000422355929029*^9}, {
   4.001087951363468*^9, 4.001088000874812*^9}, {4.0010880631173162`*^9, 
   4.001088097510171*^9}, {4.001088621856681*^9, 4.0010886653871727`*^9}, {
   4.001089379522028*^9, 4.001089407124345*^9}, {4.001091166130054*^9, 
   4.0010912129902554`*^9}, 4.001091391261121*^9, {4.001091486974721*^9, 
   4.0010915026822567`*^9}, {4.001095559611475*^9, 4.001095579289102*^9}, {
   4.0010957252885227`*^9, 4.001095806261395*^9}, {4.001095966832601*^9, 
   4.001095974883708*^9}, {4.001096095231681*^9, 4.001096125714559*^9}, {
   4.001096232966847*^9, 4.001096290364564*^9}, {4.0010963325687428`*^9, 
   4.001096352430357*^9}, {4.0011114935177526`*^9, 4.001111551729865*^9}, {
   4.0011115951743097`*^9, 4.001111787687873*^9}, {4.001113968024612*^9, 
   4.001114012974532*^9}, {4.00111406161021*^9, 
   4.0011141656592827`*^9}},ExpressionUUID->"7ce1ec36-8674-4be6-99f5-\
21b7136ea359"],

Cell[TextData[{
 "Because the characteristic roots of the dynamical matrix depend on the sign \
of the discriminant ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"4", 
     SuperscriptBox["\[Omega]", "2"]}], "-", 
    SubsuperscriptBox["\[Gamma]", "d", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f5368039-b131-465a-9a60-a1692273d5ef"],
 ", the four scalar propagator elements take three analytical forms."
}], "Text",
 CellChangeTimes->{{4.0011142047510357`*^9, 
  4.001114267482978*^9}},ExpressionUUID->"5541a6d8-85ad-456a-868d-\
60aa9b3c0e68"],

Cell[TextData[{
 "Underdamped (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "d"], "<", 
    RowBox[{"2", "\[Omega]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "187bdd83-a143-4e90-b940-35f740f54b74"],
 ")"
}], "Text",
 CellChangeTimes->{{4.001114280714677*^9, 
  4.001114320655034*^9}},ExpressionUUID->"0ac4bed3-7011-4a93-89ff-\
8f96d1e45790"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Omega]", "1"], "=", 
   SqrtBox[
    RowBox[{
     RowBox[{"4", " ", 
      SuperscriptBox["\[Omega]", "2"]}], "-", 
     SubsuperscriptBox["\[Gamma]", "d", "2"]}]]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {4.000421938323202*^9, 
   4.00042195783239*^9}, {4.0004222272255993`*^9, 4.000422355929029*^9}, {
   4.001087951363468*^9, 4.001088000874812*^9}, {4.0010880631173162`*^9, 
   4.001088097510171*^9}, {4.001088621856681*^9, 4.0010886653871727`*^9}, {
   4.001089379522028*^9, 4.001089407124345*^9}, {4.001091166130054*^9, 
   4.0010912129902554`*^9}, 4.001091391261121*^9, {4.001091486974721*^9, 
   4.0010915026822567`*^9}, {4.001095559611475*^9, 4.001095579289102*^9}, {
   4.0010957252885227`*^9, 4.001095806261395*^9}, {4.001095966832601*^9, 
   4.001095974883708*^9}, {4.001096095231681*^9, 4.001096125714559*^9}, {
   4.001096232966847*^9, 4.001096290364564*^9}, {4.0010963325687428`*^9, 
   4.001096352430357*^9}, {4.0011114935177526`*^9, 4.001111551729865*^9}, {
   4.0011115951743097`*^9, 4.001111787687873*^9}, {4.001113968024612*^9, 
   4.001114012974532*^9}, {4.00111406161021*^9, 4.0011141656592827`*^9}, {
   4.001114333952326*^9, 
   4.00111434954988*^9}},ExpressionUUID->"1cdd15bd-d244-410d-a1a6-\
b3828b86db0e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["G", "xx"], "(", "t", ")"}], "=", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
