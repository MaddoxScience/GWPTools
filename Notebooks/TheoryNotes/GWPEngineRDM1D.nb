98c8589dff61"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["N", "xx"], "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{"D", 
     RowBox[{
      SubsuperscriptBox["\[Integral]", "0", "t"], 
      RowBox[{
       RowBox[{
        SubsuperscriptBox["G", "xp", "2"], "(", "\[Tau]", ")"}], 
       RowBox[{"\[DifferentialD]", "\[Tau]"}]}]}]}], "=", 
    RowBox[{
     RowBox[{
      FractionBox["D", 
       RowBox[{"2", 
        SuperscriptBox["m", "2"], 
        SubsuperscriptBox["\[Gamma]", "d", "3"]}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", 
         SubscriptBox["\[Gamma]", "d"], "t"}], "-", "3", "+", 
        RowBox[{"4", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            SubscriptBox["\[Gamma]", "d"]}], "t"}]]}], "-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "2"}], 
          SubscriptBox["\[Gamma]", "d"], "t"}]]}], ")"}]}], "=", 
     RowBox[{
      FractionBox[
       RowBox[{
        SubscriptBox["k", "B"], "T"}], 
       RowBox[{"m", " ", 
        SubsuperscriptBox["\[Gamma]", "d", "2"]}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"...", "same"}], "..."}], ")"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
