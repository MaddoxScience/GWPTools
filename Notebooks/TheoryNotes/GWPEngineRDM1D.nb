     SuperscriptBox[
      OverscriptBox["x", "^"], "2"], " ", 
     OverscriptBox["\[Rho]", "^"]}], ")"}], "=", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
     RowBox[{
