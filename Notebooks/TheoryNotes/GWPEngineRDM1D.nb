Cell[TextData[{
 "and to ask what is the total derivative of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"F", "(", "x", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2dfb5b0c-15f9-44d2-b397-754e8fe4ed4b"],
 " along the diagonal line ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "\[Prime]"], "=", "x"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "22273219-f965-460e-ace3-dcb017158093"],
 "? This involves two terms"
}], "Text",
 CellChangeTimes->{{4.001586935905325*^9, 4.001586964302411*^9}, {
  4.001587395713419*^9, 4.0015874088504133`*^9}, {4.0015963796196327`*^9, 
  4.001596399113645*^9}},ExpressionUUID->"07cf0bf0-d018-46c1-a4d1-\
6baa54d51719"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"\[DifferentialD]", 
     RowBox[{"F", "(", "x", ")"}]}], 
    RowBox[{"\[DifferentialD]", "x"}]], "=", 
   RowBox[{
    RowBox[{
     FractionBox["\[DifferentialD]", 
      RowBox[{"\[DifferentialD]", "x"}]], 
     RowBox[{"(", 
      SubscriptBox[
       RowBox[{"(", 
        FractionBox[
         RowBox[{"\[PartialD]", 
          RowBox[{"\[Rho]", "(", 
           RowBox[{"x", ",", 
            SuperscriptBox["x", "\[Prime]"], ",", "t"}], ")"}]}], 
         RowBox[{"\[PartialD]", "x"}]], ")"}], 
       RowBox[{
        SuperscriptBox["x", "\[Prime]"], "=", "x"}]], ")"}]}], "=", 
    RowBox[{
     SubscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", "x"}]], 
         RowBox[{"(", 
          FractionBox[
           RowBox[{"\[PartialD]", "\[Rho]"}], 
           RowBox[{"\[PartialD]", "x"}]], ")"}]}], "+", 
        RowBox[{
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", "\[Prime]"]}]], 
         RowBox[{"(", 
          FractionBox[
           RowBox[{"\[PartialD]", "\[Rho]"}], 
           RowBox[{"\[PartialD]", "x"}]], ")"}]}]}], ")"}], 
      RowBox[{
       SuperscriptBox["x", "\[Prime]"], "=", "x"}]], "=", 
     SubscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[PartialD]", "2"], "\[Rho]"}], 
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", "2"]}]], ")"}], "+", 
        RowBox[{"(", 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[PartialD]", "2"], "\[Rho]"}], 
          RowBox[{
           RowBox[{"\[PartialD]", "x"}], 
           RowBox[{"\[PartialD]", 
            SuperscriptBox["x", "\[Prime]"]}]}]], ")"}]}], ")"}], 
      RowBox[{
       SuperscriptBox["x", "\[Prime]"], "=", "x"}]]}]}]}], 
  TraditionalForm]], "Text",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
