Cell["but not for the variances.", "Text",
 CellChangeTimes->{{4.00110515828435*^9, 
  4.0011051694317513`*^9}},ExpressionUUID->"9cf7e804-d0a9-463d-ae51-\
a9fac20464a0"],

Cell[TextData[{
 "For the critically damped oscillator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "d"], "=", 
    RowBox[{"2", "\[Omega]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0b6f38c8-e151-43d4-88af-440988b9b8d6"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", "1"], "->", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "15b5aa04-d3de-4f2b-bb00-bddff1ae0794"],
 ", the characteristic polynomial has a repeated root and the solutions \
reduce to polynomial-exponential forms in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", " ", "t"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a0469092-a939-4b5d-a159-24e0e525de48"],
 "."
}], "Text",
