Cell["\<\
In the presence of thermal momentum diffusion, the covariance matrix relaxes \
asymptotically in time to the the stationary Maxwell-Boltzmann equilibrium \
matrix\
\>", "Text",
 CellChangeTimes->{{4.001115701989421*^9, 
  4.00111575138865*^9}},ExpressionUUID->"891d2d5f-d120-4c13-8737-\
82da2b9819bb"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox["\[CapitalSigma]",
     FontWeight->"Bold"], "(", "\[Infinity]", ")"}], "=", 
   RowBox[{
    RowBox[{"(", GridBox[{
       {
        RowBox[{
         SubscriptBox["\[CapitalSigma]", "xx"], "(", "\[Infinity]", ")"}], 
        RowBox[{
         SubscriptBox["\[CapitalSigma]", "xp"], "(", "\[Infinity]", ")"}]},
       {
        RowBox[{
         SubscriptBox["\[CapitalSigma]", "xp"], "(", "\[Infinity]", ")"}], 
        RowBox[{
         SubscriptBox["\[CapitalSigma]", "pp"], "(", "\[Infinity]", ")"}]}
      }], ")"}], "=", 
    RowBox[{"(", GridBox[{
       {
        FractionBox[
         RowBox[{
          SubscriptBox["k", "B"], "T"}], 
         RowBox[{"m", " ", 
          SuperscriptBox["\[Omega]", "2"]}]], "0"},
       {"0", 
        RowBox[{"m", " ", 
         SubscriptBox["k", "B"], "T"}]}
      }], ")"}]}]}], TraditionalForm]], "DisplayFormula",
