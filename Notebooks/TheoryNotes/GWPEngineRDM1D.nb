Cell[TextData[{
 "As ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "->", "\[Infinity]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3240857c-2532-4fa1-93d8-11de0182b11e"],
 ", the spatial variance transitions from ballistic spreading to linear \
Einstein diffusion and the momentum variance thermalizes to the classical \
Maxwell-Boltzmann limit:"
}], "Text",
 CellChangeTimes->{{4.001091440553584*^9, 4.001091477742304*^9}, {
  4.001091507947185*^9, 4.00109153231102*^9}, {4.001091564288377*^9, 
