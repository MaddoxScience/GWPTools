Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox["\[CapitalSigma]",
     FontWeight->"Bold"], "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{
     StyleBox["\[CapitalSigma]",
      FontWeight->"Bold"], "(", "\[Infinity]", ")"}], "+", 
    RowBox[{
     RowBox[{
      StyleBox["G",
       FontWeight->"Bold",
       FontSlant->"Plain"], "(", "t", ")"}], 
     RowBox[{
      StyleBox[
       RowBox[{"\[CapitalDelta]", 
        StyleBox["\[CapitalSigma]",
         FontWeight->"Bold"]}]], "(", "0", ")"}], 
     RowBox[{
      SuperscriptBox[
       StyleBox["G",
        FontWeight->"Bold",
        FontSlant->"Plain"], "T"], "(", "t", ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {4.000421938323202*^9, 
