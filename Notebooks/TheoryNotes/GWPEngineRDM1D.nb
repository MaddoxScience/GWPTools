bbf795d7c6d4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalSigma]", "pp"], "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{"m", " ", 
     SubscriptBox["k", "B"], "T"}], "+", 
