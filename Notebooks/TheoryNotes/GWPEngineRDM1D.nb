  4.001596571438455*^9}},ExpressionUUID->"df509a53-b522-46e7-95d7-\
c91f08edec1d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
    RowBox[{
     FractionBox[
      RowBox[{"\[DifferentialD]", 
       RowBox[{"F", "(", "x", ")"}]}], 
      RowBox[{"\[DifferentialD]", "x"}]], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      UnderscriptBox["lim", 
       RowBox[{"x", "->", "\[Infinity]"}]], " ", 
      RowBox[{"F", "(", "x", ")"}]}], "-", 
     RowBox[{
      UnderscriptBox["lim", 
       RowBox[{"x", "->", 
        RowBox[{"-", "\[Infinity]"}]}]], 
      RowBox[{"F", "(", "x", ")"}]}]}], "=", "0"}]}], 
  TraditionalForm]], "Text",
