187c5032aad6"],

Cell[TextData[{
 "Evaluating the matrix element in coordinate space follows two fundamental \
rules whenever ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["A", "^"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "133b7068-4bfd-49ef-b324-6cf4bca5079f"],
 " contains momentum operators ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["p", "^"], "=", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]\[HBar]"}], 
     SubscriptBox["\[PartialD]", "x"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5341eb07-806d-48b7-9a79-fdfc179f17f3"],
 "."
}], "Text",
 CellChangeTimes->{{4.001590961356642*^9, 4.001591066788518*^9}, {
  4.001591710120737*^9, 
  4.001591710838581*^9}},ExpressionUUID->"d77621cc-5d72-435c-b0b7-\
4597546393bc"],

Cell["\<\
An operator to the left of the density matrix acts exclusively on the first \
coordinate while holding the second coordinate fixed.\
\>", "Text",
 CellChangeTimes->{{4.001591232468029*^9, 
  4.001591277913961*^9}},ExpressionUUID->"e06556d4-bf87-45de-88cb-\
6ec1deff8217"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    TemplateBox[{"x"},
     "Bra"], 
    OverscriptBox["x", "^"], 
    OverscriptBox["\[Rho]", "^"], 
    TemplateBox[{
      SuperscriptBox["x", "\[Prime]"]},
     "Ket"]}], "=", 
   RowBox[{"x", " ", 
    RowBox[{"\[Rho]", "(", 
     RowBox[{"x", ",", 
