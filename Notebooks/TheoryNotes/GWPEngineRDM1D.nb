Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"det", "(", 
    RowBox[{
     StyleBox["G",
      FontWeight->"Bold",
      FontSlant->"Plain"], "(", "t", ")"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["G", "xx"], "(", "t", ")"}], 
      RowBox[{
       SubscriptBox["G", "pp"], "(", "t", ")"}]}], "-", 
     RowBox[{
      RowBox[{
       SubscriptBox["G", "xp"], "(", "t", ")"}], 
      RowBox[{
       SubscriptBox["G", "px"], "(", "t", ")"}]}]}], "=", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", 
       SubscriptBox["\[Gamma]", "d"]}], "t"}]]}]}], 
  TraditionalForm]], "DisplayFormula",
