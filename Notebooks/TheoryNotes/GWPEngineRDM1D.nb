Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["Q", "."], "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[Gamma]", "d"], "(", "t", ")"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["k", "B"], 
       RowBox[{"T", "(", "t", ")"}]}], "-", 
      FractionBox[
       RowBox[{
        SubsuperscriptBox["p", "t", "2"], "+", 
        RowBox[{
         SubscriptBox["\[CapitalSigma]", "pp"], "(", "t", ")"}]}], "m"]}], 
     ")"}]}]}], TraditionalForm]], "Text",
