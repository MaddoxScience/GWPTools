0b4c318f9b5b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[ScriptCapitalL]", "diff"], "(", "\[Rho]", ")"}], "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      RowBox[{"m", " ", 
       SubscriptBox["\[Gamma]", "d"], 
       RowBox[{"(", "t", ")"}], 
