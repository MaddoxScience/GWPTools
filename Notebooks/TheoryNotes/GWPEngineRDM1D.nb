       RowBox[{"(", 
        RowBox[{"1", "-", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            SubscriptBox["\[Gamma]", "d"]}], "t"}]]}], ")"}], "2"]}], "=", 
     RowBox[{
      FractionBox[
       RowBox[{"m", " ", 
        SubscriptBox["k", "B"], "T"}], "2"], 
      RowBox[{
       SubsuperscriptBox["G", "xp", "2"], "(", "t", ")"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
