Cell["where we have the unitary evolution", "Text",
 CellChangeTimes->{{4.001576149991683*^9, 4.001576150414774*^9}, {
  4.0015779655662746`*^9, 4.001577980652025*^9}, {4.001595757081943*^9, 
  4.0015957583601418`*^9}},ExpressionUUID->"95410d51-ab33-415e-932e-\
8a9ee0760a77"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[ScriptCapitalL]", "U"], "(", "\[Rho]", ")"}], "=", 
   RowBox[{
    RowBox[{"(", " ", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"\[ImaginaryI]", " ", "\[HBar]"}], 
        RowBox[{"2", "m"}]], 
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          SuperscriptBox["\[PartialD]", "2"], 
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", "2"]}]], 
         RowBox[{"-", " ", 
          FractionBox[
           SuperscriptBox["\[PartialD]", "2"], 
           RowBox[{"\[PartialD]", 
            SuperscriptBox[
             SuperscriptBox["x", "\[Prime]"], "2"]}]]}]}], ")"}]}], "-", 
      RowBox[{
       FractionBox["\[ImaginaryI]", "\[HBar]"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"V", "(", 
          RowBox[{"x", ",", "t"}], ")"}], "-", 
         RowBox[{"V", "(", 
          RowBox[{
           SuperscriptBox["x", "\[Prime]"], ",", "t"}], ")"}]}], ")"}]}]}], 
     ")"}], 
    RowBox[{"\[Rho]", "(", 
     RowBox[{"x", ",", 
      SuperscriptBox["x", "\[Prime]"], ",", "t"}], ")"}]}]}], 
  TraditionalForm]], "Text",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
   4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
