168cfc2935dd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalSigma]", "xp"], "(", "t", ")"}], "=", 
   RowBox[{
    FractionBox[
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "2"}], "\[Omega]", " ", "t"}]], 
     RowBox[{"2", "m"}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", "m", " ", 
       RowBox[{
        SubscriptBox["\[CapitalSigma]", "xp"], "(", "0", ")"}]}], "+", 
      RowBox[{"2", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[CapitalSigma]", "pp"], "(", "0", ")"}], "-", 
         RowBox[{
          SuperscriptBox["m", "2"], 
          SuperscriptBox["\[Omega]", "2"], 
          RowBox[{
           SubscriptBox["\[CapitalSigma]", "xx"], "(", "0", ")"}]}]}], ")"}], 
       "t"}], "+", 
      RowBox[{"(", 
       RowBox[{"D", "-", 
        RowBox[{"2", 
         RowBox[{"\[Omega]", "(", 
          RowBox[{
           RowBox[{
            SubscriptBox["\[CapitalSigma]", "pp"], "(", "0", ")"}], "+", 
           RowBox[{"2", "m", " ", "\[Omega]", " ", 
            RowBox[{
             SubscriptBox["\[CapitalSigma]", "xp"], "(", "0", ")"}]}], "+", 
           RowBox[{
            SuperscriptBox["m", "2"], 
            SuperscriptBox["\[Omega]", "2"], 
            RowBox[{
             SubscriptBox["\[CapitalSigma]", "xx"], "(", "0", ")"}]}]}], 
          ")"}], 
         SuperscriptBox["t", "2"]}]}], ")"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {4.000421938323202*^9, 
