     SubscriptBox["x", "0"], 
     RowBox[{"cos", "(", 
      RowBox[{"\[Omega]", " ", "t"}], ")"}]}], "+", 
    RowBox[{
     FractionBox[
      SubscriptBox["p", "0"], 
      RowBox[{"m", " ", "\[Omega]"}]], 
     RowBox[{"sin", "(", 
      RowBox[{"\[Omega]", " ", "t"}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
