Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["N", "xp"], "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{"D", 
     RowBox[{
      SubsuperscriptBox["\[Integral]", "0", "t"], 
      RowBox[{
       RowBox[{
        SubscriptBox["G", "xp"], "(", "\[Tau]", ")"}], 
       RowBox[{
        SubscriptBox["G", "pp"], "(", "\[Tau]", ")"}], 
       RowBox[{"\[DifferentialD]", "\[Tau]"}]}]}]}], "=", 
