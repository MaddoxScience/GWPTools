Cell["\<\
Meanwhile, the covariance components evolve according to Ornstein-Uhlenbeck \
Brownian motion:\
\>", "Text",
 CellChangeTimes->{{4.001090901423518*^9, 
  4.001090930399695*^9}},ExpressionUUID->"354f3c32-6800-4c1d-aa33-\
735e44e549cc"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalSigma]", "xx"], "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[CapitalSigma]", "xx"], "(", "0", ")"}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{"2", 
       RowBox[{
        SubscriptBox["\[CapitalSigma]", "xp"], "(", "0", ")"}]}], 
      SubscriptBox["m\[Gamma]", "d"]], 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", 
          SubscriptBox["\[Gamma]", "d"]}], "t"}]]}], ")"}]}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{
       SubscriptBox["\[CapitalSigma]", "pp"], "(", "0", ")"}], 
      RowBox[{
       SuperscriptBox["m", "2"], 
       SubsuperscriptBox["\[Gamma]", "d", "2"]}]], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", 
           SubscriptBox["\[Gamma]", "d"]}], "t"}]]}], ")"}], "2"]}], "+", 
    RowBox[{
     FractionBox["D", 
      RowBox[{"2", 
       SuperscriptBox["m", "2"], 
       SubsuperscriptBox["\[Gamma]", "d", "3"]}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", 
        SubscriptBox["\[Gamma]", "d"], "t"}], "-", "3", "+", 
       RowBox[{"4", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", 
           SubscriptBox["\[Gamma]", "d"]}], "t"}]]}], "-", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "2"}], 
         SubscriptBox["\[Gamma]", "d"], "t"}]]}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
