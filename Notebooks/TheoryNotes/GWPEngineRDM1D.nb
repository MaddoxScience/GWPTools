     SubscriptBox["\[CapitalDelta]\[CapitalSigma]", "pp"]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
