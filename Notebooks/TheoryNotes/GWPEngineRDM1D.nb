Cell[CellGroupData[{

Cell["Coordinate-space Derivation of the Quantum Purity", "Subsection",
 CellChangeTimes->{{4.001602413005232*^9, 
  4.001602432155081*^9}},ExpressionUUID->"4e1bea89-2d8a-4ccc-b322-\
2805755a8136"],

Cell["\<\
In the coordinate representation, the trace of the squared density operator \
is given by the double spatial integral\
\>", "Text",
 CellChangeTimes->{{4.0016024678090963`*^9, 
  4.0016024995929937`*^9}},ExpressionUUID->"60ec5c7b-57f8-4479-a214-\
16b4df6393ef"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[ScriptCapitalP]", "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{"Tr", "(", 
     SuperscriptBox[
      RowBox[{
       OverscriptBox["\[Rho]", "^"], "(", "t", ")"}], "2"], ")"}], "=", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
     RowBox[{
      SubsuperscriptBox["\[Integral]", 
       RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
      RowBox[{
       TemplateBox[{"x"},
        "Bra"], 
       RowBox[{
        OverscriptBox["\[Rho]", "^"], "(", "t", ")"}], 
       TemplateBox[{
         SuperscriptBox["x", "\[Prime]"]},
        "Ket"], 
       TemplateBox[{
         SuperscriptBox["x", "\[Prime]"]},
        "Bra"], 
       RowBox[{
        OverscriptBox["\[Rho]", "^"], "(", "t", ")"}], 
       TemplateBox[{"x"},
        "Ket"], 
       RowBox[{"\[DifferentialD]", "x"}], 
       RowBox[{"\[DifferentialD]", 
        SuperscriptBox["x", "\[Prime]"]}]}]}]}]}]}], TraditionalForm]], "Text",\

 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
   4.001166971811784*^9, 4.00116697242843*^9}, {4.001167016753029*^9, 
