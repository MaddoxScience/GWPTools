09c8588d8939"],

Cell["\<\
A general one-dimensional mixed Gaussian quantum state is represented by the \
coordinate-space reduced density matrix\
\>", "Text",
 CellChangeTimes->{{4.0015423125873947`*^9, 
  4.001542325416746*^9}},ExpressionUUID->"39978f7f-8238-4abc-8c00-\
0616be0fad2c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Rho]", "(", 
    RowBox[{"x", ",", 
     SuperscriptBox["x", "\[Prime]"], ",", "t"}], ")"}], "=", 
   RowBox[{
    TemplateBox[{"x"},
     "Bra"], 
    OverscriptBox["\[Rho]", "^"], 
    TemplateBox[{
      SuperscriptBox["x", "\[Prime]"]},
     "Ket"]}]}], TraditionalForm]], "Text",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
