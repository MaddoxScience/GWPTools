36ac3815ae2f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox["1", 
     RowBox[{"2", "m"}]], 
    SuperscriptBox[
     OverscriptBox["p", "^"], "2"], 
    RowBox[{
     SubscriptBox["\[ScriptCapitalL]", "fric"], "(", "\[Rho]", ")"}]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["\[HBar]", "2"], 
       RowBox[{"2", "m"}]]}], 
     RowBox[{
      FractionBox[
       SuperscriptBox["\[PartialD]", "2"], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", "2"]}]], 
      RowBox[{
       SubscriptBox["\[ScriptCapitalL]", "fric"], "(", "\[Rho]", ")"}]}]}], "=", 
    RowBox[{
     FractionBox[
      RowBox[{
       SuperscriptBox["\[HBar]", "2"], 
       RowBox[{
        SubscriptBox["\[Gamma]", "d"], "(", "t", ")"}]}], 
      RowBox[{"4", "m"}]], 
     RowBox[{
      FractionBox[
       SuperscriptBox["\[PartialD]", "2"], 
       RowBox[{"\[PartialD]", 
        SuperscriptBox["x", "2"]}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", 
          SuperscriptBox["x", "\[Prime]"]}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{"\[PartialD]", "\[Rho]"}], 
           RowBox[{"\[PartialD]", "x"}]], "-", " ", 
          FractionBox[
           RowBox[{"\[PartialD]", "\[Rho]"}], 
           RowBox[{"\[PartialD]", 
            SuperscriptBox["x", "\[Prime]"]}]]}], ")"}]}], ")"}]}]}]}]}], 
  TraditionalForm]], "Text",
