  4.001605929559458*^9}},ExpressionUUID->"654e73ad-8b42-47b8-8200-\
76c2e3974fae"],

Cell[TextData[{
 "This demonstrates whey the total entropy rate is positive through the \
nonequilibrium ramp and vanishes if and only if the classical center is at \
rest (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "t"], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8a89a8d4-2984-4dd0-ac4a-f0354592ad18"],
 ") and the momentum variance is equilibrated with the instantaneous bath \
temperature (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[CapitalSigma]", "pp"], "(", "t", ")"}], "=", 
    RowBox[{"m", " ", 
     SubscriptBox["k", "B"], 
     RowBox[{"T", "(", "t", ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8f0cf9c2-a5e0-44a4-a574-75c88c27c6be"],
 ")."
}], "Text",
 CellChangeTimes->{{4.001605961244194*^9, 
  4.00160606608325*^9}},ExpressionUUID->"66b3d57f-8ba3-419d-a119-\
467b686383d3"]
}, Closed]]
