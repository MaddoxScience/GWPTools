Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]", "(", 
     RowBox[{"x", ",", 
      SuperscriptBox["x", "\[Prime]"], ",", "t"}], ")"}], 
    RowBox[{"\[Rho]", "(", 
     RowBox[{
      SuperscriptBox["x", "\[Prime]"], ",", "x", ",", "t"}], ")"}]}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"2", 
      RowBox[{"Re", "(", 
       SubscriptBox["\[Alpha]", "t"], ")"}]}], "\[Pi]"], 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], 
       RowBox[{"Re", "(", 
        SubscriptBox["\[Alpha]", "t"], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[CapitalDelta]", " ", 
          SuperscriptBox["x", "2"]}], "+", 
         RowBox[{"\[CapitalDelta]", " ", 
          SuperscriptBox["x", "\[Prime]2"]}]}], ")"}]}], "-", 
      RowBox[{"2", 
       SuperscriptBox[
        RowBox[{"\[Theta]", "(", 
         RowBox[{
          RowBox[{"\[CapitalDelta]", " ", "x"}], "-", 
          RowBox[{"\[CapitalDelta]", " ", 
           SuperscriptBox["x", "\[Prime]"]}]}], ")"}], "2"]}]}], ")"}]}]}], 
  TraditionalForm]], "Text",
