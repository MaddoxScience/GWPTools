Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Theta]", "eq"], "=", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{
        SubscriptBox["\[CapitalSigma]", "xx"], "(", "\[Infinity]", ")"}], 
