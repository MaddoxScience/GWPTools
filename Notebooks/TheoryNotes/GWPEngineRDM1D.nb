Cell["\<\
Furthermore, the action of the potential energy acting on the friction and \
diffusion terms are each identically canceled by taking the diagonal limit\
\>", "Text",
 CellChangeTimes->{{4.0015789393562117`*^9, 
  4.001578995161684*^9}},ExpressionUUID->"d681ace3-601e-41fe-a8c2-\
5241e2220646"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    UnderscriptBox["lim", 
     RowBox[{
      SuperscriptBox["x", "\[Prime]"], "->", "x"}]], 
    RowBox[{"(", 
     RowBox[{
      OverscriptBox["V", "^"], 
      RowBox[{
       SubscriptBox["\[ScriptCapitalL]", "fric"], "(", "\[Rho]", ")"}]}], 
     ")"}]}], "=", 
   RowBox[{
    RowBox[{
     UnderscriptBox["lim", 
      RowBox[{
       SuperscriptBox["x", "\[Prime]"], "->", "x"}]], 
     RowBox[{"(", 
      RowBox[{
       OverscriptBox["V", "^"], 
       RowBox[{
        SubscriptBox["\[ScriptCapitalL]", "diff"], "(", "\[Rho]", ")"}]}], 
      ")"}]}], "=", "0"}]}], TraditionalForm]], "Text",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
