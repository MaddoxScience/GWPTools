    FractionBox["1", "4"], 
    RowBox[{"ln", "(", 
     FractionBox[
      RowBox[{"2", 
       RowBox[{"Re", "(", 
        SubscriptBox["\[Alpha]", "t"], ")"}]}], "\[Pi]"], ")"}]}]}], 
