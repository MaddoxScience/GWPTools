Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
    RowBox[{
     SubscriptBox[
      RowBox[{"(", 
       FractionBox[
        RowBox[{
         SuperscriptBox["\[PartialD]", "2"], "\[Rho]"}], 
        RowBox[{
         RowBox[{"\[PartialD]", "x"}], 
         RowBox[{"\[PartialD]", 
          SuperscriptBox["x", "\[Prime]"]}]}]], ")"}], 
      RowBox[{
       SuperscriptBox["x", "\[Prime]"], "=", "x"}]], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{
      SubsuperscriptBox["\[Integral]", 
       RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
      RowBox[{
       SubscriptBox[
        RowBox[{"(", 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[PartialD]", "2"], "\[Rho]"}], 
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", "2"]}]], ")"}], 
        RowBox[{
         SuperscriptBox["x", "\[Prime]"], "=", "x"}]], 
       RowBox[{"\[DifferentialD]", "x"}]}]}]}], "=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         FractionBox["1", 
          SuperscriptBox["\[HBar]", "2"]]}], 
        RowBox[{"\[LeftAngleBracket]", 
         SuperscriptBox[
          OverscriptBox["p", "^"], "2"], "\[RightAngleBracket]"}]}], ")"}]}], 
     "=", 
     RowBox[{
      FractionBox["1", 
       SuperscriptBox["\[HBar]", "2"]], 
      RowBox[{"\[LeftAngleBracket]", 
       SuperscriptBox[
        OverscriptBox["p", "^"], "2"], "\[RightAngleBracket]"}]}]}]}]}], 
  TraditionalForm]], "Text",
