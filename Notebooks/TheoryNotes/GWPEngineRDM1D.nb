Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["I", "fric"], "=", 
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["\[HBar]", "2"], 
      RowBox[{
       SubscriptBox["\[Gamma]", "d"], "(", "t", ")"}]}], 
     RowBox[{"2", "m"}]], 
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
     RowBox[{
      SubscriptBox[
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          RowBox[{
           SuperscriptBox["\[PartialD]", "2"], "\[Rho]"}], 
          RowBox[{"\[PartialD]", 
           SuperscriptBox["x", "2"]}]], "-", " ", 
         FractionBox[
          RowBox[{
           SuperscriptBox["\[PartialD]", "2"], "\[Rho]"}], 
          RowBox[{
           RowBox[{"\[PartialD]", "x"}], 
           RowBox[{"\[PartialD]", 
            SuperscriptBox["x", "\[Prime]"]}]}]]}], ")"}], 
       RowBox[{
        SuperscriptBox["x", "\[Prime]"], "->", "x"}]], 
      RowBox[{"\[DifferentialD]", "x"}]}]}]}]}], TraditionalForm]], "Text",
