     RowBox[{
      SubscriptBox[
       OverscriptBox["V", "."], "2"], "(", "t", ")"}], 
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["x", "t", "2"], "+", 
       RowBox[{
        SubscriptBox["\[CapitalSigma]", "xx"], "(", "t", ")"}]}], ")"}]}]}]}],
   TraditionalForm]], "Text",
 CellChangeTimes->{{4.0011668128168173`*^9, 4.00116688580229*^9}, {
