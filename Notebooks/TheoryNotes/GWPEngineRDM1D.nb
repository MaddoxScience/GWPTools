Cell[TextData[{
 "causes the purely imaginary phase chirp ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Im", "(", 
    SubscriptBox["\[Alpha]", "t"], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4422b4a5-99b0-4b80-bb7e-8013ca31bf90"],
 " and momentum ",
 Cell[BoxData[
