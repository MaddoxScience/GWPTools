Cell[TextData[{
 "Next, we initialize a dynamic 2D wavepacket in an uncoupled isotropic \
harmonic oscillator (\[OpenCurlyDoubleQuote]Potential\[CloseCurlyDoubleQuote] \
-> \[OpenCurlyDoubleQuote]HO\[CloseCurlyDoubleQuote] with standard parameters \
(",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "100b5b0d-2310-4720-8b96-60a07d5241f9"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[HBar]", "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0da39c93-8df7-453e-8279-04ddafa4a01d"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", "x"], "=", 
    RowBox[{
     SubscriptBox["\[Omega]", "y"], "=", "1"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5a58da0b-08f0-4689-8a35-ea5fb15706be"],
 ") using a diagonal real shape matrix and an initial displacement along ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7714691f-5bab-4972-a772-af698ea22422"],
 ". Because the ground-state Gaussian width parameter is 1/2, this state is a \
displaced coherent state along ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "260c8b12-b19e-4f40-924d-c73b6035e044"],
 " ( ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", 
     RowBox[{
      RowBox[{"x", " ", "x"}], ",", "0"}]], "=", 
    RowBox[{"1", "/", "2"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f226d8ee-e727-4d64-ab01-d526e5308ce7"],
 ") and a stretched/squeezed state along ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "708ac8f2-5bd5-4b99-8046-1fdeaa76418b"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", 
     RowBox[{
      RowBox[{"y", " ", "y"}], ",", "0"}]], "=", 
    RowBox[{"1", "/", "4"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dc775fdb-5ea3-4775-a2ab-7579c32d8453"],
 "). Omitting the trailing momentum center and phase arguments defaults them \
to zero:"
}], "Text",
 CellChangeTimes->{{4.000899667746009*^9, 4.000899669936254*^9}, {
  4.0008998296271544`*^9, 4.000899899473942*^9}, {4.0008999537668333`*^9, 
  4.000899959252404*^9}, {4.000900010753899*^9, 4.000900027851457*^9}, {
  4.001709054611381*^9, 
  4.001709162289154*^9}},ExpressionUUID->"fd397464-3e8c-4b6f-a78b-\
7c85b45eecc1"],

Cell[CellGroupData[{

