Cell[CellGroupData[{

Cell["Two-Dimensional Wavepackets (GWPEngine2D)", "Section",
 CellChangeTimes->{{4.0008995201118593`*^9, 4.0008995301756163`*^9}, {
  4.001708951498706*^9, 
  4.001708954236305*^9}},ExpressionUUID->"141661a0-02d3-4042-a8a4-\
0b03738ad173"],

Cell["\<\
Next, we load GWPEngine2D to register the \[OpenCurlyDoubleQuote]2D\
\[CloseCurlyDoubleQuote] wavepacket type and its associated properties into \
the active session. A detailed mathematical treatment of the 2D Gaussian \
ansatz, Heller stability matrix linearization, and normal-mode propagators is \
available in the Notebooks/TheoryNotes/GWPEngine2D.nb notebook included with \
the package distribution (which serves as a precursor to a future Wolfram \
Documentation Center Tech Note).\
\>", "Text",
 CellChangeTimes->{{4.000894848496149*^9, 4.000894897403533*^9}, {
   4.000899536890386*^9, 4.0008995438310843`*^9}, 4.0017089667189302`*^9, 
   4.001709446442061*^9},ExpressionUUID->"ca5bce82-61a0-45d3-b387-\
e815c3591798"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Needs", "[", "\"\<MaddoxScience`GWPTools`GWPEngine2D`\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"GWP", "[", "\"\<Types\>\"", "]"}]}], "Input",
 CellChangeTimes->{{4.000891514852448*^9, 4.000891547010755*^9}, {
  4.000894904448255*^9, 4.0008949052173643`*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"2d997ef5-6ce1-4823-a46b-9f9a47ef61b8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"1D\"\>", ",", "\<\"2D\"\>"}], "}"}]], "Output",
 CellChangeTimes->{4.001706826071748*^9, 4.001712797912334*^9},
 CellLabel->"Out[29]=",ExpressionUUID->"71f25084-1ff7-4ac9-a84d-e55584474bfa"]
}, Open  ]],

Cell["\<\
Each wavepacket engine defines its own set of properties and analytical \
potential models. As prototype extensions, the multi-dimensional and \
multi-component engines currently implement a streamlined core subset of the \
full 1D property library:\
\>", "Text",
 CellChangeTimes->{{4.000894989169484*^9, 4.000895102188664*^9}, 
   4.001708977322954*^9},ExpressionUUID->"a3f1ff09-078d-4f17-b4ab-\
5cc886cf510e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Inspect", " ", "all", " ", "2", "D", " ", "properties", " ", "by", " ", 
    "class"}], "*)"}], 
  RowBox[{"TabView", "[", 
   RowBox[{"Dataset", "/@", 
    RowBox[{"Association", "@@", 
     RowBox[{"Rule", "@@@", 
      RowBox[{"Transpose", "@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"GWP", "[", "\"\<2D\>\"", "]"}], "[", "\"\<Classes\>\"", 
          "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"GWP", "[", "\"\<2D\>\"", "]"}], "[", 
            RowBox[{"\"\<Records\>\"", ",", "#"}], "]"}], "&"}], "/@", 
          RowBox[{
           RowBox[{"GWP", "[", "\"\<2D\>\"", "]"}], "[", "\"\<Classes\>\"", 
           "]"}]}]}], "}"}]}]}]}]}], "]"}]}]], "Input",
