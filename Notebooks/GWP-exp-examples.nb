Cell[BoxData[
 FractionBox[
  RowBox[{"63", " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"t", "/", "4"}]]}], 
  RowBox[{"128", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["11", "4"]}], "+", 
     FractionBox[
      RowBox[{"63", " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"t", "/", "4"}]]}], "16"], "+", 
     RowBox[{
