 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"GWP", " ", "2", "D"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"obj", "=", 
   RowBox[{
    RowBox[{"GWP", "[", "\"\<2D\>\"", "]"}], "[", 
    RowBox[{
