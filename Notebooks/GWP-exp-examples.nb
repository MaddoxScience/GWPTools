Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Symbolic", " ", "wavefunction", " ", "for", " ", "two", " ", "equal"}], "-", 
    RowBox[{
    "width", " ", "Gaussians", " ", "centered", " ", "at", " ", "x1", " ", 
     "and", " ", "x2"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"GWP", "[", "\"\<SS1D\>\"", "]"}], "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x1", ",", "x2"}], "}"}], ",", 
      RowBox[{"\"\<C\>\"", "->", "c"}]}], "]"}], "[", "\"\<PSIX\>\"", "]"}], "[",
    "x", "]"}]}]], "Input",
 CellChangeTimes->{{4.000909877032452*^9, 4.000909899393841*^9}, {
   4.0009115946503763`*^9, 4.0009116255958548`*^9}, {4.000911671853615*^9, 
   4.000911724504978*^9}, 4.001710069774892*^9},
 CellLabel->"In[51]:=",ExpressionUUID->"202a2c06-74b2-46ae-88e3-f23e16e370c1"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"x", "-", "x1"}], ")"}], "2"]}]], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["2", "\[Pi]"], ")"}], 
     RowBox[{"1", "/", "4"}]]}], "+", 
   RowBox[{"c", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"x", "-", "x2"}], ")"}], "2"]}]], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["2", "\[Pi]"], ")"}], 
     RowBox[{"1", "/", "4"}]]}]}], 
  SqrtBox[
   RowBox[{"1", "+", 
    SuperscriptBox["c", "2"], "+", 
    RowBox[{"2", " ", "c", " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x1", "-", "x2"}], ")"}], "2"]}]]}]}]]]], "Output",
 CellChangeTimes->{4.001712808087117*^9},
 CellLabel->"Out[51]=",ExpressionUUID->"bb4c9861-61ef-416d-9046-d235ce67f610"]
}, Open  ]],

Cell["\<\
Varying the relative mixing coefficient \[OpenCurlyDoubleQuote]C\
\[CloseCurlyDoubleQuote] controls the quantum interference between the two \
components. Below, we compare symmetric (\[OpenCurlyDoubleQuote]C\
\[CloseCurlyDoubleQuote] -> 1, constructive interference) and antisymmetric (\
\[OpenCurlyDoubleQuote]C\[CloseCurlyDoubleQuote] -> -1, destructive node at \
the origin) superpositions using the default initial state parameters, \
followed by an asymmetric two-Gaussian superposition with a complex relative \
phase (\[OpenCurlyDoubleQuote]C\[CloseCurlyDoubleQuote] -> Exp[I*Pi/3]):\
\>", "Text",
 CellChangeTimes->{
  4.001710087227685*^9},ExpressionUUID->"a4083080-59a9-4041-a04a-\
3b6c0010d563"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rho1", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"GWP", "[", "\"\<SS1D\>\"", "]"}], "[", 
      RowBox[{"\"\<C\>\"", "->", "1"}], "]"}], "[", "\"\<RHOX\>\"", "]"}], "[",
     "x", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rho2", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"GWP", "[", "\"\<SS1D\>\"", "]"}], "[", 
      RowBox[{"\"\<C\>\"", "->", 
       RowBox[{"-", "1"}]}], "]"}], "[", "\"\<RHOX\>\"", "]"}], "[", "x", 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.0009118190786343`*^9, 4.00091184313904*^9}},
 CellLabel->"In[52]:=",ExpressionUUID->"9f585bed-6014-4e9a-8306-3e79b19acd5f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"rho1", ",", "rho2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "3"}], ",", "3"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{4.00090944701637*^9, 4.000909539200892*^9}, {
