Cell[CellGroupData[{

Cell["Open-System Reduced Density Matrices (GWPEngineRDM1D)", "Section",
 CellChangeTimes->{{4.000997197111889*^9, 4.000997197852545*^9}, {
   4.000998103572653*^9, 4.000998104049292*^9}, 
   4.001712075065714*^9},ExpressionUUID->"5f2d225b-d32f-4fb4-a739-\
7109b30a0fc6"],

Cell["\<\
Finally, we load GWPEngineRDM1D to register the \[OpenCurlyDoubleQuote]RDM1D\
\[CloseCurlyDoubleQuote] wavepacket type, which extends GWPTools from \
pure-state wavefunctions to mixed-state Gaussian reduced density matrices \
$\\rho(x, x\[CloseCurlyQuote], t)$. (Extensive theoretical notes and \
derivations for this engine are available in \
Notebooks/TheoryNotes/GWPEngineRDM1D.nb.\
\>", "Text",
 CellChangeTimes->{{4.0017120876073523`*^9, 4.001712107024795*^9}, 
   4.001712279891898*^9},ExpressionUUID->"13928e15-b000-4893-bae0-\
ea187fb7d845"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Needs", "[", "\"\<MaddoxScience`GWPTools`GWPEngineRDM1D`\>\"", 
  "]"}], "\n", 
 RowBox[{"GWP", "[", "\"\<Types\>\"", "]"}]}], "Input",
 CellChangeTimes->{{4.001060614720042*^9, 4.001060648913341*^9}, {
   4.001060719354249*^9, 4.0010607233178177`*^9}, {4.001707079213292*^9, 
   4.001707079765648*^9}, 4.001712181346126*^9},
 CellLabel->"In[65]:=",ExpressionUUID->"9518df53-7f0f-4784-882d-7fc5df5c87bc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"1D\"\>", ",", "\<\"2D\"\>", ",", "\<\"SS1D\"\>", 
   ",", "\<\"MC1D\"\>", ",", "\<\"RDM1D\"\>"}], "}"}]], "Output",
 CellChangeTimes->{4.0017121837730713`*^9, 4.00171281476299*^9},
 CellLabel->"Out[66]=",ExpressionUUID->"f69029f7-fe87-4484-b000-12b92864e9ca"]
}, Open  ]],

Cell["\<\
Alongside the standard unitary potential models, RDM1D introduces analytical \
open-system potential models\[LongDash]such as \
\[OpenCurlyDoubleQuote]HarmonicCL\[CloseCurlyDoubleQuote]\[LongDash]governed \
by the Caldeira\[Dash]Leggett master equation:\
\>", "Text",
 CellChangeTimes->{
  4.0017123033890676`*^9},ExpressionUUID->"807ac718-510e-48b6-acb9-\
a9eace84d985"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Dataset", "@", 
  RowBox[{
   RowBox[{"GWP", "[", "\"\<RDM1D\>\"", "]"}], "[", "\"\<PotentialRecords\>\"",
    "]"}]}]], "Input",
