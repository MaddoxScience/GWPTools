Cell[CellGroupData[{

Cell["1D Superposition states (GWPEngineSS1D)", "Section",
 CellChangeTimes->{{4.00090668862952*^9, 4.000906703860963*^9}, {
  4.0017163930415154`*^9, 
  4.00171639824022*^9}},ExpressionUUID->"68493243-2fd6-4714-90cb-\
c35eb3814459"],

Cell["\<\
The GWPEngineSS1D sub-package registers the \[OpenCurlyDoubleQuote]SS1D\
\[CloseCurlyDoubleQuote] wavepacket type, which constructs a coherent \
two-term superposition of arbitrary 1D Gaussian wavepackets.\
\>", "Text",
 CellChangeTimes->{{4.000910195833446*^9, 4.000910198670308*^9}, {
  4.000910283509842*^9, 4.000910379381572*^9}, {4.0009107329793777`*^9, 
  4.0009107563260593`*^9}, {4.000910885101837*^9, 4.000910913135151*^9}, {
  4.0017099856106043`*^9, 
  4.0017099945877934`*^9}},ExpressionUUID->"2c7fc749-63f6-4ab0-a4f6-\
f4f79834f8aa"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Needs", "[", "\"\<MaddoxScience`GWPTools`GWPEngineSS1D`\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"GWP", "[", "\"\<Types\>\"", "]"}]}], "Input",
 CellChangeTimes->{{4.000906707254924*^9, 4.000906732649579*^9}, {
  4.000909299678164*^9, 4.00090931404527*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"bd7287ed-29ab-4614-b0da-42b80f01b859"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"1D\"\>", ",", "\<\"2D\"\>", ",", "\<\"SS1D\"\>"}], 
  "}"}]], "Output",
 CellChangeTimes->{4.001706906167523*^9, 4.0017128080163794`*^9},
 CellLabel->"Out[47]=",ExpressionUUID->"8a8df7c4-b582-478e-b9e5-5b25e478e0ac"]
}, Open  ]],

Cell["\<\
Currently, SS1D implements a focused set of coordinate-space wavefunction and \
probability properties:\
\>", "Text",
 CellChangeTimes->{{4.00091245328962*^9, 4.000912460912506*^9}, {
   4.000913695762244*^9, 4.000913702328526*^9}, 
   4.001710008195364*^9},ExpressionUUID->"140edf1a-f722-43fc-bc20-\
fb3208bd4d54"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"GWP", "[", "\"\<SS1D\>\"", "]"}], "[", "\"\<Properties\>\"", 
  "]"}]], "Input",
 CellChangeTimes->{{4.000909379575601*^9, 4.000909429334828*^9}},
 CellLabel->"In[48]:=",ExpressionUUID->"7a76c695-acbe-418f-a794-06d633d76e26"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"ConjugateWavefunctionX\"\>", 
   ",", "\<\"CumulativeDistributionX\"\>", ",", "\<\"DensityX\"\>", 
   ",", "\<\"Normalization\"\>", ",", "\<\"WavefunctionX\"\>"}], 
  "}"}]], "Output",
 CellChangeTimes->{4.001706908135594*^9, 4.0017128080209627`*^9},
 CellLabel->"Out[48]=",ExpressionUUID->"f8087567-35b7-417b-a9a8-336df2ec7a08"]
}, Open  ]],

Cell["\<\
However, it inherits the complete library of analytical potential models from \
the base 1D engine:\
\>", "Text",
 CellChangeTimes->{{4.000912463569901*^9, 4.0009124997707872`*^9}, {
   4.000913703960472*^9, 4.000913704921296*^9}, 
   4.001710018711357*^9},ExpressionUUID->"06d9f423-1cec-4190-8370-\
527cde3437de"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"GWP", "[", "\"\<SS1D\>\"", "]"}], "[", "\"\<PotentialNames\>\"", 
  "]"}]], "Input",
 CellChangeTimes->{{4.0009124801420193`*^9, 4.00091249148343*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"a1839ae7-c703-443c-9c6d-7fde0cd8165b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Free\"\>", ",", "\<\"Harmonic\"\>", ",", "\<\"HO\"\>", 
   ",", "\<\"Linear\"\>", ",", "\<\"LinearForcedHO\"\>", 
   ",", "\<\"NonResonantForcedHO\"\>", ",", "\<\"ParabolicBarrier\"\>", 
   ",", "\<\"ResonantForcedHO\"\>"}], "}"}]], "Output",
 CellChangeTimes->{4.0017069112441673`*^9, 4.001712808036121*^9},
 CellLabel->"Out[49]=",ExpressionUUID->"9ace4069-51b5-43fe-bf17-0a99c2fd62d6"]
}, Open  ]],

Cell["\<\
The positional constructor arguments mirror those of GWP[\
\[OpenCurlyDoubleQuote]1D\[CloseCurlyDoubleQuote]], except each parameter is \
passed as a two-element list {param1, param2} representing the two Gaussian \
branches. An additional option, \[OpenCurlyDoubleQuote]C\
\[CloseCurlyDoubleQuote], specifies the complex relative weight of the second \
wavepacket with respect to the first:\
\>", "Text",
 CellChangeTimes->{{4.000911400454606*^9, 4.000911451674712*^9}, {
   4.000911516995144*^9, 4.000911578626439*^9}, {4.0009117450280323`*^9, 
   4.0009117670594997`*^9}, 
   4.0017100339387712`*^9},ExpressionUUID->"63781d8a-225e-48a0-bc93-\
470e3a97f60f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"obj", "=", 
  RowBox[{
   RowBox[{"GWP", "[", "\"\<SS1D\>\"", "]"}], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"RA1", "+", 
       RowBox[{"I", "*", "IA1"}]}], ",", 
      RowBox[{"RA2", "+", 
       RowBox[{"I", "*", "IA2"}]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"RX1", ",", "RX2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"RP1", ",", "RP2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"RG1", "+", 
       RowBox[{"I", "*", "IG1"}]}], ",", 
      RowBox[{"RG2", "+", 
       RowBox[{"I", "*", "IG2"}]}]}], "}"}], ",", 
    RowBox[{"\"\<C\>\"", "->", 
     RowBox[{"RC", "+", 
      RowBox[{"I", "*", "IC"}]}]}], ",", 
    RowBox[{"\"\<MASS\>\"", "->", "MASS"}], ",", 
    RowBox[{"\"\<HBAR\>\"", "->", "HBAR"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{4.000909954751666*^9, 4.00091003992842*^9}, {
  4.000911494597556*^9, 4.0009115074115667`*^9}},
 CellLabel->"In[50]:=",ExpressionUUID->"3790222d-5be9-4f9c-b7d0-ec58565db2c6"],

