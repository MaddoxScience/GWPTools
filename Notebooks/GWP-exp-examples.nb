 CellLabel->"In[33]:=",ExpressionUUID->"6be41360-6b56-43a4-a832-16f6283299cb"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{
    FractionBox["IG", "HBAR"], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "IAXX"}], "-", "RAXX"}], ")"}], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "RX"}], "+", "x"}], ")"}], "2"]}], "-", 
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[ImaginaryI]", " ", "IAXY"}], "+", "RAXY"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "RX"}], "+", "x"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "RY"}], "+", "y"}], ")"}]}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"IAYY", "+", "RAYY"}], ")"}], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "RY"}], "+", "y"}], ")"}], "2"]}], "+", 
    FractionBox[
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[ImaginaryI]", " ", "IG"}], "+", "RG", "+", 
        RowBox[{"RPX", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "RX"}], "+", "x"}], ")"}]}], "+", 
        RowBox[{"RPY", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "RY"}], "+", "y"}], ")"}]}]}], ")"}]}], "HBAR"]}]], " ", 
  SqrtBox[
   FractionBox["2", "\[Pi]"]], " ", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox["RAXY", "2"]}], "+", 
     RowBox[{"RAXX", " ", 
      RowBox[{"(", 
       RowBox[{"IAYY", "+", "RAYY"}], ")"}]}]}], ")"}], 
   RowBox[{"1", "/", "4"}]]}]], "Output",
 CellChangeTimes->{4.00171279877127*^9},
 CellLabel->"Out[33]=",ExpressionUUID->"35f87b7f-746e-4e9b-81d6-42d099737d04"]
}, Open  ]],

