($CellContext`RA1 $CellContext`RA2 ((-2) $CellContext`RG1 + 
                  2 $CellContext`RG2 + ($CellContext`RP1 + $CellContext`RP2) \
($CellContext`RX1 - $CellContext`RX2)) + $CellContext`RA2^2 \
