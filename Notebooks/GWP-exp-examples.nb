  RowBox[{"(*", 
   RowBox[{"Position", " ", "uncertainties", " ", "along", " ", "x", " ", 
    RowBox[{"(", "stationary", ")"}], " ", "and", " ", "y", " ", 
    RowBox[{"(", "breathing", ")"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"obj", "[", "\"\<UX\>\"", "]"}], "[", "t", "]"}], "\n", 
   RowBox[{
    RowBox[{"obj", "[", "\"\<UY\>\"", "]"}], "[", "t", "]"}]}]}]], "Input",
 CellChangeTimes->{{4.000900071118084*^9, 4.000900078572741*^9}, {
  4.00170923955951*^9, 4.001709241558127*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"9655ce9b-e76a-47fa-92a1-4eab7f3c289d"],

Cell[BoxData[
 FractionBox["1", 
  SqrtBox["2"]]], "Output",
 CellChangeTimes->{4.001712798950528*^9},
 CellLabel->"Out[38]=",ExpressionUUID->"a2dbe3a4-4910-4e1a-9b70-4b17610c930f"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "2"], " ", 
  SqrtBox[
   RowBox[{
    RowBox[{"4", " ", 
     SuperscriptBox[
      RowBox[{"Cos", "[", "t", "]"}], "2"]}], "+", 
    SuperscriptBox[
     RowBox[{"Sin", "[", "t", "]"}], "2"]}]]}]], "Output",
 CellChangeTimes->{4.001712798954603*^9},
 CellLabel->"Out[39]=",ExpressionUUID->"18bab60c-4e29-4bf7-acc7-61f35a2e7626"]
}, Open  ]],

Cell[TextData[{
 "Evaluate the cell below to animate the 2D probability density over one trap \
period (showing classical oscillation along ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5342875f-87c4-4148-8f13-4904d1daf480"],
 " combined with symmetric width breathing along ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d676e214-2483-429d-a87a-ed3b2cc11af1"],
 "):"
}], "Text",
 CellChangeTimes->{{4.000900103491428*^9, 4.000900108368503*^9}, {
  4.001709256181539*^9, 
  4.0017092658059607`*^9}},ExpressionUUID->"d25629d1-1381-4321-be89-\
7e21015deb73"],

Cell[BoxData[
 RowBox[{"ListAnimate", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Plot3D", "[", 
     RowBox[{"rho", ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", 
        RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", 
      RowBox[{"2", "Pi"}], ",", 
      RowBox[{"2", 
       RowBox[{"Pi", "/", "100"}]}]}], "}"}]}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{4.000898644389461*^9, 4.000898715192416*^9}},
 CellLabel->"In[40]:=",ExpressionUUID->"33d48834-882b-4b18-ac1f-54a560b7e28a"],

Cell[TextData[{
 "Finally, we demonstrate the parameterized \[OpenCurlyDoubleQuote]Harmonic\
\[CloseCurlyDoubleQuote] potential model {\[OpenCurlyDoubleQuote]Harmonic\
\[CloseCurlyDoubleQuote], omegaX, omegaY, omegaXY} with strong bilinear mode \
coupling ( ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", 
     RowBox[{"x", " ", "y"}]], "=", 
    RowBox[{"7", "/", "8"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "039f61e6-06db-4b8f-848d-10f8272c3dde"],
 "):"
}], "Text",
 CellChangeTimes->{{4.0009061894263973`*^9, 4.000906213639069*^9}, {
  4.0009066074104156`*^9, 4.0009066129315557`*^9}, {4.001709282230813*^9, 
  4.0017093162134666`*^9}},ExpressionUUID->"ea8dd430-c66d-40ca-abd2-\
f1179ab4b11a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"obj", "=", 
  RowBox[{
   RowBox[{"GWP", "[", "\"\<2D\>\"", "]"}], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "2"}], ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"1", "/", "4"}]}], "}"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{"-", "2"}]}], "}"}], ",", 
    RowBox[{"\"\<Potential\>\"", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Harmonic\>\"", ",", "1", ",", "1", ",", 
       RowBox[{"7", "/", "8"}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{4.000906225488678*^9, 4.000906265328964*^9}, {
   4.000906320114003*^9, 4.000906320256407*^9}, {4.000906360666924*^9, 
   4.000906360873375*^9}, {4.000906396554531*^9, 4.0009064075584583`*^9}, {
