             4 $CellContext`HBAR ($CellContext`IG1 + $CellContext`IG2 + \
$CellContext`HBAR $CellContext`RA1 $CellContext`RA2 ($CellContext`RA1 + \
$CellContext`RA2)^(-1) ($CellContext`RX1 - $CellContext`RX2)^2) + \
($CellContext`RA1 + $CellContext`RA2)^(-1) ((-$CellContext`IA1 + \
$CellContext`IA2)^2 + ($CellContext`RA1 + $CellContext`RA2)^2)^(-1) \
($CellContext`RA2 (-$CellContext`RP1 + $CellContext`RP2 + 
                  2 $CellContext`HBAR $CellContext`IA1 (-$CellContext`RX1 + \
$CellContext`RX2)) + $CellContext`RA1 (-$CellContext`RP1 + $CellContext`RP2 + 
                  2 $CellContext`HBAR $CellContext`IA2 (-$CellContext`RX1 + \
$CellContext`RX2)))^2)) $CellContext`IC $CellContext`RA1^
          Rational[1, 4] $CellContext`RA2^
          Rational[
           1, 4] ((-$CellContext`IA1 + $CellContext`IA2)^2 + \
($CellContext`RA1 + $CellContext`RA2)^2)^Rational[-1, 4] 
         Sin[Rational[
            1, 4] ($CellContext`HBAR^(-2) ((-$CellContext`IA1 + \
$CellContext`IA2) ($CellContext`RA1 + $CellContext`RA2)^(-2) \
((-$CellContext`IA1 + $CellContext`IA2)^2 + ($CellContext`RA1 + \
$CellContext`RA2)^2)^(-1) ($CellContext`RA2 (-$CellContext`RP1 + \
$CellContext`RP2 + 
                   2 $CellContext`HBAR $CellContext`IA1 (-$CellContext`RX1 + \
$CellContext`RX2)) + $CellContext`RA1 (-$CellContext`RP1 + $CellContext`RP2 + 
                   2 $CellContext`HBAR $CellContext`IA2 (-$CellContext`RX1 + \
$CellContext`RX2)))^2 + 
