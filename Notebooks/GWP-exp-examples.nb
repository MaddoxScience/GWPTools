 CellLabel->"Out[56]=",ExpressionUUID->"74dd07af-b4f2-49fb-b008-bc7eb66a6e94"]
}, Open  ]],

Cell[TextData[{
 "Finally, a classic dynamical example\[LongDash]a coherent superposition of \
a displaced coherent state (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", 
     RowBox[{"1", ",", "0"}]], "=", 
    RowBox[{"-", "5"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a489f789-83bc-4de0-8c3a-20da350fc734"],
 ") and the stationary ground state (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", 
     RowBox[{"2", ",", "0"}]], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2fe01045-4b2a-4c6c-b32a-12c8d4a66968"],
 ") in a harmonic oscillator (\[OpenCurlyDoubleQuote]Potential\
\[CloseCurlyDoubleQuote] -> \
\[OpenCurlyDoubleQuote]HO\[CloseCurlyDoubleQuote])\[LongDash]shows the \
displaced branch sweeping periodically through the stationary ground state \
and generating transient interference fringes at every collision: "
}], "Text",
 CellChangeTimes->{{4.0009123950042877`*^9, 4.000912404180254*^9}, {
  4.000913550505188*^9, 4.000913558824169*^9}, {4.000913652728053*^9, 
  4.000913675062274*^9}, {4.001710134999922*^9, 
  4.0017101713994217`*^9}},ExpressionUUID->"ccd34d05-2833-487b-9eb0-\
29637d9418b0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rho4", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"GWP", "[", "\"\<SS1D\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "2"}], ",", 
         RowBox[{"1", "/", "2"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "5"}], ",", "0"}], "}"}], ",", 
       RowBox[{"\"\<Potential\>\"", "->", "\"\<HO\>\""}]}], "]"}], 
     "[", "\"\<RHOX\>\"", "]"}], "[", 
    RowBox[{"x", ",", "t"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.000912413262941*^9, 4.000912448833626*^9}, {
  4.0009135652923098`*^9, 4.0009135657690697`*^9}},
 CellLabel->"In[57]:=",ExpressionUUID->"93b8b324-b9c0-4160-a94a-69db208fd60d"],

Cell[BoxData[
 RowBox[{"ListAnimate", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Plot", "[", 
     RowBox[{"rho4", ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", 
      RowBox[{"2", "Pi"}], ",", 
      RowBox[{"2", 
       RowBox[{"Pi", "/", "100"}]}]}], "}"}]}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{4.00091356967203*^9, 4.000913630154937*^9}},
 CellLabel->"In[58]:=",ExpressionUUID->"edff5c43-d802-4b8d-86bd-bae9d4962e9f"]
}, Closed]],

Cell[CellGroupData[{

Cell["1D Multi-Component Superpositions (GWPEngineMC1D)", "Section",
 CellChangeTimes->{{4.000913783758819*^9, 4.000913790441662*^9}, 
   4.001710313226142*^9},ExpressionUUID->"de5dc80d-2e68-405f-8bc6-\
6fc61ddca47c"],

Cell[TextData[{
 "The GWPEngineMC1D sub-package generalizes and supersedes SS1D by \
constructing coherent superpositions of an arbitrary number ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "abc4cc33-e940-45a8-ab3a-4d8cb021eeb4"],
 " of 1D Gaussian wavepacket components: "
}], "Text",
 CellChangeTimes->{{4.0009137944653254`*^9, 4.0009138409824457`*^9}, {
  4.001710330495294*^9, 
  4.001710335930378*^9}},ExpressionUUID->"37ea5e2d-431b-40b1-b974-\
f214f060f0a9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Needs", "[", "\"\<MaddoxScience`GWPTools`GWPEngineMC1D`\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"GWP", "[", "\"\<Types\>\"", "]"}]}], "Input",
 CellChangeTimes->{{4.000913849535647*^9, 4.0009138913956947`*^9}},
 CellLabel->"In[59]:=",ExpressionUUID->"5ccd0fdf-5fbd-41f0-b334-621f29d9d90c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"1D\"\>", ",", "\<\"2D\"\>", ",", "\<\"SS1D\"\>", 
   ",", "\<\"MC1D\"\>"}], "}"}]], "Output",
 CellChangeTimes->{4.0017128124310417`*^9},
 CellLabel->"Out[60]=",ExpressionUUID->"c578ce7b-b59d-42da-be85-0ec41a7f8cb6"]
}, Open  ]],

Cell["\<\
Like SS1D, this prototype engine currently implements a focused set of \
coordinate-space properties while supporting all analytical potential models \
from the base 1D library\[LongDash]providing a flexible foundation for \
multi-state wavepacket trains and basis-set expansions:\
\>", "Text",
 CellChangeTimes->{{4.000913975408422*^9, 4.000913984069602*^9}, {
  4.000995101139292*^9, 4.000995113262019*^9}, {4.001710352417551*^9, 
  4.0017103703666763`*^9}},ExpressionUUID->"684a04c0-c425-44e7-a8c2-\
5463c617ce29"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"GWP", "[", "\"\<MC1D\>\"", "]"}], "[", "\"\<Properties\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GWP", "[", "\"\<MC1D\>\"", "]"}], "[", "\"\<PotentialNames\>\"", 
  "]"}]}], "Input",
 CellChangeTimes->{{4.0009139242558517`*^9, 4.000913973139832*^9}},
 CellLabel->"In[61]:=",ExpressionUUID->"b0493d6b-aad0-4709-97c3-85a4cf6f877a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"ConjugateWavefunctionX\"\>", 
   ",", "\<\"CumulativeDistributionX\"\>", ",", "\<\"DensityX\"\>", 
   ",", "\<\"Normalization\"\>", ",", "\<\"WavefunctionX\"\>"}], 
  "}"}]], "Output",
 CellChangeTimes->{4.001706953940024*^9, 4.0017128124388733`*^9},
 CellLabel->"Out[61]=",ExpressionUUID->"693f5234-c5cb-4df4-833c-9e16dc1acd6c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Free\"\>", ",", "\<\"HO\"\>"}], "}"}]], "Output",
 CellChangeTimes->{4.001706953940024*^9, 4.0017128124415417`*^9},
 CellLabel->"Out[62]=",ExpressionUUID->"3188e92f-cb94-4467-8260-72505f59c5cf"]
}, Open  ]],

Cell[TextData[{
 "Calling GWP[\[OpenCurlyDoubleQuote]MC1D\[CloseCurlyDoubleQuote]][] with no \
arguments initializes a default two-component state, while passing \
$N$-element parameter lists along with the weight option \
\[OpenCurlyDoubleQuote]C\[CloseCurlyDoubleQuote] -> {c1, c2, ..., cN} \
constructs an $N$-state superposition. Below, we initialize and plot the \
spatial probability density of a symmetric three-component Gaussian \
wavepacket train centered at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "0"], "\[Element]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "3"}], ",", "0", ",", "3"}], "}"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "da9ca709-bf2a-4c11-b4f7-b56aed7ba180"],
 ": "
}], "Text",
 CellChangeTimes->{{4.001710373560124*^9, 
  4.0017103972020187`*^9}},ExpressionUUID->"af4bef6a-58ae-4948-b0f2-\
93a9964e0ea1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"obj", "=", 
  RowBox[{
   RowBox[{"GWP", "[", "\"\<MC1D\>\"", "]"}], "[", "]"}]}]], "Input",
