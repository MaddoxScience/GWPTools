   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"RAXX", "+", 
         RowBox[{"I", "*", "IAXX"}]}], ",", 
        RowBox[{"RAXY", "+", 
         RowBox[{"I", "*", "IAXY"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"RAXY", "+", 
