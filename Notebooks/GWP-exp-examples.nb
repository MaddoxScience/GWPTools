Cell[TextData[{
 "Unlike the isolated unitary harmonic oscillator, environmental friction and \
thermal diffusion damp the classical trajectory and width breathing over \
time, relaxing both the real shape parameter RA and the diagonal spatial \
probability density RHOX (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "(", 
    RowBox[{"x", ",", "x", ",", "t"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2baccc5d-ac8c-4ced-a807-d3a253859dcc"],
 ") toward a stationary thermal Gibbs distribution:"
}], "Text",
 CellChangeTimes->{
  4.00171249271867*^9, {4.001712721270013*^9, 
   4.00171273027579*^9}},ExpressionUUID->"2b47945d-6cba-4dd4-8e9e-\
323754e4132e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Visualize", " ", "dissipative", " ", "relaxation", " ", "of", " ", "the", 
    " ", "spatial", " ", "probability", " ", "density"}], "*)"}], 
  RowBox[{"Plot3D", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"obj", "[", "\"\<RHOX\>\"", "]"}], "[", 
     RowBox[{"x", ",", "t"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", 
      RowBox[{"4", "*", "2", "*", "Pi"}]}], "}"}], ",", 
    RowBox[{"{", 
