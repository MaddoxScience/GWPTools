Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Coordinate", "-", 
    RowBox[{"space", " ", "wavefunction"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"obj", "[", "\"\<PSIX\>\"", "]"}], "[", 
   RowBox[{"x", ",", "y"}], "]"}]}]], "Input",
