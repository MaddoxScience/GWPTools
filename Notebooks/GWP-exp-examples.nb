   RowBox[{"Dataset", "/@", 
    RowBox[{"Association", "@@", 
     RowBox[{"Rule", "@@@", 
      RowBox[{"Transpose", "@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", "\"\<Classes\>\"", 
          "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
            RowBox[{"\"\<Records\>\"", ",", "#"}], "]"}], "&"}], "/@", 
          RowBox[{
           RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", "\"\<Classes\>\"", 
           "]"}]}]}], "}"}]}]}]}]}], "]"}]}]], "Input",
