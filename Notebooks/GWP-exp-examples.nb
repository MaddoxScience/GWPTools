Cell[TextData[{
 "Below, we initialize a displaced and stretched Gaussian density matrix ( ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "0"], "=", 
    RowBox[{"1", "/", "4"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8530e65e-f0f7-47a3-9573-3234ac81177b"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "0"], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9fab9a7a-2d0a-4c04-b337-3ae273d820e3"],
 ") in a harmonic oscillator coupled to an Ohmic thermal reservoir using \
\[OpenCurlyDoubleQuote]Potential\[CloseCurlyDoubleQuote] -> {\
\[OpenCurlyDoubleQuote]HarmonicCL\[CloseCurlyDoubleQuote], omega, gamma, kT} \
with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "21421268-a938-4cd2-91c4-005664986def"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "d"], "=", 
    RowBox[{"1", "/", "4"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c81da74d-483a-469f-ab1c-21b3f4e46e2c"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["k", "B"], "T"}], "=", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9a4bd9b4-bff2-4247-b5d8-7421a7b38a67"],
 ". Omitting the trailing momentum center, phase, and initial thermal \
decoherence parameter ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f45c3a06-295e-49b4-933b-d6ed96ee3e05"],
 " defaults them to zero:"
}], "Text",
 CellChangeTimes->{{4.0017123254413633`*^9, 4.00171240481469*^9}, {
  4.001712696255116*^9, 
  4.00171270224669*^9}},ExpressionUUID->"3e115c5a-09f9-4107-805d-\
db2b9a151053"],

