Cell[TextData[{
 "When a GWPObject is initialized with a \[OpenCurlyDoubleQuote]Potential\
\[CloseCurlyDoubleQuote] model, passing the \[OpenCurlyDoubleQuote]Time\
\[CloseCurlyDoubleQuote] \[Rule] t0 option (default 0) instructs GWPEnsemble \
to propagate the wavepacket parameters to time ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "43c7af8a-91ef-472e-acc4-a7e5b6d5a068"],
 " prior to generating the coordinate ensemble.   Below, we initialize a \
squeezed, displaced wavepacket (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "0"], "=", 
    RowBox[{"1", "/", "2"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e52ff238-e001-4ca5-a101-630a37325be8"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "0"], "=", 
    RowBox[{"-", "2"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7d848169-5c12-4007-95e7-4217b56b1b16"],
 ") in a harmonic oscillator (\[OpenCurlyDoubleQuote]Potential\
\[CloseCurlyDoubleQuote] \[Rule] \[OpenCurlyDoubleQuote]HO\
\[CloseCurlyDoubleQuote]) and sample its 15-point quantile ensemble at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "47f71c66-69e0-4fc8-8be8-42a69d9b66fb"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", 
    RowBox[{"\[Pi]", "/", "2"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "40a6e167-e95a-43a1-8cd0-81fdae316df6"],
 " (origin crossing with compressed width), and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", "\[Pi]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ce29c1f6-b871-4d3a-8ba3-211c8a9a55bd"],
 " (right turning point):"
}], "Text",
 CellChangeTimes->{{4.002131848931081*^9, 4.002131884017013*^9}, {
  4.002132179284726*^9, 
  4.0021322419964046`*^9}},ExpressionUUID->"b27a8a6f-b688-48a5-9f8b-\
e317f28bff1f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"objDyn", "=", 
    RowBox[{
     RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
     RowBox[{
      RowBox[{"1", "/", "2"}], ",", 
      RowBox[{"-", "2"}], ",", 
      RowBox[{"\"\<Potential\>\"", "->", "\"\<HO\>\""}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ensT0", "=", 
   RowBox[{"GWPEnsemble", "[", 
    RowBox[{"objDyn", ",", 
     RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<UniformC\>\""}], ",", 
