Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"objDyn", "=", 
   RowBox[{
    RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
    RowBox[{
     RowBox[{"1", "/", "2"}], ",", 
     RowBox[{"-", "2"}], ",", "0", ",", 
     RowBox[{"\"\<Potential\>\"", "->", "\"\<HO\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ensT0", "=", 
   RowBox[{"GWPEnsemble", "[", 
    RowBox[{"objDyn", ",", 
     RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<UniformC\>\""}], ",", 
     RowBox[{"\"\<Grid\>\"", "->", "15"}], ",", 
     RowBox[{"\"\<Time\>\"", "->", "0"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ensT1", "=", 
   RowBox[{"GWPEnsemble", "[", 
    RowBox[{"objDyn", ",", 
     RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<UniformC\>\""}], ",", 
     RowBox[{"\"\<Grid\>\"", "->", "15"}], ",", 
     RowBox[{"\"\<Time\>\"", "->", 
      RowBox[{"Pi", "/", "2"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ensT2", "=", 
    RowBox[{"GWPEnsemble", "[", 
     RowBox[{"objDyn", ",", 
      RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<UniformC\>\""}], ",", 
      RowBox[{"\"\<Grid\>\"", "->", "15"}], ",", 
      RowBox[{"\"\<Time\>\"", "->", "Pi"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"objDyn", "[", "\"\<RHOX\>\"", "]"}], "[", 
        RowBox[{"x", ",", "0"}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"objDyn", "[", "\"\<RHOX\>\"", "]"}], "[", 
        RowBox[{"x", ",", 
         RowBox[{"Pi", "/", "2"}]}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"objDyn", "[", "\"\<RHOX\>\"", "]"}], "[", 
        RowBox[{"x", ",", "Pi"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.2"}], ",", "0.9"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<x\>\"", ",", "\"\<\[Rho](x,t)\>\""}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "->", 
