Notebook[{

Cell[CellGroupData[{
Cell["GWPEnsemble and EnsembleTrajectoryTools", "Title",
 CellChangeTimes->{{4.001775041095405*^9, 4.001775052150195*^9}, {
  4.002211452004697*^9, 4.0022114692242537`*^9}, {4.0022210830833406`*^9, 
  4.002221085194689*^9}},ExpressionUUID->"b755997f-566f-4f4d-9be3-\
c184ad0121e7"],

Cell["Jeremy B. Maddox", "Author",
 CellChangeTimes->{{3.988201532003448*^9, 
  3.988201536787407*^9}},ExpressionUUID->"f9796ecd-52dc-44b1-ab3d-\
d7cdf3ebc678"],

Cell["\<\
Department of Chemistry and Biochemistry
Western Kentucky University
Bowling Green, KY 42101-1079
Email: jeremy.maddox@wku.edu\
\>", "Affiliation",
 CellChangeTimes->{{3.988201549259402*^9, 
  3.988201579115401*^9}},ExpressionUUID->"b7217d74-bf0b-4029-8ac3-\
c812a0d96213"],

Cell["\<\
The GWPEnsemble package generates structured coordinate and phase-space point \
ensembles from GWPObject instances across the 1D, SS1D, MC1D, and 2D \
wavepacket engines. These ensembles provide initial condition grids and \
trajectory markers for quantum hydrodynamic (Bohmian) propagation, \
semiclassical phase-space sampling, and Monte Carlo integration.\
\>", "Text",
 CellChangeTimes->{
  4.002128701193407*^9},ExpressionUUID->"63012113-dbab-4e8d-bb28-\
20848d1967b2"],

Cell[CellGroupData[{

