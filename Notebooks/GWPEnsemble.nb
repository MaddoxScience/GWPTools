 CellChangeTimes->{{4.002147774684801*^9, 4.002147780965578*^9}, 
   4.002211476093889*^9},ExpressionUUID->"bff2a307-dd61-4a3c-b729-\
327db2621ee5"],

Cell[CellGroupData[{

Cell["\<\
1D Squeezed & Displaced Harmonic Oscillator (Affine Breathing + Oscillation)\
\>", "Subsection",
 CellChangeTimes->{{4.0021934584264936`*^9, 
  4.002193480681003*^9}},ExpressionUUID->"ad82f3f6-1242-4ecf-9884-\
384a386a1a7f"],

Cell[TextData[{
 "A single 1D Gaussian wavepacket displaced from equilibrium with an initial \
width narrower than the ground state exhibits classical center-of-mass \
sloshing combined with quantum width breathing at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Omega]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6a25e1ae-aa7e-4e7b-aeb7-98092f5ce19c"],
 ". Because the single-Gaussian Bohmian velocity field is strictly linear in ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "39962220-334d-45d4-b13b-320b9d399a7c"],
 ", the quantile trajectories form a non-crossing affine fan that expands and \
contracts in lockstep with the analytical standard deviation envelope."
}], "Text",
 CellChangeTimes->{
  4.002193472642293*^9, {4.0021936758453197`*^9, 
   4.0021936926547194`*^9}},ExpressionUUID->"4cbbe923-ce6d-470a-960b-\
c20550f541f3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Displaced", " ", 
    RowBox[{"(", 
     RowBox[{"r0", "=", 
      RowBox[{"-", "2"}]}], ")"}], " ", "and", " ", "squeezed", " ", 
    RowBox[{"(", 
     RowBox[{"a0", "=", "2"}], ")"}], " ", "1", "D", " ", "harmonic", " ", 
    "oscillator"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"obj1D", "=", 
     RowBox[{
      RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
      RowBox[{"2", ",", 
       RowBox[{"-", "2"}], ",", "0", ",", 
       RowBox[{"\"\<Potential\>\"", "->", "\"\<HO\>\""}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Sample", " ", "21", " ", "equiquantile", " ", "initial", " ", 
     "positions", " ", "via", " ", "UniformC"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x0", "=", 
     RowBox[{"GWPEnsemble", "[", 
      RowBox[{"obj1D", ",", 
       RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<UniformC\>\""}], ",", 
       RowBox[{"\"\<Grid\>\"", "->", "21"}], ",", 
       RowBox[{"\"\<Time\>\"", "->", "0"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Propagate", " ", "1", "st"}], "-", 
     RowBox[{
     "order", " ", "Bohmian", " ", "trajectories", " ", "over", " ", "one", " ",
       "full", " ", 
      RowBox[{"period", "[", 
       RowBox[{"0", ",", 
        RowBox[{"2", " ", "Pi"}]}], "]"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"sol1D", "=", 
     RowBox[{"EnsembleSolve", "[", 
      RowBox[{"x0", ",", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "t"}], "}"}], ",", 
         RowBox[{
          RowBox[{"obj1D", "[", "\"\<VX\>\"", "]"}], "[", 
          RowBox[{"x", ",", "t"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", 
         RowBox[{"2", " ", "Pi"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"parsed1D", "=", 
     RowBox[{"EnsembleParse", "[", 
      RowBox[{"x0", ",", "sol1D"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"traj1D", "=", 
     RowBox[{"EnsembleFormat", "[", 
      RowBox[{"parsed1D", ",", "\"\<X0DAT\>\""}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Plot", " ", "trajectories", " ", "alongside", " ", "the", " ", 
     "classical", " ", "center", " ", "RX", 
     RowBox[{"(", "t", ")"}]}], "*)"}], "\n", 
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ListLinePlot", "[", 
      RowBox[{"traj1D", ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"Opacity", "[", "0.6", "]"}], ",", 
          RowBox[{"ColorData", "[", 
           RowBox[{"97", ",", "1"}], "]"}]}], "]"}]}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<t\>\"", ",", "\"\<x(t)\>\""}], "}"}]}], ",", 
       RowBox[{
       "PlotLabel", 
        "->", "\"\<1D Squeezed Coherent State: Quantile Bohmian \
Trajectories\>\""}]}], "]"}], ",", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"obj1D", "[", "\"\<RX\>\"", "]"}], "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", 
         RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Black", ",", "Dashed", ",", "Thick"}], "}"}]}]}], "]"}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{4.002193488820788*^9, 4.0021935348878183`*^9}, {
  4.002193576143093*^9, 4.0021935774621067`*^9}, {4.002193616334557*^9, 
  4.002193662954924*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"abf6175f-4182-44a1-93d3-3d6de2e4c890"],

