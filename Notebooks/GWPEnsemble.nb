Cell[CellGroupData[{

Cell["Superposition Examples (SS1D and MC1D)", "Section",
 CellChangeTimes->{{4.002134065294366*^9, 4.002134096555992*^9}, {
  4.0021358923700733`*^9, 
  4.002135892673098*^9}},ExpressionUUID->"e61ef5a3-9f94-4286-83ca-\
28b8de1d5ddd"],

Cell[TextData[{
 "For two-state (SS1D) and multi-component (MC1D) superpositions, quantum \
interference between overlapping Gaussian branches produces oscillatory nodes \
and fringes in the probability density ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "(", 
    RowBox[{"x", ",", "t"}], ")"}], TraditionalForm]],ExpressionUUID->
  "7d8a5ca9-59c5-45b6-b22a-29bd6c5e7c64"],
 ". Consequently, the cumulative distribution function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", "x", ")"}], TraditionalForm]],ExpressionUUID->
  "0de8f1ec-0b01-4153-88af-63ccba7ba392"],
 " cannot be inverted analytically in closed form.  "
}], "Text",
 CellChangeTimes->{{4.002134109192664*^9, 4.002134140106238*^9}, {
   4.002135247351672*^9, 4.002135339750003*^9}, {4.00213542537576*^9, 
   4.002135428640918*^9}, {4.002135472240951*^9, 4.002135560712928*^9}, {
   4.00223894846451*^9, 4.002238949674968*^9}, 
   4.0022820949123163`*^9},ExpressionUUID->"9e2d3fa8-b4b8-4d59-b161-\
d9068086749b"],

Cell[CellGroupData[{

Cell["Sampling Methods for SS1D and MC1D", "Subsection",
 CellChangeTimes->{{4.00228211024588*^9, 
  4.002282116685075*^9}},ExpressionUUID->"964cebb8-f753-4234-8668-\
e4707b662427"],

Cell["\<\
Both SS1D and MC1D share an identical GWPEnsemble interface with three \
sampling methods:\
\>", "Text",
 CellChangeTimes->{
  4.002282097650785*^9},ExpressionUUID->"f35ada04-231e-41f1-b2a0-\
8788b5c1a17f"],

Cell[TextData[{
 "\[OpenCurlyDoubleQuote]UniformX\[CloseCurlyDoubleQuote] (or \
\[OpenCurlyDoubleQuote]Cartesian\[CloseCurlyDoubleQuote] / Automatic): \
Subdivides the composite ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[PlusMinus]", "4"}], 
    SubscriptBox["\[Sigma]", "x"]}], TraditionalForm]],ExpressionUUID->
  "ab025a31-d8f1-4908-8eac-102b50075edc"],
 " bounding box ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     RowBox[{
      SubscriptBox["min", "k"], "(", 
      RowBox[{
       SubscriptBox["x", "k"], "-", 
       RowBox[{"4", 
        SubscriptBox["\[Sigma]", "k"]}]}], ")"}], ",", 
     RowBox[{
      SubscriptBox["max", "k"], "(", 
      RowBox[{
       SubscriptBox["x", "k"], "+", 
       RowBox[{"4", 
        SubscriptBox["\[Sigma]", "k"]}]}], ")"}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"470d26a2-943d-4681-bd49-1fbe6d65e56c"],
 " (or a user-supplied {N, {xMin, xMax}} window) into ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],ExpressionUUID->
  "22e83012-1285-4b10-a66c-2a4345b56a61"],
 " evenly spaced points.  "
}], "Item",
 CellChangeTimes->{{4.0022389317960243`*^9, 
  4.002238934422714*^9}},ExpressionUUID->"a715b7ff-ea04-40dc-acc3-\
49359ac36313"],

Cell[TextData[{
 "\[OpenCurlyDoubleQuote]InverseC\[CloseCurlyDoubleQuote] (Numerical Quantile \
Root-Finding): Solves ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"C", "(", 
     SubscriptBox["x", "k"], ")"}], "=", 
    SubscriptBox["c", "k"]}], TraditionalForm]],ExpressionUUID->
  "48dbae17-d46a-439f-b567-ce24e387e2ee"],
 " sequentially across the quantile grid using FindRoot supplied with the \
exact analytical Jacobian ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], 
     RowBox[{"C", "(", 
      RowBox[{"x", ",", "t"}], ")"}]}], "=", 
    RowBox[{"\[Rho]", "(", 
     RowBox[{"x", ",", "t"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "b4fb7418-2809-40dc-8c98-e5fa427ed827"],
 ". Any standard FindRoot options (such as WorkingPrecision, AccuracyGoal, or \
MaxIterations) may be passed directly into GWPEnsemble.   "
}], "Item",
 CellChangeTimes->{{4.0022389317960243`*^9, 4.002238937127357*^9}, {
  4.002238993319902*^9, 
  4.0022389963507137`*^9}},ExpressionUUID->"46983e25-944e-4d71-83aa-\
e0dcf1031eaa"],

Cell[TextData[{
 "\[OpenCurlyDoubleQuote]RandomDensity\[CloseCurlyDoubleQuote] (Rejection \
Sampling): Generates ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],ExpressionUUID->
  "33c92ad3-31a6-404e-a82c-e44e1f54158b"],
 " sorted variates via von Neumann rejection sampling under a bounding \
envelope of the interfering probability density."
}], "Item",
 CellChangeTimes->{{4.0022389317960243`*^9, 
  4.002238936610272*^9}},ExpressionUUID->"5d41622f-542d-498a-b79f-\
9ba3503b0180"]
}, Closed]],

Cell[CellGroupData[{

Cell["Antisymmetric Two-Sate Superposition (\[OpenCurlyDoubleQuote]SS1D\
\[CloseCurlyDoubleQuote])", "Subsection",
 CellChangeTimes->{{4.002239123381482*^9, 
  4.002239139025847*^9}},ExpressionUUID->"51f4dfdd-26c7-4819-9fc8-\
4831fdb2c07c"],

Cell[TextData[{
 "Here we initialize an antisymmetric two-Gaussian superposition (\
\[OpenCurlyDoubleQuote]C\[CloseCurlyDoubleQuote] \[Rule] -1) with overlapping \
branches centered at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "0"], "=", 
    RowBox[{
     RowBox[{"\[PlusMinus]", "1"}], "/", "2"}]}], TraditionalForm]],
  ExpressionUUID->"660cfec6-fd95-4e4d-a973-5fa43484b946"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "0"], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"52b3f437-f161-4c65-bc3c-0d8e05ab34b3"],
 ", creating a destructive interference node at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "c584e107-36d6-495a-b47c-af24f2f8394b"],
 ". Comparing \[OpenCurlyDoubleQuote]UniformX\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]InverseC\[CloseCurlyDoubleQuote], and \
\[OpenCurlyDoubleQuote]RandomDensity\[CloseCurlyDoubleQuote] demonstrates how \
both \[OpenCurlyDoubleQuote]InverseC\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]RandomDensity\[CloseCurlyDoubleQuote] automatically \
evacuate the destructive node at the origin and cluster trajectories inside \
the two constructive interference lobes:"
}], "Text",
 CellChangeTimes->{
  4.002134164177865*^9, {4.002135563635363*^9, 4.0021356204427156`*^9}, {
   4.002239161089624*^9, 
   4.002239164490808*^9}},ExpressionUUID->"02b70986-15cd-4708-92ac-\
ee816fbce4a4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Antisymmetric", " ", "overlapping", " ", "two"}], "-", 
     RowBox[{
     "state", " ", "superposition", " ", "with", " ", "a", " ", "node", " ", 
      "at", " ", "x"}]}], "=", "0"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"objSS", "=", 
     RowBox[{
      RowBox[{"GWP", "[", "\"\<SS1D\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "1"}], "/", "2"}], ",", 
         RowBox[{"1", "/", "2"}]}], "}"}], ",", 
       RowBox[{"\"\<C\>\"", "->", 
        RowBox[{"-", "1"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ensSSX", "=", 
     RowBox[{"GWPEnsemble", "[", 
      RowBox[{"objSS", ",", 
       RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<UniformX\>\""}], ",", 
       RowBox[{"\"\<Grid\>\"", "->", "24"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ensSSC", "=", 
     RowBox[{"GWPEnsemble", "[", 
      RowBox[{"objSS", ",", 
       RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<InverseC\>\""}], ",", 
       RowBox[{"\"\<Grid\>\"", "->", "24"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ensSSRD", "=", 
     RowBox[{"GWPEnsemble", "[", 
      RowBox[{"objSS", ",", 
       RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<RandomDensity\>\""}], ",", 
       RowBox[{"\"\<Grid\>\"", "->", "24"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"objSS", "[", "\"\<RHOX\>\"", "]"}], "[", "x", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "0.22"}], ",", "0.65"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<x\>\"", ",", "\"\<\[Rho](x) and Ensemble Markers\>\""}],
          "}"}]}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Thick", ",", 
          RowBox[{"GrayLevel", "[", "0.3", "]"}]}], "]"}]}], ",", 
       RowBox[{"BaseStyle", "->", 
        RowBox[{"{", 
         RowBox[{"FontSize", "->", "12"}], "}"}]}], ",", 
       RowBox[{"ImageSize", "->", "500"}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Thread", "[", 
          RowBox[{"{", 
           RowBox[{"ensSSX", ",", 
            RowBox[{"-", "0.05"}]}], "}"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Thread", "[", 
          RowBox[{"{", 
           RowBox[{"ensSSC", ",", 
            RowBox[{"-", "0.11"}]}], "}"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Thread", "[", 
          RowBox[{"{", 
           RowBox[{"ensSSRD", ",", 
            RowBox[{"-", "0.17"}]}], "}"}], "]"}]}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ColorData", "[", 
           RowBox[{"97", ",", "1"}], "]"}], ",", 
          RowBox[{"ColorData", "[", 
           RowBox[{"97", ",", "2"}], "]"}], ",", 
          RowBox[{"ColorData", "[", 
           RowBox[{"97", ",", "3"}], "]"}]}], "}"}]}], ",", 
       RowBox[{"PlotMarkers", "->", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", "8"}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<UniformX (Default)\>\"", 
          ",", "\"\<InverseC (Quantile)\>\"", ",", "\"\<RandomDensity\>\""}], 
         "}"}]}]}], "]"}], ",", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "Project", " ", "InverseC", " ", "points", " ", "onto", " ", "rho", 
        RowBox[{"(", "x", ")"}], " ", "to", " ", "highlight", " ", 
        "evacuation", " ", "of", " ", "the", " ", "x"}], "=", 
       RowBox[{"0", " ", "node"}]}], "*)"}], 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"ensSSC", ",", 
          RowBox[{
           RowBox[{"objSS", "[", "\"\<RHOX\>\"", "]"}], "[", "ensSSC", 
           "]"}]}], "}"}], "]"}], ",", 
       RowBox[{"Filling", "->", "Axis"}], ",", 
       RowBox[{"FillingStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"Opacity", "[", "0.35", "]"}], ",", 
          RowBox[{"ColorData", "[", 
           RowBox[{"97", ",", "2"}], "]"}]}], "]"}]}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", "2"}], "]"}]}], ",", 
       RowBox[{"PlotMarkers", "->", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", "7"}], "}"}]}]}], "]"}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{4.002238890134326*^9, 4.00223889013446*^9}, {
  4.002239206427813*^9, 4.002239224750268*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"8c1ae2e4-0ee3-44da-a85d-c8941840e64f"],

