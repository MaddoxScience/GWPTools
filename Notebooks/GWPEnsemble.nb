Cell[CellGroupData[{

Cell["\<\
\[OpenCurlyDoubleQuote]PolarC\[CloseCurlyDoubleQuote] Shell Layout Options (\
\[OpenCurlyDoubleQuote]Structure\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]IncludeCore\[CloseCurlyDoubleQuote])\
\>", "Subsection",
 CellChangeTimes->{
  4.00227244007308*^9},ExpressionUUID->"e02508b2-6329-4dc9-ac95-2c487cdec3b4"],

Cell["\<\
The \[OpenCurlyDoubleQuote]PolarC\[CloseCurlyDoubleQuote] method supports two \
specialized layout options that control the arrangement of points across the \
concentric probability shells:   \
\>", "Text",
 CellChangeTimes->{
  4.002136152249298*^9, {4.00213768998074*^9, 4.0021377633020363`*^9}, {
   4.002272510470829*^9, 
   4.002272515567922*^9}},ExpressionUUID->"dbb8ff9e-deef-41d9-9e18-\
899558804c1d"],

Cell[TextData[{
 "\[OpenCurlyDoubleQuote]Structure\[CloseCurlyDoubleQuote] \[Rule] \
\[OpenCurlyDoubleQuote]Staggered\[CloseCurlyDoubleQuote] (default) vs. \
\[OpenCurlyDoubleQuote]Aligned\[CloseCurlyDoubleQuote]: \
\[OpenCurlyDoubleQuote]Staggered\[CloseCurlyDoubleQuote] alternates the \
angular phase of adjacent radial shells by half a ray spacing (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]c", "\[Theta]"], "=", 
    RowBox[{
     RowBox[{"1", "/", "2"}], 
     SubscriptBox["n", "\[Theta]"]}]}], TraditionalForm]],ExpressionUUID->
  "449393a2-24f2-4fdf-932a-a66c50e3f517"],
 "), producing a triangulated packing, whereas \[OpenCurlyDoubleQuote]Aligned\
\[CloseCurlyDoubleQuote] places points along fixed radial spokes. "
}], "Item",
 CellChangeTimes->{{4.002272536973534*^9, 
  4.0022726062838383`*^9}},ExpressionUUID->"1cc383e2-5fbd-4f58-b2cd-\
2da0c67e5904"],

Cell[TextData[{
 "\[OpenCurlyDoubleQuote]IncludeCore\[CloseCurlyDoubleQuote] \[Rule] True \
(default) vs. False: Controls whether the wavepacket center ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["\[Mu]",
     FontWeight->"Bold"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["x", "t"], ",", 
       SubscriptBox["y", "t"]}], ")"}], "T"]}], TraditionalForm]],
  ExpressionUUID->"d57aa1ed-394e-4d41-b47f-2f535c7d1556"],
 " corresponding to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["c", "r"], ",", 
      SubscriptBox["c", "\[Theta]"]}], ")"}], "=", 
    RowBox[{"(", 
     RowBox[{"0", ",", "0"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "d742054d-62f1-4fa6-9656-972a0e54ebfc"],
 " is prepended as a core point at the center of the innermost ring. "
}], "Item",
 CellChangeTimes->{{4.002272536973534*^9, 4.00227254288888*^9}, {
  4.002272620847886*^9, 
  4.002272643827631*^9}},ExpressionUUID->"d96d2932-2ae5-48a6-a995-\
539aa558641e"],

Cell["\<\
Because \[OpenCurlyDoubleQuote]PolarC\[CloseCurlyDoubleQuote] places each \
radial shell at a uniform cumulative probability step and distributes rays at \
uniform canonical phase angles, the sampling geometry defines a natural \
curvilinear polar mesh adapted to the wavepacket\[CloseCurlyQuote]s \
covariance ellipse. In the figure below, we set the background contour levels \
to match the five radial shells and draw radial spokes from the wavepacket \
center along the 16 canonical ray angles. This makes the structural \
difference immediately clear: the \[OpenCurlyDoubleQuote]Aligned\
\[CloseCurlyDoubleQuote] ensemble places every marker directly at the \
intersection of a spoke and a contour ring, whereas the \
\[OpenCurlyDoubleQuote]Staggered\[CloseCurlyDoubleQuote] ensemble shifts \
alternating rings halfway between the spokes for a more uniform spatial \
packing:\
\>", "Text",
 CellChangeTimes->{
  4.002281391223035*^9},ExpressionUUID->"bdde52cc-5f09-44b9-bdc5-\
54ebd4b84895"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Compare", " ", "Staggered", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"with", " ", 
       RowBox[{"core", ":", 
        RowBox[{
         RowBox[{"5", "*", "16"}], "+", "1"}]}]}], "=", 
      RowBox[{"81", " ", "pts"}]}], ")"}], " ", 
    RowBox[{"vs", ".", "Aligned"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"without", " ", 
       RowBox[{"core", ":", 
        RowBox[{"5", "*", "16"}]}]}], "=", 
      RowBox[{"80", " ", "pts"}]}], ")"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"polarStaggered", "=", 
     RowBox[{"GWPEnsemble", "[", 
      RowBox[{"obj2D", ",", 
       RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<PolarC\>\""}], ",", 
       RowBox[{"\"\<Grid\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"5", ",", "16"}], "}"}]}], ",", 
       RowBox[{"\"\<Structure\>\"", "->", "\"\<Staggered\>\""}], ",", 
       RowBox[{"\"\<IncludeCore\>\"", "->", "True"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"polarAligned", "=", 
     RowBox[{"GWPEnsemble", "[", 
      RowBox[{"obj2D", ",", 
       RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<PolarC\>\""}], ",", 
       RowBox[{"\"\<Grid\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"5", ",", "16"}], "}"}]}], ",", 
       RowBox[{"\"\<Structure\>\"", "->", "\"\<Aligned\>\""}], ",", 
       RowBox[{"\"\<IncludeCore\>\"", "->", "False"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "1.", " ", "Exact", " ", "density", " ", "contour", " ", "levels", " ", 
      "for", " ", "the", " ", "nr"}], "=", 
     RowBox[{"5", " ", "radial", " ", "shells"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nr", "=", "5"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ntheta", "=", "16"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rhoMax", "=", 
     RowBox[{
      RowBox[{"obj2D", "[", "\"\<RHOX\>\"", "]"}], "[", 
      RowBox[{"1", ",", 
       RowBox[{"-", "1"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"crContours", "=", 
     RowBox[{"rhoMax", "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         RowBox[{"Range", "[", "nr", "]"}], "/", 
         RowBox[{"(", 
          RowBox[{"nr", "+", "1"}], ")"}]}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "2.", " ", "Radial", " ", "spokes", " ", "from", " ", "the", " ", 
      "center", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"-", "1"}]}], "}"}], " ", "out", " ", "to", " ", "cr"}], "=", 
     
     RowBox[{
     "0.95", " ", "along", " ", "the", " ", "16", " ", "ray", " ", 
      "angles"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"spokeTips", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"obj2D", "[", "\"\<XC\>\"", "]"}], "[", 
        RowBox[{"0.95", ",", 
         RowBox[{"j", "/", "ntheta"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", 
         RowBox[{"ntheta", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"spokeGraphics", "=", 
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{"Thin", ",", 
        RowBox[{"GrayLevel", "[", "0.55", "]"}], ",", 
        RowBox[{"Line", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"1", ",", 
               RowBox[{"-", "1"}]}], "}"}], ",", "pt"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"pt", ",", "spokeTips"}], "}"}]}], "]"}], "]"}]}], "}"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"bgContourPolar", "=", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"ContourPlot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"obj2D", "[", "\"\<RHOX\>\"", "]"}], "[", 
          RowBox[{"x", ",", "y"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"-", "2.5"}], ",", "4.5"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"y", ",", 
           RowBox[{"-", "5"}], ",", "3"}], "}"}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"Contours", "->", "crContours"}], ",", 
         RowBox[{"ContourShading", "->", "None"}], ",", 
         RowBox[{"ContourStyle", "->", "Thin"}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
         RowBox[{"BaseStyle", "->", 
          RowBox[{"{", 
           RowBox[{"FontSize", "->", "11"}], "}"}]}]}], "]"}], ",", 
       "spokeGraphics"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Show", "[", 
        RowBox[{"bgContourPolar", ",", 
         RowBox[{"ListPlot", "[", 
          RowBox[{"polarStaggered", ",", 
           RowBox[{"PlotStyle", "->", 
            RowBox[{"ColorData", "[", 
             RowBox[{"97", ",", "3"}], "]"}]}], ",", 
           RowBox[{"PlotMarkers", "->", 
            RowBox[{"{", 
             RowBox[{"Automatic", ",", "6"}], "}"}]}]}], "]"}], ",", 
         RowBox[{
         "PlotLabel", 
          "->", "\"\<Staggered + IncludeCore -> True (81 pts)\>\""}]}], "]"}],
        ",", 
       RowBox[{"Show", "[", 
        RowBox[{"bgContourPolar", ",", 
         RowBox[{"ListPlot", "[", 
          RowBox[{"polarAligned", ",", 
           RowBox[{"PlotStyle", "->", 
            RowBox[{"ColorData", "[", 
             RowBox[{"97", ",", "2"}], "]"}]}], ",", 
           RowBox[{"PlotMarkers", "->", 
            RowBox[{"{", 
             RowBox[{"Automatic", ",", "6"}], "}"}]}]}], "]"}], ",", 
         RowBox[{
         "PlotLabel", 
          "->", "\"\<Aligned + IncludeCore -> False (80 pts)\>\""}]}], 
        "]"}]}], "}"}], ",", 
     RowBox[{"ImageSize", "->", "680"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{4.0022812495372477`*^9, 4.0022813537915707`*^9}},
 CellLabel->"In[94]:=",ExpressionUUID->"4a2ec161-47ca-454e-b890-a049963095a5"],

