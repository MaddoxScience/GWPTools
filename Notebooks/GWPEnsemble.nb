Cell[CellGroupData[{

Cell["\<\
Anisotropic Coupled 2D Oscillator (Lissajous Swirl & Phase-Space Vorticity)\
\>", "Subsection",
 CellChangeTimes->{
  4.002193719842095*^9, {4.0022962841550913`*^9, 
   4.002296288506744*^9}},ExpressionUUID->"45ccf4a9-4fa3-4ffa-9c14-\
14f2c21ca6d4"],

Cell[TextData[{
 "Applying \[OpenCurlyDoubleQuote]SamplingMethod\[CloseCurlyDoubleQuote] \
\[Rule] \[OpenCurlyDoubleQuote]PolarC\[CloseCurlyDoubleQuote] to a 2D \
Gaussian wavepacket with initial off-diagonal correlation (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "xy"], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "513d4657-4549-4df7-a50d-c16525ddbe09"],
 ") and transverse momentum demonstrates how GWPEnsembleSolve propagates \
multi-dimensional ensembles directly from obj2D, and how GWPEnsembleFormat \
extracts both 2D planar orbits {x(t), y(t)} and 1D coordinate time series {t, \
x(t)} and {t, y(t)}:"
}], "Text",
 CellChangeTimes->{{4.002193736941905*^9, 4.002193772947125*^9}, {
  4.0022962542082567`*^9, 4.0022962745431128`*^9}, {4.0022965100927267`*^9, 
  4.002296528245037*^9}},ExpressionUUID->"e2ab6f3f-f7d7-4502-8aa5-\
f90377667017"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Correlated", " ", "2", "D", " ", "Gaussian", " ", "in", " ", 
    "an", " ", "isotropic", " ", "harmonic", " ", "trap"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"obj2D", "=", 
     RowBox[{
      RowBox[{"GWP", "[", "\"\<2D\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"3", "/", "2"}], ",", 
           RowBox[{"1", "/", "2"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "2"}], ",", 
           RowBox[{"2", "/", "3"}]}], "}"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "2"}], ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"3", "/", "2"}]}], "}"}], ",", 
       RowBox[{"\"\<Potential\>\"", "->", "\"\<HO\>\""}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
      "2.", " ", "Sample", " ", "3", " ", "radial", " ", "shells", " ", "x", " ",
        "10", " ", "angular", " ", "rays"}], "+", 
      RowBox[{"1", " ", "core", " ", "point"}]}], "=", 
     RowBox[{"31", " ", "trajectories"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xy0", "=", 
     RowBox[{"GWPEnsemble", "[", 
      RowBox[{"obj2D", ",", 
       RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<PolarC\>\""}], ",", 
       RowBox[{"\"\<Grid\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"3", ",", "10"}], "}"}]}], ",", 
       RowBox[{"\"\<Time\>\"", "->", "0"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Propagate", " ", "2", "D", " ", "Bohmian", " ", "velocity", " ",
      "field", " ", "directly", " ", "from", " ", "obj2D"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol2D", "=", 
     RowBox[{"GWPEnsembleSolve", "[", 
      RowBox[{"obj2D", ",", "xy0", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", 
         RowBox[{"2", "*", "2", " ", "Pi"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"parsed2D", "=", 
     RowBox[{"GWPEnsembleParse", "[", 
      RowBox[{"xy0", ",", "sol2D"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"4.", " ", "Extract", " ", "planar", " ", 
      RowBox[{"(", 
       RowBox[{"x", ",", "y"}], ")"}], " ", "orbits", " ", "and", " ", "1", 
      "D", " ", "x", 
      RowBox[{"(", "t", ")"}]}], ",", 
     RowBox[{"y", 
      RowBox[{"(", "t", ")"}], " ", "projections"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"trajXY", "=", 
     RowBox[{"GWPEnsembleFormat", "[", 
      RowBox[{"parsed2D", ",", "\"\<X0DAT\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"trajX", "=", 
     RowBox[{"GWPEnsembleFormat", "[", 
      RowBox[{"parsed2D", ",", "\"\<X0DAT\>\"", ",", 
       RowBox[{"\"\<Component\>\"", "->", "1"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"trajY", "=", 
     RowBox[{"GWPEnsembleFormat", "[", 
      RowBox[{"parsed2D", ",", "\"\<X0DAT\>\"", ",", 
       RowBox[{"\"\<Component\>\"", "->", "2"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ListLinePlot", "[", 
        RowBox[{"trajXY", ",", 
         RowBox[{"AspectRatio", "->", "1"}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<x(t)\>\"", ",", "\"\<y(t)\>\""}], "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<2D Planar Orbits\>\""}], ",", 
         RowBox[{"Epilog", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"PointSize", "[", "0.015", "]"}], ",", "Black", ",", 
            RowBox[{"Point", "[", "xy0", "]"}]}], "}"}]}]}], "]"}], ",", 
       RowBox[{"GraphicsColumn", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ListLinePlot", "[", 
           RowBox[{"trajX", ",", 
            RowBox[{"Frame", "->", "True"}], ",", 
            RowBox[{"FrameLabel", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<t\>\"", ",", "\"\<x(t)\>\""}], "}"}]}], ",", 
            RowBox[{"PlotRange", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "4"}], ",", "4"}], "}"}]}]}], "]"}], ",", 
          RowBox[{"ListLinePlot", "[", 
           RowBox[{"trajY", ",", 
            RowBox[{"Frame", "->", "True"}], ",", 
            RowBox[{"FrameLabel", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<t\>\"", ",", "\"\<y(t)\>\""}], "}"}]}], ",", 
            RowBox[{"PlotRange", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "4"}], ",", "4"}], "}"}]}]}], "]"}]}], "}"}], 
        "]"}]}], "}"}], ",", 
     RowBox[{"ImageSize", "->", "750"}]}], "]"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Prepend", " ", "TDAT", " ", "to", " ", "each", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", 
        RowBox[{"(", "t", ")"}]}], ",", 
       RowBox[{"y", 
        RowBox[{"(", "t", ")"}]}]}], "}"}], " ", "pair", " ", "to", " ", 
     "visualize", " ", "3", "D", " ", "spacetime", " ", "worldlines", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{"x", 
        RowBox[{"(", "t", ")"}]}], ",", 
       RowBox[{"y", 
        RowBox[{"(", "t", ")"}]}]}], "}"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"trajTXY", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"MapThread", "[", 
        RowBox[{"Prepend", ",", 
         RowBox[{"{", 
          RowBox[{"#", ",", 
           RowBox[{"parsed2D", "[", "\"\<TDAT\>\"", "]"}]}], "}"}]}], "]"}], 
       "&"}], "/@", "trajXY"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"ListLinePlot3D", "[", 
    RowBox[{"trajTXY", ",", 
     RowBox[{"BoxRatios", "->", 
      RowBox[{"{", 
       RowBox[{"3", ",", "1", ",", "1"}], "}"}]}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", "1"}], "]"}], ",", "Thin"}], "]"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<t\>\"", ",", "\"\<x(t)\>\"", ",", "\"\<y(t)\>\""}], 
       "}"}]}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<3D Spacetime Worldlines\>\""}], ",", 
     RowBox[{"ImageSize", "->", "550"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{4.00219377049992*^9, 4.002193779286539*^9}, {
   4.00219424101653*^9, 4.0021942414683657`*^9}, {4.002194483533389*^9, 
   4.00219456685662*^9}, {4.002194652740005*^9, 4.002194669109517*^9}, 
   4.0022963121817493`*^9, 4.002296459179178*^9},
 CellLabel->
  "In[213]:=",ExpressionUUID->"36bceedf-a5c0-4cc9-8864-4efd9ad1cd9a"],

