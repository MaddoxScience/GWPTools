Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "2.", " ", "Construct", " ", "2", "D", " ", "numerical", " ", "wavepacket",
     " ", "with", " ", "all", " ", "6", " ", "scalar", " ", "coefficient", " ",
     "functions"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"obj2DNum", "=", 
     RowBox[{
      RowBox[{"GWP", "[", "\"\<2D\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"\"\<Potential\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Numerical\>\"", ",", "v00", ",", "v10", ",", "v01", ",",
           "v20", ",", "v02", ",", "v11", ",", "0", ",", 
          RowBox[{"2", "*", "2", " ", "Pi"}]}], "}"}]}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Sample", " ", "a", " ", "2", "D", " ", "PolarC", " ", "ring", 
     " ", "ensemble"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xy0Num", "=", 
     RowBox[{"GWPEnsemble", "[", 
      RowBox[{"obj2DNum", ",", 
       RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<PolarC\>\""}], ",", 
       RowBox[{"\"\<Grid\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"2", ",", "12"}], "}"}]}], ",", 
       RowBox[{"\"\<Time\>\"", "->", "0"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"4.", " ", "Propagate", " ", "2", "D", " ", "trajectories"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol2DNum", "=", 
     RowBox[{"EnsembleSolve", "[", 
      RowBox[{"xy0Num", ",", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"xy", ",", "t"}], "}"}], ",", 
         RowBox[{"Transpose", "@", 
          RowBox[{
           RowBox[{"obj2DNum", "[", "\"\<VX\>\"", "]"}], "[", 
           RowBox[{
            RowBox[{"xy", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
            RowBox[{"xy", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "t"}], "]"}]}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", 
         RowBox[{"2", "*", "2", " ", "Pi"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"parsed2DNum", "=", 
     RowBox[{"EnsembleParse", "[", 
      RowBox[{"xy0Num", ",", "sol2DNum"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"traj2DNum", "=", 
     RowBox[{"EnsembleFormat", "[", 
      RowBox[{"parsed2DNum", ",", "\"\<X0DAT\>\""}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "5.", " ", "Plot", " ", "2", "D", " ", "trajectories", " ", "and", " ", 
      "3", "D", " ", 
      RowBox[{"(", 
       RowBox[{"t", ",", "x", ",", "y"}], ")"}], " ", "space"}], "-", 
     RowBox[{"time", " ", "worldlines"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"worldlines3D", "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"Prepend", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", "#1", "]"}], ",", "#2"}], "]"}], "]"}], 
        "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"traj2DNum", ",", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"parsed2DNum", "[", "\"\<TDAT\>\"", "]"}], ",", 
           RowBox[{"parsed2DNum", "[", "\"\<NS\>\"", "]"}]}], "]"}]}], 
        "}"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ListLinePlot", "[", 
        RowBox[{"traj2DNum", ",", 
         RowBox[{"AspectRatio", "->", "1"}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<x(t)\>\"", ",", "\"\<y(t)\>\""}], "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<2D Rotating Quadrupole Orbits\>\""}],
          ",", 
         RowBox[{"Epilog", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"PointSize", "[", "Small", "]"}], ",", "Black", ",", 
            RowBox[{"Point", "[", "xy0Num", "]"}]}], "}"}]}]}], "]"}], ",", 
       RowBox[{"Graphics3D", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Thick", ",", 
           RowBox[{"MapIndexed", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"ColorData", "[", 
                 RowBox[{"97", ",", 
                  RowBox[{"First", "[", "#2", "]"}]}], "]"}], ",", 
                RowBox[{"Line", "[", "#1", "]"}]}], "}"}], "&"}], ",", 
             "worldlines3D"}], "]"}]}], "}"}], ",", 
         RowBox[{"Axes", "->", "True"}], ",", 
         RowBox[{"AxesLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<t\>\"", ",", "\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}],
          ",", 
         RowBox[{"BoxRatios", "->", 
          RowBox[{"{", 
           RowBox[{"2", ",", "1", ",", "1"}], "}"}]}], ",", 
         RowBox[{
         "PlotLabel", "->", "\"\<Space-Time Worldlines (t, x, y)\>\""}]}], 
        "]"}]}], "}"}], ",", 
     RowBox[{"ImageSize", "->", "800"}]}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
 CellLabel->
  "In[396]:=",ExpressionUUID->"11fdef9e-82f0-4cb4-a4c0-7a183f0fd71b"],

