Cell[CellGroupData[{

Cell["Multi-Component Focal Interference (\[OpenCurlyDoubleQuote]MC1D\
\[CloseCurlyDoubleQuote])", "Subsection",
 CellChangeTimes->{{4.002239245406024*^9, 4.002239253254369*^9}, {
  4.002239358681183*^9, 
  4.002239362889868*^9}},ExpressionUUID->"9ee8bad0-7ae4-4b4d-a268-\
3c84b7ac971b"],

Cell[TextData[{
 "In this dynamic \[OpenCurlyDoubleQuote]MC1D\[CloseCurlyDoubleQuote] \
example, a train of three Gaussian wavepackets (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "0"], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"b36ca64c-b834-46a7-b4e0-67c44b33fe46"],
 ") initialized at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "0"], "\[Element]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "3"}], ",", "0", ",", "3"}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"de1c5dea-38dd-497e-8e25-7aae0f76e99b"],
 " in a harmonic oscillator (\[OpenCurlyDoubleQuote]Potential\
\[CloseCurlyDoubleQuote] \[Rule] \[OpenCurlyDoubleQuote]HO\
\[CloseCurlyDoubleQuote]) are sampled via \[OpenCurlyDoubleQuote]InverseC\
\[CloseCurlyDoubleQuote] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"N", "=", "30"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5ed9e4e3-64ab-4f10-9680-235fa176895e"],
 ") at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "ed3ffa2e-874e-4185-b3dc-3b59341e1a19"],
 " (three well-separated Gaussian peaks) and at the half-period focal \
collision ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", 
    RowBox[{"\[Pi]", "/", "2"}]}], TraditionalForm]],ExpressionUUID->
  "e3278e27-6aca-47b0-ad16-a34bfe5a0d13"],
 " (where all three branches cross at the origin to form high-frequency \
three-beam interference fringes):"
}], "Text",
 CellChangeTimes->{
  4.002134185378134*^9, {4.002135638813113*^9, 4.002135695574387*^9}, {
   4.00223935518892*^9, 
   4.002239404922064*^9}},ExpressionUUID->"2c8015b4-0faa-4415-8465-\
783600d84593"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"objMC", "=", 
    RowBox[{
     RowBox[{"GWP", "[", "\"\<MC1D\>\"", "]"}], "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "3"}], ",", "0", ",", "3"}], "}"}], ",", 
      RowBox[{"\"\<C\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ",", 
      RowBox[{"\"\<Potential\>\"", "->", "\"\<HO\>\""}]}], "]"}]}], ";"}], 
  "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"30", " ", "quantile", " ", "points", " ", "at", " ", "t"}], "=", 
    
    RowBox[{
     RowBox[{"0", " ", 
      RowBox[{"(", 
       RowBox[{"separated", " ", "lobes"}], ")"}], " ", 
      RowBox[{"vs", ".", "t"}]}], "=", 
     RowBox[{
      RowBox[{"Pi", "/", "2"}], " ", 
      RowBox[{"(", 
       RowBox[{"focal", " ", "interference"}], ")"}]}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ensMC0", "=", 
   RowBox[{"GWPEnsemble", "[", 
    RowBox[{"objMC", ",", 
     RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<InverseC\>\""}], ",", 
     RowBox[{"\"\<Grid\>\"", "->", "30"}], ",", 
     RowBox[{"\"\<Time\>\"", "->", "0"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ensMCT", "=", 
    RowBox[{"GWPEnsemble", "[", 
     RowBox[{"objMC", ",", 
      RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<InverseC\>\""}], ",", 
      RowBox[{"\"\<Grid\>\"", "->", "30"}], ",", 
      RowBox[{"\"\<Time\>\"", "->", 
       RowBox[{"Pi", "/", "2"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"GraphicsRow", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"objMC", "[", "\"\<RHOX\>\"", "]"}], "[", 
          RowBox[{"x", ",", "0"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"-", "5.5"}], ",", "5.5"}], "}"}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "5.5"}], ",", "5.5"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "0.08"}], ",", "0.35"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<x\>\"", ",", "\"\<\[Rho](x, 0)\>\""}], "}"}]}], ",", 
         RowBox[{
         "PlotLabel", "->", "\"\<t = 0 (Separated Wavepacket Train)\>\""}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{"Thick", ",", 
            RowBox[{"ColorData", "[", 
             RowBox[{"97", ",", "1"}], "]"}]}], "]"}]}], ",", 
         RowBox[{"BaseStyle", "->", 
          RowBox[{"{", 
           RowBox[{"FontSize", "->", "11"}], "}"}]}]}], "]"}], ",", 
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{"Thread", "[", 
          RowBox[{"{", 
           RowBox[{"ensMC0", ",", 
            RowBox[{"-", "0.03"}]}], "}"}], "]"}], ",", 
         RowBox[{"PlotStyle", "->", "Red"}], ",", 
         RowBox[{"PlotMarkers", "->", 
          RowBox[{"{", 
           RowBox[{"Automatic", ",", "6"}], "}"}]}]}], "]"}], ",", 
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"ensMC0", ",", 
            RowBox[{
             RowBox[{"objMC", "[", "\"\<RHOX\>\"", "]"}], "[", 
             RowBox[{"ensMC0", ",", "0"}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Filling", "->", "Axis"}], ",", 
         RowBox[{"FillingStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"Opacity", "[", "0.3", "]"}], ",", "Red"}], "]"}]}], ",", 
         
         RowBox[{"PlotStyle", "->", "Red"}], ",", 
         RowBox[{"PlotMarkers", "->", 
          RowBox[{"{", 
           RowBox[{"Automatic", ",", "5"}], "}"}]}]}], "]"}]}], "]"}], ",", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"objMC", "[", "\"\<RHOX\>\"", "]"}], "[", 
          RowBox[{"x", ",", 
           RowBox[{"Pi", "/", "2"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "0.3"}], ",", "1.8"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<x\>\"", ",", "\"\<\[Rho](x, \[Pi]/2)\>\""}], "}"}]}], 
         ",", 
         RowBox[{
         "PlotLabel", 
          "->", "\"\<t = \[Pi]/2 (Three-Beam Focal Interference)\>\""}], ",", 
         
         RowBox[{"PlotStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{"Thick", ",", 
            RowBox[{"ColorData", "[", 
             RowBox[{"97", ",", "1"}], "]"}]}], "]"}]}], ",", 
         RowBox[{"BaseStyle", "->", 
          RowBox[{"{", 
           RowBox[{"FontSize", "->", "11"}], "}"}]}]}], "]"}], ",", 
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{"Thread", "[", 
          RowBox[{"{", 
           RowBox[{"ensMCT", ",", 
            RowBox[{"-", "0.15"}]}], "}"}], "]"}], ",", 
         RowBox[{"PlotStyle", "->", "Red"}], ",", 
         RowBox[{"PlotMarkers", "->", 
          RowBox[{"{", 
           RowBox[{"Automatic", ",", "6"}], "}"}]}]}], "]"}], ",", 
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"ensMCT", ",", 
            RowBox[{
             RowBox[{"objMC", "[", "\"\<RHOX\>\"", "]"}], "[", 
             RowBox[{"ensMCT", ",", 
              RowBox[{"Pi", "/", "2"}]}], "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"Filling", "->", "Axis"}], ",", 
         RowBox[{"FillingStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"Opacity", "[", "0.3", "]"}], ",", "Red"}], "]"}]}], ",", 
         
         RowBox[{"PlotStyle", "->", "Red"}], ",", 
         RowBox[{"PlotMarkers", "->", 
          RowBox[{"{", 
           RowBox[{"Automatic", ",", "5"}], "}"}]}]}], "]"}]}], "]"}]}], 
    "}"}], ",", 
   RowBox[{"ImageSize", "->", "750"}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.002134193998308*^9, 4.002134221303712*^9}, 
   4.002239427724522*^9},
 CellLabel->"In[19]:=",ExpressionUUID->"0ca583ca-e643-4d14-a4c9-ea99071476f9"],

