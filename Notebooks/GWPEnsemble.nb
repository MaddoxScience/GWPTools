Cell["\<\
Selecting \[OpenCurlyDoubleQuote]SamplingMethod\[CloseCurlyDoubleQuote] \
\[Rule] \[OpenCurlyDoubleQuote]UniformC\[CloseCurlyDoubleQuote] places grid \
points at equal probability intervals along the cumulative distribution \
function \
\>", "Text",
 CellChangeTimes->{{4.002129335038191*^9, 
  4.002129360437236*^9}},ExpressionUUID->"be44920e-64d3-43b4-ac46-\
7cb8b5ee64fa"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"C", "(", "x", ")"}], "=", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{"-", "\[Infinity]"}], "x"], 
     RowBox[{
      RowBox[{"\[Rho]", "(", 
       SuperscriptBox["x", "\[Prime]"], ")"}], 
      RowBox[{"\[DifferentialD]", 
       SuperscriptBox["x", "\[Prime]"]}]}]}], "\[Element]", 
    RowBox[{"(", 
     RowBox[{"0", ",", "1"}], ")"}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.002128957153825*^9, 4.0021289888049107`*^9}, {
  4.002129377650779*^9, 
  4.00212942207405*^9}},ExpressionUUID->"09d519cd-b177-44db-a699-\
f645c72873fb"],

Cell[TextData[{
 "naturally concentrating points near the peak of the probability density and \
spreading them out in the tails (ideal for equal-weight Bohmian trajectory \
ensembles):   \n\n\[OpenCurlyDoubleQuote]Grid\[CloseCurlyDoubleQuote] \[Rule] \
N: Evaluates the inverse CDF at the ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "920fb55a-6564-49c6-8c84-a462a0c714f3"],
 " bin midpoints ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["c", "k"], "=", 
     RowBox[{
      RowBox[{"1", "/", "2"}], "N"}]}], ",", 
    RowBox[{
     RowBox[{"3", "/", "2"}], "N"}], ",", "\[Ellipsis]", ",", 
    RowBox[{"1", "-", 
     RowBox[{
      RowBox[{"1", "/", "2"}], "N"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9d5da39e-6ee3-4573-b189-878376b862bf"],
 " (avoiding the divergent endpoints at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4fca0416-d7c9-46a9-81c0-fd387a476412"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6673782b-9b11-4d41-946b-eff417a90283"],
 ").   \n\n\[OpenCurlyDoubleQuote]Grid\[CloseCurlyDoubleQuote] \[Rule] {N, \
{cMin, cMax}}: Subdivides the cumulative probability window ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      SubscriptBox["c", "min"], ",", 
      SubscriptBox["c", "max"]}], "]"}], "\[Subset]", 
    RowBox[{"(", 
     RowBox[{"0", ",", "1"}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "20ca2f94-9060-4ebf-a645-a1296d24fbf3"],
 " into ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "94ea6fcc-002c-4c86-81cd-2c00877e01b5"],
 " points including the endpoints. "
}], "Text",
 CellChangeTimes->{
  4.002129362839416*^9, {4.002129427341544*^9, 4.002129452150136*^9}, {
   4.0021305634055977`*^9, 4.002130691286487*^9}, {4.002193604010594*^9, 
