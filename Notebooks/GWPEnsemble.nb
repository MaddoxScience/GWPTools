Cell[CellGroupData[{

Cell["Superposition Examples (SS1D and MC1D)", "Section",
 CellChangeTimes->{{4.002134065294366*^9, 4.002134096555992*^9}, {
  4.0021358923700733`*^9, 
  4.002135892673098*^9}},ExpressionUUID->"e61ef5a3-9f94-4286-83ca-\
28b8de1d5ddd"],

Cell[TextData[{
 "For two-state (SS1D) and multi-component (MC1D) superpositions, quantum \
interference between overlapping Gaussian branches produces oscillatory nodes \
and fringes in the probability density ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "(", 
    RowBox[{"x", ",", "t"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7d8a5ca9-59c5-45b6-b22a-29bd6c5e7c64"],
 ". Consequently, the cumulative distribution function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", "x", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0de8f1ec-0b01-4153-88af-63ccba7ba392"],
 " cannot be inverted analytically in closed form.  Both SS1D and MC1D share \
an identical GWPEnsemble interface with three sampling methods:\n\n\
\[OpenCurlyDoubleQuote]UniformX\[CloseCurlyDoubleQuote] (or \
\[OpenCurlyDoubleQuote]Cartesian\[CloseCurlyDoubleQuote] / Automatic): \
Subdivides the composite ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[PlusMinus]", "4"}], 
    SubscriptBox["\[Sigma]", "x"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6cca2678-8687-44b5-a132-73240bb6ef68"],
 " bounding box ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     RowBox[{
      SubscriptBox["min", "k"], "(", 
      RowBox[{
       SubscriptBox["x", "k"], "-", 
       RowBox[{"4", 
        SubscriptBox["\[Sigma]", "k"]}]}], ")"}], ",", 
     RowBox[{
      SubscriptBox["max", "k"], "(", 
      RowBox[{
       SubscriptBox["x", "k"], "+", 
       RowBox[{"4", 
        SubscriptBox["\[Sigma]", "k"]}]}], ")"}]}], "]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8d1d75ba-6383-4f97-8751-b7a0f627c167"],
 " (or a user-supplied {N, {xMin, xMax}} window) into ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "73eb3a68-03b0-450a-83c5-24d0ce13ab83"],
 " evenly spaced points.  \n\n\[OpenCurlyDoubleQuote]InverseC\
\[CloseCurlyDoubleQuote] (Numerical Quantile Root-Finding): Solves ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"C", "(", 
     SubscriptBox["x", "k"], ")"}], "=", 
    SubscriptBox["c", "k"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b7a0bc07-1be9-412a-bc15-f004417ff75d"],
 " sequentially across the quantile grid using FindRoot supplied with the \
exact analytical Jacobian ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], 
     RowBox[{"C", "(", "x", ")"}]}], "=", 
    RowBox[{"\[Rho]", "(", "x", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "da9f131a-48e9-4322-9647-48be2197da70"],
 ". Any standard FindRoot options (such as WorkingPrecision, AccuracyGoal, or \
MaxIterations) may be passed directly into GWPEnsemble.   \n\n\
\[OpenCurlyDoubleQuote]RandomDensity\[CloseCurlyDoubleQuote] (Rejection \
Sampling): Generates ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f75a4e1f-36b5-4517-a71f-f067adff04f8"],
 " sorted variates via von Neumann rejection sampling under a bounding \
envelope of the interfering probability density."
}], "Text",
 CellChangeTimes->{{4.002134109192664*^9, 4.002134140106238*^9}, {
  4.002135247351672*^9, 4.002135339750003*^9}, {4.00213542537576*^9, 
  4.002135428640918*^9}, {4.002135472240951*^9, 
  4.002135560712928*^9}},ExpressionUUID->"9e2d3fa8-b4b8-4d59-b161-\
d9068086749b"],

Cell[TextData[{
 "Here we initialize an antisymmetric two-Gaussian superposition (\
\[OpenCurlyDoubleQuote]C\[CloseCurlyDoubleQuote] \[Rule] -1) with overlapping \
branches centered at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "0"], "=", 
    RowBox[{
     RowBox[{"\[PlusMinus]", "1"}], "/", "2"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "660cfec6-fd95-4e4d-a973-5fa43484b946"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "0"], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "52b3f437-f161-4c65-bc3c-0d8e05ab34b3"],
 "), creating a destructive interference node at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c584e107-36d6-495a-b47c-af24f2f8394b"],
 ". Comparing \[OpenCurlyDoubleQuote]UniformX\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]InverseC\[CloseCurlyDoubleQuote], and \
\[OpenCurlyDoubleQuote]RandomDensity\[CloseCurlyDoubleQuote] demonstrates how \
both \[OpenCurlyDoubleQuote]InverseC\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]RandomDensity\[CloseCurlyDoubleQuote] automatically \
evacuate the destructive node at the origin and cluster trajectories inside \
the two constructive interference lobes:"
}], "Text",
 CellChangeTimes->{
  4.002134164177865*^9, {4.002135563635363*^9, 
   4.0021356204427156`*^9}},ExpressionUUID->"02b70986-15cd-4708-92ac-\
ee816fbce4a4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Antisymmetric", " ", "overlapping", " ", "two"}], "-", 
     RowBox[{
     "state", " ", "superposition", " ", "with", " ", "a", " ", "node", " ", 
      "at", " ", "x"}]}], "=", "0"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"objSS", "=", 
     RowBox[{
      RowBox[{"GWP", "[", "\"\<SS1D\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "1"}], "/", "2"}], ",", 
         RowBox[{"1", "/", "2"}]}], "}"}], ",", 
       RowBox[{"\"\<C\>\"", "->", 
        RowBox[{"-", "1"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ensSSX", "=", 
     RowBox[{"GWPEnsemble", "[", 
      RowBox[{"objSS", ",", 
       RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<UniformX\>\""}], ",", 
       RowBox[{"\"\<Grid\>\"", "->", "24"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ensSSC", "=", 
     RowBox[{"GWPEnsemble", "[", 
      RowBox[{"objSS", ",", 
       RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<InverseC\>\""}], ",", 
       RowBox[{"\"\<Grid\>\"", "->", "24"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ensSSRD", "=", 
     RowBox[{"GWPEnsemble", "[", 
      RowBox[{"objSS", ",", 
       RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<RandomDensity\>\""}], ",", 
       RowBox[{"\"\<Grid\>\"", "->", "24"}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"objSS", "[", "\"\<RHOX\>\"", "]"}], "[", "x", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.22"}], ",", "0.65"}], "}"}]}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<x\>\"", ",", "\"\<rho(x) and Ensemble Markers\>\""}], 
         "}"}]}], ",", 
       RowBox[{"BaseStyle", "->", 
        RowBox[{"FontSize", "->", "12"}]}]}], "]"}], ",", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Thread", "[", 
          RowBox[{"{", 
           RowBox[{"ensSSX", ",", 
            RowBox[{"-", "0.05"}]}], "}"}], "]"}], ",", 
         RowBox[{"Thread", "[", 
          RowBox[{"{", 
           RowBox[{"ensSSC", ",", 
            RowBox[{"-", "0.11"}]}], "}"}], "]"}], ",", 
         RowBox[{"Thread", "[", 
          RowBox[{"{", 
           RowBox[{"ensSSRD", ",", 
            RowBox[{"-", "0.17"}]}], "}"}], "]"}]}], "}"}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<UniformX (Default)\>\"", 
          ",", "\"\<InverseC (Quantile)\>\"", ",", "\"\<RandomDensity\>\""}], 
         "}"}]}]}], "]"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{4.002135210351866*^9, 4.0021352196439457`*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"baf95e50-cd20-41ab-a856-28860408aabc"],

