Cell[TextData[{
 "GWPEnsemble provides two distinct random sampling modes for 1D wavepackets: \
  \n\n\[OpenCurlyDoubleQuote]SamplingMethod\[CloseCurlyDoubleQuote] \[Rule] \
\[OpenCurlyDoubleQuote]Random\[CloseCurlyDoubleQuote]: Draws ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9e59021e-5177-461b-8e25-baf7481323c6"],
 " sorted variates directly from the analytical unbounded Gaussian \
distribution NormalDistribution[RX, ux] over ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], ")"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7b529b93-70f3-4185-9085-2091fb79bc40"],
 ". (Note that \[OpenCurlyDoubleQuote]Random\[CloseCurlyDoubleQuote] only \
reads the point count ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2e532d65-980e-4b1c-9405-2d528291025b"],
 " from \[OpenCurlyDoubleQuote]Grid\[CloseCurlyDoubleQuote] and ignores \
spatial bound specifications.)   \n\n\[OpenCurlyDoubleQuote]SamplingMethod\
\[CloseCurlyDoubleQuote] \[Rule] \[OpenCurlyDoubleQuote]RandomDensity\
\[CloseCurlyDoubleQuote]: Constructs a numerical ProbabilityDistribution from \
the wavepacket density GWP1DRHOX truncated and normalized over a bounded \
spatial domain (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[PlusMinus]", "4"}], 
    SubscriptBox["\[Sigma]", "x"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fd1a8746-971f-4c59-ae70-50dda3ed3655"],
 " by default, \[OpenCurlyDoubleQuote]3Sigma\[CloseCurlyDoubleQuote], or an \
explicit {xMin, xMax} window)."
}], "Text",
 CellChangeTimes->{{4.002131587666334*^9, 
  4.0021316648808727`*^9}},ExpressionUUID->"a59bb5ac-c76d-434e-b80a-\
7c3f757b8700"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "10", " ", "sorted", " ", "random", " ", "variates", " ", "from", " ", 
    "the", " ", "full", " ", "unbounded", " ", "normal", " ", 
    "distribution"}], "*)"}], 
  RowBox[{
   RowBox[{"xdatR1", "=", 
    RowBox[{"GWPEnsemble", "[", 
     RowBox[{"obj", ",", 
      RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<Random\>\""}], ",", 
      RowBox[{"\"\<Grid\>\"", "->", "10"}]}], "]"}]}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "10", " ", "sorted", " ", "random", " ", "variates", " ", "restricted", " ",
       "to", " ", "the"}], "+", 
     RowBox[{
      RowBox[{"/", 
       RowBox[{"-", "3"}]}], "*", "Sigma", " ", 
      RowBox[{"window", "[", 
       RowBox[{
        RowBox[{"-", "3"}], ",", "3"}], "]"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"xdatRD1", "=", 
    RowBox[{"GWPEnsemble", "[", 
     RowBox[{"obj", ",", 
      RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<RandomDensity\>\""}], ",", 
      
      RowBox[{"\"\<Grid\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"10", ",", "\"\<3Sigma\>\""}], "}"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "10", " ", "sorted", " ", "random", " ", "variates", " ", "restricted", " ",
      "to", " ", "the", " ", "positive", " ", "spatial", " ", 
     RowBox[{"window", "[", 
      RowBox[{"0", ",", "2"}], "]"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"xdatRD2", "=", 
    RowBox[{"GWPEnsemble", "[", 
     RowBox[{"obj", ",", 
      RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<RandomDensity\>\""}], ",", 
      
      RowBox[{"\"\<Grid\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"10", ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "2"}], "}"}]}], "}"}]}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{4.002131678506672*^9, 4.002131701267541*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"f363ed71-d69c-4c1d-a64a-4273d7102a58"],

