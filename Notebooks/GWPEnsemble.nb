Cell[CellGroupData[{

Cell["Uniform Spatial Grids (\[OpenCurlyDoubleQuote]UniformX\
\[CloseCurlyDoubleQuote])", "Subsection",
 CellChangeTimes->{{4.002236317012773*^9, 
  4.002236327431229*^9}},ExpressionUUID->"b58b29aa-34b6-45fb-96ed-\
9dd28aed3be4"],

Cell[TextData[{
 "Selecting \[OpenCurlyDoubleQuote]SamplingMethod\[CloseCurlyDoubleQuote] \
\[Rule] \[OpenCurlyDoubleQuote]UniformX\[CloseCurlyDoubleQuote] generates a \
uniformly spaced Cartesian coordinate grid centered around the wavepacket\
\[CloseCurlyQuote]s expectation value ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "t"], "=", 
    RowBox[{"\[LeftAngleBracket]", 
     RowBox[{"x", "(", "t", ")"}], "\[RightAngleBracket]"}]}], 
   TraditionalForm]],ExpressionUUID->"c2d6cb27-89f0-4cb0-880a-c856fcdb5465"],
 ". The \[OpenCurlyDoubleQuote]Grid\[CloseCurlyDoubleQuote] option accepts \
three formats to control the number of grid points ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],ExpressionUUID->
  "8304a443-cf81-4bb1-b683-43003238ae2d"],
 " and the spatial domain bounds:  "
}], "Text",
 CellChangeTimes->{
  4.00212888532204*^9, {4.002129032797327*^9, 4.0021290430071993`*^9}, {
   4.002129112670944*^9, 4.002129300076766*^9}, {4.0022370568016357`*^9, 
   4.002237068237516*^9}, {4.002237204026245*^9, 
   4.002237212824902*^9}},ExpressionUUID->"a2801d5c-dc95-4fd8-b810-\
b2114b434109"],

Cell[TextData[{
 "\[OpenCurlyDoubleQuote]Grid\[CloseCurlyDoubleQuote] \[Rule] N (or Automatic \
for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "=", "100"}], TraditionalForm]],ExpressionUUID->
  "2f4cb8b7-70b6-435d-9c43-b6f42aa3304a"],
 "): Subdivides the default ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[PlusMinus]", "4"}], 
    SubscriptBox["\[Sigma]", "x"]}], TraditionalForm]],ExpressionUUID->
  "f0cda7c0-69d0-4236-ae2f-0ea03bcc3ef1"],
 " interval ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     RowBox[{
      SubscriptBox["x", "t"], "-", 
      RowBox[{"4", 
       SubscriptBox["\[Sigma]", "x"]}]}], ",", 
     RowBox[{"x", "+", 
      RowBox[{"4", 
       SubscriptBox["\[Sigma]", "x"]}]}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"52eb22a0-c452-42e6-a417-06607c44e89e"],
 " into ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],ExpressionUUID->
  "899253eb-e2a2-4a6d-83e6-384f35a6afca"],
 " evenly spaced points."
}], "Item",
 CellChangeTimes->{{4.002237147765781*^9, 
  4.002237156294696*^9}},ExpressionUUID->"446b125b-f138-4888-831e-\
c8df34420e4f"],

Cell[TextData[{
 "\[OpenCurlyDoubleQuote]Grid\[CloseCurlyDoubleQuote] \[Rule] {N, \
\[OpenCurlyDoubleQuote]3Sigma\[CloseCurlyDoubleQuote]}: Subdivides the \
narrower ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[PlusMinus]", "3"}], 
    SubscriptBox["\[Sigma]", "x"]}], TraditionalForm]],ExpressionUUID->
  "1490bd91-a5a0-4d0d-bcce-c3a77cf73587"],
 " interval ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     RowBox[{
      SubscriptBox["x", "t"], "-", 
      RowBox[{"3", 
       SubscriptBox["\[Sigma]", "x"]}]}], ",", 
     RowBox[{
      SubscriptBox["x", "t"], "+", 
