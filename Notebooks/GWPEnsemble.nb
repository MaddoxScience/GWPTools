Cell["\<\
By default (WorkingPrecision \[Rule] Automatic), \
\[OpenCurlyDoubleQuote]Random\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]RandomDensity\[CloseCurlyDoubleQuote] generate \
machine-precision floating-point numbers, whereas exact methods (\
\[OpenCurlyDoubleQuote]UniformX\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]UniformC\[CloseCurlyDoubleQuote]) preserve exact \
symbolic expressions when the underlying wavepacket parameters are exact. \
Passing an explicit WorkingPrecision option overrides this default across all \
sampling methods\[LongDash]generating arbitrary-precision random variates or \
directly evaluating exact symbolic grids to the requested number of digits:\
\>", "Text",
 CellChangeTimes->{{4.002133046877429*^9, 
  4.002133050592223*^9}},ExpressionUUID->"f5aadae7-3072-431f-8773-\
d005ed2c80ed"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Arbitrary", "-", 
    RowBox[{"precision", " ", "random", " ", "sampling", " ", 
     RowBox[{"(", 
      RowBox[{"25", " ", "digits"}], ")"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{"xdatR25", "=", 
    RowBox[{"GWPEnsemble", "[", 
     RowBox[{"obj", ",", 
      RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<Random\>\""}], ",", 
      RowBox[{"\"\<Grid\>\"", "->", "5"}], ",", 
      RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{"xdatRD25", "=", 
    RowBox[{"GWPEnsemble", "[", 
     RowBox[{"obj", ",", 
      RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<RandomDensity\>\""}], ",", 
      
      RowBox[{"\"\<Grid\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"5", ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "2"}], "}"}]}], "}"}]}], ",", 
      RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Evaluating", " ", "an", " ", "exact", " ", "symbolic", " ", "quantile", 
      " ", "grid", " ", 
      RowBox[{"(", "\"\<UniformC\>\"", ")"}], " ", "directly", " ", "to", " ",
       "25"}], "-", 
     RowBox[{"digit", " ", "precision"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"xdatC25", "=", 
    RowBox[{"GWPEnsemble", "[", 
     RowBox[{"obj", ",", 
      RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<UniformC\>\""}], ",", 
      RowBox[{"\"\<Grid\>\"", "->", "5"}], ",", 
      RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{4.002133073028655*^9, 4.002133073028777*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"562c8786-cf97-4b0f-9ed6-eccdcb804ad7"],

