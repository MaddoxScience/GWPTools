Cell["\<\
Because Bohmian trajectories conserve cumulative probability along the flow, \
specifying a narrow probability interval \[OpenCurlyDoubleQuote]Grid\
\[CloseCurlyDoubleQuote] -> {N, {cMin, cMax}} in \
\[OpenCurlyDoubleQuote]InverseC\[CloseCurlyDoubleQuote] acts as a microscope \
on an individual interference feature.\
\>", "Text",
 CellChangeTimes->{
  4.0022982591642323`*^9},ExpressionUUID->"18f206ef-46e7-4b97-88a9-\
c61d92678449"],

Cell[TextData[{
 "Due to the dipole laser pulse ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "1"], "(", "t", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1bf21db9-3900-421d-8fb1-fa18515a5336"],
 ", the interference fringes are shifted both in time and position relative \
to an unperturbed harmonic oscillator. Below, we sample 50 trajectories \
inside the quantile band ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "\[Element]", 
    RowBox[{"[", 
     RowBox[{"0.15", ",", "0.30"}], "]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4743da07-ec69-49c9-8f2a-e6afc92320f2"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", "0.9"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2f2349e7-eaea-4fe3-8671-86b73071353d"],
 " and propagate across the short window ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "\[Element]", 
    RowBox[{"[", 
     RowBox[{"0.9", ",", "1.3"}], "]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f4d837b5-7168-4dbe-b68c-d435f43d74ff"],
 " over ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "\[Element]", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"-", "0.75"}], ",", "0"}], "]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5024bfdc-c337-4424-a417-8ca657c34763"],
 ", resolving the sharp hyperbolic bifurcation and rapid velocity shear right \
around a single destructive node:"
}], "Text",
 CellChangeTimes->{{4.0022982722787447`*^9, 
  4.002298337102683*^9}},ExpressionUUID->"b406fa71-4075-4561-aeed-\
20f233ad9d23"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "1.", " ", "Sample", " ", "50", " ", "trajectories", " ", "inside", " ", 
     "the", " ", "quantile", " ", "band", " ", "c", " ", 
     RowBox[{"in", "[", 
      RowBox[{"0.15", ",", "0.30"}], "]"}], " ", "at", " ", "t"}], "=", 
    "0.9"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"x0Zoom", "=", 
     RowBox[{
      RowBox[{"GWPEnsemble", "[", 
       RowBox[{"objCat", ",", 
        RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<InverseC\>\""}], ",", 
        RowBox[{"\"\<Grid\>\"", "->", 
         RowBox[{"{", 
          RowBox[{"50", ",", 
           RowBox[{"{", 
            RowBox[{"0.15", ",", "0.30"}], "}"}]}], "}"}]}], ",", 
        RowBox[{"\"\<Time\>\"", "->", "0.9"}]}], "]"}], "//", "Chop"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Propagate", " ", "over", " ", "the", " ", "short", " ", 
     "interference", " ", "window", " ", "t", " ", 
     RowBox[{"in", "[", 
      RowBox[{"0.9", ",", "1.3"}], "]"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solZoom", "=", 
     RowBox[{"GWPEnsembleSolve", "[", 
      RowBox[{"objCat", ",", "x0Zoom", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0.9", ",", "1.3"}], "}"}], ",", 
       RowBox[{"MaxStepSize", "->", "0.005"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"parsedZoom", "=", 
     RowBox[{"GWPEnsembleParse", "[", 
      RowBox[{"x0Zoom", ",", "solZoom"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"trajZoom", "=", 
     RowBox[{"GWPEnsembleFormat", "[", 
      RowBox[{"parsedZoom", ",", "\"\<X0DAT\>\""}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Compare", " ", "standalone", " ", "zoomed", " ", 
     "trajectories", " ", "alongside", " ", "the", " ", "local", " ", "node", 
     " ", "density"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ListLinePlot", "[", 
        RowBox[{"trajZoom", ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0.9", ",", "1.3"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "0.75"}], ",", "0"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"ColorData", "[", 
             RowBox[{"97", ",", "1"}], "]"}], ",", "Thin"}], "]"}]}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<t\>\"", ",", "\"\<x(t)\>\""}], "}"}]}], ",", 
         RowBox[{
         "PlotLabel", 
          "->", "\"\<Node Zoom: Trajectories (c \[Element] [0.15, \
0.30])\>\""}], ",", 
         RowBox[{"AspectRatio", "->", "1"}]}], "]"}], ",", 
       RowBox[{"Show", "[", 
        RowBox[{
         RowBox[{"DensityPlot", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"objCat", "[", "\"\<RHOX\>\"", "]"}], "[", 
            RowBox[{"x", ",", "t"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0.9", ",", "1.3"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"-", "0.75"}], ",", "0"}], "}"}], ",", 
           RowBox[{"PlotPoints", "->", "60"}], ",", 
           RowBox[{"ColorFunction", "->", "\"\<SunsetColors\>\""}], ",", 
           RowBox[{"FrameLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<t\>\"", ",", "\"\<x(t)\>\""}], "}"}]}], ",", 
           RowBox[{
           "PlotLabel", "->", "\"\<Hyperbolic Avoidance at Dark Node\>\""}]}],
           "]"}], ",", 
         RowBox[{"ListLinePlot", "[", 
          RowBox[{"trajZoom", ",", 
           RowBox[{"PlotStyle", "->", 
            RowBox[{"Directive", "[", 
             RowBox[{"White", ",", 
              RowBox[{"Opacity", "[", "0.85", "]"}], ",", "Thin"}], "]"}]}]}],
           "]"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"ImageSize", "->", "750"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{4.002298074445578*^9, 4.0022980744456997`*^9}},
 CellLabel->
  "In[320]:=",ExpressionUUID->"19a4f9eb-5bb4-47c4-9200-5258c06100a0"],

