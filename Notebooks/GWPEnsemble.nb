Cell[CellGroupData[{

Cell["Single GWP Examples (1D)", "Section",
 CellChangeTimes->{{4.002128676720232*^9, 4.002128685764328*^9}, {
  4.0021340774500647`*^9, 4.0021340862853394`*^9}, {4.002135887495648*^9, 
  4.0021358975804367`*^9}},ExpressionUUID->"46b6c13f-a549-48b4-b30f-\
e1d9162e7fa4"],

Cell["\<\
For a 1D Gaussian wavepacket, GWPEnsemble provides four sampling strategies \
controlled via the \[OpenCurlyDoubleQuote]SamplingMethod\
\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]Grid\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]Time\[CloseCurlyDoubleQuote], and WorkingPrecision \
options, which are demonstrated in the examples below.\
\>", "Text",
 CellChangeTimes->{{4.0022390731738653`*^9, 
  4.002239087756381*^9}},ExpressionUUID->"1a2809ad-c93d-4203-aea1-\
2ba3ffc6448d"],

Cell[CellGroupData[{

Cell["Default Behavior (Automatic Quantile Sampling)", "Subsection",
 CellChangeTimes->{{4.002236293446813*^9, 4.002236307607147*^9}, {
  4.002237034886425*^9, 
  4.0022370390267572`*^9}},ExpressionUUID->"0665d80e-0fe2-44cf-b0fb-\
44e62a4cadf7"],

Cell[TextData[{
 "We begin by initializing a default stationary wavepacket (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "0"], "=", 
    RowBox[{"1", "/", "4"}]}], TraditionalForm]],ExpressionUUID->
  "ecb3eafd-b4b7-4cb2-9168-8185d7c7776b"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "0"], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "7b3a5563-c1be-4862-b5c8-18cc4e4472a5"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["p", "0"], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d5b82d01-a91f-4a5b-8c97-6eee8d369d7b"],
 ") which has initial position expectation value ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[LeftAngleBracket]", "x", "\[RightAngleBracket]"}], "=", "0"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f7e08aa7-7ede-45db-9b7f-3ba7089152ec"],
 " and spatial width ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", "x"], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"997cf109-d7b0-4702-aeb6-9cd7c22782d7"],
 "):"
}], "Text",
 CellChangeTimes->{{4.002128734129011*^9, 4.0021288225290403`*^9}, {
  4.002129148930615*^9, 4.002129152413328*^9}, {4.002236609958713*^9, 
  4.002236676023674*^9}},ExpressionUUID->"1c3ec17f-ec06-4637-ad12-\
0cbb8b162827"],

Cell[BoxData[
 RowBox[{
  RowBox[{"obj", "=", 
   RowBox[{
    RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.001775274043401*^9, 4.001775278531234*^9}, 
   4.0021283935786333`*^9},
 CellLabel->
  "In[104]:=",ExpressionUUID->"d6b92820-3c3f-4727-9416-5d9b831bbebc"],

Cell[TextData[{
 "Calling GWPEnsemble[obj] with no options triggers the default settings \
\[OpenCurlyDoubleQuote]SamplingMethod\[CloseCurlyDoubleQuote] \[Rule] \
Automatic and \
\[OpenCurlyDoubleQuote]Grid\[CloseCurlyDoubleQuote]\[RightArrow] Automatic. \
For a 1D wavepacket, Automatic resolves to \[OpenCurlyDoubleQuote]UniformC\
\[CloseCurlyDoubleQuote] (uniform cumulative distribution sampling) and \
generates a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "=", "100"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "67fc639b-fbf2-486c-aefb-f242f7a39e24"],
 " point grid evaluated at the probability midpoints"
}], "Text",
 CellChangeTimes->{
  4.002128836791461*^9, {4.002128921394294*^9, 4.002128951774909*^9}, {
   4.0021289947568417`*^9, 4.002129013681685*^9}, {4.002236701679364*^9, 
   4.002236725719239*^9}},ExpressionUUID->"f95062f9-911b-41ee-9d3a-\
f3cb8c369f44"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["c", "k"], "=", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"2", "k"}], "-", "1"}], 
     RowBox[{"2", "N"}]], "\[Element]", 
    RowBox[{"(", 
     RowBox[{"0", ",", "1"}], ")"}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.002128957153825*^9, 
  4.0021289888049107`*^9}},ExpressionUUID->"b7355b21-bcba-4256-ae7a-\
1224b71c8975"],

Cell[TextData[{
 "for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"k", "=", "1"}], ",", "2", ",", "\[Ellipsis]", ",", "N"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b3635876-86bb-48eb-9200-8dd92187b991"],
 " via the analytical inverse cumulative distribution function obj[\
\[OpenCurlyDoubleQuote]XC\[CloseCurlyDoubleQuote]][c,t]"
}], "Text",
 CellChangeTimes->{{4.002128998355035*^9, 4.002129000053293*^9}, {
  4.002236740432374*^9, 
  4.002236773238076*^9}},ExpressionUUID->"30288a72-0e1f-4c5d-9465-\
dbcb5ac07c02"],

