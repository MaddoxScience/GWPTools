{$CellContext`x, -3.5, 3.5}, {$CellContext`y, -3.5, 3.5}, Contours -> 8, 
          ColorFunction -> "DeepSeaColors", PlotRange -> All, Exclusions -> 
          None], 
         Graphics[{White, 
