Cell[CellGroupData[{

Cell["\<\
2D Anisotropic Coupled Oscillator (Lissajous Swirl & Phase-Space Vorticity)\
\>", "Subsection",
 CellChangeTimes->{
  4.002193719842095*^9},ExpressionUUID->"45ccf4a9-4fa3-4ffa-9c14-\
14f2c21ca6d4"],

Cell[TextData[{
 "Using \[OpenCurlyDoubleQuote]SamplingMethod\[CloseCurlyDoubleQuote]\[Rule] \
\[OpenCurlyDoubleQuote]PolarC\[CloseCurlyDoubleQuote] on a 2D Gaussian \
wavepacket with initial off-diagonal correlation (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", 
     RowBox[{"x", " ", "y"}]], "!=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "882d60f6-924b-41ff-91a1-cd88865cd481"],
 ") and initial transverse momentum shows how EnsembleFormat extracts both 2D \
planar orbits and 1D coordinate projections."
}], "Text",
 CellChangeTimes->{{4.002193736941905*^9, 
  4.002193772947125*^9}},ExpressionUUID->"e2ab6f3f-f7d7-4502-8aa5-\
f90377667017"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Correlated", " ", "2", "D", " ", "Gaussian", " ", "in", " ", 
    "an", " ", "isotropic", " ", "harmonic", " ", "trap"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"obj2D", "=", 
     RowBox[{
      RowBox[{"GWP", "[", "\"\<2D\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"3", "/", "2"}], ",", 
           RowBox[{"1", "/", "2"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "2"}], ",", 
           RowBox[{"2", "/", "3"}]}], "}"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "2"}], ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"3", "/", "2"}]}], "}"}], ",", 
       RowBox[{"\"\<Potential\>\"", "->", "\"\<HO\>\""}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "2.", " ", "Sample", " ", "3", " ", "radial", " ", "shells", " ", "x", " ",
       "10", " ", "angular", " ", "spokes"}], "=", 
     RowBox[{"30", " ", "trajectories"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"xy0", "=", 
     RowBox[{"GWPEnsemble", "[", 
      RowBox[{"obj2D", ",", 
       RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<PolarC\>\""}], ",", 
       RowBox[{"\"\<Grid\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"3", ",", "10"}], "}"}]}], ",", 
       RowBox[{"\"\<Time\>\"", "->", "0"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Propagate", " ", "2", "D", " ", "Bohmian", " ", "velocity", " ",
      "field"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol2D", "=", 
     RowBox[{"EnsembleSolve", "[", 
      RowBox[{"xy0", ",", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"xy", ",", "t"}], "}"}], ",", 
         RowBox[{"Transpose", "@", 
          RowBox[{
           RowBox[{"obj2D", "[", "\"\<VX\>\"", "]"}], "[", 
           RowBox[{
            RowBox[{"xy", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
            RowBox[{"xy", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "t"}], "]"}]}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", 
         RowBox[{"2", "*", "2", " ", "Pi"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"parsed2D", "=", 
     RowBox[{"EnsembleParse", "[", 
      RowBox[{"xy0", ",", "sol2D"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"4.", " ", "Extract", " ", "planar", " ", 
      RowBox[{"(", 
       RowBox[{"x", ",", "y"}], ")"}], " ", "trajectories", " ", "and", " ", 
      "1", "D", " ", "x", 
      RowBox[{"(", "t", ")"}]}], ",", 
     RowBox[{"y", 
      RowBox[{"(", "t", ")"}], " ", "projections"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"trajXY", "=", 
     RowBox[{"EnsembleFormat", "[", 
      RowBox[{"parsed2D", ",", "\"\<X0DAT\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"trajX", "=", 
     RowBox[{"EnsembleFormat", "[", 
      RowBox[{"parsed2D", ",", "\"\<X0DAT\>\"", ",", 
       RowBox[{"\"\<Component\>\"", "->", "1"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"trajY", "=", 
     RowBox[{"EnsembleFormat", "[", 
      RowBox[{"parsed2D", ",", "\"\<X0DAT\>\"", ",", 
       RowBox[{"\"\<Component\>\"", "->", "2"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ListLinePlot", "[", 
        RowBox[{"trajXY", ",", 
         RowBox[{"AspectRatio", "->", "1"}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
