Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Initial", " ", "2", "D", " ", "velocities", " ", "at", " ", "t"}], "=", 
    "0"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"vxy0Num", "=", 
     RowBox[{"Transpose", "@", 
      RowBox[{
       RowBox[{"obj2DNum", "[", "\"\<VX\>\"", "]"}], "[", 
       RowBox[{
        RowBox[{"xy0Num", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
        RowBox[{"xy0Num", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "0"}], "]"}]}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Classical", " ", "force", " ", "F_class"}], "=", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "dV"}], "/", "dx"}], ",", 
        RowBox[{
         RowBox[{"-", "dV"}], "/", "dy"}]}], "}"}], "+", 
      RowBox[{"Quantum", " ", "force", " ", "QFX"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fTotal2D", "[", 
      RowBox[{"xy_", ",", "t_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "=", 
          RowBox[{"xy", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", 
         RowBox[{"y", "=", 
          RowBox[{"xy", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ",", "fxClass", ",", 
         "fyClass", ",", "qf"}], "}"}], ",", 
       RowBox[{
        RowBox[{"fxClass", "=", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"v10", "[", "t", "]"}]}], "-", 
          RowBox[{"2", " ", 
           RowBox[{"v20", "[", "t", "]"}], " ", "x"}], "-", 
          RowBox[{
           RowBox[{"v11", "[", "t", "]"}], " ", "y"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"fyClass", "=", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"v01", "[", "t", "]"}]}], "-", 
          RowBox[{"2", " ", 
           RowBox[{"v02", "[", "t", "]"}], " ", "y"}], "-", 
          RowBox[{
           RowBox[{"v11", "[", "t", "]"}], " ", "x"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"qf", "=", 
         RowBox[{
          RowBox[{"obj2DNum", "[", "\"\<QFX\>\"", "]"}], "[", 
          RowBox[{"x", ",", "y", ",", "t"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"fxClass", "+", 
             RowBox[{"qf", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ",", 
            RowBox[{"fyClass", "+", 
             RowBox[{"qf", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], "]"}], "/", 
         RowBox[{"obj2DNum", "[", "\"\<MASS\>\"", "]"}]}]}]}], "]"}]}], ";"}],
    "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Integrate", " ", "2", "nd"}], "-", 
     RowBox[{"order", " ", "2", "D", " ", "Newton"}], "-", 
     RowBox[{"Bohm", " ", "equations"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol2DNum2nd", "=", 
     RowBox[{"EnsembleSolve", "[", 
      RowBox[{"xy0Num", ",", "vxy0Num", ",", "fTotal2D", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", 
         RowBox[{"2", " ", "Pi"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Maximum", " ", "2", "D", " ", "endpoint", " ", "discrepancy", " ", 
      "between", " ", "1", "st"}], "-", 
     RowBox[{"order", " ", "and", " ", "2", "nd"}], "-", 
     RowBox[{"order", " ", "propagation"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Max", "@", 
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"Through", "[", 
       RowBox[{"sol2DNum", "[", 
        RowBox[{"2", " ", "Pi"}], "]"}], "]"}], "-", 
      RowBox[{"Through", "[", 
       RowBox[{"sol2DNum2nd", "[", 
        RowBox[{"2", " ", "Pi"}], "]"}], "]"}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{4.002196431336384*^9, 4.002196433400955*^9}},
 CellLabel->
  "In[364]:=",ExpressionUUID->"e3eed11f-3d82-4876-a8e6-467111229db2"],

