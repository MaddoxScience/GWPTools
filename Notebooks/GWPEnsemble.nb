Cell[CellGroupData[{

Cell["\<\
Laser-Driven \
\[OpenCurlyDoubleQuote]Schr\[ODoubleDot]dinger\[CloseCurlyQuote]s Cat\
\[CloseCurlyDoubleQuote] Superposition (MC1D + Chirped Pulse)\
\>", "Subsection",
 CellChangeTimes->{
  4.0021947493273706`*^9},ExpressionUUID->"c6428298-fdc6-47d1-8621-\
eadb89c0ce41"],

Cell[TextData[{
 "A two-packet MC1D superposition starts separated in a harmonic trap (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "0"], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "2.5"}], ",", "2.5"}], "}"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d10f777a-1976-4e24-aa76-5454703a5d19"],
 ") and is hit by an ultrashort Gaussian-envelope laser pulse "
}], "Text",
 CellChangeTimes->{{4.002194763224449*^9, 
  4.002194792372293*^9}},ExpressionUUID->"7f77a4a0-6007-49d2-96f4-\
2736b3975d18"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["V", "1"], "(", "t", ")"}], "=", 
   RowBox[{
    SubscriptBox["E", "0"], 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"t", "-", 
          SubscriptBox["t", "0"]}], ")"}], "2"]}], "/", 
      SuperscriptBox["\[Tau]", "2"]}]], 
    RowBox[{"cos", "(", 
     RowBox[{
      SubscriptBox["\[Omega]", "L"], " ", "t"}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.002128957153825*^9, 4.0021289888049107`*^9}, {
  4.002129377650779*^9, 4.00212942207405*^9}, {4.002194823571836*^9, 
  4.0021948552042227`*^9}},ExpressionUUID->"72ec4d06-d033-4201-951e-\
f323cdec23a5"],

Cell["\<\
The trajectories exhibit sharp non-crossing topological bounces inside the \
interference fringes at the center of the trap while the entire interference \
pattern is shaken by the laser field.\
\>", "Text",
 CellChangeTimes->{
  4.0021947945507317`*^9, {4.002194858715629*^9, 
   4.002194861080158*^9}},ExpressionUUID->"f0456981-0c03-4886-a7d3-\
c3917165b2c9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"1.", " ", "Define", " ", "a", " ", "Gaussian"}], "-", 
    RowBox[{"envelope", " ", "oscillating", " ", "laser", " ", "pulse", " ", 
     RowBox[{"(", 
      RowBox[{"dipole", " ", "force", " ", 
       RowBox[{"v1", "[", "t", "]"}]}], ")"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"GWPClearCache", "[", "\"\<Quiet\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Clear", "[", 
    RowBox[{"v0Pulse", ",", "v1Pulse", ",", "v2Pulse"}], "]"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"v0Pulse", "[", "t_", "]"}], ":=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"v1Pulse", "[", "t_", "]"}], ":=", 
     RowBox[{"2.5", "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"t", "-", "Pi"}], ")"}], "^", "2"}]}], "/", 
        RowBox[{"0.8", "^", "2"}]}], "]"}], "*", 
      RowBox[{"Cos", "[", 
       RowBox[{"4", " ", "t"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"v2Pulse", "[", "t_", "]"}], ":=", "1"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Harmonic", " ", "confinement", " ", "omega"}], "=", "1"}], 
    "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"2.", " ", "Build", " ", "a", " ", "2"}], "-", 
     RowBox[{
     "state", " ", "Cat", " ", "superposition", " ", "driven", " ", "by", " ",
       "the", " ", "numerical", " ", "pulse", " ", 
      RowBox[{"over", "[", 
       RowBox[{"0", ",", 
        RowBox[{"2", " ", "Pi"}]}], "]"}]}]}], "*)"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"objCat", "=", 
     RowBox[{
      RowBox[{"GWP", "[", "\"\<MC1D\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "5"}], "/", "2"}], ",", 
         RowBox[{"5", "/", "2"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"\"\<C\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}]}], ",", 
       RowBox[{"\"\<Potential\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Numerical\>\"", ",", "v0Pulse", ",", "v1Pulse", ",", 
          "v2Pulse", ",", "0", ",", 
          RowBox[{"2", " ", "Pi"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Sample", " ", "30", " ", "quantile", " ", "trajectories", " ",
      "across", " ", "the", " ", "bimodal", " ", "initial", " ", "density"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x0Cat", "=", 
     RowBox[{"GWPEnsemble", "[", 
      RowBox[{"objCat", ",", 
       RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<InverseC\>\""}], ",", 
       RowBox[{"\"\<Grid\>\"", "->", "30"}], ",", 
       RowBox[{"\"\<Time\>\"", "->", "0"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "4.", " ", "Propagate", " ", "trajectories", " ", "through", " ", "the", 
      " ", "laser"}], "-", 
     RowBox[{"driven", " ", "interference", " ", "fringes"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solCat", "=", 
     RowBox[{"EnsembleSolve", "[", 
      RowBox[{"x0Cat", ",", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "t"}], "}"}], ",", 
         RowBox[{
          RowBox[{"objCat", "[", "\"\<VX\>\"", "]"}], "[", 
          RowBox[{"x", ",", "t"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", 
         RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
       RowBox[{"MaxStepSize", "->", "0.02"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"parsedCat", "=", 
     RowBox[{"EnsembleParse", "[", 
      RowBox[{"x0Cat", ",", "solCat"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"trajCat", "=", 
     RowBox[{"EnsembleFormat", "[", 
      RowBox[{"parsedCat", ",", "\"\<X0DAT\>\""}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{4.002194870518536*^9, 4.002194883910593*^9}, {
  4.002194963943447*^9, 
  4.002194979531904*^9}},ExpressionUUID->"a2d2cdbc-0a8b-47ce-9e9e-\
174e2bb03d1c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "5.", " ", "Overlay", " ", "Bohmian", " ", "trajectories", " ", "on", " ", 
    "top", " ", "of", " ", "a", " ", "DensityPlot", " ", "of", " ", "rho", 
    RowBox[{"(", 
     RowBox[{"x", ",", "t"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"DensityPlot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"objCat", "[", "\"\<RHOX\>\"", "]"}], "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", 
        RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
      RowBox[{"PlotPoints", "->", "60"}], ",", 
      RowBox[{"ColorFunction", "->", "\"\<SunsetColors\>\""}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<t\>\"", ",", "\"\<x\>\""}], "}"}]}]}], "]"}], ",", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{"trajCat", ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"White", ",", 
         RowBox[{"Opacity", "[", "0.85", "]"}], ",", "Thin"}], "]"}]}]}], 
     "]"}], ",", 
    RowBox[{
    "PlotLabel", 
     "->", "\"\<Laser-Driven Cat State: Bohmian Fringe Avoidance\>\""}]}], 
   "]"}]}]], "Input",ExpressionUUID->"a5048bf5-0bd6-44fd-a656-7892f858dc19"],

