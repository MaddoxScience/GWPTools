Cell[CellGroupData[{

Cell["Dynamic Trajectory Propagation", "Section",
 CellChangeTimes->{{4.002147774684801*^9, 4.002147780965578*^9}, 
   4.002211476093889*^9, {4.002235676405952*^9, 
   4.002235702050495*^9}},ExpressionUUID->"bff2a307-dd61-4a3c-b729-\
327db2621ee5"],

Cell["\<\
Once an initial coordinate grid X0DAT is generated with GWPEnsemble, \
time-dependent trajectories are integrated, parsed, and reshaped for \
visualization directly within GWPEnsemble using a three-stage functional \
pipeline:\
\>", "Text",
 CellChangeTimes->{
  4.0022359727232447`*^9},ExpressionUUID->"67f93036-0510-42c2-a8e9-\
e0474f4491ae"],

Cell["\<\
GWPEnsembleSolve \[LongDash] Integrates 1st-order kinematic (Bohmian \
guidance) or 2nd-order dynamic (Newton\[Dash]Bohm) ODE systems over arbitrary \
N-dimensional ensemble arrays, or accepts a GWPObject directly to propagate \
Bohmian trajectories automatically.\
\>", "Item",
 CellChangeTimes->{{4.002236000468184*^9, 
  4.002236003208352*^9}},ExpressionUUID->"9a3bf2cd-87b6-4d73-8170-\
9e98051df56c"],

Cell["\<\
GWPEnsembleParse \[LongDash] Inspects the internal structure of the resulting \
InterpolatingFunction list to extract the adaptive solver time grid \
\[OpenCurlyDoubleQuote]TDAT\[CloseCurlyDoubleQuote], the position tensor \
\[OpenCurlyDoubleQuote]X0DAT\[CloseCurlyDoubleQuote], and the velocity tensor \
\[OpenCurlyDoubleQuote]X1DAT\[CloseCurlyDoubleQuote] without redundant \
function evaluations.\
\>", "Item",
 CellChangeTimes->{{4.002236000468184*^9, 4.002236029506678*^9}, {
   4.0022822767024937`*^9, 4.002282277755315*^9}, {4.002282344755477*^9, 
   4.002282345820401*^9}, 
   4.002295991301265*^9},ExpressionUUID->"cfbeddbf-01b8-4628-8b03-\
17c628362d0d"],

Cell["\<\
GWPEnsembleFormat \[LongDash] Reshapes and slices the parsed trajectory \
tensors into ListLinePlot-ready time series or parametric configuration-space \
orbits using the \[OpenCurlyDoubleQuote]Component\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]PairWithTime\[CloseCurlyDoubleQuote] options.\
\>", "Item",
 CellChangeTimes->{{4.002236000468184*^9, 4.002236030284727*^9}, 
   4.002282371254484*^9, 
   4.0022960069966087`*^9},ExpressionUUID->"6db70986-fa56-4ccd-84bf-\
4ad9f7f47a33"],

Cell[CellGroupData[{

Cell["Solver Signatures & Formatting Options", "Subsection",
 CellChangeTimes->{{4.002282529187653*^9, 
  4.0022825396041107`*^9}},ExpressionUUID->"d199c00b-4674-4ce8-8b73-\
38fa9a7dd25c"],

Cell["\<\
GWPEnsembleSolve supports three primary calling conventions depending on \
whether the velocity or acceleration field is taken directly from a GWPObject \
or supplied as a custom function:\
\>", "Text",
 CellChangeTimes->{
  4.002282549550006*^9},ExpressionUUID->"d23aabbd-181f-4665-be59-\
dc4e54ecbfea"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Direct GWPObject Bohmian Propagation (1st-Order): ", \
"ItemNumbered"]], "Item",
 CellChangeTimes->{{4.002282604230385*^9, 4.002282610106831*^9}, {
  4.002282666510027*^9, 
  4.0022826665129232`*^9}},ExpressionUUID->"2411a785-b0b6-4e60-b964-\
1f098afa3dff"],

Cell[TextData[{
 StyleBox["GWPEnsembleSolve[obj, X0DAT, {t, tMin, tMax}, opts] automatically \
extracts the hydrodynamic velocity field from obj and integrates ", 
  "ItemParagraph"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox[
      StyleBox["x",
       FontWeight->"Bold",
       FontSlant->"Plain"], "."], "(", "t", ")"}], "=", 
    RowBox[{
     StyleBox["v",
      FontWeight->"Bold",
      FontSlant->"Plain"], "(", 
     RowBox[{
      StyleBox["x",
       FontWeight->"Bold",
       FontSlant->"Plain"], ",", "t"}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f2871300-1235-4727-81da-9303147e1881"],
 StyleBox[".", "ItemParagraph"]
}], "ItemParagraph",
 CellChangeTimes->{{4.002282604230385*^9, 4.002282610106831*^9}, {
  4.002282789713304*^9, 
  4.0022828186205387`*^9}},ExpressionUUID->"d98130b0-29c8-4f23-bb23-\
47b77fcf72a3"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Custom Kinematic Velocity Field (1st-Order): ", \
"ItemNumbered"]], "Item",
 CellChangeTimes->{{4.002282604230385*^9, 4.0022826158596277`*^9}, {
  4.0022826886389236`*^9, 
  4.00228268864211*^9}},ExpressionUUID->"7d340cb2-8f22-4818-a822-\
e3fd016e5bb3"],

Cell[TextData[{
 StyleBox["GWPEnsembleSolve[X0DAT, VFUN, {t, tMin, tMax}, opts] integrates ", 
  "ItemNumbered"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox[
      StyleBox["x",
       FontWeight->"Bold",
       FontSlant->"Plain"], "."], "(", "t", ")"}], "=", 
    RowBox[{"VFUN", "[", 
     RowBox[{
      RowBox[{
       StyleBox["x",
        FontWeight->"Bold",
        FontSlant->"Plain"], "(", "t", ")"}], ",", "t"}], "]"}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6ee908a6-f2f8-4a16-95bd-bda1e7784308"],
 StyleBox[" for a two-argument velocity function Function[{x, t}, ...].", 
  "ItemNumbered"]
}], "ItemParagraph",
 CellChangeTimes->{{4.002282604230385*^9, 4.0022826158596277`*^9}, {
  4.00228283113151*^9, 4.002282875471055*^9}, {4.002296057176177*^9, 
  4.002296060549181*^9}},ExpressionUUID->"4a2e27be-b036-4f0f-a88c-\
1059d75aa1b9"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Dynamic Acceleration Field (2nd-Order \
Newton\[Dash]Bohm): ", "ItemNumbered"]], "Item",
 CellChangeTimes->{
  4.002282604230385*^9, {4.002282690175583*^9, 
   4.002282690178392*^9}},ExpressionUUID->"f6a60694-a22c-4a51-b9d6-\
9e5bb7415194"],

Cell[TextData[{
 StyleBox["GWPEnsembleSolve[X0DAT, V0DAT, AFUN, {t, tMin, tMax}, opts] \
integrates ", "ItemNumbered"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox[
      StyleBox["x",
       FontWeight->"Bold",
       FontSlant->"Plain"], ".."], "(", "t", ")"}], "=", 
    RowBox[{"AFUN", "[", 
     RowBox[{
      RowBox[{
       StyleBox["x",
        FontWeight->"Bold",
        FontSlant->"Plain"], "(", "t", ")"}], ",", 
      RowBox[{
       OverscriptBox[
        StyleBox["x",
         FontWeight->"Bold",
         FontSlant->"Plain"], "."], "(", "t", ")"}], ",", "t"}], "]"}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "376f8ece-f13f-4472-bb4e-cd7c0867421a"],
 " given initial positions X0DAT, initial velocities V0DAT, and a \
two-argument acceleration function Function[{x, t}, ...]. Any standard \
NDSolve options (such as Method, WorkingPrecision, MaxSteps, or AccuracyGoal) \
may be passed directly to GWPEnsembleSolve"
}], "ItemParagraph",
 CellChangeTimes->{
  4.002282604230385*^9, {4.002282927141626*^9, 4.002282959366913*^9}, 
   4.002296082788692*^9},ExpressionUUID->"5935172a-b1f0-46d5-b407-\
87891011d3fd"]
}, Open  ]],

Cell["\<\
Once parsed via PARSED = GWPEnsembleParse[X0DAT, SOLN], trajectories are \
formatted for plotting with GWPEnsembleFormat[PARSED, key, opts], where key \
is \[OpenCurlyDoubleQuote]X0DAT\[CloseCurlyDoubleQuote] (positions, the \
default) or \[OpenCurlyDoubleQuote]X1DAT\[CloseCurlyDoubleQuote] (velocities):\
\>", "Text",
 CellChangeTimes->{4.002283040156641*^9, 
  4.002296101427988*^9},ExpressionUUID->"d51e9f93-42ff-45b7-a920-\
1de75deaab13"],

Cell["\<\
\[OpenCurlyDoubleQuote]Component\[CloseCurlyDoubleQuote] \[Rule] All | k | \
{k1, k2, ...}: Selects which spatial coordinate component(s) to extract for \
multi-dimensional ensembles (defaults to All).\
\>", "Item",
 CellChangeTimes->{{4.002283064669796*^9, 4.0022830719461107`*^9}, {
  4.002284327277647*^9, 
  4.0022843282779427`*^9}},ExpressionUUID->"fdf99816-bd19-4d85-84f3-\
86f9f2ab45de"],

Cell["\<\
\[OpenCurlyDoubleQuote]PairWithTime\[CloseCurlyDoubleQuote] -> Automatic | \
True | False: Controls whether the output coordinates are paired with the \
solver time grid as {t, x_k(t)} curves (default True for 1D data or single \
components) or returned as parametric configuration-space orbits {x(t), y(t)} \
(default False when multiple spatial components are extracted).\
\>", "Item",
 CellChangeTimes->{{4.002283064669796*^9, 4.0022830712898207`*^9}, {
   4.002284330298946*^9, 4.0022843310416517`*^9}, 
   4.0022961188848743`*^9},ExpressionUUID->"d20ec81f-f312-4c20-b9d5-\
f2f26630950e"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
Squeezed & Displaced Harmonic Oscillator (Affine Breathing + Oscillation)\
\>", "Subsection",
 CellChangeTimes->{{4.0021934584264936`*^9, 4.002193480681003*^9}, 
   4.002283177880268*^9},ExpressionUUID->"ad82f3f6-1242-4ecf-9884-\
384a386a1a7f"],

Cell[TextData[{
 "A single 1D Gaussian wavepacket displaced from equilibrium with an initial \
width narrower than the ground state exhibits classical center-of-mass \
sloshing combined with quantum width breathing at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Omega]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1b1c28e7-4705-4890-912c-39234f389bc4"],
 ". Because the single-Gaussian Bohmian velocity field is strictly linear in ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0a994bea-bc49-49b1-a35c-8b0957c6172c"],
 ", the quantile trajectories form a non-crossing affine fan that expands and \
contracts in lockstep with the analytical standard deviation envelope."
}], "Text",
 CellChangeTimes->{
  4.002193472642293*^9, {4.0021936758453197`*^9, 4.0021936926547194`*^9}, {
   4.002283256895194*^9, 4.002283268305943*^9}, {4.002283298778658*^9, 
   4.002283303384449*^9}},ExpressionUUID->"4cbbe923-ce6d-470a-960b-\
c20550f541f3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Displaced", " ", 
    RowBox[{"(", 
     RowBox[{"x0", "=", 
      RowBox[{"-", "2"}]}], ")"}], " ", "and", " ", "squeezed", " ", 
    RowBox[{"(", 
     RowBox[{"a0", "=", "2"}], ")"}], " ", "1", "D", " ", "harmonic", " ", 
    "oscillator"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"obj1D", "=", 
     RowBox[{
      RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
      RowBox[{"2", ",", 
       RowBox[{"-", "2"}], ",", "0", ",", 
       RowBox[{"\"\<Potential\>\"", "->", "\"\<HO\>\""}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Sample", " ", "21", " ", "equiquantile", " ", "initial", " ", 
     "positions", " ", "via", " ", "UniformC"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"x0", "=", 
     RowBox[{"GWPEnsemble", "[", 
      RowBox[{"obj1D", ",", 
       RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<UniformC\>\""}], ",", 
       RowBox[{"\"\<Grid\>\"", "->", "21"}], ",", 
       RowBox[{"\"\<Time\>\"", "->", "0"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Propagate", " ", "1", "st"}], "-", 
     RowBox[{
     "order", " ", "Bohmian", " ", "trajectories", " ", "directly", " ", 
      "from", " ", "obj1D", " ", "over", " ", "one", " ", "full", " ", 
      RowBox[{"period", "[", 
       RowBox[{"0", ",", 
        RowBox[{"2", " ", "Pi"}]}], "]"}]}]}], "*)"}], "\[IndentingNewLine]", 
   
   RowBox[{"(*", 
    RowBox[{"Note", ":", 
     RowBox[{"Equivalent", " ", "to", " ", 
      RowBox[{"GWPEnsembleSolve", "[", 
       RowBox[{"x0", ",", 
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", "t"}], "}"}], ",", 
          RowBox[{
           RowBox[{"obj1D", "[", "\"\<VX\>\"", "]"}], "[", 
           RowBox[{"x", ",", "t"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", 
          RowBox[{"2", " ", "Pi"}]}], "}"}]}], "]"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol1D", "=", 
     RowBox[{"GWPEnsembleSolve", "[", 
      RowBox[{"obj1D", ",", "x0", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", 
         RowBox[{"2", " ", "Pi"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"parsed1D", "=", 
     RowBox[{"GWPEnsembleParse", "[", 
      RowBox[{"x0", ",", "sol1D"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"traj1D", "=", 
     RowBox[{"GWPEnsembleFormat", "[", 
      RowBox[{"parsed1D", ",", "\"\<X0DAT\>\""}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Plot", " ", "trajectories", " ", "alongside", " ", "the", " ", 
     "classical", " ", "center", " ", "RX", 
     RowBox[{"(", "t", ")"}]}], "*)"}], "\n", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"ListLinePlot", "[", 
      RowBox[{"traj1D", ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"Opacity", "[", "0.6", "]"}], ",", 
          RowBox[{"ColorData", "[", 
           RowBox[{"97", ",", "1"}], "]"}]}], "]"}]}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<t\>\"", ",", "\"\<x(t)\>\""}], "}"}]}], ",", 
       RowBox[{
       "PlotLabel", 
        "->", "\"\<1D Squeezed Coherent State: Quantile Bohmian \
Trajectories\>\""}], ",", 
       RowBox[{"BaseStyle", "->", 
        RowBox[{"{", 
         RowBox[{"FontSize", "->", "11"}], "}"}]}], ",", 
       RowBox[{"ImageSize", "->", "500"}]}], "]"}], ",", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"obj1D", "[", "\"\<RX\>\"", "]"}], "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", 
         RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Black", ",", "Dashed", ",", "Thick"}], "]"}]}]}], "]"}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{4.002193488820788*^9, 4.0021935348878183`*^9}, {
   4.002193576143093*^9, 4.0021935774621067`*^9}, {4.002193616334557*^9, 
   4.002193662954924*^9}, 4.002283320767371*^9, 4.002283366699827*^9},
 CellLabel->
  "In[132]:=",ExpressionUUID->"abf6175f-4182-44a1-93d3-3d6de2e4c890"],

