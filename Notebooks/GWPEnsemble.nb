Cell[CellGroupData[{

Cell["\<\
Second-Order Newton-Bohm Propagation (Classical+Quantum Force)\
\>", "Subsection",
 CellChangeTimes->{{4.002285428445426*^9, 
  4.002285447423257*^9}},ExpressionUUID->"0be66bc9-42c1-4b00-bbe9-\
04329847238a"],

Cell["\<\
Alternatively, trajectories can be integrated using the second-order Newton\
\[Dash]Bohm equation of motion, where each particle is accelerated by the sum \
of the external classical force (\[OpenCurlyDoubleQuote]FEX\
\[CloseCurlyDoubleQuote]) and the Bohmian quantum force (\
\[OpenCurlyDoubleQuote]QFX\[CloseCurlyDoubleQuote]). When initialized with \
the exact hydrodynamic velocity field v0 = obj1D[\[OpenCurlyDoubleQuote]VX\
\[CloseCurlyDoubleQuote]][x0, 0], second-order dynamic propagation reproduces \
the first-order Bohmian trajectories to numerical precision:\
\>", "Text",
 CellChangeTimes->{4.002285458861843*^9, 
  4.002296134096404*^9},ExpressionUUID->"bd4c4ccc-e967-4c1b-ab61-\
e82c49357034"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "1.", " ", "Initial", " ", "positions", " ", "x0", " ", "and", " ", 
     "initial", " ", "Bohmian", " ", "velocities", " ", "v0", " ", "at", " ", 
     "t"}], "=", "0"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"x0", "=", 
     RowBox[{"GWPEnsemble", "[", 
      RowBox[{"obj1D", ",", 
       RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<UniformC\>\""}], ",", 
       RowBox[{"\"\<Grid\>\"", "->", "21"}], ",", 
       RowBox[{"\"\<Time\>\"", "->", "0"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"v0", "=", 
     RowBox[{
      RowBox[{"obj1D", "[", "\"\<VX\>\"", "]"}], "[", 
      RowBox[{"x0", ",", "0"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"2.", " ", "Define", " ", "total", " ", "acceleration", " ", "a", 
      RowBox[{"(", 
       RowBox[{"x", ",", "t"}], ")"}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"F_external", "+", "F_quantum"}], ")"}], "/", "m"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"with", " ", "m"}], "=", "1"}], ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"aFun", "=", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "t"}], "}"}], ",", 
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"obj1D", "[", "\"\<FEX\>\"", "]"}], "[", 
          RowBox[{"x", ",", "t"}], "]"}], "+", 
         RowBox[{
          RowBox[{"obj1D", "[", "\"\<QFX\>\"", "]"}], "[", 
          RowBox[{"x", ",", "t"}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"3.", " ", "Integrate", " ", "2", "nd"}], "-", 
     RowBox[{"order", " ", "Newton"}], "-", 
     RowBox[{
     "Bohm", " ", "equations", " ", "and", " ", "parse", " ", "X0DAT", " ", 
      "and", " ", "X1DAT"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol1DDyn", "=", 
     RowBox[{"GWPEnsembleSolve", "[", 
      RowBox[{"x0", ",", "v0", ",", "aFun", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", 
         RowBox[{"2", " ", "Pi"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"parsed1DDyn", "=", 
     RowBox[{"GWPEnsembleParse", "[", 
      RowBox[{"x0", ",", "sol1DDyn"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{"trajPos", "=", 
     RowBox[{"GWPEnsembleFormat", "[", 
      RowBox[{"parsed1DDyn", ",", "\"\<X0DAT\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"trajVel", "=", 
     RowBox[{"GWPEnsembleFormat", "[", 
      RowBox[{"parsed1DDyn", ",", "\"\<X1DAT\>\""}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"4.", " ", "Visualize", " ", "2", "nd"}], "-", 
     RowBox[{"order", " ", "position", " ", "x", 
      RowBox[{"(", "t", ")"}], " ", "and", " ", "velocity", " ", "v", 
      RowBox[{"(", "t", ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ListLinePlot", "[", 
        RowBox[{"trajPos", ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"Opacity", "[", "0.6", "]"}], ",", 
            RowBox[{"ColorData", "[", 
             RowBox[{"97", ",", "1"}], "]"}]}], "]"}]}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<t\>\"", ",", "\"\<x(t)\>\""}], "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<2nd-Order Positions (X0DAT)\>\""}]}],
         "]"}], ",", 
       RowBox[{"ListLinePlot", "[", 
        RowBox[{"trajVel", ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"Opacity", "[", "0.6", "]"}], ",", 
            RowBox[{"ColorData", "[", 
             RowBox[{"97", ",", "2"}], "]"}]}], "]"}]}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<t\>\"", ",", "\"\<v(t)\>\""}], "}"}]}], ",", 
         RowBox[{
         "PlotLabel", "->", "\"\<2nd-Order Velocities (X1DAT)\>\""}]}], 
        "]"}]}], "}"}], ",", 
     RowBox[{"ImageSize", "->", "680"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{4.002285468319647*^9, 4.002285532285612*^9}, 
   4.0022856893692093`*^9, 4.002285732005557*^9, 4.0022961447618856`*^9},
 CellLabel->
  "In[184]:=",ExpressionUUID->"7aed358d-8a2a-43a7-a158-636bc227956e"],

