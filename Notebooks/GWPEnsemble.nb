     RowBox[{
      RowBox[{"1", "/", "2"}], ",", 
      RowBox[{"3", "/", "4"}]}], "]"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"xdatC2", "=", 
   RowBox[{"GWPEnsemble", "[", 
    RowBox[{"obj", ",", 
     RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<UniformC\>\""}], ",", 
     RowBox[{"\"\<Grid\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"10", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "2"}], ",", 
          RowBox[{"3", "/", "4"}]}], "}"}]}], "}"}]}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{4.00213070812599*^9, 4.002130708126174*^9}, {
  4.0021307416571836`*^9, 4.002130746503356*^9}, {4.002237414036388*^9, 
