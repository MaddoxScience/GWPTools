Cell[CellGroupData[{

Cell["\<\
2D Rotating Quadrupole / Circularly Polarized Laser Trap (GWPNumerical2D)\
\>", "Subsection",
 CellChangeTimes->{
  4.002195256210384*^9},ExpressionUUID->"776a7adb-f107-4091-8e50-\
663fc6776b65"],

Cell["\<\
For \[OpenCurlyDoubleQuote]2D\[CloseCurlyDoubleQuote], the \
\[OpenCurlyDoubleQuote]Numerical\[CloseCurlyDoubleQuote] potential accepts \
six time-dependent scalar coefficient functions\[LongDash]defining the \
general locally quadratic 2D potential surface: \
\>", "Text",
 CellChangeTimes->{4.0021952669908648`*^9, 4.002209485331706*^9, 
  4.002210069383157*^9},ExpressionUUID->"8be81862-d44b-42b4-a387-\
952b4965ead4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"V", "(", 
    RowBox[{"x", ",", "y", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["V", "00"], "(", "t", ")"}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["V", "10"], "(", "t", ")"}], "x"}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["V", "01"], "(", "t", ")"}], "y"}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["V", "20"], "(", "t", ")"}], 
     SuperscriptBox["x", "2"]}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["V", "02"], "(", "t", ")"}], 
     SuperscriptBox["y", "2"]}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["V", "11"], "(", "t", ")"}], "x", " ", "y"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.002128957153825*^9, 4.0021289888049107`*^9}, {
  4.002129377650779*^9, 4.00212942207405*^9}, {4.002194823571836*^9, 
  4.0021948552042227`*^9}, {4.002195145048251*^9, 4.0021951695783663`*^9}, {
  4.002209510025131*^9, 
  4.0022095548191013`*^9}},ExpressionUUID->"632d32e5-cfb6-4214-9b5b-\
962d18d3e22d"],

Cell[TextData[{
 "In this example, the linear coefficients ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubscriptBox["V", "10"], "(", "t", ")"}], ",", 
     RowBox[{
      SubscriptBox["V", "01"], "(", "t", ")"}]}], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fd4854a0-a52c-420d-ad32-b1e559ac1b59"],
 " represent a time-dependent dipole driving force:"
}], "Text",
 CellChangeTimes->{{4.002209562322296*^9, 4.002209628017042*^9}, 
   4.002209684617931*^9, {4.002210074738594*^9, 4.002210082457696*^9}, {
   4.0022101128856983`*^9, 
   4.002210113303843*^9}},ExpressionUUID->"089aecc2-cdae-414f-a946-\
8e6fa652b1d5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["V", "10"], "(", "t", ")"}], "=", 
   RowBox[{
    SubscriptBox["f", "0"], 
    RowBox[{
     SuperscriptBox["sin", "2"], "(", 
     RowBox[{
      SubscriptBox["\[Omega]", "env"], "t"}], ")"}], 
    RowBox[{"cos", "(", 
     RowBox[{
      SubscriptBox["\[Omega]", "L"], "t"}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.002128957153825*^9, 4.0021289888049107`*^9}, {
  4.002129377650779*^9, 4.00212942207405*^9}, {4.002194823571836*^9, 
  4.0021948552042227`*^9}, {4.002195145048251*^9, 4.0021951695783663`*^9}, {
  4.002209510025131*^9, 4.0022095548191013`*^9}, {4.002209637092525*^9, 
  4.0022096522140837`*^9}},ExpressionUUID->"ddefd3d6-8bea-4700-abdd-\
7f6a76ac81be"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["V", "01"], "(", "t", ")"}], "=", 
   RowBox[{
    SubscriptBox["f", "0"], 
    RowBox[{
     SuperscriptBox["sin", "2"], "(", 
     RowBox[{
      SubscriptBox["\[Omega]", "env"], "t"}], ")"}], 
    RowBox[{"sin", "(", 
     RowBox[{
      SubscriptBox["\[Omega]", "L"], "t"}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.002128957153825*^9, 4.0021289888049107`*^9}, {
  4.002129377650779*^9, 4.00212942207405*^9}, {4.002194823571836*^9, 
  4.0021948552042227`*^9}, {4.002195145048251*^9, 4.0021951695783663`*^9}, {
  4.002209510025131*^9, 4.0022095548191013`*^9}, {4.002209637092525*^9, 
  4.0022096707720337`*^9}},ExpressionUUID->"970635c2-05a0-477f-a75b-\
b702b9cc608a"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e664d703-19ea-437f-aae1-26310a660326"],
 " is the amplitude of the laser pulse, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "env"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b2b05254-7d96-4611-a525-1ae9264dd9ae"],
 " is its envelope frequency, and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "L"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cfde7b74-bce7-4035-b2c8-34a0274864e0"],
 " is the carrier frequency."
}], "Text",
 CellChangeTimes->{{4.002209772541004*^9, 
  4.002209823709818*^9}},ExpressionUUID->"5a2e4c8c-9bb0-4cf9-ba41-\
ed3c3ac6749e"],

Cell[TextData[{
 "The quadratic coefficients ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubscriptBox["V", "20"], "(", "t", ")"}], ",", 
     RowBox[{
      SubscriptBox["V", "02"], "(", "t", ")"}], ",", 
     RowBox[{
      SubscriptBox["V", "11"], "(", "t", ")"}]}], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "303aa6d6-9c1f-43dd-8c5c-1adbdbc47f85"],
 " govern the 2D trap curvatures and cross-coupling."
}], "Text",
 CellChangeTimes->{{4.002209687470319*^9, 4.002209689586974*^9}, 
   4.002209765474987*^9, {4.0022100959663143`*^9, 
   4.002210096697337*^9}},ExpressionUUID->"db87733b-dc54-4efd-8529-\
1e680c786c7b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["V", "20"], "(", "t", ")"}], "=", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{
     SubsuperscriptBox["\[Omega]", "0", "2"], "(", 
     RowBox[{"1", "+", 
      RowBox[{"\[Epsilon]", " ", 
       RowBox[{"cos", "(", 
        RowBox[{
         SubscriptBox["\[CapitalOmega]", "Q"], "t"}], ")"}]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.002128957153825*^9, 4.0021289888049107`*^9}, {
  4.002129377650779*^9, 4.00212942207405*^9}, {4.002194823571836*^9, 
  4.0021948552042227`*^9}, {4.002195145048251*^9, 4.0021951695783663`*^9}, {
  4.002209510025131*^9, 4.0022095548191013`*^9}, {4.002209637092525*^9, 
  4.0022096522140837`*^9}, {4.002209696532915*^9, 
  4.002209721834304*^9}},ExpressionUUID->"84d6fe91-3d20-430a-8a16-\
22cd0056c330"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["V", "02"], "(", "t", ")"}], "=", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{
     SubsuperscriptBox["\[Omega]", "0", "2"], "(", 
     RowBox[{"1", "-", 
      RowBox[{"\[Epsilon]", " ", 
       RowBox[{"cos", "(", 
        RowBox[{
         SubscriptBox["\[CapitalOmega]", "Q"], "t"}], ")"}]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.002128957153825*^9, 4.0021289888049107`*^9}, {
  4.002129377650779*^9, 4.00212942207405*^9}, {4.002194823571836*^9, 
  4.0021948552042227`*^9}, {4.002195145048251*^9, 4.0021951695783663`*^9}, {
  4.002209510025131*^9, 4.0022095548191013`*^9}, {4.002209637092525*^9, 
  4.0022097302100277`*^9}},ExpressionUUID->"8b349e23-86d8-42cf-9f71-\
d1dd22122703"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["V", "11"], "(", "t", ")"}], "=", 
    RowBox[{
     SubsuperscriptBox["\[Omega]", "0", "2"], "\[Epsilon]", " ", 
     RowBox[{"sin", "(", 
      RowBox[{
       SubscriptBox["\[CapitalOmega]", "Q"], "t"}], ")"}]}]}], ")"}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.002128957153825*^9, 4.0021289888049107`*^9}, {
  4.002129377650779*^9, 4.00212942207405*^9}, {4.002194823571836*^9, 
  4.0021948552042227`*^9}, {4.002195145048251*^9, 4.0021951695783663`*^9}, {
  4.002209510025131*^9, 4.0022095548191013`*^9}, {4.002209637092525*^9, 
  4.002209750195674*^9}},ExpressionUUID->"85d2e41d-2ac2-4fed-920b-\
c6f00dbca749"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "454f7ed8-bb1b-43d7-8ec2-1e3d3e5d78c3"],
 " is the base harmonic trap frequency, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "<=", "\[Epsilon]", "<", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c005c0b8-74f5-4c8d-bd63-29e871c7f016"],
 " is the quadrupole eccentricity/anisotropy, and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "Q"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bf77300a-7a2d-47f0-93ce-1c14c4aca4e8"],
 " is the quadrupole rotation frequency."
}], "Text",
 CellChangeTimes->{{4.002209849774431*^9, 4.002209914544702*^9}, {
  4.002209995548143*^9, 
  4.0022100370396023`*^9}},ExpressionUUID->"c329a3e6-43fd-4843-82f3-\
a711bcbeb22d"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Clear", " ", "numerical", " ", "cache", " ", "and", " ", 
    "previous", " ", "symbol", " ", "definitions"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"GWPClearCache", "[", "\"\<Quiet\>\"", "]"}], ";"}], "\n", 
   RowBox[{"Clear", "[", 
    RowBox[{
    "v00", ",", "v10", ",", "v01", ",", "v20", ",", "v02", ",", "v11", ",", 
     "f0", ",", "wEnv", ",", "wL", ",", "w0", ",", "eps", ",", "wQ"}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Adjustable"}]}], " ", "Potential", " ", 
      RowBox[{"Parameters", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Bounded", " ", "adiabatic", " ", "precession"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"wEnv", "=", 
     RowBox[{"1", "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"w0", "=", "2.0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"eps", "=", "0.35"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wQ", "=", "1.0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f0", "=", "1.0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wL", "=", "1.5"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Pure", " ", "rotating", " ", "quadrupole", " ", "vortex"}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wEnv", "=", 
     RowBox[{"1", "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"w0", "=", "1.5"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"eps", "=", "0.45"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wQ", "=", "1.0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f0", "=", "0.0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wL", "=", "1.5"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"2", ":", 
     RowBox[{
      RowBox[{"1", " ", "Parametric", " ", "resonance", " ", "blow"}], "-", 
      "up"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wEnv", "=", 
     RowBox[{"1", "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"w0", "=", "1.0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eps", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wQ", "=", 
     RowBox[{"2", "*", "w0"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f0", "=", "1.0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wL", "=", "1.5"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "2."}]}], " ", "Define", " ", "the", " ", "6", " ", 
      "scalar", " ", "2", "D", " ", "potential", " ", 
      RowBox[{"coefficients", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   
   RowBox[{"(*", 
    RowBox[{"Constant", " ", "background"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"v00", "[", "t_", "]"}], ":=", "0"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Circularly", " ", "polarized", " ", "dipole", " ", "laser", " ", 
     "pulse"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"v10", "[", "t_", "]"}], ":=", 
     RowBox[{"f0", "*", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"wEnv", "*", "t"}], "]"}], "^", "2"}], "*", 
      RowBox[{"Cos", "[", 
       RowBox[{"wL", "*", "t"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"v01", "[", "t_", "]"}], ":=", 
     RowBox[{"f0", "*", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"wEnv", "*", "t"}], "]"}], "^", "2"}], "*", 
      RowBox[{"Sin", "[", 
       RowBox[{"wL", "*", "t"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Rotating", " ", "anisotropic", " ", "quadrupole", " ", "trap"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"v20", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], "*", 
      RowBox[{"w0", "^", "2"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"eps", "*", 
         RowBox[{"Cos", "[", 
          RowBox[{"wQ", "*", "t"}], "]"}]}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"v02", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], "*", 
      RowBox[{"w0", "^", "2"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"eps", "*", 
         RowBox[{"Cos", "[", 
          RowBox[{"wQ", "*", "t"}], "]"}]}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"v11", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"w0", "^", "2"}], "*", "eps", "*", 
      RowBox[{"Sin", "[", 
       RowBox[{"wQ", "*", "t"}], "]"}]}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.002195286224135*^9, 4.0021953562423277`*^9}, {
   4.002196172066703*^9, 4.002196241008319*^9}, {4.002197163992591*^9, 
   4.002197195693404*^9}, 4.0022093163655243`*^9, {4.002209351358344*^9, 
   4.002209379193245*^9}, {4.0022101635510817`*^9, 4.00221032937572*^9}, {
