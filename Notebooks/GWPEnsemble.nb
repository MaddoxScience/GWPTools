Cell[TextData[{
 "By passing \[OpenCurlyDoubleQuote]PairWithTime\[CloseCurlyDoubleQuote] \
\[Rule] False to GWPEnsembleFormat, we can pair the raw position and velocity \
time series into parametric Bohmian phase-space orbits ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "(", "t", ")"}], ",", 
     RowBox[{"v", "(", "t", ")"}]}], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a4cf0dfa-1bb8-48d5-8efa-7d1e08a35fa6"],
 "."
}], "Text",
 CellChangeTimes->{{4.0022987045976973`*^9, 
  4.0022987245171833`*^9}},ExpressionUUID->"cd4d4c7e-ffef-4647-978f-\
dfcc08664ae1"],

Cell["\<\
In phase space, an individual trajectory (psPaul[[3]], left) traces a slow \
secular macro-orbit decorated with rapid RF micromotion oscillations and \
sharp vertical velocity excursions where it encounters interference nodes. \
Grouping the ensemble into the left (1 ;; 8), center (9 ;; 17), and right (18 \
;; 25) wavepacket quantiles (right) reveals how Bohmian non-crossing confines \
each packet\[CloseCurlyQuote]s probability bundle to its own phase-space \
domain:\
\>", "Text",
 CellChangeTimes->{
  4.002298736320692*^9},ExpressionUUID->"110bea78-db50-4b1c-b5c6-\
8b4e5f50b3f0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Extract", " ", "un"}], "-", 
    RowBox[{"paired", " ", "x", 
     RowBox[{"(", "t", ")"}], " ", "and", " ", "v", 
     RowBox[{"(", "t", ")"}], " ", "arrays", " ", "and", " ", "pair", " ", 
     "into", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", 
        RowBox[{"(", "t", ")"}]}], ",", 
       RowBox[{"v", 
        RowBox[{"(", "t", ")"}]}]}], "}"}], " ", "phase"}], "-", 
    RowBox[{"space", " ", "orbits"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"xRaw", "=", 
     RowBox[{"GWPEnsembleFormat", "[", 
      RowBox[{"parsedPaul", ",", "\"\<X0DAT\>\"", ",", 
       RowBox[{"\"\<PairWithTime\>\"", "->", "False"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"vRaw", "=", 
     RowBox[{"GWPEnsembleFormat", "[", 
      RowBox[{"parsedPaul", ",", "\"\<X1DAT\>\"", ",", 
       RowBox[{"\"\<PairWithTime\>\"", "->", "False"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"psPaul", "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"#1", ",", "#2"}], "}"}], "]"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"xRaw", ",", "vRaw"}], "}"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"(*", 
       RowBox[{"Left", ":", 
        RowBox[{
         RowBox[{
         "Single", " ", "outer", " ", "trajectory", " ", "showing", " ", "RF",
           " ", "micromotion", " ", "loops"}], "+", 
         RowBox[{"quantum", " ", "node", " ", "kicks"}]}]}], "*)"}], 
      RowBox[{
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"psPaul", "[", 
          RowBox[{"[", "3", "]"}], "]"}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "15"}], ",", "15"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"ColorData", "[", 
             RowBox[{"97", ",", "1"}], "]"}], ",", "Thin"}], "]"}]}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<x(t)\>\"", ",", "\"\<v(t)\>\""}], "}"}]}], ",", 
         RowBox[{
         "PlotLabel", 
          "->", "\"\<Single Phase-Space Orbit (Quantile #3)\>\""}], ",", 
         RowBox[{"AspectRatio", "->", 
          RowBox[{"3", "/", "4"}]}], ",", 
         RowBox[{"Epilog", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"PointSize", "[", "0.02", "]"}], ",", "Black", ",", 
            RowBox[{"Point", "[", 
             RowBox[{"psPaul", "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", "1"}], "]"}], "]"}], "]"}]}], "}"}]}]}], 
        "]"}], ",", 
       RowBox[{"(*", 
        RowBox[{"Right", ":", 
         RowBox[{
          RowBox[{"Outer", " ", "right"}], "-", 
          RowBox[{"lobe", " ", "packet", " ", "bundle", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"quantiles", " ", "18"}], ".."}], "25"}], ")"}], " ", 
           "in", " ", "phase", " ", "space"}]}]}], "*)"}], 
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"psPaul", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"-", "8"}], ";;", 
            RowBox[{"-", "1"}]}], "]"}], "]"}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "10"}], ",", "10"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"ColorData", "[", 
             RowBox[{"97", ",", "2"}], "]"}], ",", 
            RowBox[{"Opacity", "[", "0.65", "]"}], ",", "Thin"}], "]"}]}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<x(t)\>\"", ",", "\"\<v(t)\>\""}], "}"}]}], ",", 
         RowBox[{
         "PlotLabel", 
          "->", "\"\<Right-Lobe Ensemble in Phase Space (Quantiles \
18\[Dash]25)\>\""}], ",", 
         RowBox[{"AspectRatio", "->", 
          RowBox[{"3", "/", "4"}]}], ",", 
         RowBox[{"Epilog", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"PointSize", "[", "0.015", "]"}], ",", "Black", ",", 
            RowBox[{"Point", "[", 
             RowBox[{"psPaul", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{
                 RowBox[{"-", "8"}], ";;", 
                 RowBox[{"-", "1"}]}], ",", "1"}], "]"}], "]"}], "]"}]}], 
           "}"}]}]}], "]"}]}], "}"}], ",", 
     RowBox[{"ImageSize", "->", "750"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{4.002298594020081*^9, 4.002298594020227*^9}},
 CellLabel->
  "In[337]:=",ExpressionUUID->"6a987fe4-fffc-4c37-a5e6-99d6bc533e8f"],

