Cell[CellGroupData[{

Cell["Single GWP Examples (2D)", "Section",
 CellChangeTimes->{{4.002135838591145*^9, 
  4.002135902355191*^9}},ExpressionUUID->"53b596e2-21e2-44c0-99e8-\
c2e8b0cb6c17"],

Cell[TextData[{
 "For two-dimensional wavepackets (\[OpenCurlyDoubleQuote]2D\
\[CloseCurlyDoubleQuote]), GWPEnsemble generates lists of coordinate pairs \
{{x1, y1}, {x2, y2}, ...} adapted to the position center ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["\[Mu]",
     FontWeight->"Bold"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["x", "t"], ",", 
       SubscriptBox["y", "t"]}], ")"}], "T"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "65496dac-006a-4126-b6d4-74653da1ffab"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6327a461-a595-403b-ae61-2d2fea4f4b7f"],
 " spatial covariance matrix ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[CapitalSigma]",
     FontWeight->"Bold"], "r"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b0718bfd-1e70-4d0f-8a14-03ed74bf413b"],
 " of the wavepacket."
}], "Text",
 CellChangeTimes->{
  4.002135958377902*^9, {4.002136448810196*^9, 
   4.002136540776169*^9}},ExpressionUUID->"4b4a1e8a-ca51-4930-a212-\
b2de8c3e98a4"],

Cell[TextData[{
 "In GWP2DENSEMBLE, the \[OpenCurlyDoubleQuote]Grid\[CloseCurlyDoubleQuote] \
option accepts three flexible formats:   \n\n\[OpenCurlyDoubleQuote]Grid\
\[CloseCurlyDoubleQuote] \[Rule] Automatic: Defaults to a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"20", "\[Times]", "20"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "67a4fe49-ae80-46c5-99f6-a17e86f46c59"],
 " mesh (400 total points).   \n\n\[OpenCurlyDoubleQuote]Grid\
\[CloseCurlyDoubleQuote]\[RightArrow] N (single integer): Sets the total \
point count to ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7396b139-6b25-437a-8032-d5a8f0cd0c33"],
 " for random methods (\[OpenCurlyDoubleQuote]Random\[CloseCurlyDoubleQuote] \
and \[OpenCurlyDoubleQuote]RandomDensity\[CloseCurlyDoubleQuote]), or \
constructs an approximately square ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox["N"], "\[Times]", 
    SqrtBox["N"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c67f151d-035b-41c0-bb05-18e32b53a91d"],
 " mesh for structured grid methods.   \n\n\[OpenCurlyDoubleQuote]Grid\
\[CloseCurlyDoubleQuote] \[Rule] {nx, ny} or {nx, ny, {{xMin, xMax}, {yMin, \
yMax}}}: Explicitly specifies the grid dimensions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["n", "x"], "\[Times]", 
    SubscriptBox["n", "y"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4c71820e-bab6-4379-b954-5fdef08953b3"],
 " (or ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["n", "r"], "\[Times]", 
    SubscriptBox["n", "\[Theta]"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "24a1588f-d6a9-4594-b687-1f439c75b9c3"],
 " radial shells and angular rays for \[OpenCurlyDoubleQuote]PolarC\
\[CloseCurlyDoubleQuote]), along with optional custom bounding intervals for \
\[OpenCurlyDoubleQuote]Cartesian\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]RandomDensity\[CloseCurlyDoubleQuote]. "
}], "Text",
 CellChangeTimes->{
  4.002135971876375*^9, {4.0021365450888643`*^9, 4.002136580732132*^9}, {
   4.0021366398407793`*^9, 4.002136702777152*^9}, {4.002138456621479*^9, 
   4.002138458308051*^9}},ExpressionUUID->"cc082fdb-fd12-4a25-9017-\
b81f889a0343"],

Cell[TextData[{
 "Five \[OpenCurlyDoubleQuote]SamplingMethod\[CloseCurlyDoubleQuote] \
geometries are available for 2D wavepackets:   \n\n\
\[OpenCurlyDoubleQuote]Cartesian\[CloseCurlyDoubleQuote] (or \
\[OpenCurlyDoubleQuote]UniformX\[CloseCurlyDoubleQuote] / Automatic): Forms a \
rectangular ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["n", "x"], "\[Times]", 
    SubscriptBox["n", "y"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b6b7dfcf-93f7-41f8-805e-a239eb671032"],
 " outer-product grid across ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      RowBox[{
       SubscriptBox["x", "t"], "-", 
       RowBox[{"4", 
        SubscriptBox["\[Sigma]", "x"]}]}], ",", 
      RowBox[{
       SubscriptBox["x", "t"], "+", 
       RowBox[{"4", 
        SubscriptBox["\[Sigma]", "x"]}]}]}], "]"}], "\[Times]", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{
       SubscriptBox["y", "t"], "-", 
       RowBox[{"4", 
        SubscriptBox["\[Sigma]", "y"]}]}], ",", 
      RowBox[{
       SubscriptBox["y", "t"], "+", 
       RowBox[{"4", 
        SubscriptBox["\[Sigma]", "y"]}]}]}], "]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c03e46da-db92-4256-8e82-a716eba78434"],
 " (or custom bounds).   \n\n\[OpenCurlyDoubleQuote]AffineC\
\[CloseCurlyDoubleQuote] (Cholesky Quantile Mesh): For a correlated 2D \
Gaussian wavepacket, the spatial probability density ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "(", 
    RowBox[{"x", ",", "y"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "17cbdf12-f9c6-46a2-b454-7c650aad615a"],
 " does not factorize along the laboratory ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "52249011-ce8d-4064-87ed-8b685d9a8085"],
 " and ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "383cb053-7215-4036-a5d2-209d96c33955"],
 " axes, meaning independent 1D quantile grids cannot capture its tilted \
covariance ellipse. To construct an exact equal-probability mesh without \
numerical root-finding, \
\[OpenCurlyDoubleQuote]AffineC\[CloseCurlyDoubleQuote] first generates an \
uncorrelated ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["n", "x"], "\[Times]", 
    SubscriptBox["n", "y"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "53a375d7-b6e9-4295-8af5-aea81e3a4512"],
 " canonical quantile grid ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["z",
     FontWeight->"Bold",
     FontSlant->"Plain"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["z", "x"], ",", 
       SubscriptBox["z", "y"]}], ")"}], "T"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e58817f8-726d-445c-8e58-73c3ad1f1ab7"],
 " for a 2D standard normal distribution (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[Mu]",
      FontWeight->"Bold"], "z"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"0", ",", "0"}], ")"}], "T"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d4e12c4e-aac5-4eff-8ea3-8b1e7dc9ec04"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[CapitalSigma]",
      FontWeight->"Bold"], "z"], "=", 
    SubscriptBox[
     StyleBox["I",
      FontWeight->"Bold",
      FontSlant->"Plain"], "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e2a246f3-87db-40a7-a86c-09095a24791e"],
 ") by evaluating the 1D inverse cumulative distribution function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["z", "k"], "=", 
    RowBox[{
     SqrtBox["2"], 
     RowBox[{
      SuperscriptBox["erf", 
       RowBox[{"-", "1"}]], "(", 
      RowBox[{
       RowBox[{"2", 
        SubscriptBox["c", "k"]}], "-", "1"}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6b12d5c2-42ef-44a6-89ba-66f5bbd6ce4b"],
 " at the probability midpoints ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", "k"], "\[Element]", 
    RowBox[{"(", 
     RowBox[{"0", ",", "1"}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c2d837d5-1bb4-4d3f-8154-73fac322d32f"],
 " along each axis. Next, it computes the lower-triangular Cholesky \
decomposition ",
 Cell[BoxData[
  FormBox[
   StyleBox["L",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f7df4832-1723-4b3f-b7e9-1bfff34bbad0"],
 " of the wavepacket\[CloseCurlyQuote]s ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bdf46c24-290b-40d9-b88d-0af9f63e4c10"],
 " spatial covariance matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[CapitalSigma]",
      FontWeight->"Bold"], "r"], "=", 
    RowBox[{
     StyleBox["L",
      FontWeight->"Bold",
      FontSlant->"Plain"], " ", 
     SuperscriptBox[
      StyleBox["L",
       FontWeight->"Bold",
       FontSlant->"Plain"], "T"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "faff2a57-8fb4-46cd-a8bb-34330a433c38"],
 " and applies the affine transformation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r",
     FontWeight->"Bold",
     FontSlant->"Plain"], "=", 
    RowBox[{
     StyleBox["\[Mu]",
      FontWeight->"Bold"], "+", 
     RowBox[{
      StyleBox["L",
       FontWeight->"Bold",
       FontSlant->"Plain"], " ", 
      StyleBox["z",
       FontWeight->"Bold",
       FontSlant->"Plain"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8d51dc85-3930-4aa5-98f4-ba22c0e066b3"],
 " to every canonical point ",
 StyleBox["z",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ". Geometrically, ",
 Cell[BoxData[
  FormBox[
   StyleBox["L",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bd443e46-b203-4c12-973e-89feb05b4a94"],
 " scales and shears the rectangular unit-normal quantile mesh so that it \
aligns with the principal axes and correlation tilt of the physical \
wavepacket centered at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["\[Mu]",
     FontWeight->"Bold"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["x", "t"], ",", 
       SubscriptBox["y", "t"]}], ")"}], "T"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "742c119b-6b4c-42d4-8da5-f32726e0a9ea"],
 ".   \n\n\[OpenCurlyDoubleQuote]PolarC\[CloseCurlyDoubleQuote] \
(Radial-Angular Quantile Shells): Rather than warping a rectangular grid, \
\[OpenCurlyDoubleQuote]PolarC\[CloseCurlyDoubleQuote] samples the 2D Gaussian \
probability distribution in canonical polar quantile coordinates ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["c", "r"], ",", 
         SubscriptBox["c", "\[Theta]"]}], ")"}], "\[Element]", 
       RowBox[{"[", 
        RowBox[{"0", ",", "1"}]}]}], ")"}], "\[Times]", 
     RowBox[{"[", 
      RowBox[{"0", ",", "1"}]}]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e9f0c4eb-fc1d-434b-a07f-2bef35762bf7"],
 ". For a grid specification of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "r"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dc92b7bf-cc25-467b-833d-c12f7930e1a0"],
 " radial shells and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "\[Theta]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "40b6eb30-57bb-41cf-9260-f24bb462a67a"],
 " angular rays, the method places radial cumulative probability coordinates \
at uniform intervals (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", 
     RowBox[{"r", ",", "i"}]], "=", 
    RowBox[{"i", "/", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["n", "r"], "+", "1"}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7a2ea390-d637-4620-aae5-823312ecf266"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", "\[Ellipsis]", ",", 
    SubscriptBox["n", "r"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "176b64ea-4537-4f74-8a6f-d465e9d82777"],
 ") and distributes ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "\[Theta]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c124ca88-c487-4f6a-893d-b41185889f98"],
 " angular phase coordinates uniformly around each shell (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", 
     RowBox[{"\[Theta]", ",", "j"}]], "=", 
    RowBox[{"j", "/", 
     SubscriptBox["n", "\[Theta]"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "575f42ce-0bd1-4fff-84a6-2385bc073b82"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"j", "=", "0"}], ",", "\[Ellipsis]", ",", 
    RowBox[{
     SubscriptBox["n", "\[Theta]"], "-", "1"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "34d80267-591c-4128-aee8-6124b0e30a32"],
 ").  When \[OpenCurlyDoubleQuote]Structure\[CloseCurlyDoubleQuote] \[Rule] \
\[OpenCurlyDoubleQuote]Staggered\[CloseCurlyDoubleQuote] (the default) is \
active, odd-numbered radial shells are shifted in angular phase by half a ray \
spacing (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]c", "\[Theta]"], "=", 
    RowBox[{
     RowBox[{"1", "/", "2"}], 
     SubscriptBox["n", "\[Theta]"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a2a82350-bd76-449f-929b-6ac5a6c894ec"],
 ") to create a triangulated packing, whereas \[OpenCurlyDoubleQuote]Aligned\
\[CloseCurlyDoubleQuote] keeps all points along fixed radial spokes. If \
\[OpenCurlyDoubleQuote]IncludeCore\[CloseCurlyDoubleQuote] \[Rule] True (the \
default), the origin point ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["c", "r"], ",", 
      SubscriptBox["c", "\[Theta]"]}], ")"}], "=", 
    RowBox[{"(", 
     RowBox[{"0", ",", "0"}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5d17642c-2e3d-47bf-89fc-26b1976b3061"],
 " is prepended to the ensemble. Finally, each ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["c", "r"], ",", 
     SubscriptBox["c", "\[Theta]"]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ea9ecabf-11db-46ff-830a-e729afd85d60"],
 " pair is mapped through the backend 2D polar inverse cumulative \
distribution (GWP2DXC), which converts ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["c", "r"], ",", 
     SubscriptBox["c", "\[Theta]"]}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d78d0193-059c-4f47-a92f-22d2c2e1ecf8"],
 " into canonical polar coordinates (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Rho]", "=", 
     SqrtBox[
      RowBox[{
       RowBox[{"-", "2"}], 
       RowBox[{"ln", "(", 
        RowBox[{"1", "-", 
         SubscriptBox["c", "r"]}], ")"}]}]]}], ",", " ", 
    RowBox[{"\[Phi]", "=", 
     RowBox[{"2", "\[Pi]", " ", 
      SubscriptBox["c", "\[Theta]"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3b10b520-8dd7-4de6-bfab-8a7ed749b896"],
 ") and transforms them onto concentric constant-probability ellipses aligned \
with the wavepacket\[CloseCurlyQuote]s covariance matrix ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[CapitalSigma]",
     FontWeight->"Bold"], "r"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ac31d9b0-79a0-463d-a6cf-6eb8a4f07cd5"],
 " and center ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[Mu]",
    FontWeight->"Bold"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "10518ea2-0fe9-49da-8359-691d8ab3d14f"],
 ". \n\n\n\[OpenCurlyDoubleQuote]Random\[CloseCurlyDoubleQuote]: Draws ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "=", 
    RowBox[{
     SubscriptBox["n", "x"], 
     SubscriptBox["n", "y"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9ed53328-518c-4968-8d3f-fe84ff58a3a9"],
 " variates directly from the analytical MultinormalDistribution[mu, sigma].  \
 \n\n\[OpenCurlyDoubleQuote]RandomDensity\[CloseCurlyDoubleQuote]: Draws ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "708da4d2-c7cb-4985-b15d-3d68d025cd69"],
 " variates via 2D numerical rejection sampling over the bounding box. "
}], "Text",
 CellChangeTimes->{
  4.002135986057953*^9, {4.0021367142896757`*^9, 4.002136877695661*^9}, {
   4.002136932235183*^9, 4.002136971265278*^9}, {4.0021379427933807`*^9, 
   4.002138266319858*^9}, {4.00213830488481*^9, 4.0021383343863773`*^9}, {
   4.002138579608285*^9, 4.002138942064186*^9}, {4.0021389730847883`*^9, 
   4.002139001871114*^9}},ExpressionUUID->"f403c295-a6c3-4d3a-b06e-\
a4d4be8c0d0b"],

Cell[TextData[{
 "To highlight how the structured quantile methods adapt to anisotropic \
squeezing and inter-mode correlation, we construct a 2D wavepacket with a \
non-diagonal shape matrix centered at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["r",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"], "=", 
    RowBox[{"(", 
     RowBox[{"1", ",", 
      RowBox[{"-", "1"}]}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bfc6540d-03f3-4b48-aa5a-4f5ac31727f3"],
 ": "
}], "Text",
 CellChangeTimes->{
  4.00213600353231*^9, {4.0021369777665052`*^9, 4.002137010621016*^9}, {
   4.0021375231111097`*^9, 
   4.0021375247344522`*^9}},ExpressionUUID->"e04a2fa7-0470-4827-92b4-\
7751ee548331"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Anisotropic", ",", 
    RowBox[{
     RowBox[{
     "correlated", " ", "2", "D", " ", "GWP", " ", "tilted", " ", "in", " ", 
      "the", " ", "xy"}], "-", "plane"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"obj2D", "=", 
     RowBox[{
      RowBox[{"GWP", "[", "\"\<2D\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"3", "/", "5"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"3", "/", "5"}], ",", 
           RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ptsCart", "=", 
     RowBox[{"GWPEnsemble", "[", 
      RowBox[{"obj2D", ",", 
       RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<Cartesian\>\""}], ",", 
       RowBox[{"\"\<Grid\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"12", ",", "12"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ptsAffine", "=", 
     RowBox[{"GWPEnsemble", "[", 
      RowBox[{"obj2D", ",", 
       RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<AffineC\>\""}], ",", 
       RowBox[{"\"\<Grid\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"12", ",", "12"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ptsPolar", "=", 
     RowBox[{"GWPEnsemble", "[", 
      RowBox[{"obj2D", ",", 
       RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<PolarC\>\""}], ",", 
       RowBox[{"\"\<Grid\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"6", ",", "24"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ptsRand", "=", 
     RowBox[{"GWPEnsemble", "[", 
      RowBox[{"obj2D", ",", 
       RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<Random\>\""}], ",", 
       RowBox[{"\"\<Grid\>\"", "->", "144"}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.002135932799038*^9, 4.002135936390746*^9}},
 CellLabel->"In[41]:=",ExpressionUUID->"58e07e50-cb7b-4006-807f-ec8f33c645d1"],

Cell[TextData[{
 "Visualizing all four 144-point ensembles superimposed on the contour plot \
of the 2D probability density ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "(", 
    RowBox[{"x", ",", "y"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c4720554-c74c-4dea-834d-6b6f4ec3ec29"],
 " illustrates how \[OpenCurlyDoubleQuote]AffineC\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]PolarC\[CloseCurlyDoubleQuote] shear and rotate \
automatically with the covariance ellipse, whereas \
\[OpenCurlyDoubleQuote]Cartesian\[CloseCurlyDoubleQuote] remains locked to \
the laboratory axes:   "
}], "Text",
 CellChangeTimes->{
  4.002136017269434*^9, {4.002137555057708*^9, 
   4.002137568281567*^9}},ExpressionUUID->"fc7414bd-16c1-4e90-9ea3-\
51ec4bead23e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"bgContour", "=", 
    RowBox[{"ContourPlot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"obj2D", "[", "\"\<RHOX\>\"", "]"}], "[", 
       RowBox[{"x", ",", "y"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "2.5"}], ",", "4.5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", 
        RowBox[{"-", "5"}], ",", "3"}], "}"}], ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"Contours", "->", "8"}], ",", 
      RowBox[{"ContourShading", "->", "None"}], ",", 
      RowBox[{"ContourStyle", "->", "Thin"}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"GraphicsGrid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Show", "[", 
        RowBox[{"bgContour", ",", 
         RowBox[{"ListPlot", "[", "ptsCart", "]"}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<Cartesian (12x12)\>\""}]}], "]"}], ",", 
       RowBox[{"Show", "[", 
        RowBox[{"bgContour", ",", 
         RowBox[{"ListPlot", "[", "ptsAffine", "]"}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<AffineC (Cholesky 12x12)\>\""}]}], 
        "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Show", "[", 
        RowBox[{"bgContour", ",", 
         RowBox[{"ListPlot", "[", "ptsPolar", "]"}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<PolarC (6 Shells x 24 Rays)\>\""}]}],
         "]"}], ",", 
       RowBox[{"Show", "[", 
        RowBox[{"bgContour", ",", 
         RowBox[{"ListPlot", "[", "ptsRand", "]"}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<Random (144 Points)\>\""}]}], 
        "]"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"ImageSize", "->", "650"}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.002136029308179*^9, 4.002136119547068*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"c6634891-4b98-41d1-af73-ab25bbe6f626"],

