Cell[TextData[{
 "The \[OpenCurlyDoubleQuote]PolarC\[CloseCurlyDoubleQuote] method supports \
two specialized layout options that control the arrangement of points across \
the concentric probability shells:   \n\n\[OpenCurlyDoubleQuote]Structure\
\[CloseCurlyDoubleQuote] \[Rule] \[OpenCurlyDoubleQuote]Staggered\
\[CloseCurlyDoubleQuote] (default) vs. \[OpenCurlyDoubleQuote]Aligned\
\[CloseCurlyDoubleQuote]: \[OpenCurlyDoubleQuote]Staggered\
\[CloseCurlyDoubleQuote] alternates the angular phase of adjacent radial \
shells by half a ray spacing (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]\[Theta]", "/", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7fcc2f38-b328-4886-b05e-4391aa71707d"],
 "), producing a triangulated packing, whereas \[OpenCurlyDoubleQuote]Aligned\
\[CloseCurlyDoubleQuote] places points along radial spokes at fixed angles.   \
\n\n\[OpenCurlyDoubleQuote]IncludeCore\[CloseCurlyDoubleQuote] \[Rule] True \
(default) vs. False: Controls whether the wavepacket center ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["\[Mu]",
     FontWeight->"Bold"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["x", "t"], ",", 
       SubscriptBox["y", "t"]}], ")"}], "T"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c2320c3f-72ce-41a6-adf3-c8bc6ffe1f8a"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", "r"], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6eee6136-5e5c-451e-9e76-0eca0cb08565"],
 ") is prepended as a core point at the center of the innermost ring. "
}], "Text",
 CellChangeTimes->{
  4.002136152249298*^9, {4.00213768998074*^9, 
   4.0021377633020363`*^9}},ExpressionUUID->"dbb8ff9e-deef-41d9-9e18-\
899558804c1d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Compare", " ", "Staggered", " ", 
    RowBox[{"(", 
     RowBox[{"with", " ", "core"}], ")"}], " ", 
    RowBox[{"vs", ".", "Aligned"}], " ", 
    RowBox[{"(", 
     RowBox[{"without", " ", "core"}], ")"}], " ", "PolarC", " ", 
    "ensembles"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"polarStaggered", "=", 
     RowBox[{"GWPEnsemble", "[", 
      RowBox[{"obj2D", ",", 
       RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<PolarC\>\""}], ",", 
       RowBox[{"\"\<Grid\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"5", ",", "16"}], "}"}]}], ",", 
       RowBox[{"\"\<Structure\>\"", "->", "\"\<Staggered\>\""}], ",", 
       RowBox[{"\"\<IncludeCore\>\"", "->", "True"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"polarAligned", "=", 
     RowBox[{"GWPEnsemble", "[", 
      RowBox[{"obj2D", ",", 
       RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<PolarC\>\""}], ",", 
       RowBox[{"\"\<Grid\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"5", ",", "16"}], "}"}]}], ",", 
       RowBox[{"\"\<Structure\>\"", "->", "\"\<Aligned\>\""}], ",", 
       RowBox[{"\"\<IncludeCore\>\"", "->", "False"}]}], "]"}]}], ";"}], "\n",
    "\[IndentingNewLine]", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Show", "[", 
        RowBox[{"bgContour", ",", 
         RowBox[{"ListPlot", "[", "polarStaggered", "]"}], ",", 
         RowBox[{
         "PlotLabel", 
          "->", "\"\<Staggered + IncludeCore -> True (81 pts)\>\""}]}], "]"}],
        ",", 
       RowBox[{"Show", "[", 
        RowBox[{"bgContour", ",", 
         RowBox[{"ListPlot", "[", "polarAligned", "]"}], ",", 
         RowBox[{
         "PlotLabel", 
          "->", "\"\<Aligned + IncludeCore -> False (80 pts)\>\""}]}], 
        "]"}]}], "}"}], ",", 
     RowBox[{"ImageSize", "->", "650"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{4.002136168957897*^9, 4.0021361689580507`*^9}, {
  4.002136428754744*^9, 4.002136435074546*^9}},
 CellLabel->"In[51]:=",ExpressionUUID->"a3693e09-7de9-4556-bcb6-30f5adb65f25"],

