Cell[TextData[{
 "We can visually compare the point distributions of \
\[OpenCurlyDoubleQuote]UniformX\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]UniformC\[CloseCurlyDoubleQuote], and \
\[OpenCurlyDoubleQuote]Random\[CloseCurlyDoubleQuote] (for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "=", "25"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "69d8aee7-0e4d-43e8-946c-438b2050559a"],
 ") against the underlying Gaussian probability density ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "(", "x", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "eaa0e173-60c7-411f-a524-a58d65a7e30b"],
 ":"
}], "Text",
 CellChangeTimes->{{4.002131720323265*^9, 
  4.0021317465245457`*^9}},ExpressionUUID->"7a2e9f4c-38bc-4b64-98ec-\
891abd6ac9f3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ensX", "=", 
   RowBox[{"GWPEnsemble", "[", 
    RowBox[{"obj", ",", 
     RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<UniformX\>\""}], ",", 
     RowBox[{"\"\<Grid\>\"", "->", "25"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ensC", "=", 
   RowBox[{"GWPEnsemble", "[", 
    RowBox[{"obj", ",", 
     RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<UniformC\>\""}], ",", 
     RowBox[{"\"\<Grid\>\"", "->", "25"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ensR", "=", 
    RowBox[{"GWPEnsemble", "[", 
     RowBox[{"obj", ",", 
      RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<Random\>\""}], ",", 
      RowBox[{"\"\<Grid\>\"", "->", "25"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"obj", "[", "\"\<RHOX\>\"", "]"}], "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "4.5"}], ",", "4.5"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.18"}], ",", "0.45"}], "}"}]}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<x\>\"", ",", "\"\<rho(x) and Ensemble Markers\>\""}], 
       "}"}]}], ",", 
     RowBox[{"BaseStyle", "->", 
      RowBox[{"FontSize", "->", "12"}]}]}], "]"}], ",", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{"{", 
         RowBox[{"ensX", ",", 
          RowBox[{"-", "0.04"}]}], "}"}], "]"}], ",", 
       RowBox[{"Thread", "[", 
        RowBox[{"{", 
         RowBox[{"ensC", ",", 
          RowBox[{"-", "0.09"}]}], "}"}], "]"}], ",", 
       RowBox[{"Thread", "[", 
        RowBox[{"{", 
         RowBox[{"ensR", ",", 
          RowBox[{"-", "0.14"}]}], "}"}], "]"}]}], "}"}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<UniformX (+/- 4 Sigma)\>\"", 
