Cell[CellGroupData[{

Cell["\<\
Parametric Resonance & Kapitza Pendulum in a 1D Paul Trap (MC1D / SS1D)\
\>", "Subsection",
 CellChangeTimes->{
  4.002195108693891*^9},ExpressionUUID->"27d1861d-f199-48ea-8222-\
0f8052ecbb42"],

Cell["In an RF Paul trap, the quadratic curvature ", "Text",
 CellChangeTimes->{{4.002195124068659*^9, 
  4.0021951289002743`*^9}},ExpressionUUID->"b3d90612-b794-4169-a88e-\
158182a4efd7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["V", "2"], "(", "t", ")"}], "=", 
   RowBox[{
    SubscriptBox["u", "DC"], "+", 
    RowBox[{
     SubscriptBox["u", "AC"], 
     RowBox[{"cos", "(", 
      RowBox[{"\[CapitalOmega]", " ", "t"}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.002128957153825*^9, 4.0021289888049107`*^9}, {
  4.002129377650779*^9, 4.00212942207405*^9}, {4.002194823571836*^9, 
  4.0021948552042227`*^9}, {4.002195145048251*^9, 
  4.0021951695783663`*^9}},ExpressionUUID->"9be27691-6b60-45ac-a507-\
723bf924ecbc"],

Cell["\<\
oscillates rapidly in time according to the Mathieu equation. A 3-packet \
\[OpenCurlyDoubleQuote]MC1D\[CloseCurlyDoubleQuote] superposition inside a \
modulated Paul trap exhibits rapid micromotion ripples superimposed on slow \
secular macromotion, while quantum interference nodes weave between the \
micromotion oscillations:\
\>", "Text",
 CellChangeTimes->{4.002195131148672*^9, 4.002195173271311*^9, 
  4.002298682541442*^9},ExpressionUUID->"9c0d24dd-685f-482d-a02c-\
039eb6716ecb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"1.", " ", "Paul", " ", "trap", " ", 
    RowBox[{"curvature", ":", 
     RowBox[{
      RowBox[{"DC", " ", "confinement"}], "+", "high", "-", 
      RowBox[{
      "frequency", " ", "AC", " ", "micromotion", " ", "drive"}]}]}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"GWPClearCache", "[", "\"\<Quiet\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{"v0Paul", ",", "v1Paul", ",", "v2Paul"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"v0Paul", "[", "t_", "]"}], ":=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"v1Paul", "[", "t_", "]"}], ":=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"v2Paul", "[", "t_", "]"}], ":=", 
     RowBox[{"0.4", "+", 
      RowBox[{"1.8", "*", 
       RowBox[{"Cos", "[", 
        RowBox[{"6", " ", "t"}], "]"}]}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Mathieu", " ", "stability", " ", "regime"}], "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"2.", " ", "3"}], "-", 
     RowBox[{
     "state", " ", "superposition", " ", "in", " ", "the", " ", "Paul", " ", 
      "trap"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"objPaul", "=", 
     RowBox[{
      RowBox[{"GWP", "[", "\"\<MC1D\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "3"}], ",", "0", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"\"\<C\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ",", 
       RowBox[{"\"\<Potential\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Numerical\>\"", ",", "v0Paul", ",", "v1Paul", ",", 
          "v2Paul", ",", "0", ",", 
          RowBox[{"2", " ", "Pi"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Sample", " ", "25", " ", "quantile", " ", "trajectories", " ",
      "and", " ", "propagate", " ", "directly", " ", "from", " ", "objPaul"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x0Paul", "=", 
     RowBox[{"GWPEnsemble", "[", 
      RowBox[{"objPaul", ",", 
       RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<InverseC\>\""}], ",", 
       RowBox[{"\"\<Grid\>\"", "->", "25"}], ",", 
       RowBox[{"\"\<Time\>\"", "->", "0"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"solPaul", "=", 
     RowBox[{"GWPEnsembleSolve", "[", 
      RowBox[{"objPaul", ",", "x0Paul", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", 
         RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
       RowBox[{"MaxStepSize", "->", "0.02"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "4.", " ", "Parse", " ", "and", " ", "extract", " ", "both", " ", 
     "positions", " ", 
     RowBox[{"(", "X0DAT", ")"}], " ", "and", " ", "micromotion", " ", 
     "velocities", " ", 
     RowBox[{"(", "X1DAT", ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"parsedPaul", "=", 
     RowBox[{"GWPEnsembleParse", "[", 
      RowBox[{"x0Paul", ",", "solPaul"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"trajPaul", "=", 
     RowBox[{"GWPEnsembleFormat", "[", 
      RowBox[{"parsedPaul", ",", "\"\<X0DAT\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"velPaul", "=", 
     RowBox[{"GWPEnsembleFormat", "[", 
      RowBox[{"parsedPaul", ",", "\"\<X1DAT\>\""}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ListLinePlot", "[", 
        RowBox[{"trajPaul", ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<t\>\"", ",", "\"\<x(t)\>\""}], "}"}]}], ",", 
         RowBox[{
         "PlotLabel", 
          "->", "\"\<Paul Trap Trajectories x(t) (Secular + \
Micromotion)\>\""}]}], "]"}], ",", 
       RowBox[{"ListLinePlot", "[", 
        RowBox[{"velPaul", ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<t\>\"", ",", "\"\<v(t)\>\""}], "}"}]}], ",", 
         RowBox[{
         "PlotLabel", 
          "->", "\"\<Extracted Micromotion Velocities v(t)\>\""}]}], "]"}]}], 
      "}"}], ",", 
     RowBox[{"ImageSize", "->", "750"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{4.002298542343295*^9, 4.00229854632218*^9}},
 CellLabel->
  "In[325]:=",ExpressionUUID->"d32306cd-dade-494d-a3e0-6131a85481ca"],

