Cell[TextData[{
 "Passing obj2DNum directly to GWPEnsembleSolve propagates the 25-trajectory \
\[OpenCurlyDoubleQuote]PolarC\[CloseCurlyDoubleQuote] ensemble (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", "\[Times]", "12"}], "+", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f1c42888-56ba-4271-8896-97fb2cf4fd0d"],
 " core point) without manual array transpositions:"
}], "Text",
 CellChangeTimes->{{4.0022995196357517`*^9, 
  4.002299543023458*^9}},ExpressionUUID->"c86790d7-18cb-4f43-9b11-\
b763055a9ed8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "3.", " ", "Construct", " ", "2", "D", " ", "numerical", " ", "wavepacket",
     " ", "with", " ", "all", " ", "6", " ", "scalar", " ", "coefficient", " ",
     "functions"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"obj2DNum", "=", 
     RowBox[{
      RowBox[{"GWP", "[", "\"\<2D\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"\"\<Potential\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Numerical\>\"", ",", "v00", ",", "v10", ",", "v01", ",",
           "v20", ",", "v02", ",", "v11", ",", "0", ",", 
          RowBox[{"2", "*", "2", " ", "Pi"}]}], "}"}]}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "4.", " ", "Sample", " ", "a", " ", "2", "D", " ", "PolarC", " ", "ring", 
     " ", "ensemble", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"2", " ", "shells", " ", "x", " ", "12", " ", "rays"}], "+", 
        RowBox[{"1", " ", "core"}]}], "=", 
       RowBox[{"25", " ", "trajectories"}]}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xy0Num", "=", 
     RowBox[{"GWPEnsemble", "[", 
      RowBox[{"obj2DNum", ",", 
       RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<PolarC\>\""}], ",", 
       RowBox[{"\"\<Grid\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"2", ",", "12"}], "}"}]}], ",", 
       RowBox[{"\"\<Time\>\"", "->", "0"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "5.", " ", "Propagate", " ", "2", "D", " ", "Bohmian", " ", 
     "trajectories", " ", "directly", " ", "from", " ", "obj2DNum"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol2DNum", "=", 
     RowBox[{"GWPEnsembleSolve", "[", 
      RowBox[{"obj2DNum", ",", "xy0Num", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", 
         RowBox[{"2", "*", "2", " ", "Pi"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"parsed2DNum", "=", 
     RowBox[{"GWPEnsembleParse", "[", 
      RowBox[{"xy0Num", ",", "sol2DNum"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"traj2DNum", "=", 
     RowBox[{"GWPEnsembleFormat", "[", 
      RowBox[{"parsed2DNum", ",", "\"\<X0DAT\>\""}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "6.", " ", "Prepend", " ", "TDAT", " ", "to", " ", "form", " ", "3", "D", 
     " ", "spacetime", " ", "worldlines", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{"x", 
        RowBox[{"(", "t", ")"}]}], ",", 
       RowBox[{"y", 
        RowBox[{"(", "t", ")"}]}]}], "}"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"worldlines3D", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"MapThread", "[", 
        RowBox[{"Prepend", ",", 
         RowBox[{"{", 
          RowBox[{"#", ",", 
           RowBox[{"parsed2DNum", "[", "\"\<TDAT\>\"", "]"}]}], "}"}]}], 
        "]"}], "&"}], "/@", "traj2DNum"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ListLinePlot", "[", 
        RowBox[{"traj2DNum", ",", 
         RowBox[{"AspectRatio", "->", "1"}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<x(t)\>\"", ",", "\"\<y(t)\>\""}], "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<2D Rotating Quadrupole Orbits\>\""}],
          ",", 
         RowBox[{"Epilog", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"PointSize", "[", "Small", "]"}], ",", "Black", ",", 
            RowBox[{"Point", "[", "xy0Num", "]"}]}], "}"}]}]}], "]"}], ",", 
       RowBox[{"ListLinePlot3D", "[", 
        RowBox[{"worldlines3D", ",", 
         RowBox[{"BoxRatios", "->", 
          RowBox[{"{", 
           RowBox[{"2", ",", "1", ",", "1"}], "}"}]}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"Directive", "[", "Thick", "]"}]}], ",", 
         RowBox[{"Axes", "->", "True"}], ",", 
         RowBox[{"AxesLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<t\>\"", ",", "\"\<x(t)\>\"", ",", "\"\<y(t)\>\""}], 
           "}"}]}], ",", 
         RowBox[{
         "PlotLabel", "->", "\"\<Spacetime Worldlines (t, x, y)\>\""}]}], 
        "]"}]}], "}"}], ",", 
     RowBox[{"ImageSize", "->", "780"}]}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{4.002299556362067*^9, 4.002299558399332*^9}},
 CellLabel->
  "In[362]:=",ExpressionUUID->"11fdef9e-82f0-4cb4-a4c0-7a183f0fd71b"],

