  4.0022096707720337`*^9}},ExpressionUUID->"970635c2-05a0-477f-a75b-\
b702b9cc608a"],

Cell[TextData[{
 "The quadratic coefficients ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubscriptBox["V", "20"], "(", "t", ")"}], ",", 
     RowBox[{
      SubscriptBox["V", "02"], "(", "t", ")"}], ",", 
     RowBox[{
      SubscriptBox["V", "11"], "(", "t", ")"}]}], "}"}], TraditionalForm]],
  ExpressionUUID->"303aa6d6-9c1f-43dd-8c5c-1adbdbc47f85"],
 " and anisotropic harmonic trap with base frequency ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0172c95f-11b9-4d61-85a5-a10b905dc4f6"],
 " and eccentricity ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "<", "\[Epsilon]", "<", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "80bf894d-3ce4-4c5e-aaaf-0295980bac2b"],
 " rotating at frequency ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalOmega]", "Q"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fdf961e6-3875-48bf-8071-750220f18b70"],
 ":"
}], "Text",
 CellChangeTimes->{{4.002209687470319*^9, 4.002209689586974*^9}, 
   4.002209765474987*^9, {4.0022100959663143`*^9, 4.002210096697337*^9}, {
   4.002299207676383*^9, 
   4.002299258705563*^9}},ExpressionUUID->"db87733b-dc54-4efd-8529-\
1e680c786c7b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["V", "20"], "(", "t", ")"}], "=", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{
     SubsuperscriptBox["\[Omega]", "0", "2"], "(", 
     RowBox[{"1", "+", 
      RowBox[{"\[Epsilon]", " ", 
       RowBox[{"cos", "(", 
        RowBox[{
         SubscriptBox["\[CapitalOmega]", "Q"], "t"}], ")"}]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.002128957153825*^9, 4.0021289888049107`*^9}, {
  4.002129377650779*^9, 4.00212942207405*^9}, {4.002194823571836*^9, 
  4.0021948552042227`*^9}, {4.002195145048251*^9, 4.0021951695783663`*^9}, {
  4.002209510025131*^9, 4.0022095548191013`*^9}, {4.002209637092525*^9, 
  4.0022096522140837`*^9}, {4.002209696532915*^9, 
  4.002209721834304*^9}},ExpressionUUID->"84d6fe91-3d20-430a-8a16-\
22cd0056c330"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["V", "02"], "(", "t", ")"}], "=", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{
     SubsuperscriptBox["\[Omega]", "0", "2"], "(", 
     RowBox[{"1", "-", 
      RowBox[{"\[Epsilon]", " ", 
       RowBox[{"cos", "(", 
        RowBox[{
         SubscriptBox["\[CapitalOmega]", "Q"], "t"}], ")"}]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.002128957153825*^9, 4.0021289888049107`*^9}, {
  4.002129377650779*^9, 4.00212942207405*^9}, {4.002194823571836*^9, 
  4.0021948552042227`*^9}, {4.002195145048251*^9, 4.0021951695783663`*^9}, {
  4.002209510025131*^9, 4.0022095548191013`*^9}, {4.002209637092525*^9, 
  4.0022097302100277`*^9}},ExpressionUUID->"8b349e23-86d8-42cf-9f71-\
d1dd22122703"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["V", "11"], "(", "t", ")"}], "=", 
    RowBox[{
     SubsuperscriptBox["\[Omega]", "0", "2"], "\[Epsilon]", " ", 
     RowBox[{"sin", "(", 
      RowBox[{
       SubscriptBox["\[CapitalOmega]", "Q"], "t"}], ")"}]}]}], ")"}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.002128957153825*^9, 4.0021289888049107`*^9}, {
  4.002129377650779*^9, 4.00212942207405*^9}, {4.002194823571836*^9, 
  4.0021948552042227`*^9}, {4.002195145048251*^9, 4.0021951695783663`*^9}, {
  4.002209510025131*^9, 4.0022095548191013`*^9}, {4.002209637092525*^9, 
  4.002209750195674*^9}},ExpressionUUID->"85d2e41d-2ac2-4fed-920b-\
c6f00dbca749"],

Cell[TextData[{
 "Depending on the ratio of the quadrupole rotation rate ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalOmega]", "Q"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8b81dd9a-24d8-4c96-bd35-5ee4b2c82f90"],
 " to the trap frequency ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e0865e37-f019-4d79-a8d9-d9c839334975"],
 ", the wavepacket exhibits three distinct dynamical regimes (you can switch \
between them by uncommenting the desired parameter block below):"
}], "Text",
 CellChangeTimes->{{4.002209849774431*^9, 4.002209914544702*^9}, {
  4.002209995548143*^9, 4.0022100370396023`*^9}, {4.0022992741708317`*^9, 
  4.002299313339167*^9}},ExpressionUUID->"c329a3e6-43fd-4843-82f3-\
a711bcbeb22d"],

Cell[TextData[{
 "Bounded Adiabatic Precession (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", "0"], "=", "2.0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5dd00691-613b-4b06-9494-d8e698351f74"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalOmega]", "Q"], "=", "1.0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ff69ec54-802c-4c5e-abac-a1abfaa5400c"],
 "): The wavepacket breathes and precesses stably inside the rotating saddle \
while being spiraled by the circularly polarized laser field."
}], "Item",
 CellChangeTimes->{{4.00229933626024*^9, 
  4.002299374288498*^9}},ExpressionUUID->"ad3824d5-9078-4369-b753-\
608ae0e1c997"],

Cell[TextData[{
 "Pure Rotating Quadrupole Vortex (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["f", "0"], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3f7dddc8-033c-49bf-96ce-52f805bc6ba3"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", "0"], "=", "1.5"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0e673802-9b21-46c2-93c8-b82b9ae9acc5"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalOmega]", "Q"], "=", "1.0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f3d67b66-4674-48ef-984a-c667d134f480"],
 "): Without dipole driving, the rotating anisotropy induces pure quadrupolar \
shearing and vortex-like circulation."
}], "Item",
 CellChangeTimes->{{4.00229933626024*^9, 4.002299352273635*^9}, {
  4.002299385672586*^9, 
  4.002299442631289*^9}},ExpressionUUID->"2eae414b-f723-4fc9-8454-\
2eadd9e97d89"],

Cell[CellGroupData[{

Cell[TextData[{
 "2:1 Parametric Resonance (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalOmega]", "Q"], "=", 
    RowBox[{"2", 
     SubscriptBox["\[Omega]", "0"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9ba2d904-42ae-4aec-a280-f7d33b1fa0f1"],
 "): Driving the quadrupole rotation at twice the natural trap frequency \
excites exponential parametric amplification along the unstable manifold."
}], "Item",
 CellChangeTimes->{{4.00229933626024*^9, 4.002299353079232*^9}, {
  4.002299419357222*^9, 
  4.002299435900672*^9}},ExpressionUUID->"cb904e1c-ec52-4b5a-8f3f-\
23d86beaaf0d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Clear", " ", "numerical", " ", "cache", " ", "and", " ", 
    "previous", " ", "symbol", " ", "definitions"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"GWPClearCache", "[", "\"\<Quiet\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{
     "v00", ",", "v10", ",", "v01", ",", "v20", ",", "v02", ",", "v11", ",", 
      "f0", ",", "wEnv", ",", "wL", ",", "w0", ",", "eps", ",", "wQ"}], "]"}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Adjustable"}]}], " ", "Potential", " ", "Parameters", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Uncomment", " ", "one", " ", "regime"}], ")"}], "--"}]}], 
     "-"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Regime", " ", 
     RowBox[{"A", ":", 
      RowBox[{"Bounded", " ", "adiabatic", " ", "precession", " ", 
       RowBox[{"(", 
        RowBox[{"Active", " ", "Default"}], ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wEnv", "=", 
     RowBox[{"1", "/", "2"}]}], ";", 
    RowBox[{"w0", "=", "2.0"}], ";", 
    RowBox[{"eps", "=", "0.35"}], ";", 
    RowBox[{"wQ", "=", "1.0"}], ";", 
    RowBox[{"f0", "=", "1.0"}], ";", 
    RowBox[{"wL", "=", "1.5"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Regime", " ", 
     RowBox[{"B", ":", 
      RowBox[{"Pure", " ", "rotating", " ", "quadrupole", " ", "vortex"}]}]}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"wEnv", "=", 
      RowBox[{"1", "/", "2"}]}], ";", 
     RowBox[{"w0", "=", "1.5"}], ";", 
     RowBox[{"eps", "=", "0.45"}], ";", 
     RowBox[{"wQ", "=", "1.0"}], ";", 
     RowBox[{"f0", "=", "0.0"}], ";", 
     RowBox[{"wL", "=", "1.5"}], ";"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Regime", " ", 
     RowBox[{"C", ":", "2", ":", 
      RowBox[{
       RowBox[{"1", " ", "Parametric", " ", "resonance", " ", "blow"}], "-", 
       "up"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"wEnv", "=", 
      RowBox[{"1", "/", "2"}]}], ";", 
     RowBox[{"w0", "=", "1.0"}], ";", 
     RowBox[{"eps", "=", "0.50"}], ";", 
     RowBox[{"wQ", "=", 
      RowBox[{"2", "*", "w0"}]}], ";", 
     RowBox[{"f0", "=", "1.0"}], ";", 
     RowBox[{"wL", "=", "1.5"}], ";"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Define", " ", "the", " ", "6", " ", "scalar", " ", "2", "D", " ",
      "potential", " ", "coefficients"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"v00", "[", "t_", "]"}], ":=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"v10", "[", "t_", "]"}], ":=", 
     RowBox[{"f0", "*", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"wEnv", "*", "t"}], "]"}], "^", "2"}], "*", 
      RowBox[{"Cos", "[", 
       RowBox[{"wL", "*", "t"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"v01", "[", "t_", "]"}], ":=", 
     RowBox[{"f0", "*", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"wEnv", "*", "t"}], "]"}], "^", "2"}], "*", 
      RowBox[{"Sin", "[", 
       RowBox[{"wL", "*", "t"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"v20", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], "*", 
      RowBox[{"w0", "^", "2"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"eps", "*", 
         RowBox[{"Cos", "[", 
          RowBox[{"wQ", "*", "t"}], "]"}]}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"v02", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], "*", 
      RowBox[{"w0", "^", "2"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"eps", "*", 
         RowBox[{"Cos", "[", 
          RowBox[{"wQ", "*", "t"}], "]"}]}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"v11", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"w0", "^", "2"}], "*", "eps", "*", 
      RowBox[{"Sin", "[", 
       RowBox[{"wQ", "*", "t"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Inspect", " ", "the", " ", "dipole", " ", "laser", " ", "components", " ",
      "and", " ", "rotating", " ", "quadrupole", " ", "curvatures"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"v10", "[", "t", "]"}], ",", 
       RowBox[{"v01", "[", "t", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", 
       RowBox[{"2", "*", "2", " ", "Pi"}]}], "}"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<t\>\"", ",", "\"\<Dipole Force\>\""}], "}"}]}], ",", 
     RowBox[{
     "PlotLabel", "->", "\"\<Circularly Polarized Pulse {V10, V01}\>\""}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<V10(t)\>\"", ",", "\"\<V01(t)\>\""}], "}"}]}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"v20", "[", "t", "]"}], ",", 
       RowBox[{"v02", "[", "t", "]"}], ",", 
       RowBox[{"v11", "[", "t", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", 
       RowBox[{"2", "*", "2", " ", "Pi"}]}], "}"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<t\>\"", ",", "\"\<Curvature\>\""}], "}"}]}], ",", 
     RowBox[{
     "PlotLabel", "->", "\"\<Rotating Quadrupole {V20, V02, V11}\>\""}], ",", 
     
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<V20(t)\>\"", ",", "\"\<V02(t)\>\"", 
        ",", "\"\<V11(t)\>\""}], "}"}]}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{4.002299453543137*^9, 4.002299488206564*^9}},
 CellLabel->
  "In[351]:=",ExpressionUUID->"b4fedbf7-4a3a-4f3c-82fc-8b0c4519e732"],

