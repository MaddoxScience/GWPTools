Cell[CellGroupData[{

Cell["\<\
Rotating Quadrupole / Circularly Polarized Laser Trap \
(\[OpenCurlyDoubleQuote]2D\[CloseCurlyDoubleQuote] Numerical Potential) \
\>", "Subsection",
 CellChangeTimes->{
  4.002195256210384*^9, {4.0022988117812138`*^9, 4.002298817181333*^9}, {
   4.0022990465349827`*^9, 
   4.002299059042213*^9}},ExpressionUUID->"776a7adb-f107-4091-8e50-\
663fc6776b65"],

Cell["\<\
For \[OpenCurlyDoubleQuote]2D\[CloseCurlyDoubleQuote] systems, the \
\[OpenCurlyDoubleQuote]Numerical\[CloseCurlyDoubleQuote] potential accepts \
six time-dependent scalar coefficient functions defining the general locally \
quadratic 2D potential surface:\
\>", "Text",
 CellChangeTimes->{
  4.0021952669908648`*^9, 4.002209485331706*^9, 4.002210069383157*^9, {
   4.0022991027532253`*^9, 
   4.002299107409218*^9}},ExpressionUUID->"8be81862-d44b-42b4-a387-\
952b4965ead4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"V", "(", 
    RowBox[{"x", ",", "y", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["V", "00"], "(", "t", ")"}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["V", "10"], "(", "t", ")"}], "x"}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["V", "01"], "(", "t", ")"}], "y"}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["V", "20"], "(", "t", ")"}], 
     SuperscriptBox["x", "2"]}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["V", "02"], "(", "t", ")"}], 
     SuperscriptBox["y", "2"]}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["V", "11"], "(", "t", ")"}], "x", " ", "y"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.002128957153825*^9, 4.0021289888049107`*^9}, {
  4.002129377650779*^9, 4.00212942207405*^9}, {4.002194823571836*^9, 
  4.0021948552042227`*^9}, {4.002195145048251*^9, 4.0021951695783663`*^9}, {
  4.002209510025131*^9, 
  4.0022095548191013`*^9}},ExpressionUUID->"632d32e5-cfb6-4214-9b5b-\
962d18d3e22d"],

Cell[TextData[{
 "Here, the linear coefficients ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubscriptBox["V", "10"], "(", "t", ")"}], ",", 
     RowBox[{
      SubscriptBox["V", "01"], "(", "t", ")"}]}], "}"}], TraditionalForm]],
  ExpressionUUID->"fd4854a0-a52c-420d-ad32-b1e559ac1b59"],
 " represent a circularly polarized dipole laser pulse with amplitude ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "39bee387-2595-45f2-b23c-62ba04d64db1"],
 ", envelope frequency ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "env"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "174e80de-95bc-46a2-a858-a6e7a7d3e72f"],
 ", and carrier frequency ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "L"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "38bc79c9-6382-4414-9086-4865ca7a7823"],
 ":"
}], "Text",
 CellChangeTimes->{{4.002209562322296*^9, 4.002209628017042*^9}, 
   4.002209684617931*^9, {4.002210074738594*^9, 4.002210082457696*^9}, {
   4.0022101128856983`*^9, 4.002210113303843*^9}, {4.002299115042294*^9, 
   4.002299188590664*^9}},ExpressionUUID->"089aecc2-cdae-414f-a946-\
8e6fa652b1d5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["V", "10"], "(", "t", ")"}], "=", 
   RowBox[{
    SubscriptBox["f", "0"], 
    RowBox[{
     SuperscriptBox["sin", "2"], "(", 
     RowBox[{
      SubscriptBox["\[Omega]", "env"], "t"}], ")"}], 
    RowBox[{"cos", "(", 
     RowBox[{
      SubscriptBox["\[Omega]", "L"], "t"}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.002128957153825*^9, 4.0021289888049107`*^9}, {
  4.002129377650779*^9, 4.00212942207405*^9}, {4.002194823571836*^9, 
