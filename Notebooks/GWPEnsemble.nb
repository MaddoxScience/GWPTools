Cell[TextData[{
 "Because \[OpenCurlyDoubleQuote]InverseC\[CloseCurlyDoubleQuote] delegates \
directly to FindRoot with the exact analytical derivative ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "x"], 
     RowBox[{"C", "(", "x", ")"}]}], "=", 
    RowBox[{"\[Rho]", "(", "x", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d344c216-de50-4fce-be48-f08929105862"],
 ", arbitrary-precision quantile grids or restricted probability windows {N, \
{cMin, cMax}} can be computed simply by passing FindRoot options:"
}], "Text",
 CellChangeTimes->{{4.0022392985034113`*^9, 
  4.0022393195284643`*^9}},ExpressionUUID->"66632414-10a6-4015-bb03-\
77ce90228146"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"8", " ", "high"}], "-", 
    RowBox[{
    "precision", " ", "quantile", " ", "points", " ", "across", " ", "the", " ",
      "upper", " ", "lobe", " ", "c", " ", 
     RowBox[{"in", "[", 
      RowBox[{"0.55", ",", "0.95"}], "]"}]}]}], "*)"}], 
  RowBox[{"GWPEnsemble", "[", 
   RowBox[{"objSS", ",", 
    RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<InverseC\>\""}], ",", 
    RowBox[{"\"\<Grid\>\"", "->", 
     RowBox[{"{", 
      RowBox[{"8", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"11", "/", "20"}], ",", 
         RowBox[{"19", "/", "20"}]}], "}"}]}], "}"}]}], ",", 
    RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{4.002239271907823*^9, 4.002239271908049*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"10423367-176d-45fc-b7f3-ce0b64088b88"],

