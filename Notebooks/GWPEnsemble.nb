Cell[CellGroupData[{

Cell["Single GWP Examples (2D)", "Section",
 CellChangeTimes->{{4.002135838591145*^9, 
  4.002135902355191*^9}},ExpressionUUID->"53b596e2-21e2-44c0-99e8-\
c2e8b0cb6c17"],

Cell[TextData[{
 "For two-dimensional wavepackets (\[OpenCurlyDoubleQuote]2D\
\[CloseCurlyDoubleQuote]), GWPEnsemble generates lists of coordinate pairs \
{{x1, y1}, {x2, y2}, ...} adapted to the position center ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["\[Mu]",
     FontWeight->"Bold"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["x", "t"], ",", 
       SubscriptBox["y", "t"]}], ")"}], "T"]}], TraditionalForm]],
  ExpressionUUID->"65496dac-006a-4126-b6d4-74653da1ffab"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]],ExpressionUUID->
  "6327a461-a595-403b-ae61-2d2fea4f4b7f"],
 " spatial covariance matrix ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[CapitalSigma]",
     FontWeight->"Bold"], "r"], TraditionalForm]],ExpressionUUID->
  "b0718bfd-1e70-4d0f-8a14-03ed74bf413b"],
 " of the wavepacket."
}], "Text",
 CellChangeTimes->{
  4.002135958377902*^9, {4.002136448810196*^9, 
   4.002136540776169*^9}},ExpressionUUID->"4b4a1e8a-ca51-4930-a212-\
b2de8c3e98a4"],

Cell[CellGroupData[{

Cell["Sampling Methods & Grid Specifications Overview", "Subsection",
 CellChangeTimes->{
  4.0022722574994793`*^9, {4.002280564943763*^9, 
   4.002280580910385*^9}},ExpressionUUID->"f73ad792-7807-4d40-b9dc-\
07a9e121ada6"],

Cell["\<\
Five \[OpenCurlyDoubleQuote]SamplingMethod\[CloseCurlyDoubleQuote] geometries \
are available for 2D wavepackets: \
\>", "Text",
 CellChangeTimes->{
  4.002135986057953*^9, {4.0021367142896757`*^9, 4.002136877695661*^9}, {
   4.002136932235183*^9, 4.002136971265278*^9}, {4.0021379427933807`*^9, 
   4.002138266319858*^9}, {4.00213830488481*^9, 4.0021383343863773`*^9}, {
   4.002138579608285*^9, 4.002138942064186*^9}, {4.0021389730847883`*^9, 
   4.002139001871114*^9}, 4.002272965617347*^9, {4.0022729991271763`*^9, 
   4.0022730030458517`*^9}, {4.002280305407918*^9, 4.002280473263358*^9}, {
   4.0022805048402643`*^9, 
   4.00228050620986*^9}},ExpressionUUID->"f403c295-a6c3-4d3a-b06e-\
a4d4be8c0d0b"],

Cell[TextData[{
 StyleBox["\[OpenCurlyDoubleQuote]Cartesian\[CloseCurlyDoubleQuote] (or \
\[OpenCurlyDoubleQuote]UniformX\[CloseCurlyDoubleQuote] / Automatic): Forms a \
rectangular ", "Item"],
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["n", "x"], "\[Times]", 
    SubscriptBox["n", "y"]}], TraditionalForm]], "Item",ExpressionUUID->
  "b8c664f0-a598-4b47-af24-4e426658948a"], "Item"],
 StyleBox[" outer-product grid across ", "Item"],
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      RowBox[{
       SubscriptBox["x", "t"], "-", 
       RowBox[{"4", 
        SubscriptBox["\[Sigma]", "x"]}]}], ",", 
      RowBox[{
       SubscriptBox["x", "t"], "+", 
       RowBox[{"4", 
        SubscriptBox["\[Sigma]", "x"]}]}]}], "]"}], "\[Times]", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{
       SubscriptBox["y", "t"], "-", 
       RowBox[{"4", 
        SubscriptBox["\[Sigma]", "y"]}]}], ",", 
      RowBox[{
       SubscriptBox["y", "t"], "+", 
       RowBox[{"4", 
        SubscriptBox["\[Sigma]", "y"]}]}]}], "]"}]}], TraditionalForm]], 
  "Item",ExpressionUUID->"e5822915-f800-4c29-a9ec-c9f2ff78b9b1"], "Item"],
 StyleBox[" (or custom bounds).   ", "Item"]
}], "Item",
 CellChangeTimes->{{4.002280482885838*^9, 
  4.0022804858916407`*^9}},ExpressionUUID->"d7df10ef-0905-44fb-9b03-\
3d037236ff45"],

Cell[TextData[{
 StyleBox["\[OpenCurlyDoubleQuote]AffineC\[CloseCurlyDoubleQuote]: Warps a \
canonical ", "Item"],
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["n", "x"], "\[Times]", 
    SubscriptBox["n", "y"]}], TraditionalForm]], "Item",
  FormatType->TraditionalForm,ExpressionUUID->
  "9552df7b-7712-4e2c-bec7-a066cc7f2bd8"], "Item"],
 StyleBox[" normal quantile mesh via the Cholesky factor ", "Item"],
 StyleBox[Cell[BoxData[
  FormBox[
   StyleBox["L",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]], "Item",
  FormatType->TraditionalForm,ExpressionUUID->
  "019c8349-1906-4049-a0c2-c3033e06d2b7"], "Item"],
 StyleBox[" of the covariance matrix (", "Item"],
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[CapitalSigma]",
      FontWeight->"Bold"], "r"], "=", 
    RowBox[{
     StyleBox["L",
      FontWeight->"Bold",
      FontSlant->"Plain"], " ", 
     SuperscriptBox[
      StyleBox["L",
       FontWeight->"Bold",
       FontSlant->"Plain"], "T"]}]}], TraditionalForm]], "Item",
  FormatType->TraditionalForm,ExpressionUUID->
  "4f9290d1-cea8-41dd-9ea4-b155b7b4bc66"], "Item"],
 StyleBox[") to align with the wavepacket\[CloseCurlyQuote]s principal axes \
and tilt.", "Item"]
}], "Item",
 CellChangeTimes->{{4.002280482885838*^9, 
  4.002280488544235*^9}},ExpressionUUID->"a13a655c-feea-4f1d-be01-\
148f8d9de599"],

Cell[TextData[{
 StyleBox["\[OpenCurlyDoubleQuote]PolarC\[CloseCurlyDoubleQuote]: Maps ", 
  "Item"],
 StyleBox[Cell[BoxData[
  FormBox[
   SubscriptBox["n", "r"], TraditionalForm]], "Item",
  FormatType->TraditionalForm,ExpressionUUID->
  "27c1cfb2-22a7-4504-bad9-0b7db461ff1d"], "Item"],
 StyleBox[" radial probability shells and ", "Item"],
 StyleBox[Cell[BoxData[
  FormBox[
   SubscriptBox["n", "\[Theta]"], TraditionalForm]], "Item",
  FormatType->TraditionalForm,ExpressionUUID->
  "3925dd3c-b9b0-4578-a450-7a72f427fa5e"], "Item"],
 StyleBox[" angular rays onto concentric constant-probability ellipses via \
the polar inverse CDF \
obj[\[OpenCurlyDoubleQuote]XC\[CloseCurlyDoubleQuote]][cr, ctheta].", "Item"]
}], "Item",
 CellChangeTimes->{{4.002280482885838*^9, 
  4.002280491008442*^9}},ExpressionUUID->"ae573670-42b4-4ef8-ab7a-\
38389bf2723e"],

Cell[TextData[{
 StyleBox["\[OpenCurlyDoubleQuote]Random\[CloseCurlyDoubleQuote]: Draws ", 
  "Item"],
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{"N", "=", 
    RowBox[{
     SubscriptBox["n", "x"], 
     SubscriptBox["n", "y"]}]}], TraditionalForm]], "Item",ExpressionUUID->
  "e77f2e4b-40b3-4c46-9c60-d786eb88fe78"], "Item"],
 StyleBox[" variates directly from the analytical MultinormalDistribution[mu, \
sigma].", "Item"]
}], "Item",
 CellChangeTimes->{{4.002280482885838*^9, 
  4.002280496074881*^9}},ExpressionUUID->"003804ef-b07e-4e3d-9b04-\
8d21f4405dfa"],

Cell[TextData[{
 StyleBox["\[OpenCurlyDoubleQuote]RandomDensity\[CloseCurlyDoubleQuote]: \
Draws ", "Item"],
 StyleBox[Cell[BoxData[
  FormBox["N", TraditionalForm]], "Item",ExpressionUUID->
  "ca86e98f-aa73-48d0-a808-f839dcfebc57"], "Item"],
 StyleBox[" variates via 2D numerical rejection sampling over the bounding \
box. ", "Item"]
}], "Item",
 CellChangeTimes->{{4.002280482885838*^9, 
  4.002280492809757*^9}},ExpressionUUID->"14d2f01d-6cdf-4bf3-a92a-\
0e7af92e3f16"],

Cell["\<\
For a \[OpenCurlyDoubleQuote]2D\[CloseCurlyDoubleQuote] wavepacket, the \
\[OpenCurlyDoubleQuote]Grid\[CloseCurlyDoubleQuote] option accepts three \
flexible formats:\
\>", "Text",
 CellChangeTimes->{
  4.002135971876375*^9, {4.0021365450888643`*^9, 4.002136580732132*^9}, {
   4.0021366398407793`*^9, 4.002136702777152*^9}, {4.002138456621479*^9, 
   4.002138458308051*^9}, {4.002279906722682*^9, 4.0022799093899193`*^9}, 
   4.002280522674986*^9},ExpressionUUID->"cc082fdb-fd12-4a25-9017-\
b81f889a0343"],

Cell[TextData[{
 "\[OpenCurlyDoubleQuote]Grid\[CloseCurlyDoubleQuote] \[Rule] Automatic: \
Defaults to a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"20", "\[Times]", "20"}], TraditionalForm]],ExpressionUUID->
  "2a2beb9d-1018-448e-8e89-0b6544cfdc91"],
 " mesh (400 total points).   "
}], "Item",
 CellChangeTimes->{
  4.002279919556231*^9, {4.002280256007312*^9, 
   4.002280256938848*^9}},ExpressionUUID->"9fb2fbc8-168f-419e-bd73-\
72f48a392509"],

Cell[TextData[{
 "\[OpenCurlyDoubleQuote]Grid\[CloseCurlyDoubleQuote]\[RightArrow] N (single \
integer): Sets the total point count to ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],ExpressionUUID->
  "55aa01a5-cc31-4926-9186-837a88409f10"],
 " for random methods (\[OpenCurlyDoubleQuote]Random\[CloseCurlyDoubleQuote] \
and \[OpenCurlyDoubleQuote]RandomDensity\[CloseCurlyDoubleQuote]), or \
constructs an approximately square ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox["N"], "\[Times]", 
    SqrtBox["N"]}], TraditionalForm]],ExpressionUUID->
  "e1d7bb79-0be4-4ada-88fa-48d044db01e1"],
 " mesh for structured grid methods.   "
}], "Item",
 CellChangeTimes->{
  4.002279919556231*^9, {4.002280256007312*^9, 
   4.002280267297297*^9}},ExpressionUUID->"53850a70-b146-4b62-8a15-\
924c162e4f71"],

Cell[TextData[{
 "\[OpenCurlyDoubleQuote]Grid\[CloseCurlyDoubleQuote] \[Rule] {nx, ny} or \
{nx, ny, {{xMin, xMax}, {yMin, yMax}}}: Explicitly specifies the grid \
dimensions ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["n", "x"], "\[Times]", 
    SubscriptBox["n", "y"]}], TraditionalForm]],ExpressionUUID->
  "4db08568-e0ec-4b53-9c36-44c5df29ece7"],
 " (or ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["n", "r"], "\[Times]", 
    SubscriptBox["n", "\[Theta]"]}], TraditionalForm]],ExpressionUUID->
  "d3af62b6-506b-4ac9-ac51-fde040a8d1ba"],
 " radial shells and angular rays for \[OpenCurlyDoubleQuote]PolarC\
\[CloseCurlyDoubleQuote]), along with optional custom bounding intervals for \
\[OpenCurlyDoubleQuote]Cartesian\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]RandomDensity\[CloseCurlyDoubleQuote]. "
}], "Item",
 CellChangeTimes->{
  4.002279919556231*^9, {4.002280256007312*^9, 
   4.002280266762602*^9}},ExpressionUUID->"2b711437-b797-4b2b-9f9f-\
89fbba56a889"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
Structured Covariance-Adapted Meshes (\[OpenCurlyDoubleQuote]AffineC\
\[CloseCurlyDoubleQuote] and \[OpenCurlyDoubleQuote]PolarC\
\[CloseCurlyDoubleQuote])\
\>", "Subsection",
 CellChangeTimes->{{4.0022730073176928`*^9, 
  4.002273026910822*^9}},ExpressionUUID->"3c8a9b58-2128-46b6-b35d-\
2fac0160d698"],

Cell[TextData[{
 "\[OpenCurlyDoubleQuote]AffineC\[CloseCurlyDoubleQuote] (Cholesky Quantile \
Mesh): \n\nFor a correlated 2D Gaussian wavepacket, the spatial probability \
density ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "(", 
    RowBox[{"x", ",", "y"}], ")"}], TraditionalForm]],ExpressionUUID->
  "8f9724c1-ab4f-45e8-b5a7-ed24666092bc"],
 " does not factorize along the laboratory ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "89ab0319-d1b2-47c1-a0ee-a7df7f5d6233"],
 " and ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],ExpressionUUID->
  "5ca8c3f8-0ba5-472a-92b2-e36fa75e72a1"],
 " axes, meaning independent 1D quantile grids cannot capture its tilted \
covariance ellipse. To construct an exact equal-probability mesh without \
numerical root-finding, \
\[OpenCurlyDoubleQuote]AffineC\[CloseCurlyDoubleQuote] first generates an \
uncorrelated ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["n", "x"], "\[Times]", 
    SubscriptBox["n", "y"]}], TraditionalForm]],ExpressionUUID->
  "2454d228-b7f0-4223-9ac0-e84552e7a799"],
 " canonical quantile grid ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["z",
     FontWeight->"Bold",
     FontSlant->"Plain"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["z", "x"], ",", 
       SubscriptBox["z", "y"]}], ")"}], "T"]}], TraditionalForm]],
  ExpressionUUID->"f9641361-fc98-450d-8e39-9bce20283ae3"],
 " for a 2D standard normal distribution (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[Mu]",
      FontWeight->"Bold"], "z"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"0", ",", "0"}], ")"}], "T"]}], TraditionalForm]],
  ExpressionUUID->"59f1973a-b8c8-4434-8caa-ef8257ed4989"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[CapitalSigma]",
      FontWeight->"Bold"], "z"], "=", 
    SubscriptBox[
     StyleBox["I",
      FontWeight->"Bold",
      FontSlant->"Plain"], "2"]}], TraditionalForm]],ExpressionUUID->
  "1795c230-8c4d-48dc-8c69-4efe631d1bbc"],
 ") by evaluating the 1D inverse cumulative distribution function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["z", "k"], "=", 
    RowBox[{
     SqrtBox["2"], 
     RowBox[{
      SuperscriptBox["erf", 
       RowBox[{"-", "1"}]], "(", 
      RowBox[{
       RowBox[{"2", 
        SubscriptBox["c", "k"]}], "-", "1"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"72eae708-df81-49bd-add9-1f02a5bfe67d"],
 " at the probability midpoints ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", "k"], "\[Element]", 
    RowBox[{"(", 
     RowBox[{"0", ",", "1"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "ff838523-2a57-4253-9140-5d99b41515cf"],
 " along each axis. Next, it computes the lower-triangular Cholesky \
decomposition ",
 Cell[BoxData[
  FormBox[
   StyleBox["L",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]],ExpressionUUID->
  "71f76d65-2f6e-48e3-982e-c8636a8ea5c2"],
 " of the wavepacket\[CloseCurlyQuote]s ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]],ExpressionUUID->
  "963255fd-cbb0-4c37-bd11-412f4edcf483"],
 " spatial covariance matrix ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["\[CapitalSigma]",
      FontWeight->"Bold"], "r"], "=", 
    RowBox[{
     StyleBox["L",
      FontWeight->"Bold",
      FontSlant->"Plain"], " ", 
     SuperscriptBox[
      StyleBox["L",
       FontWeight->"Bold",
       FontSlant->"Plain"], "T"]}]}], TraditionalForm]],ExpressionUUID->
  "306bf06b-7aaa-4ba3-a1fb-12268fcaa624"],
 " and applies the affine transformation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r",
     FontWeight->"Bold",
     FontSlant->"Plain"], "=", 
    RowBox[{
     StyleBox["\[Mu]",
      FontWeight->"Bold"], "+", 
     RowBox[{
      StyleBox["L",
       FontWeight->"Bold",
       FontSlant->"Plain"], " ", 
      StyleBox["z",
       FontWeight->"Bold",
       FontSlant->"Plain"]}]}]}], TraditionalForm]],ExpressionUUID->
  "7bc70613-4fd4-437c-81d2-1d0b64d3bc34"],
 " to every canonical point ",
 StyleBox["z",
  FontWeight->"Bold"],
 ". Geometrically, ",
 Cell[BoxData[
  FormBox[
   StyleBox["L",
    FontWeight->"Bold",
    FontSlant->"Plain"], TraditionalForm]],ExpressionUUID->
  "fa8abe75-3422-4e4e-a178-89e47e62c2ab"],
 " scales and shears the rectangular unit-normal quantile mesh so that it \
aligns with the principal axes and correlation tilt of the physical \
wavepacket centered at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["\[Mu]",
     FontWeight->"Bold"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["x", "t"], ",", 
       SubscriptBox["y", "t"]}], ")"}], "T"]}], TraditionalForm]],
  ExpressionUUID->"60ba8981-e032-4e21-8705-bd1fc1131803"],
 ".  "
}], "Text",
 CellChangeTimes->{
  4.002280697868816*^9},ExpressionUUID->"1cbe72f7-ccc8-416f-9da2-\
274c26bbebfc"],

Cell[TextData[{
 " \[OpenCurlyDoubleQuote]PolarC\[CloseCurlyDoubleQuote] (Radial-Angular \
Quantile Shells): \n\nRather than warping a rectangular grid, \
\[OpenCurlyDoubleQuote]PolarC\[CloseCurlyDoubleQuote] samples the 2D Gaussian \
probability distribution in canonical polar quantile coordinates ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["c", "r"], ",", 
         SubscriptBox["c", "\[Theta]"]}], ")"}], "\[Element]", 
       RowBox[{"[", 
        RowBox[{"0", ",", "1"}]}]}], ")"}], "\[Times]", 
     RowBox[{"[", 
      RowBox[{"0", ",", "1"}]}]}], ")"}], TraditionalForm]],ExpressionUUID->
  "658b6d09-50ea-4baf-8b77-ee0f0810a286"],
 ". For a grid specification of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "r"], TraditionalForm]],ExpressionUUID->
  "c2be4c4c-a7ef-4da3-a7e4-d66a4c1e5341"],
 " radial shells and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "\[Theta]"], TraditionalForm]],ExpressionUUID->
  "0f0d24d3-e9e3-4b54-bf15-59ce6407cb03"],
 " angular rays, the method places radial cumulative probability coordinates \
at uniform intervals (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", 
     RowBox[{"r", ",", "i"}]], "=", 
    RowBox[{"i", "/", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["n", "r"], "+", "1"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"12ff6f8e-beb2-4336-9c4c-0f32ac775b0f"],
 " for  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", "\[Ellipsis]", ",", 
    SubscriptBox["n", "r"]}], TraditionalForm]],ExpressionUUID->
  "7ee81082-b795-4d66-b6ec-6835847270f1"],
 ") and distributes ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "\[Theta]"], TraditionalForm]],ExpressionUUID->
  "f5ca2114-d388-448d-9b60-fa8a1592d45c"],
 " angular phase coordinates uniformly around each shell (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["c", 
     RowBox[{"\[Theta]", ",", "j"}]], "=", 
    RowBox[{"j", "/", 
     SubscriptBox["n", "\[Theta]"]}]}], TraditionalForm]],ExpressionUUID->
  "ca5bc609-45ac-45ee-8dab-7510f50dfedc"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"j", "=", "0"}], ",", "\[Ellipsis]", ",", 
    RowBox[{
     SubscriptBox["n", "\[Theta]"], "-", "1"}]}], TraditionalForm]],
  ExpressionUUID->"7d324af0-a73d-4f42-82d2-8867c501b13e"],
 ").  When \[OpenCurlyDoubleQuote]Structure\[CloseCurlyDoubleQuote] \[Rule] \
\[OpenCurlyDoubleQuote]Staggered\[CloseCurlyDoubleQuote] (the default) is \
active, odd-numbered radial shells are shifted in angular phase by half a ray \
spacing (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]c", "\[Theta]"], "=", 
    RowBox[{
     RowBox[{"1", "/", "2"}], 
     SubscriptBox["n", "\[Theta]"]}]}], TraditionalForm]],ExpressionUUID->
  "0c4b9b97-3bce-4a38-be9f-6224823fbd38"],
 ") to create a triangulated packing, whereas \[OpenCurlyDoubleQuote]Aligned\
\[CloseCurlyDoubleQuote] keeps all points along fixed radial spokes. If \
\[OpenCurlyDoubleQuote]IncludeCore\[CloseCurlyDoubleQuote] \[Rule] True (the \
default), the origin point ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["c", "r"], ",", 
      SubscriptBox["c", "\[Theta]"]}], ")"}], "=", 
    RowBox[{"(", 
     RowBox[{"0", ",", "0"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "b421962a-0dc7-4e06-8eec-72c848ed2bec"],
 " is prepended to the ensemble. Finally, each ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["c", "r"], ",", 
     SubscriptBox["c", "\[Theta]"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "56f167ab-218a-4112-ab29-551206079a5a"],
 " pair is mapped through the backend 2D polar inverse cumulative \
distribution (GWP2DXC), which converts ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["c", "r"], ",", 
     SubscriptBox["c", "\[Theta]"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "332322ab-0131-473a-95a3-baa3f78d0ec3"],
 " into canonical polar coordinates (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Rho]", "=", 
     SqrtBox[
      RowBox[{
       RowBox[{"-", "2"}], 
       RowBox[{"ln", "(", 
        RowBox[{"1", "-", 
         SubscriptBox["c", "r"]}], ")"}]}]]}], ",", " ", 
    RowBox[{"\[Phi]", "=", 
     RowBox[{"2", "\[Pi]", " ", 
      SubscriptBox["c", "\[Theta]"]}]}]}], TraditionalForm]],ExpressionUUID->
  "d3ec786c-61f5-4532-ab46-f5209b38231a"],
 ") and transforms them onto concentric constant-probability ellipses aligned \
with the wavepacket\[CloseCurlyQuote]s covariance matrix ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[CapitalSigma]",
     FontWeight->"Bold"], "r"], TraditionalForm]],ExpressionUUID->
  "2804fd74-2181-4107-996c-dbe181f83784"],
 " and center ",
 Cell[BoxData[
  FormBox[
   StyleBox["\[Mu]",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "66410992-59ab-461a-99ef-2feeff2695c4"],
 "."
}], "Text",
 CellChangeTimes->{{4.002272969915758*^9, 4.0022729931288633`*^9}, {
  4.002280614808034*^9, 4.002280624777351*^9}, {4.0022806941241293`*^9, 
  4.002280702084106*^9}, {4.0022807506864157`*^9, 4.002280762681752*^9}, {
  4.002280815717513*^9, 
  4.0022808166507597`*^9}},ExpressionUUID->"fd4fe9cb-9bab-4009-93f0-\
73d17437a9d0"]
}, Closed]],

Cell[CellGroupData[{

Cell["Comparing 2D Sampling Geometries", "Subsection",
 CellChangeTimes->{
  4.002272324569622*^9},ExpressionUUID->"20ee5152-e869-4686-a617-\
2734e4c4eed3"],

Cell[TextData[{
 "To illustrate how the structured quantile methods adapt to anisotropic \
squeezing and inter-mode correlation, we construct a 2D wavepacket centered \
at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["r",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"], "=", 
    RowBox[{"(", 
     RowBox[{"1", ",", 
      RowBox[{"-", "1"}]}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "bfc6540d-03f3-4b48-aa5a-4f5ac31727f3"],
 " with a non-diagonal shape matrix: "
}], "Text",
 CellChangeTimes->{
  4.00213600353231*^9, {4.0021369777665052`*^9, 4.002137010621016*^9}, {
   4.0021375231111097`*^9, 4.0021375247344522`*^9}, {4.002272339788308*^9, 
   4.0022723429928713`*^9}, {4.002272719898078*^9, 
   4.002272733406642*^9}},ExpressionUUID->"e04a2fa7-0470-4827-92b4-\
7751ee548331"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["A",
     FontWeight->"Bold",
     FontSlant->"Plain"], "0"], "=", 
   RowBox[{"(", GridBox[{
      {"1", 
       RowBox[{"3", "/", "5"}]},
      {
       RowBox[{"3", "/", "5"}], 
       RowBox[{"1", "/", "2"}]}
     }], ")"}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.002272760858388*^9, 4.0022727686841288`*^9}, {
  4.0022728023884773`*^9, 
  4.002272824822298*^9}},ExpressionUUID->"73ae8bd5-62eb-4def-804f-\
8dc704ec8f8e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Anisotropic", ",", 
    RowBox[{
     RowBox[{
     "correlated", " ", "2", "D", " ", "GWP", " ", "tilted", " ", "in", " ", 
      "the", " ", "xy"}], "-", "plane"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"obj2D", "=", 
     RowBox[{
      RowBox[{"GWP", "[", "\"\<2D\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"3", "/", "5"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"3", "/", "5"}], ",", 
           RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ptsCart", "=", 
     RowBox[{"GWPEnsemble", "[", 
      RowBox[{"obj2D", ",", 
       RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<Cartesian\>\""}], ",", 
       RowBox[{"\"\<Grid\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"12", ",", "12"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ptsAffine", "=", 
     RowBox[{"GWPEnsemble", "[", 
      RowBox[{"obj2D", ",", 
       RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<AffineC\>\""}], ",", 
       RowBox[{"\"\<Grid\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"12", ",", "12"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ptsPolar", "=", 
     RowBox[{"GWPEnsemble", "[", 
      RowBox[{"obj2D", ",", 
       RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<PolarC\>\""}], ",", 
       RowBox[{"\"\<Grid\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"6", ",", "24"}], "}"}]}]}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"6", "*", "24"}], "+", 
      RowBox[{"1", " ", "core"}]}], "=", 
     RowBox[{"145", " ", "pts"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"ptsRand", "=", 
     RowBox[{"GWPEnsemble", "[", 
      RowBox[{"obj2D", ",", 
       RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<Random\>\""}], ",", 
       RowBox[{"\"\<Grid\>\"", "->", "144"}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.002135932799038*^9, 4.002135936390746*^9}, 
   4.002272373391169*^9, {4.002272833641747*^9, 4.0022728350392237`*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"58e07e50-cb7b-4006-807f-ec8f33c645d1"],

Cell[TextData[{
 "Visualizing all four ensembles superimposed on the contour plot of the 2D \
probability density ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "(", 
    RowBox[{"x", ",", "y"}], ")"}], TraditionalForm]],ExpressionUUID->
  "c4720554-c74c-4dea-834d-6b6f4ec3ec29"],
 " illustrates how \[OpenCurlyDoubleQuote]AffineC\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]PolarC\[CloseCurlyDoubleQuote] shear and rotate \
automatically with the covariance ellipse, whereas \
\[OpenCurlyDoubleQuote]Cartesian\[CloseCurlyDoubleQuote] remains locked to \
the laboratory axes:   "
}], "Text",
 CellChangeTimes->{
  4.002136017269434*^9, {4.002137555057708*^9, 4.002137568281567*^9}, 
   4.002272385476255*^9},ExpressionUUID->"fc7414bd-16c1-4e90-9ea3-\
51ec4bead23e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"bgContour", "=", 
    RowBox[{"ContourPlot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"obj2D", "[", "\"\<RHOX\>\"", "]"}], "[", 
       RowBox[{"x", ",", "y"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "2.5"}], ",", "4.5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", 
        RowBox[{"-", "5"}], ",", "3"}], "}"}], ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"Contours", "->", "8"}], ",", 
      RowBox[{"ContourShading", "->", "None"}], ",", 
      RowBox[{"ContourStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Thin", ",", 
         RowBox[{"GrayLevel", "[", "0.65", "]"}]}], "]"}]}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
      RowBox[{"BaseStyle", "->", 
       RowBox[{"{", 
        RowBox[{"FontSize", "->", "11"}], "}"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"GraphicsGrid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Show", "[", 
        RowBox[{"bgContour", ",", 
         RowBox[{"ListPlot", "[", 
          RowBox[{"ptsCart", ",", 
           RowBox[{"PlotStyle", "->", 
            RowBox[{"ColorData", "[", 
             RowBox[{"97", ",", "1"}], "]"}]}], ",", 
           RowBox[{"PlotMarkers", "->", 
            RowBox[{"{", 
             RowBox[{"Automatic", ",", "5"}], "}"}]}]}], "]"}], ",", 
         RowBox[{
         "PlotLabel", "->", "\"\<Cartesian (12\[Times]12 = 144 pts)\>\""}]}], 
        "]"}], ",", 
       RowBox[{"Show", "[", 
        RowBox[{"bgContour", ",", 
         RowBox[{"ListPlot", "[", 
          RowBox[{"ptsAffine", ",", 
           RowBox[{"PlotStyle", "->", 
            RowBox[{"ColorData", "[", 
             RowBox[{"97", ",", "2"}], "]"}]}], ",", 
           RowBox[{"PlotMarkers", "->", 
            RowBox[{"{", 
