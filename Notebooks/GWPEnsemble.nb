Cell[CellGroupData[{

Cell["Controlling Numerical Precision (WorkingPrecision)", "Subsection",
 CellChangeTimes->{{4.002236388249638*^9, 
  4.002236398106537*^9}},ExpressionUUID->"12fa02a2-5f06-4293-9987-\
c4deae164616"],

Cell[TextData[{
 "By default (WorkingPrecision \[Rule] Automatic), \
\[OpenCurlyDoubleQuote]Random\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]RandomDensity\[CloseCurlyDoubleQuote] generate \
machine-precision floating-point numbers, whereas exact methods (\
\[OpenCurlyDoubleQuote]UniformX\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]UniformC\[CloseCurlyDoubleQuote]) preserve exact \
symbolic expressions when the underlying wavepacket parameters are exact. \
Passing an explicit WorkingPrecision\[Rule] ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0955acc6-5846-44f7-a6ee-7abc78a3663d"],
 " option overrides this default across all sampling \
methods\[LongDash]generating arbitrary-precision random variates or directly \
evaluating exact symbolic grids to ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d93e0ff1-ee59-4bec-ac0c-dfff65fea5e0"],
 " digits:"
}], "Text",
 CellChangeTimes->{{4.002133046877429*^9, 4.002133050592223*^9}, {
  4.00223793829615*^9, 
  4.002237964112606*^9}},ExpressionUUID->"f5aadae7-3072-431f-8773-\
d005ed2c80ed"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Arbitrary", "-", 
    RowBox[{"precision", " ", "random", " ", "sampling", " ", 
     RowBox[{"(", 
      RowBox[{"25", " ", "digits"}], ")"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{"xdatR25", "=", 
    RowBox[{"GWPEnsemble", "[", 
     RowBox[{"obj", ",", 
      RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<Random\>\""}], ",", 
      RowBox[{"\"\<Grid\>\"", "->", "5"}], ",", 
      RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"xdatRD25", "=", 
    RowBox[{"GWPEnsemble", "[", 
     RowBox[{"obj", ",", 
      RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<RandomDensity\>\""}], ",", 
      
      RowBox[{"\"\<Grid\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"5", ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "2"}], "}"}]}], "}"}]}], ",", 
      RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Evaluating", " ", "an", " ", "exact", " ", "symbolic", " ", "quantile", 
      " ", "grid", " ", 
      RowBox[{"(", "\"\<UniformC\>\"", ")"}], " ", "directly", " ", "to", " ",
       "25"}], "-", 
     RowBox[{"digit", " ", "precision"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"xdatC25", "=", 
    RowBox[{"GWPEnsemble", "[", 
     RowBox[{"obj", ",", 
      RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<UniformC\>\""}], ",", 
      RowBox[{"\"\<Grid\>\"", "->", "5"}], ",", 
      RowBox[{"WorkingPrecision", "->", "25"}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{4.002133073028655*^9, 4.002133073028777*^9}},
 CellLabel->"In[52]:=",ExpressionUUID->"562c8786-cf97-4b0f-9ed6-eccdcb804ad7"],

