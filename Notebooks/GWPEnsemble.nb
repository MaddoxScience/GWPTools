Cell[CellGroupData[{

Cell["Single GWP Examples (1D)", "Section",
 CellChangeTimes->{{4.002128676720232*^9, 4.002128685764328*^9}, {
  4.0021340774500647`*^9, 4.0021340862853394`*^9}, {4.002135887495648*^9, 
  4.0021358975804367`*^9}},ExpressionUUID->"46b6c13f-a549-48b4-b30f-\
e1d9162e7fa4"],

Cell[TextData[{
 "We begin by initializing a default stationary wavepacket (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "0"], "=", 
    RowBox[{"1", "/", "4"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ecb3eafd-b4b7-4cb2-9168-8185d7c7776b"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "0"], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7b3a5563-c1be-4862-b5c8-18cc4e4472a5"],
 ", which has position uncertainty ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", "x"], "=", 
    RowBox[{
     RowBox[{"\[CapitalDelta]", " ", "x"}], "=", "1"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "997cf109-d7b0-4702-aeb6-9cd7c22782d7"],
 "):"
}], "Text",
 CellChangeTimes->{{4.002128734129011*^9, 4.0021288225290403`*^9}, {
  4.002129148930615*^9, 
  4.002129152413328*^9}},ExpressionUUID->"1c3ec17f-ec06-4637-ad12-\
0cbb8b162827"],

Cell[BoxData[
 RowBox[{
  RowBox[{"obj", "=", 
   RowBox[{
    RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.001775274043401*^9, 4.001775278531234*^9}, 
   4.0021283935786333`*^9},
 CellLabel->"In[8]:=",ExpressionUUID->"d6b92820-3c3f-4727-9416-5d9b831bbebc"],

Cell["\<\
Calling GWPEnsemble[obj] with no options triggers the default settings \
\[OpenCurlyDoubleQuote]SamplingMethod\[CloseCurlyDoubleQuote] \[Rule] \
Automatic and \
\[OpenCurlyDoubleQuote]Grid\[CloseCurlyDoubleQuote]\[RightArrow] Automatic. \
For a 1D wavepacket, Automatic routes to \[OpenCurlyDoubleQuote]UniformC\
\[CloseCurlyDoubleQuote] (uniform cumulative distribution / quantile \
sampling) and generates a 100-point grid evaluated at the probability \
midpoints\
\>", "Text",
 CellChangeTimes->{
  4.002128836791461*^9, {4.002128921394294*^9, 4.002128951774909*^9}, {
   4.0021289947568417`*^9, 
   4.002129013681685*^9}},ExpressionUUID->"f95062f9-911b-41ee-9d3a-\
f3cb8c369f44"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["c", "k"], "=", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"2", "k"}], "-", "1"}], 
     RowBox[{"2", "N"}]], "\[Element]", 
    RowBox[{"(", 
     RowBox[{"0", ",", "1"}], ")"}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.002128957153825*^9, 
  4.0021289888049107`*^9}},ExpressionUUID->"b7355b21-bcba-4256-ae7a-\
1224b71c8975"],

Cell["\<\
via the analytical inverse cumulative distribution function (GWP1DXC)\
\>", "Text",
 CellChangeTimes->{{4.002128998355035*^9, 
  4.002129000053293*^9}},ExpressionUUID->"30288a72-0e1f-4c5d-9465-\
dbcb5ac07c02"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Default", ":", 
    RowBox[{
     RowBox[{"100", " ", "equal"}], "-", 
     RowBox[{"probability", " ", "quantile", " ", "points", " ", 
      RowBox[{"(", "\"\<UniformC\>\"", ")"}]}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"xdatDefault", "=", 
     RowBox[{"GWPEnsemble", "[", "obj", "]"}]}], ";"}], "\n", 
   RowBox[{"Length", "[", "xdatDefault", "]"}], "\n", 
   RowBox[{"Short", "[", "xdatDefault", "]"}]}]}]], "Input",
 CellChangeTimes->{{4.00212886198663*^9, 4.002128861986788*^9}, 
   4.002133892528953*^9},
 CellLabel->"In[9]:=",ExpressionUUID->"efa783fd-b207-41de-a219-baca2cd5a11e"],

Cell[BoxData["100"], "Output",
 CellChangeTimes->{
  4.002128865276078*^9, 4.002132974276887*^9, 4.002133893483735*^9, 
   4.0021343172356586`*^9, {4.0021363524581623`*^9, 4.0021363686578503`*^9}},
 CellLabel->"Out[10]=",ExpressionUUID->"25e32f4a-2de4-4ea7-8a15-90a0e2f28054"],

Cell[BoxData[
 TagBox[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      SqrtBox["2"]}], " ", 
     RowBox[{"InverseErf", "[", 
      FractionBox["99", "100"], "]"}]}], ",", 
    RowBox[{
     RowBox[{"-", 
      SqrtBox["2"]}], " ", 
     RowBox[{"InverseErf", "[", 
      FractionBox["97", "100"], "]"}]}], ",", 
    RowBox[{"\[LeftSkeleton]", "96", "\[RightSkeleton]"}], ",", 
    RowBox[{
     SqrtBox["2"], " ", 
     RowBox[{"InverseErf", "[", 
      FractionBox["97", "100"], "]"}]}], ",", 
    RowBox[{
     SqrtBox["2"], " ", 
     RowBox[{"InverseErf", "[", 
      FractionBox["99", "100"], "]"}]}]}], "}"}],
  Short]], "Output",
 CellChangeTimes->{
  4.002128865276078*^9, 4.002132974276887*^9, 4.002133893483735*^9, 
   4.0021343172356586`*^9, {4.0021363524581623`*^9, 4.002136368658633*^9}},
 CellLabel->
  "Out[11]//Short=",ExpressionUUID->"e87b295d-693a-4926-a998-44b51b44e38f"]
}, Open  ]],

Cell[TextData[{
 "Selecting \[OpenCurlyDoubleQuote]SamplingMethod\[CloseCurlyDoubleQuote] \
\[Rule] \[OpenCurlyDoubleQuote]UniformX\[CloseCurlyDoubleQuote] generates a \
uniformly spaced Cartesian coordinate grid centered around the wavepacket\
\[CloseCurlyQuote]s expectation value ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "t"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c2d6cb27-89f0-4cb0-880a-c856fcdb5465"],
 ". The \[OpenCurlyDoubleQuote]Grid\[CloseCurlyDoubleQuote] option accepts \
three formats to control the number of grid points ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8304a443-cf81-4bb1-b683-43003238ae2d"],
 " and the spatial domain bounds:  \n\n\[OpenCurlyDoubleQuote]Grid\
\[CloseCurlyDoubleQuote] \[Rule] N (or Automatic for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "=", "100"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "88ef7efd-6ed0-4750-acbf-40df5cdbc924"],
 "): Subdivides the default ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[PlusMinus]", "4"}], 
    SubscriptBox["\[Sigma]", "x"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0ed10c9d-69d7-418d-99da-a1334986aef4"],
 " interval ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     RowBox[{
      SubscriptBox["x", "t"], "-", 
      RowBox[{"4", 
       SubscriptBox["\[Sigma]", "x"]}]}], ",", 
     RowBox[{"x", "+", 
      RowBox[{"4", 
       SubscriptBox["\[Sigma]", "x"]}]}]}], "]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e2c69b60-fc9b-4b3c-b32a-5e037ad96fec"],
 " into ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "59e14d09-45f4-4efa-b00d-431e734ddffc"],
 " evenly spaced points.   \n\n\[OpenCurlyDoubleQuote]Grid\
\[CloseCurlyDoubleQuote] \[Rule] {N, \[OpenCurlyDoubleQuote]3Sigma\
\[CloseCurlyDoubleQuote]}: Subdivides the narrower ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[PlusMinus]", "3"}], 
    SubscriptBox["\[Sigma]", "x"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8122fa3e-1847-447a-8799-7084459a3483"],
 " interval ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     RowBox[{
      SubscriptBox["x", "t"], "-", 
      RowBox[{"3", 
       SubscriptBox["\[Sigma]", "x"]}]}], ",", 
     RowBox[{
      SubscriptBox["x", "t"], "+", 
      RowBox[{"3", 
       SubscriptBox["\[Sigma]", "x"]}]}]}], "]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8c3b18bf-a4dd-404c-8e3a-a06c4f759503"],
 " into ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6ab8976f-2601-4d5a-9890-d0201983e751"],
 " points.   \n\n\[OpenCurlyDoubleQuote]Grid\[CloseCurlyDoubleQuote] \[Rule] \
{N, {xMin, xMax}}: Subdivides a user-specified coordinate window ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{
     SubscriptBox["x", "min"], ",", 
     SubscriptBox["x", "max"]}], "]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0662962a-4b42-4f23-8047-a27c71be2bbd"],
 " into ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "de77dfd2-c1fc-49bc-8e4b-ecf50763a4dd"],
 " points. \n "
}], "Text",
 CellChangeTimes->{
  4.00212888532204*^9, {4.002129032797327*^9, 4.0021290430071993`*^9}, {
   4.002129112670944*^9, 
   4.002129300076766*^9}},ExpressionUUID->"a2801d5c-dc95-4fd8-b810-\
b2114b434109"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"10", " ", "points", " ", "across", " ", "the", " ", "default"}], 
    "+", 
    RowBox[{
     RowBox[{"/", 
      RowBox[{"-", "4"}]}], "*", "Sigma", " ", 
     RowBox[{"window", "[", 
      RowBox[{
       RowBox[{"-", "4"}], ",", "4"}], "]"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{"xdatX1", "=", 
    RowBox[{"GWPEnsemble", "[", 
     RowBox[{"obj", ",", 
      RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<UniformX\>\""}], ",", 
      RowBox[{"\"\<Grid\>\"", "->", "10"}]}], "]"}]}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"10", " ", "points", " ", "across", " ", "the"}], "+", 
     RowBox[{
      RowBox[{"/", 
       RowBox[{"-", "3"}]}], "*", "Sigma", " ", 
      RowBox[{"window", "[", 
       RowBox[{
        RowBox[{"-", "3"}], ",", "3"}], "]"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"xdatX2", "=", 
    RowBox[{"GWPEnsemble", "[", 
     RowBox[{"obj", ",", 
      RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<UniformX\>\""}], ",", 
      RowBox[{"\"\<Grid\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"10", ",", "\"\<3Sigma\>\""}], "}"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "10", " ", "points", " ", "across", " ", "an", " ", "explicit", " ", 
     "coordinate", " ", 
     RowBox[{"window", "[", 
      RowBox[{"0", ",", "2"}], "]"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"xdatX3", "=", 
    RowBox[{"GWPEnsemble", "[", 
     RowBox[{"obj", ",", 
      RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<UniformX\>\""}], ",", 
      RowBox[{"\"\<Grid\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"10", ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "2"}], "}"}]}], "}"}]}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{4.002129067508156*^9, 4.0021290675083027`*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"c48cc683-46a3-4f09-8cbe-e93f127674dd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "4"}], ",", 
