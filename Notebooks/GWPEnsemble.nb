Cell[CellGroupData[{

Cell["Visual Comparison & Time-Evolved Ensembles (\[OpenCurlyDoubleQuote]Time\
\[CloseCurlyDoubleQuote])", "Subsection",
 CellChangeTimes->{{4.0022364131632557`*^9, 
  4.0022364346683283`*^9}},ExpressionUUID->"79b939da-5a41-42a9-a87d-\
78cb4950d75c"],

Cell[TextData[{
 "We can visually compare the point distributions of \
\[OpenCurlyDoubleQuote]UniformX\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]UniformC\[CloseCurlyDoubleQuote], and \
\[OpenCurlyDoubleQuote]Random\[CloseCurlyDoubleQuote] (for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "=", "25"}], TraditionalForm]],ExpressionUUID->
  "69d8aee7-0e4d-43e8-946c-438b2050559a"],
 ") against the underlying Gaussian probability density ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Rho]", "(", "x", ")"}], TraditionalForm]],ExpressionUUID->
  "eaa0e173-60c7-411f-a524-a58d65a7e30b"],
 " and the cumulative distribution ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", "x", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3dbd929f-94b1-4b1b-8dee-18e9e122e1d8"],
 ":"
}], "Text",
 CellChangeTimes->{{4.002131720323265*^9, 4.0021317465245457`*^9}, {
  4.002238041959516*^9, 
  4.002238049472821*^9}},ExpressionUUID->"7a2e9f4c-38bc-4b64-98ec-\
891abd6ac9f3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ensX", "=", 
   RowBox[{"GWPEnsemble", "[", 
    RowBox[{"obj", ",", 
     RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<UniformX\>\""}], ",", 
     RowBox[{"\"\<Grid\>\"", "->", "25"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ensC", "=", 
   RowBox[{"GWPEnsemble", "[", 
    RowBox[{"obj", ",", 
     RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<UniformC\>\""}], ",", 
     RowBox[{"\"\<Grid\>\"", "->", "25"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ensR", "=", 
    RowBox[{"GWPEnsemble", "[", 
     RowBox[{"obj", ",", 
      RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<Random\>\""}], ",", 
      RowBox[{"\"\<Grid\>\"", "->", "25"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"obj", "[", "\"\<RHOX\>\"", "]"}], "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "4.5"}], ",", "4.5"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "4.5"}], ",", "4.5"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.18"}], ",", "0.45"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<x\>\"", ",", "\"\<\[Rho](x)\>\""}], "}"}]}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Thick", ",", 
        RowBox[{"GrayLevel", "[", "0.3", "]"}]}], "]"}]}], ",", 
     RowBox[{"BaseStyle", "->", 
      RowBox[{"{", 
       RowBox[{"FontSize", "->", "12"}], "}"}]}], ",", 
     RowBox[{"ImageSize", "->", "500"}]}], "]"}], ",", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{"{", 
         RowBox[{"ensX", ",", 
          RowBox[{"-", "0.04"}]}], "}"}], "]"}], ",", 
       RowBox[{"Thread", "[", 
        RowBox[{"{", 
         RowBox[{"ensC", ",", 
          RowBox[{"-", "0.09"}]}], "}"}], "]"}], ",", 
       RowBox[{"Thread", "[", 
        RowBox[{"{", 
         RowBox[{"ensR", ",", 
          RowBox[{"-", "0.14"}]}], "}"}], "]"}]}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", "1"}], "]"}], ",", 
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", "2"}], "]"}], ",", 
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", "3"}], "]"}]}], "}"}]}], ",", 
     RowBox[{"PlotMarkers", "->", 
      RowBox[{"{", 
       RowBox[{"Automatic", ",", "8"}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<UniformX (\[PlusMinus]4\!\(\*SubscriptBox[\(\[Sigma]\), \
\(x\)]\))\>\"", ",", "\"\<UniformC (Quantile)\>\"", 
        ",", "\"\<Random (Normal)\>\""}], "}"}]}]}], "]"}], ",", 
   RowBox[{"(*", 
    RowBox[{
    "Project", " ", "UniformC", " ", "markers", " ", "directly", " ", "onto", 
     " ", "the", " ", "density", " ", "curve", " ", "to", " ", "highlight", " ",
      "peak", " ", "clustering"}], "*)"}], 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
