Cell[CellGroupData[{

Cell["Stochastic Sampling (\[OpenCurlyDoubleQuote]Random\
\[CloseCurlyDoubleQuote] vs. \[OpenCurlyDoubleQuote]RandomDensity\
\[CloseCurlyDoubleQuote])", "Subsection",
 CellChangeTimes->{{4.00223635942524*^9, 
  4.002236376314848*^9}},ExpressionUUID->"c2cfac28-fce7-45c0-bc6d-\
3a8fdeeee57b"],

Cell["\<\
GWPEnsemble provides two distinct random sampling modes for 1D wavepackets:   \
\>", "Text",
 CellChangeTimes->{{4.002131587666334*^9, 4.0021316648808727`*^9}, {
  4.0022377410884666`*^9, 
  4.0022377421663923`*^9}},ExpressionUUID->"a59bb5ac-c76d-434e-b80a-\
7c3f757b8700"],

Cell[CellGroupData[{

Cell[TextData[{
 "\[OpenCurlyDoubleQuote]SamplingMethod\[CloseCurlyDoubleQuote] \[Rule] \
\[OpenCurlyDoubleQuote]Random\[CloseCurlyDoubleQuote]: Draws ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],ExpressionUUID->
  "55961de1-448b-4851-945f-6e82c85e3046"],
 " sorted variates directly from the analytical unbounded Gaussian \
distribution NormalDistribution[obj[\[OpenCurlyDoubleQuote]RX\
\[CloseCurlyDoubleQuote]][t], obj[\[OpenCurlyDoubleQuote]UX\
\[CloseCurlyDoubleQuote]][t]] over ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], ")"}], 
   TraditionalForm]],ExpressionUUID->"a2cd232a-ee20-49a6-a206-20d4fe78d12c"],
 ". Note that \[OpenCurlyDoubleQuote]Random\[CloseCurlyDoubleQuote] only \
reads the point count ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],ExpressionUUID->
  "bd763a43-78cc-4874-9419-006fbcddef3e"],
 " from \[OpenCurlyDoubleQuote]Grid\[CloseCurlyDoubleQuote] and ignores \
spatial bound specifications."
}], "Item",
 CellChangeTimes->{{4.002237529788599*^9, 4.002237534330392*^9}, {
  4.002237793422142*^9, 
  4.002237830559599*^9}},ExpressionUUID->"04447fda-5c15-45a2-94a7-\
3ecb10707eef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "10", " ", "sorted", " ", "random", " ", "variates", " ", "from", " ", 
    "the", " ", "full", " ", "unbounded", " ", "normal", " ", 
    "distribution"}], "*)"}], 
  RowBox[{"xdatR1", "=", 
   RowBox[{"GWPEnsemble", "[", 
    RowBox[{"obj", ",", 
     RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<Random\>\""}], ",", 
     RowBox[{"\"\<Grid\>\"", "->", "10"}]}], "]"}]}]}]], "Input",
 CellLabel->"In[49]:=",ExpressionUUID->"b241d282-36ff-45ac-9c82-b58b62bb212f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "1.4500233910965248`"}], ",", 
   RowBox[{"-", "1.2273006528938109`"}], ",", 
   RowBox[{"-", "0.5249063735887106`"}], ",", "0.25780033896847143`", ",", 
   "0.4043520442929205`", ",", "1.091112364827904`", ",", 
   "1.364252285305186`", ",", "1.420911331817122`", ",", 
   "1.5427632111032459`", ",", "1.6700025284820408`"}], "}"}]], "Output",
 CellChangeTimes->{4.0022378547897787`*^9},
 CellLabel->"Out[49]=",ExpressionUUID->"3f2cdcb2-8b16-4d75-9984-3be6df9f52ed"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "\[OpenCurlyDoubleQuote]SamplingMethod\[CloseCurlyDoubleQuote] \[Rule] \
\[OpenCurlyDoubleQuote]RandomDensity\[CloseCurlyDoubleQuote]: Constructs a \
numerical ProbabilityDistribution from the wavepacket density obj[\
\[OpenCurlyDoubleQuote]RHO\[CloseCurlyDoubleQuote]][x,t] truncated and \
normalized over a bounded spatial domain (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[PlusMinus]", "4"}], 
    SubscriptBox["\[Sigma]", "x"]}], TraditionalForm]],ExpressionUUID->
  "ccff1222-2f78-47b4-9e52-1231dccb56d9"],
 " by default, \[OpenCurlyDoubleQuote]3Sigma\[CloseCurlyDoubleQuote], or an \
explicit {xMin, xMax} window)."
}], "Item",
 CellChangeTimes->{{4.002237529788599*^9, 4.0022375337385187`*^9}, {
  4.002237775821342*^9, 
  4.002237785400392*^9}},ExpressionUUID->"4e3bf4f7-3ef7-4d3e-90e6-\
80827c6681b5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "10", " ", "sorted", " ", "random", " ", "variates", " ", "restricted", " ",
      "to", " ", "the"}], "+", 
    RowBox[{
     RowBox[{"/", 
      RowBox[{"-", "3"}]}], "*", "Sigma", " ", 
     RowBox[{"window", "[", 
      RowBox[{
       RowBox[{"-", "3"}], ",", "3"}], "]"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"xdatRD1", "=", 
    RowBox[{"GWPEnsemble", "[", 
     RowBox[{"obj", ",", 
      RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<RandomDensity\>\""}], ",", 
      
      RowBox[{"\"\<Grid\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"10", ",", "\"\<3Sigma\>\""}], "}"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "10", " ", "sorted", " ", "random", " ", "variates", " ", "restricted", " ",
      "to", " ", "the", " ", "positive", " ", "spatial", " ", 
     RowBox[{"window", "[", 
      RowBox[{"0", ",", "2"}], "]"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"xdatRD2", "=", 
    RowBox[{"GWPEnsemble", "[", 
     RowBox[{"obj", ",", 
      RowBox[{"\"\<SamplingMethod\>\"", "->", "\"\<RandomDensity\>\""}], ",", 
      
      RowBox[{"\"\<Grid\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"10", ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "2"}], "}"}]}], "}"}]}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{4.002131678506672*^9, 4.002131701267541*^9}, {
  4.002236170042597*^9, 4.002236171250504*^9}, {4.0022378521609383`*^9, 
  4.002237857717247*^9}},
 CellLabel->"In[50]:=",ExpressionUUID->"f363ed71-d69c-4c1d-a64a-4273d7102a58"],

