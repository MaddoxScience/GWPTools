Cell[CellGroupData[{

Cell["Equal-Probability Quantile Grids (\[OpenCurlyDoubleQuote]UniformC\
\[CloseCurlyDoubleQuote])", "Subsection",
 CellChangeTimes->{{4.002236336835968*^9, 
  4.0022363483034487`*^9}},ExpressionUUID->"4db2c3e3-8966-477c-956b-\
5599e280ace5"],

Cell["\<\
Selecting \[OpenCurlyDoubleQuote]SamplingMethod\[CloseCurlyDoubleQuote] \
\[Rule] \[OpenCurlyDoubleQuote]UniformC\[CloseCurlyDoubleQuote] places grid \
points at equal probability intervals along the cumulative distribution \
function \
\>", "Text",
 CellChangeTimes->{{4.002129335038191*^9, 
  4.002129360437236*^9}},ExpressionUUID->"be44920e-64d3-43b4-ac46-\
7cb8b5ee64fa"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"C", "(", "x", ")"}], "=", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{"-", "\[Infinity]"}], "x"], 
     RowBox[{
      RowBox[{"\[Rho]", "(", 
       SuperscriptBox["x", "\[Prime]"], ")"}], 
      RowBox[{"\[DifferentialD]", 
       SuperscriptBox["x", "\[Prime]"]}]}]}], "\[Element]", 
    RowBox[{"(", 
     RowBox[{"0", ",", "1"}], ")"}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.002128957153825*^9, 4.0021289888049107`*^9}, {
  4.002129377650779*^9, 
  4.00212942207405*^9}},ExpressionUUID->"09d519cd-b177-44db-a699-\
f645c72873fb"],

Cell["\<\
This naturally concentrates points near the peak of the probability density \
and spreading them out in the tails\[LongDash]making it ideal for \
equal-weight Bohmian trajectory ensembles:   \
\>", "Text",
 CellChangeTimes->{
  4.002129362839416*^9, {4.002129427341544*^9, 4.002129452150136*^9}, {
   4.0021305634055977`*^9, 4.002130691286487*^9}, {4.002193604010594*^9, 
   4.002193606179016*^9}, {4.002237333525322*^9, 
   4.002237407663618*^9}},ExpressionUUID->"11cd464e-79a0-44db-885b-\
aad6320339df"],

Cell[CellGroupData[{

Cell[TextData[{
 "\[OpenCurlyDoubleQuote]Grid\[CloseCurlyDoubleQuote] \[Rule] N: Evaluates \
the inverse CDF at the ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],ExpressionUUID->
  "8a58bd74-c8de-4cb7-a798-8165aaab6cd9"],
 " bin midpoints ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["c", "k"], "=", 
     RowBox[{
      RowBox[{"1", "/", "2"}], "N"}]}], ",", 
    RowBox[{
     RowBox[{"3", "/", "2"}], "N"}], ",", "\[Ellipsis]", ",", 
    RowBox[{"1", "-", 
     RowBox[{
      RowBox[{"1", "/", "2"}], "N"}]}]}], TraditionalForm]],ExpressionUUID->
  "4d6b0d3d-427b-40c1-be3a-5672a49aef71"],
 " (avoiding the divergent endpoints at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "f72a58f2-9a48-401f-b72f-50237e8b1cc1"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "=", "1"}], TraditionalForm]],ExpressionUUID->
  "80e1e102-1e62-41f6-a4af-4513f52058b3"],
 ").  "
}], "Item",
 CellChangeTimes->{{4.002237399501264*^9, 
  4.002237418820878*^9}},ExpressionUUID->"ae0e9cab-de08-4ff1-ad72-\
2b1e1885cec7"],

