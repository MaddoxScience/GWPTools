Cell[TextData[{
 "Using parsed2DNum[\[OpenCurlyDoubleQuote]TDAT\[CloseCurlyDoubleQuote]] and \
traj2DNum, we can animate the ensemble\[CloseCurlyQuote]s \
\[OpenCurlyDoubleQuote]comet tails\[CloseCurlyDoubleQuote] riding inside the \
rotating and breathing probability density contours. Finally, we verify that \
integrating the 2nd-order 2D Newton\[Dash]Bohm acceleration field (combining \
the analytical classical force ",
 Cell[BoxData[
  FormBox[
   RowBox[{"-", 
    RowBox[{"\[Del]", "V"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e9179099-4775-4b49-9178-c4d73c39e3f9"],
 ", the 2D quantum force obj2DNum[\[OpenCurlyDoubleQuote]QFX\
\[CloseCurlyDoubleQuote]], and obj2DNum[\[OpenCurlyDoubleQuote]MASS\
\[CloseCurlyDoubleQuote]]) reproduces the 1st-order Bohmian trajectories to \
within ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tilde]", 
    SuperscriptBox["10", 
     RowBox[{"-", "6"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f10e6943-6349-4c26-8bfc-f42cebd84c88"],
 ":"
}], "Text",
 CellChangeTimes->{
  4.002299593741638*^9, {4.002299653508636*^9, 
   4.002299705994228*^9}},ExpressionUUID->"2f1debad-8577-490b-83e3-\
b6dcd09472ca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Interactive", " ", "comet"}], "-", 
    RowBox[{
    "tail", " ", "animation", " ", "over", " ", "the", " ", "solver", " ", 
     "time", " ", "grid"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"tGrid", "=", 
     RowBox[{"parsed2DNum", "[", "\"\<TDAT\>\"", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"Manipulate", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"tNow", "=", 
          RowBox[{"tGrid", "[", 
           RowBox[{"[", "k", "]"}], "]"}]}], ",", 
         RowBox[{"tailStart", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"1", ",", 
            RowBox[{"k", "-", "15"}]}], "]"}]}]}], "}"}], ",", 
       RowBox[{"Show", "[", 
        RowBox[{
         RowBox[{"ContourPlot", "[", 
          RowBox[{
           RowBox[{"Evaluate", "[", 
            RowBox[{
             RowBox[{"obj2DNum", "[", "\"\<RHOX\>\"", "]"}], "[", 
             RowBox[{"x", ",", "y", ",", "tNow"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"-", "3.5"}], ",", "3.5"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"y", ",", 
             RowBox[{"-", "3.5"}], ",", "3.5"}], "}"}], ",", 
           RowBox[{"Contours", "->", "8"}], ",", 
           RowBox[{"ColorFunction", "->", "\"\<DeepSeaColors\>\""}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"Exclusions", "->", "None"}]}], "]"}], ",", 
         RowBox[{"Graphics", "[", 
          RowBox[{"{", 
           RowBox[{"(*", 
            RowBox[{
            "Fading", " ", "comet", " ", "tails", " ", "over", " ", "the", " ",
              "last", " ", "15", " ", "solver", " ", "time", " ", "steps"}], 
            "*)"}], 
           RowBox[{"White", ",", 
            RowBox[{"Opacity", "[", "0.7", "]"}], ",", "Thick", ",", 
            RowBox[{"Line", "[", 
             RowBox[{"traj2DNum", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", 
                RowBox[{"tailStart", ";;", "k"}]}], "]"}], "]"}], "]"}], ",", 
            
            RowBox[{"(*", 
             RowBox[{"Current", " ", "particle", " ", "positions"}], "*)"}], 
            "Yellow", ",", 
            RowBox[{"PointSize", "[", "Medium", "]"}], ",", 
            RowBox[{"Point", "[", 
             RowBox[{"traj2DNum", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "k"}], "]"}], "]"}], "]"}]}], "}"}], "]"}],
          ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<t = \>\"", ",", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"tNow", ",", 
               RowBox[{"{", 
                RowBox[{"4", ",", "2"}], "}"}]}], "]"}]}], "}"}], "]"}]}], ",", 
         RowBox[{"ImageSize", "->", "420"}]}], "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", "\"\<Time Step\>\""}], "}"}], ",", "1", ",", 
       RowBox[{"Length", "[", "tGrid", "]"}], ",", "1", ",", "Animator"}], 
      "}"}]}], "]"}], "\n"}]}]], "Input",
 CellChangeTimes->{{4.002299728111197*^9, 4.002299731348694*^9}, {
  4.002299794627893*^9, 4.002299795877726*^9}},
 CellLabel->
  "In[375]:=",ExpressionUUID->"ee73cc88-808d-42f2-9f49-38d275a5da34"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "2"}]}], "nd"}], "-", 
    RowBox[{"Order", " ", "2", "D", " ", "Newton"}], "-", 
    RowBox[{"Bohm", " ", 
     RowBox[{"Verification", "--"}]}], "-"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "1.", " ", "Initial", " ", "2", "D", " ", "velocities", " ", "at", " ", 
     "t"}], "=", "0"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"vxy0Num", "=", 
     RowBox[{"Transpose", "@", 
      RowBox[{
       RowBox[{"obj2DNum", "[", "\"\<VX\>\"", "]"}], "[", 
       RowBox[{
        RowBox[{"xy0Num", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
        RowBox[{"xy0Num", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "0"}], "]"}]}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "Total", " ", "2", "D", " ", 
     RowBox[{"acceleration", ":", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"F_external", "+", "F_quantum"}], ")"}], "/", "Mass"}], " ", 
       "directly", " ", "from", " ", "obj2DNum"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fTotal2D", "[", 
      RowBox[{"xy_", ",", "t_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "=", 
          RowBox[{"xy", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", 
         RowBox[{"y", "=", 
          RowBox[{"xy", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"obj2DNum", "[", "\"\<FEX\>\"", "]"}], "[", 
           RowBox[{"x", ",", "y", ",", "t"}], "]"}], "+", 
          RowBox[{
           RowBox[{"obj2DNum", "[", "\"\<QFX\>\"", "]"}], "[", 
           RowBox[{"x", ",", "y", ",", "t"}], "]"}]}], "]"}], "/", 
        RowBox[{"obj2DNum", "[", "\"\<MASS\>\"", "]"}]}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"3.", " ", "Integrate", " ", "2", "nd"}], "-", 
     RowBox[{"order", " ", "2", "D", " ", "Newton"}], "-", 
     RowBox[{"Bohm", " ", "equations"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sol2DNum2nd", "=", 
     RowBox[{"GWPEnsembleSolve", "[", 
      RowBox[{"xy0Num", ",", "vxy0Num", ",", "fTotal2D", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", 
         RowBox[{"2", " ", "Pi"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
      "4.", " ", "Maximum", " ", "2", "D", " ", "endpoint", " ", 
       "discrepancy", " ", "between", " ", "1", "st"}], "-", 
      RowBox[{"order", " ", "and", " ", "2", "nd"}], "-", 
      RowBox[{"order", " ", "propagation", " ", "at", " ", "t"}]}], "=", 
     RowBox[{"2", " ", "Pi"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Max", "@", 
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"Through", "[", 
       RowBox[{"sol2DNum", "[", 
        RowBox[{"2", " ", "Pi"}], "]"}], "]"}], "-", 
      RowBox[{"Through", "[", 
       RowBox[{"sol2DNum2nd", "[", 
        RowBox[{"2", " ", "Pi"}], "]"}], "]"}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{4.002299804714385*^9, 4.002299805513311*^9}, 
   4.002299891015483*^9},
 CellLabel->
  "In[382]:=",ExpressionUUID->"271507e9-82f0-4a42-b61b-6362ac79b071"],

