Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Extract", " ", "the", " ", "time", " ", "grid", " ", "and", " ", 
    "trajectory", " ", "coordinates", " ", "from", " ", "parsed2DNum"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"tGrid", "=", 
     RowBox[{"parsed2DNum", "[", "\"\<TDAT\>\"", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"Manipulate", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"tNow", "=", 
          RowBox[{"tGrid", "[", 
           RowBox[{"[", "k", "]"}], "]"}]}], ",", 
         RowBox[{"tailStart", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"1", ",", 
            RowBox[{"k", "-", "15"}]}], "]"}]}]}], "}"}], ",", 
       RowBox[{"Show", "[", 
        RowBox[{
         RowBox[{"ContourPlot", "[", 
          RowBox[{
           RowBox[{"Evaluate", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"obj2DNum", "[", "\"\<AX\>\"", "]"}], "[", 
              RowBox[{"x", ",", "y", ",", "tNow"}], "]"}], "^", "2"}], "]"}], 
           ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"-", "3.5"}], ",", "3.5"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"y", ",", 
             RowBox[{"-", "3.5"}], ",", "3.5"}], "}"}], ",", 
           RowBox[{"Contours", "->", "8"}], ",", 
           RowBox[{"ColorFunction", "->", "\"\<DeepSeaColors\>\""}], ",", 
           RowBox[{"PlotRange", "->", "All"}], ",", 
           RowBox[{"Exclusions", "->", "None"}]}], "]"}], ",", 
         RowBox[{"Graphics", "[", 
          RowBox[{"{", 
           RowBox[{"(*", 
            RowBox[{
            "Fading", " ", "comet", " ", "tails", " ", "over", " ", "the", " ",
              "last", " ", "15", " ", "time", " ", "steps"}], "*)"}], 
           RowBox[{"White", ",", 
            RowBox[{"Opacity", "[", "0.7", "]"}], ",", "Thick", ",", 
            RowBox[{"Line", "[", 
             RowBox[{"traj2DNum", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", 
                RowBox[{"tailStart", ";;", "k"}]}], "]"}], "]"}], "]"}], ",", 
            
            RowBox[{"(*", 
             RowBox[{"Current", " ", "particle", " ", "positions"}], "*)"}], 
            "Yellow", ",", 
            RowBox[{"PointSize", "[", "Medium", "]"}], ",", 
            RowBox[{"Point", "[", 
             RowBox[{"traj2DNum", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "k"}], "]"}], "]"}], "]"}]}], "}"}], "]"}],
          ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", 
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<t = \>\"", ",", 
             RowBox[{"NumberForm", "[", 
              RowBox[{"tNow", ",", 
               RowBox[{"{", 
                RowBox[{"4", ",", "2"}], "}"}]}], "]"}]}], "}"}], "]"}]}], ",", 
         RowBox[{"ImageSize", "->", "420"}]}], "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", "\"\<Time Step\>\""}], "}"}], ",", "1", ",", 
       RowBox[{"Length", "[", "tGrid", "]"}], ",", "1", ",", "Animator"}], 
      "}"}]}], "]"}]}]}]], "Input",
