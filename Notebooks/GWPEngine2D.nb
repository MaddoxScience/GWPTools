Cell["Integrating this gives the classical action", "Text",
 CellChangeTimes->{{4.001075187782366*^9, 
  4.0010752031658783`*^9}},ExpressionUUID->"ef5b39cc-3559-4311-87db-\
5946fcd51fc4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["S", "cl"], "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        RowBox[{
         SubsuperscriptBox[
          StyleBox["p",
           FontWeight->"Bold",
           FontSlant->"Plain"], "0", "T"], 
         SubscriptBox[
          StyleBox["p",
           FontWeight->"Bold",
           FontSlant->"Plain"], "0"]}], 
        RowBox[{"2", "m"}]], "-", 
       SubscriptBox["V", "00"], "-", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["V",
          FontWeight->"Bold",
          FontSlant->"Plain"], "1", "T"], 
        SubscriptBox[
         StyleBox["r",
          FontWeight->"Bold",
          FontSlant->"Plain"], "0"]}]}], ")"}], "t"}], "-", 
    RowBox[{
     FractionBox[
      RowBox[{
       SubsuperscriptBox[
        StyleBox["V",
         FontWeight->"Bold",
         FontSlant->"Plain"], "1", "T"], 
       SubscriptBox[
        StyleBox["p",
         FontWeight->"Bold",
         FontSlant->"Plain"], "0"]}], "m"], 
     SuperscriptBox["t", "2"]}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{
       SubsuperscriptBox[
        StyleBox["V",
         FontWeight->"Bold",
         FontSlant->"Plain"], "1", "T"], 
       SubscriptBox[
        StyleBox["V",
         FontWeight->"Bold",
         FontSlant->"Plain"], "1"]}], 
      RowBox[{"3", "m"}]], 
     SuperscriptBox["t", "3"]}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422790416041*^9, 4.000422947641068*^9}, {
  4.001023019174439*^9, 4.001023024772278*^9}, {4.001029297384856*^9, 
