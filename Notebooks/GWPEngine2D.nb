  4.001073171135536*^9}},ExpressionUUID->"33a2d568-8bb1-445e-9c3f-\
4ecce038fe13"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Im", "(", 
    SubscriptBox["\[Gamma]", "t"], ")"}], "=", 
   RowBox[{
    RowBox[{"Im", "(", 
     SubscriptBox["\[Gamma]", "0"], ")"}], "+", 
    RowBox[{
     FractionBox["\[HBar]", 
      RowBox[{"4", " "}]], "ln", " ", 
     SuperscriptBox[
      RowBox[{"\[LeftBracketingBar]", 
       RowBox[{"det", "(", 
        SubscriptBox[
         StyleBox["Z",
          FontWeight->"Bold",
          FontSlant->"Plain"], "t"], ")"}], "\[RightBracketingBar]"}], 
