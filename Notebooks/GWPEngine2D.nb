+jrHdTDdMCtEGUSfur9CDUTLVTrqguhXVYn6IHrZXXWhAiAd9nu3KIjuUrA/
VQikZ19jvwOiYzm/PQDRK/4+eAyiF5geeQmiBYrLP4JovrhKxiIgbZOewASi
QwqtBMD8t7uFQPSn/E3iIHpX1A45EF20RXMFiJa0TF4FogHPla6D
  "],ExpressionUUID->"32f9e9b9-9845-4c49-a0c5-4f4a71589ffd"],

Cell["where", "Text",
 CellChangeTimes->{{4.001076814361342*^9, 
  4.001076814834903*^9}},ExpressionUUID->"5ee5fd81-ff7c-481a-9b7b-\
94eb28203f06"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["V",
     FontWeight->"Bold",
     FontSlant->"Plain"], "2"], "=", 
   RowBox[{
    FractionBox["1", "2"], "m", " ", 
    SuperscriptBox[
     StyleBox["\[CapitalOmega]",
      FontWeight->"Bold"], "2"]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGAQBmIQPTM80mPJmbeOPtVTQkD0mkDHGBCdoXI+HUQvnzyr
Giyu5dYIok0DzhYYn3vruLC5pAVEM05NbY04/9axYZtEG4jeF6AzLRpIK9Ux
