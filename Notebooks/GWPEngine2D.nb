BqIBSwu5IQ==
  "],ExpressionUUID->"816b70a7-1d23-4174-9c38-f557db9453ef"],

Cell[BoxData[
 FormBox[
  RowBox[{"\[Theta]", "=", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"atan2", "(", 
     RowBox[{
      RowBox[{
       SubsuperscriptBox["\[Omega]", "x", "2"], "-", 
       SubsuperscriptBox["\[Omega]", "y", "2"]}], ",", 
      RowBox[{"2", 
       RowBox[{"sgn", "(", 
        SubscriptBox["k", 
         RowBox[{"x", " ", "y"}]], ")"}], 
       SubsuperscriptBox["\[Omega]", 
        RowBox[{"x", " ", "y"}], "2"]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
