  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["P",
      FontWeight->"Bold",
      FontSlant->"Plain"], "~"], "t"], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "m"}], " ", 
     OverscriptBox[
      StyleBox["\[CapitalOmega]",
       FontWeight->"Bold"], "~"], 
     SubscriptBox[
      StyleBox["S",
       FontWeight->"Bold",
       FontSlant->"Plain"], "t"]}], "+", 
    RowBox[{
     SubscriptBox[
      StyleBox["C",
       FontWeight->"Bold",
       FontSlant->"Plain"], "t"], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["P",
        FontWeight->"Bold",
        FontSlant->"Plain"], "~"], "0"]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGAQAWIQPTM80mPJmbeOPtVTQkD0mkDHGBCdoXI+HUQvnzyr
Giyu5dYIok0DzhYYn3vruLC5pAVEM05NbY04/9axYZtEG4jeF6AzLRpIK9Ux
rgbRe+49PwGiBQ66XAbRfB7K10H0g8iyOyBabcXhlyB610nDVyD62qH5nDFA
+jrHdTDdMCtEGUSfur9CDUTLVTrqguhXVYn6IHrZXXWhAiA95VahMIguM1u9
vhhIH5HI2gqi57ybdRhEd3aUnQDRAhKv7oLoDer1j0F01cEOoRIgPSleQhxE
31lXqQSiZ/ibqIDoDcwpGiD6pp+iFojmCouLBNGL5wvGg2gAs0StMA==
  "],ExpressionUUID->"6db09b19-a0c6-4694-83e4-be02a0d67fee"],

Cell["We then rotate back to the lab frame ", "Text",
 CellChangeTimes->{{4.0010801037329683`*^9, 4.001080123785314*^9}, 
   4.001080208753929*^9},ExpressionUUID->"4a374e2a-d280-42a5-8a70-\
849484009f2d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["Z",
     FontWeight->"Bold",
     FontSlant->"Plain"], "t"], "=", 
   RowBox[{
    StyleBox["R",
     FontWeight->"Bold",
     FontSlant->"Plain"], " ", 
    SubscriptBox[
     OverscriptBox[
      StyleBox["Z",
       FontWeight->"Bold",
       FontSlant->"Plain"], "~"], "t"], " ", 
    SuperscriptBox[
     StyleBox["R",
      FontWeight->"Bold",
      FontSlant->"Plain"], "T"]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGAQA2IQPTM80mPJmbeOPtVTQkD0mkDHGBCdoXI+HUQvnzyr
Giyu5dYIok0DzhYYn3vruLC5pAVEM05NbY04/9axYZtEG4jeF6AzLRpIK9Ux
rgbRe+49PwGiBQ66XAbRfB7K10H0g8iyOyBabcXhlyB610nDVyD62qH5nDFA
+jrHdTDdMCtEGUSfur9CDUTLVTrqguhXVYn6IHrZXXWhAiA95VahMIguM1u9
vhhIH5HI2gqi57ybdRhEd3aUnQDRAhKv7oLoDer1j0F01cEOoRIgPSleQhxE
31lXqQSiZ/ibqIDoDcwpGiD6pp+iFoiWmaURAKJ5XgsFg2jhD28iQPSi/VNi
QPQev+0ZILo2xiYLRAMAhiW+9w==
  "],ExpressionUUID->"c34068b5-b6ae-4095-8228-18ace74ce579"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["P",
     FontWeight->"Bold",
     FontSlant->"Plain"], "t"], "=", 
   RowBox[{
    StyleBox["R",
     FontWeight->"Bold",
     FontSlant->"Plain"], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["P",
       FontWeight->"Bold",
       FontSlant->"Plain"], "~"], "t"], 
    SuperscriptBox[
     StyleBox["R",
      FontWeight->"Bold",
      FontSlant->"Plain"], "T"]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGAQBWIQPTM80mPJmbeOPtVTQkD0mkDHGBCdoXI+HUQvnzyr
Giyu5dYIok0DzhYYn3vruLC5pAVEM05NbY04/9axYZtEG4jeF6AzLRpIK9Ux
rgbRe+49PwGiBQ66XAbRfB7K10H0g8iyOyBabcXhlyB610nDVyD62qH5nDFA
+jrHdTDdMCtEGUSfur9CDUTLVTrqguhXVYn6IHrZXXWhAiA95VahMIguM1u9
vhhIH5HI2gqi57ybdRhEd3aUnQDRAhKv7oLoDer1j0F01cEOoRIgPSleQhxE
31lXqQSiZ/ibqIDoDcwpGiD6pp+iFojmCouLBNGL5wvGg+i4n97ZIPqR6Ooc
EA0A1Dq2Lg==
  "],ExpressionUUID->"f52dffd7-9ef3-4b00-899e-cdf8695b6ef2"],

Cell["and construct the shape matrix via Heller\[CloseCurlyQuote]s \
decomposition", "Text",
 CellChangeTimes->{
  4.001080214489481*^9},ExpressionUUID->"d1cbcc0c-b84a-40dd-a294-\
6e85c6d2a1c6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["A",
     FontWeight->"Bold",
     FontSlant->"Plain"], "t"], "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]"}]], 
    SubscriptBox[
     StyleBox["P",
      FontWeight->"Bold",
      FontSlant->"Plain"], "t"], 
    SubsuperscriptBox[
     StyleBox["Z",
      FontWeight->"Bold",
      FontSlant->"Plain"], "t", 
     RowBox[{"-", "1"}]]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
   3.999605770192709*^9}, {4.000422790416041*^9, 4.000422888510758*^9}, {
   4.00102361485701*^9, 4.001023631293838*^9}, {4.001026143291382*^9, 
   4.0010261437259693`*^9}, {4.001027865800858*^9, 4.001027880427754*^9}, 
   4.001028178729854*^9, 
   4.0010802359353*^9},ExpressionUUID->"425ef106-fb25-4e57-ae91-32585e560c74"],

Cell[TextData[{
 "Note that determinants are preserved by rotation, so the the determinant of \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["Z",
     FontWeight->"Bold",
     FontSlant->"Plain"], "t"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "79f2548b-63b9-4127-ad8a-dba857e234bb"],
 " can be calculated in the normal mode basis."
}], "Text",
 CellChangeTimes->{{4.001080276512383*^9, 
  4.001080327586759*^9}},ExpressionUUID->"49ee0de4-75bd-4afd-a135-\
03f2924216ac"],

Cell["\<\
Finally we need to evaluate the classical action.  Because the kinetic and \
potential energy are invariant under orthogonal coordinate rotations, the \
classical Lagrangian decomposes cleanly into the sum of the two independent \
1D normal-mode Lagrangians plus the constant equilibrium potential shift\
\>", "Text",
 CellChangeTimes->{{4.001080600375566*^9, 
  4.0010806853741083`*^9}},ExpressionUUID->"59c4b39b-a8f0-46ca-a7e1-\
6a21110a61e4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"V", "(", 
    SubscriptBox[
     StyleBox["r",
      FontWeight->"Bold",
      FontSlant->"Plain"], "eq"], ")"}], "=", 
   RowBox[{
    SubscriptBox["V", "00"], "-", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", "m"}]], 
     SubsuperscriptBox[
      OverscriptBox[
       StyleBox["V",
        FontWeight->"Bold",
        FontSlant->"Plain"], "~"], "1", "T"], 
     SuperscriptBox[
      OverscriptBox[
       StyleBox["\[CapitalOmega]",
        FontWeight->"Bold"], "~"], 
      RowBox[{"-", "2"}]], 
     SubscriptBox[
      OverscriptBox[
       StyleBox["V",
        FontWeight->"Bold",
        FontSlant->"Plain"], "~"], "1"]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
   3.999605770192709*^9}, {4.000422790416041*^9, 4.000422888510758*^9}, {
   4.00102361485701*^9, 4.001023631293838*^9}, {4.001026143291382*^9, 
   4.0010261437259693`*^9}, {4.001027865800858*^9, 4.001027880427754*^9}, 
   4.001028178729854*^9, 4.0010802359353*^9, {4.001080710488048*^9, 
   4.0010807408378553`*^9}},ExpressionUUID->"fb09a9c7-53e2-41d0-a4df-\
c9a0e6aff898"],

Cell["so that", "Text",
 CellChangeTimes->{{4.0010807442114983`*^9, 
  4.00108074682784*^9}},ExpressionUUID->"22a06d93-7625-49c7-9b97-\
6225d7100887"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["L", "t"], "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"V", "(", 
      SubscriptBox["r", "eq"], ")"}]}], "+", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k", "=", "1"}], "2"], 
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        SubsuperscriptBox[
         OverscriptBox["p", "~"], 
         RowBox[{"k", ",", "t"}], "2"], 
        RowBox[{"2", "m"}]], "-", 
       RowBox[{
        FractionBox["1", "2"], "m", " ", 
        SubsuperscriptBox["\[Omega]", "k", "2"], 
        SubsuperscriptBox[
         OverscriptBox["r", "~"], 
         RowBox[{"k", ",", "t"}], "2"]}]}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
   3.999605770192709*^9}, {4.000422790416041*^9, 4.000422888510758*^9}, {
   4.00102361485701*^9, 4.001023631293838*^9}, {4.001026143291382*^9, 
   4.0010261437259693`*^9}, {4.001027865800858*^9, 4.001027880427754*^9}, 
   4.001028178729854*^9, 4.0010802359353*^9, {4.001080710488048*^9, 
   4.001080808628808*^9}},ExpressionUUID->"c7cb4192-5f51-4c08-b42b-\
dfafc6a2c556"],

Cell["Integrate each 1D normal mode", "Text",
 CellChangeTimes->{{4.001080929692298*^9, 
  4.001080935369007*^9}},ExpressionUUID->"baa80850-f89f-4729-9344-\
5e9e5642b364"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["\[Integral]", "0", "t"], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox[
        OverscriptBox["T", "~"], "k", "2"], "-", 
       SubscriptBox[
        OverscriptBox["V", "~"], "k"]}], ")"}], 
     RowBox[{"\[DifferentialD]", 
      SuperscriptBox["t", "\[Prime]"]}]}]}], "=", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox[
        OverscriptBox["r", "~"], 
        RowBox[{"k", ",", "t"}]], 
       SubscriptBox[
        OverscriptBox["p", "~"], 
        RowBox[{"k", ",", "t"}]]}], "-", 
      RowBox[{
       SubscriptBox[
        OverscriptBox["r", "~"], 
        RowBox[{"k", ",", "0"}]], 
       SubscriptBox[
        OverscriptBox["p", "~"], 
        RowBox[{"k", ",", "0"}]]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
   3.999605770192709*^9}, {4.000422790416041*^9, 4.000422888510758*^9}, {
   4.00102361485701*^9, 4.001023631293838*^9}, {4.001026143291382*^9, 
   4.0010261437259693`*^9}, {4.001027865800858*^9, 4.001027880427754*^9}, 
   4.001028178729854*^9, 4.0010802359353*^9, {4.001080710488048*^9, 
   4.001080808628808*^9}, {4.001080966978283*^9, 
   4.0010810357272043`*^9}},ExpressionUUID->"434f9165-7406-450a-900d-\
c89b44f0b927"],

Cell["yields the exact closed-form classical action", "Text",
 CellChangeTimes->{{4.0010810481961317`*^9, 
  4.001081057897876*^9}},ExpressionUUID->"3041ece9-2c8d-4788-96f4-\
112b1e83391a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["S", "cl"], "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"V", "(", 
       SubscriptBox["r", "eq"], ")"}]}], "t"}], "+", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k", "=", "1"}], "2"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{"sin", " ", 
          RowBox[{"(", 
           RowBox[{"2", 
            SubscriptBox["\[Omega]", "k"], "t"}], ")"}]}], 
         RowBox[{"4", 
          SubscriptBox["m\[Omega]", "k"]}]], 
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox[
           OverscriptBox["p", "~"], 
           RowBox[{"k", ",", "0"}], "2"], "-", 
          RowBox[{
           SuperscriptBox["m", "2"], 
           SubsuperscriptBox["\[Omega]", "k", "2"], 
           SubsuperscriptBox[
            OverscriptBox["r", "~"], 
            RowBox[{"k", ",", "0"}], "2"]}]}], ")"}]}], "+", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"cos", 
           RowBox[{"(", 
            RowBox[{"2", 
             SubscriptBox["\[Omega]", "k"], "t"}], ")"}]}], "-", "1"}], "2"], 
        
        SubscriptBox[
         OverscriptBox["r", "~"], 
         RowBox[{"k", ",", "0"}]], 
        SubscriptBox[
         OverscriptBox["p", "~"], 
         RowBox[{"k", ",", "0"}]]}]}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
   3.999605770192709*^9}, {4.000422790416041*^9, 4.000422888510758*^9}, {
   4.00102361485701*^9, 4.001023631293838*^9}, {4.001026143291382*^9, 
   4.0010261437259693`*^9}, {4.001027865800858*^9, 4.001027880427754*^9}, 
   4.001028178729854*^9, 4.0010802359353*^9, {4.001080710488048*^9, 
   4.001080808628808*^9}, {4.001080966978283*^9, 4.0010810357272043`*^9}, {
   4.001081068355147*^9, 
   4.001081190673399*^9}},ExpressionUUID->"5ee056e6-8714-491e-9dd6-\
634d2869e196"]
}, Closed]]
}, Open  ]]
},
