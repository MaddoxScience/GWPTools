gmgANx+3uA==
  "],ExpressionUUID->"8ba72a96-ca26-4c3d-8dd6-213675e667ff"],

Cell["and the normal mode frequences are", "Text",
 CellChangeTimes->{{4.0010774261096697`*^9, 
  4.001077433590365*^9}},ExpressionUUID->"56f8e635-a621-44b5-94ff-\
fc9332027d68"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox["\[Omega]", 
    RowBox[{"1", ",", "2"}], "2"], "=", 
   RowBox[{
    FractionBox[
     RowBox[{
      SubsuperscriptBox["\[Omega]", "x", "2"], "+", 
      SubsuperscriptBox["\[Omega]", "y", "2"]}], "2"], "\[PlusMinus]", 
    SqrtBox[
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox[
         RowBox[{
          SubsuperscriptBox["\[Omega]", "x", "2"], "-", 
          SubsuperscriptBox["\[Omega]", "y", "2"]}], "2"], ")"}], "2"], "+", 
      SubsuperscriptBox["\[Omega]", 
       RowBox[{"x", " ", "y"}], "4"]}]]}]}], 
  TraditionalForm]], "DisplayFormula",
