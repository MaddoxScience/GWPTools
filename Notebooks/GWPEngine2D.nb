   RowBox[{
    SubscriptBox[
     StyleBox["P",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"], "=", " ", 
    RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]", " ", 
