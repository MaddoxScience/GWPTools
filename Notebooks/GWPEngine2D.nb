Cell["such that", "Text",
 CellChangeTimes->{{4.001077349033763*^9, 
  4.0010773551054783`*^9}},ExpressionUUID->"3fcc1b3f-2ef4-453d-9365-\
82171bdf7e80"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox[
     StyleBox["R",
      FontWeight->"Bold",
      FontSlant->"Plain"], "T"], 
    SuperscriptBox[
     StyleBox["\[CapitalOmega]",
      FontWeight->"Bold"], "2"], 
    StyleBox["R",
     FontWeight->"Bold",
     FontSlant->"Plain"]}], "=", 
   RowBox[{
    SuperscriptBox[
     OverscriptBox[
      StyleBox["\[CapitalOmega]",
       FontWeight->"Bold"], "~"], "2"], "=", 
    RowBox[{"(", GridBox[{
       {
        SubsuperscriptBox["\[Omega]", "1", "2"], "0"},
       {"0", 
        SubsuperscriptBox["\[Omega]", "2", "2"]}
      }], ")"}]}]}], TraditionalForm]], "DisplayFormula",
