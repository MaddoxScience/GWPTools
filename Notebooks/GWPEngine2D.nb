  4.001030523046254*^9}},ExpressionUUID->"3e7d32fb-6c8d-492a-86c0-\
56f291b88480"]
}, Closed]],

Cell[CellGroupData[{

Cell["Linear potential", "Section",
 CellChangeTimes->{{4.001071460004541*^9, 
  4.00107146687033*^9}},ExpressionUUID->"83481a5f-0cab-4c15-bcb5-\
fd71aa65b0ad"],

Cell[TextData[{
 "For a time-dependent linear potential surface, the quadratic curvature \
matrix vanishes (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["V",
      FontWeight->"Bold",
      FontSlant->"Plain"], "2"], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1210c0af-93eb-49f3-9fbb-b03e4b57f88a"],
 "), while the scalar offset ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "0"], "=", 
    SubscriptBox["V", "00"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "81001765-2d90-445e-94e3-571f3f10530e"],
 " and the linear gradient vector ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["V",
      FontWeight->"Bold",
      FontSlant->"Plain"], "1"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["V", "10"], ",", 
       SubscriptBox["V", "01"]}], ")"}], "T"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5d75b437-980d-4525-bbfd-122bb8466433"],
 " are constant"
}], "Text",
 CellChangeTimes->{{4.001074442402155*^9, 
  4.0010745460175047`*^9}},ExpressionUUID->"c9fec115-c3bf-47ee-a9aa-\
ae0ee5bdcff2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"V", "(", 
    StyleBox["r",
     FontWeight->"Bold",
     FontSlant->"Plain"], ")"}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["V", "00"], "+", 
     RowBox[{
      SubsuperscriptBox[
       StyleBox["V",
        FontWeight->"Bold",
        FontSlant->"Plain"], "1", "T"], 
      StyleBox["r",
       FontWeight->"Bold",
       FontSlant->"Plain"]}]}], "=", 
    RowBox[{
     SubscriptBox["V", "00"], "+", 
     RowBox[{
      SubscriptBox["V", "10"], "x"}], "+", 
     RowBox[{
      SubscriptBox["V", "01"], "y"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422790416041*^9, 4.000422947641068*^9}, {
  4.001023019174439*^9, 4.001023024772278*^9}, {4.001029297384856*^9, 
  4.001029464046647*^9}, {4.0010297032459393`*^9, 4.001029786148567*^9}, {
  4.0010298171025457`*^9, 4.001029859698471*^9}, {4.001029966114276*^9, 
  4.001029969555875*^9}, {4.0010302209925337`*^9, 4.001030222719829*^9}, {
  4.00103042664386*^9, 4.001030453277318*^9}, {4.001030506046035*^9, 
  4.001030523046254*^9}, {4.0010745538842087`*^9, 
  4.001074579984767*^9}},ExpressionUUID->"bfdc0d01-05dc-426e-8a5c-\
35b099f0e457"],

Cell[TextData[{
 "This potential exerts a uniform, constant classical force ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["F",
     FontWeight->"Bold",
     FontSlant->"Plain"], "=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"\[Del]", 
       RowBox[{"V", "(", 
        StyleBox["r",
         FontWeight->"Bold",
         FontSlant->"Plain"], ")"}]}]}], "=", 
     RowBox[{"-", 
      SubscriptBox[
       StyleBox["V",
        FontWeight->"Bold",
        FontSlant->"Plain"], "1"]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "254e04e1-faaa-459e-aaf5-b980f5980ae2"],
 " across the entire xy-plane."
}], "Text",
 CellChangeTimes->{{4.0010746327408648`*^9, 
  4.001074691949226*^9}},ExpressionUUID->"a453b3a0-98cb-4c4b-8717-\
f611a1b9680a"],

Cell["The classical trajectory equations become", "Text",
 CellChangeTimes->{{4.001074706325437*^9, 
  4.001074715314723*^9}},ExpressionUUID->"9382358b-4cff-4a8a-9486-\
2a7b9d8ed522"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["r",
      FontWeight->"Bold",
      FontSlant->"Plain"], "."], "t"], "=", 
   FractionBox[
    SubscriptBox[
     StyleBox["p",
      FontWeight->"Bold",
      FontSlant->"Plain"], "t"], "m"]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
