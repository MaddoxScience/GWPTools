Notebook[{

Cell[CellGroupData[{
Cell["GWPEngine2D Theory Reference ", "Title",
 CellChangeTimes->{{4.001661701486515*^9, 4.001661702075182*^9}, {
   4.0016617668416967`*^9, 4.0016617702113113`*^9}, 4.00166180780577*^9, {
   4.0016618445306273`*^9, 
   4.001661855190873*^9}},ExpressionUUID->"615cbe16-8974-4361-a638-\
1d2b6080bd41"],

Cell["Jeremy B. Maddox", "Author",
 CellChangeTimes->{{3.988201532003448*^9, 
  3.988201536787407*^9}},ExpressionUUID->"d5294f40-1ad0-4b97-bc0c-\
8f4e62688cd6"],

Cell["\<\
Department of Chemistry and Biochemistry
Western Kentucky University
Bowling Green, KY 42101-1079
Email: jeremy.maddox@wku.edu\
\>", "Affiliation",
 CellChangeTimes->{{3.988201549259402*^9, 
  3.988201579115401*^9}},ExpressionUUID->"2982fcb3-026c-4d80-a1f3-\
a82b85865bf9"],

Cell["\<\
This technical reference documents GWPEngine2D, the two-dimensional Gaussian \
wave packet propagation engine for the GWPTools framework. Extending the \
one-dimensional formalism to higher-dimensional systems requires replacing \
scalar kinematics with a coupled vector\[Dash]matrix representation governed \
by a two-by-two complex symmetric shape matrix, classical center-of-mass \
position and momentum vectors, and a spatially independent complex global \
phase. We present the general theoretical formulation for wave packet \
evolution on locally quadratic bivariate potential energy surfaces, detailing \
the nonlinear matrix Riccati equation for the complex shape matrix, its \
symplectic linearization via Heller\[CloseCurlyQuote]s complex stability \
matrices, and the exact integration of the quantum Maslov\[Dash]Gouy and \
normalization phases through Jacobi\[CloseCurlyQuote]s determinant identity. \
Building on this general framework, we derive and catalog the explicit \
closed-form analytical propagators implemented in GWPEngine2D for three \
foundational two-dimensional benchmark models: the free particle, the uniform \
linear potential, and the anisotropic coupled harmonic oscillator.\
\>", "Text",
 CellChangeTimes->{
  4.002384300292552*^9},ExpressionUUID->"9735a1e4-a192-441b-b755-\
93f4d70a9f68"],

Cell[CellGroupData[{

Cell["Theoretical Framework: 2D Gaussian Wave Packets", "Section",
 CellChangeTimes->{{4.000997238575883*^9, 4.0009972394664183`*^9}, {
   4.0023840406443644`*^9, 4.002384061683766*^9}, 
   4.002384118034391*^9},ExpressionUUID->"d02e1fb3-4372-4ed9-95a6-\
78c28706b2e0"],

Cell[CellGroupData[{

Cell["The 2D Vector-Matrix Wave Packet Ansatz", "Subsection",
 CellChangeTimes->{{4.002381566709901*^9, 4.002381586732395*^9}, {
  4.002385161761437*^9, 
  4.002385162198985*^9}},ExpressionUUID->"24149a61-f8fe-4355-9d23-\
1ab627a6ee99"],

Cell["\<\
Transitioning to higher-dimensional systems requires upgrading the scalar \
wave packet parameters into a generalized vector-matrix formulation. In two \
dimensions, the generalized wave packet ansatz is expressed as\
\>", "Text",
 CellChangeTimes->{
  3.999605582729249*^9, {4.0010000074797153`*^9, 4.001000038971015*^9}, {
   4.0023816104255447`*^9, 
   4.002381617992288*^9}},ExpressionUUID->"c610708d-b684-4db2-b326-\
cdc25caa9dc8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[CapitalPsi]", "(", 
    RowBox[{
     StyleBox["r",
      FontWeight->"Bold",
      FontSlant->"Plain"], ",", "t"}], ")"}], "=", 
   RowBox[{"N", " ", 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           StyleBox["r",
            FontWeight->"Bold",
            FontSlant->"Plain"], "-", 
           SubscriptBox[
            StyleBox["r",
             FontWeight->"Bold",
             FontSlant->"Plain"], "t"]}], ")"}], "T"]}], 
       RowBox[{
        SubscriptBox[
         StyleBox["A",
          FontWeight->"Bold",
          FontSlant->"Plain"], "t"], "(", 
        RowBox[{
         StyleBox["r",
          FontWeight->"Bold",
          FontSlant->"Plain"], "-", 
         SubscriptBox[
          StyleBox["r",
           FontWeight->"Bold",
           FontSlant->"Plain"], "t"]}], ")"}]}], "+", 
      RowBox[{
       FractionBox["\[ImaginaryI]", "\[HBar]"], 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["p",
          FontWeight->"Bold",
          FontSlant->"Plain"], "t", "T"], "(", 
        RowBox[{
         StyleBox["r",
          FontWeight->"Bold",
          FontSlant->"Plain"], "-", 
         SubscriptBox[
          StyleBox["r",
           FontWeight->"Bold",
           FontSlant->"Plain"], "t"]}], ")"}]}], "+", 
      RowBox[{
       FractionBox["\[ImaginaryI]", "\[HBar]"], 
       SubscriptBox["\[Gamma]", "t"]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}},ExpressionUUID->"344d64e0-62b4-4332-8ea5-\
9277bddf5cfb"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["r",
     FontWeight->"Bold",
     FontSlant->"Plain"], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"x", ",", "y"}], ")"}], "T"]}], TraditionalForm]],
  ExpressionUUID->"4af602c2-cbf0-42f7-87b6-8a933fad4e91"],
 " is the coordinate vector, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["r",
     FontWeight->"Bold",
     FontSlant->"Plain"], "t"], TraditionalForm]],ExpressionUUID->
  "cde522c3-2477-403b-ad9d-c031dd8142c6"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["p",
     FontWeight->"Bold",
     FontSlant->"Plain"], "t"], TraditionalForm]],ExpressionUUID->
  "8e76e5fa-d5dd-4bd9-810d-96d1f2d56dbb"],
 " are the classical position and momentum vectors, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "t"], TraditionalForm]],ExpressionUUID->
  "297233c2-554d-4b6f-a116-c0a820546bd0"],
 " is the complex-valued spatially independent phase. "
}], "Text",
 CellChangeTimes->{
  3.99960559401572*^9, {3.99960582456775*^9, 3.9996059434127007`*^9}, 
   4.000421378009276*^9, {4.001012361352784*^9, 4.001012362062683*^9}, {
   4.001012763468391*^9, 4.001012869160474*^9}, {4.001023088149819*^9, 
   4.001023141427725*^9}, 
   4.002381648285883*^9},ExpressionUUID->"5a9dabb6-4f1a-4395-a774-\
ade499f4da34"],

Cell[TextData[{
 "The spatial geometry, orientation, and phase-front curvature of the wave \
packet are encoded in the  2\[Times]2 complex symmetric shape matrix ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["A",
     FontWeight->"Bold",
     FontSlant->"Plain"], "t"], TraditionalForm]],ExpressionUUID->
  "5e5c2a26-76c3-496a-b233-c5a0e94ce87e"],
 ":"
}], "Text",
 CellChangeTimes->{{4.002381650477496*^9, 
  4.0023817391861467`*^9}},ExpressionUUID->"a8d26f29-ed0b-43c0-8e8d-\
47aac7745dc9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["A",
     FontWeight->"Bold",
     FontSlant->"Plain"], "t"], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Re", "(", 
      SubscriptBox[
       StyleBox["A",
        FontWeight->"Bold",
        FontSlant->"Plain"], "t"], ")"}], "+", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"Im", "(", 
       SubscriptBox[
        StyleBox["A",
         FontWeight->"Bold",
         FontSlant->"Plain"], "t"], ")"}]}]}], "=", 
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["\[Alpha]", 
         RowBox[{
          RowBox[{"x", " ", "x"}], ",", "t"}]], 
        SubscriptBox["\[Alpha]", 
         RowBox[{
          RowBox[{"x", " ", "y"}], ",", "t"}]]},
       {
        SubscriptBox["\[Alpha]", 
         RowBox[{
          RowBox[{"x", " ", "y"}], ",", "t"}]], 
        SubscriptBox["\[Alpha]", 
         RowBox[{
          RowBox[{"y", " ", "y"}], ",", "t"}]]}
      }], ")"}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.001012885150004*^9, 
  4.001012968405662*^9}},ExpressionUUID->"1feea77f-47fb-47c0-8775-\
9e7c1d0c3e76"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", 
    RowBox[{
     RowBox[{"x", " ", "x"}], ",", "t"}]], TraditionalForm]],ExpressionUUID->
  "92326eee-bfc6-4776-bb13-3b3febeb588c"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", 
    RowBox[{
     RowBox[{"y", " ", "y"}], ",", "t"}]], TraditionalForm]],ExpressionUUID->
  "93418e48-f9f5-48bb-a565-999331e0c123"],
 " govern the marginal widths and chirps along ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1c1821cb-917c-481d-8fe3-ff3a84f62a20"],
 " and ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f79acd09-3de0-440b-a078-8d37377d2ba2"],
 ", while the off-diagonal cross-term ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", 
    RowBox[{
     RowBox[{"x", " ", "y"}], ",", "t"}]], TraditionalForm]],ExpressionUUID->
  "dc0d1354-5f69-424d-bc99-18edd3ed0e78"],
 " controls spatial rotation and inter-mode coupling."
}], "Text",
 CellChangeTimes->{{4.002381736136546*^9, 
  4.002381798704681*^9}},ExpressionUUID->"aaefa9a7-8603-44b4-9d85-\
7beee929391d"],

Cell[TextData[{
 "The real component of the shape matrix, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Re", "(", 
    SubscriptBox[
     StyleBox["A",
      FontWeight->"Bold",
      FontSlant->"Plain"], "t"], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
   3.999605770192709*^9}, {4.001012885150004*^9, 4.001012968405662*^9}},
  ExpressionUUID->"2a5b7d88-9fd7-4d63-9022-a51291addd96"],
 ", governs the spatial probability density ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Rho]", "(", 
     RowBox[{
      StyleBox["r",
       FontWeight->"Bold",
       FontSlant->"Plain"], ",", "t"}], ")"}], "=", 
    SuperscriptBox[
     RowBox[{"\[LeftBracketingBar]", 
      RowBox[{"\[CapitalPsi]", "(", 
       RowBox[{
        StyleBox["r",
         FontWeight->"Bold",
         FontSlant->"Plain"], ",", "t"}], ")"}], "\[RightBracketingBar]"}], 
     "2"]}], TraditionalForm]],ExpressionUUID->
  "695514e4-a6a1-4640-87f0-d7927b2487cc"],
 ".  For the wave packet to remain square-integrable over ",
 Cell[BoxData[
  SuperscriptBox[
   TemplateBox[{},
    "Reals"], "2"]],ExpressionUUID->"e3338cb7-15ce-4b04-84d6-048160200a24"],
 ",  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Re", "(", 
    SubscriptBox[
     StyleBox["A",
      FontWeight->"Bold",
      FontSlant->"Plain"], "t"], ")"}], TraditionalForm]],
  CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
   3.999605770192709*^9}, {4.001012885150004*^9, 4.001012968405662*^9}},
  ExpressionUUID->"8a546d80-af68-403a-b196-b0a240309a5e"],
 " must be strictly positive definite (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Re", "(", 
     SubscriptBox["\[Alpha]", 
      RowBox[{
       RowBox[{"x", " ", "x"}], ",", "0"}]], ")"}], ">", "0"}], 
   TraditionalForm]],ExpressionUUID->"cd4822cc-d711-4750-bc72-5aba319f19cc"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Re", "(", 
     SubscriptBox["\[Alpha]", 
      RowBox[{
       RowBox[{"y", " ", "y"}], ",", "0"}]], ")"}], ">", "0"}], 
   TraditionalForm]],ExpressionUUID->"79f5e276-8f72-4896-97e0-3eeaef8d9ae8"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"det", "(", 
     RowBox[{"Re", "(", 
      SubscriptBox[
       StyleBox["A",
        FontWeight->"Bold",
        FontSlant->"Plain"], "0"], ")"}], ")"}], ">", "0"}], TraditionalForm]],
  CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
   3.999605770192709*^9}, {4.00100012805063*^9, 4.0010001994096003`*^9}},
  ExpressionUUID->"0e2906d0-f8c2-4ca4-8f7c-46c686e54c08"],
 ").  Under this condition, the spatial covariance matrix ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["\[CapitalSigma]",
     FontWeight->"Bold"], "t"], TraditionalForm]],ExpressionUUID->
  "4ed3f35a-a313-4bf0-b91e-0f14b5a9358e"],
 " is obtained algebraically by matrix inversion:"
}], "Text",
 CellChangeTimes->{
  3.999605606706401*^9, {3.999605950434065*^9, 3.999605964978314*^9}, {
   4.00101259501187*^9, 4.0010126008445463`*^9}, {4.001012980318935*^9, 
   4.001013082503072*^9}, {4.001013144952957*^9, 4.0010132946113358`*^9}, {
   4.0010133419627867`*^9, 4.001013358494191*^9}, {4.0010229456153173`*^9, 
   4.0010229567105017`*^9}, {4.001023159319251*^9, 4.001023161625592*^9}, {
   4.0023818141057043`*^9, 
   4.002381871392646*^9}},ExpressionUUID->"41c364ab-86a9-4bdd-8286-\
3cd1e667a8a7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["\[CapitalSigma]",
     FontWeight->"Bold"], "t"], "=", 
   RowBox[{
    RowBox[{"(", GridBox[{
       {
        SubsuperscriptBox["\[Sigma]", 
         RowBox[{"x", ",", "t"}], "2"], 
        SubscriptBox[
         RowBox[{"Cov", "(", 
          RowBox[{"x", ",", "y"}], ")"}], "t"]},
       {
        RowBox[{"Cov", 
         SubscriptBox[
          RowBox[{"(", 
           RowBox[{"x", ",", "y"}], ")"}], "t"]}], 
        SubsuperscriptBox["\[Sigma]", 
         RowBox[{"y", ",", "t"}], "2"]}
      }], ")"}], "=", 
    RowBox[{
     FractionBox["1", "4"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"Re", "(", 
        SubscriptBox[
         StyleBox["A",
          FontWeight->"Bold",
          FontSlant->"Plain"], "t"], ")"}], ")"}], 
      RowBox[{"-", "1"}]]}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605672995214*^9, 
  3.999605701371745*^9}, {4.0010126106653976`*^9, 4.0010126133978033`*^9}, {
  4.001013373481052*^9, 
  4.0010134424426193`*^9}},ExpressionUUID->"21b19f66-496c-4f4a-af81-\
07550ad2710a"],

Cell[TextData[{
 "The time-independent normalization constant ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c97d0754-e2e7-41b5-89af-71b809dbf029"],
 " is fixed by the initial state parameters at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "48ec2742-f114-4fbd-8349-8f7453fbe098"]
}], "Text",
 CellChangeTimes->{{4.001000112279173*^9, 4.001000121448825*^9}, {
  4.0010134624151506`*^9, 4.0010134795945177`*^9}, {4.0023818822009563`*^9, 
  4.0023819111190557`*^9}},ExpressionUUID->"7dede11d-7c10-49ff-8f9a-\
780c0f3d26a5"],

Cell[BoxData[
 FormBox[
  RowBox[{"N", "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{"4", 
        RowBox[{"det", "(", 
         RowBox[{"Re", "(", 
          SubscriptBox[
           StyleBox["A",
            FontWeight->"Bold",
            FontSlant->"Plain"], "0"], ")"}], ")"}]}], 
       SuperscriptBox["\[Pi]", "2"]], ")"}], 
     RowBox[{"1", "/", "4"}]], 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      FractionBox["1", "\[HBar]"], 
      RowBox[{"Im", "(", 
       SubscriptBox["\[Gamma]", "0"], ")"}]}]]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.00100012805063*^9, 
  4.0010001994096003`*^9}},ExpressionUUID->"2aadf3f8-b444-40a3-855d-\
6559033b6252"]
}, Closed]],

Cell[CellGroupData[{

Cell["Two-Dimensional Quadratic Potential Energy Surface", "Subsection",
 CellChangeTimes->{{4.002381938602129*^9, 
  4.0023819502565117`*^9}},ExpressionUUID->"786018dd-8361-457c-8677-\
9e21cc749324"],

Cell["\<\
We consider a general time-dependent, locally quadratic potential surface \
written in matrix-vector form as\
\>", "Text",
 CellChangeTimes->{{4.0004224426490726`*^9, 4.0004224720100613`*^9}, {
  4.000422569858614*^9, 4.0004225866362753`*^9}, {4.001012408609352*^9, 
  4.001012439009881*^9}, {4.002381955102519*^9, 
  4.0023819779285383`*^9}},ExpressionUUID->"5fe95f8c-035d-4db8-8ff6-\
998a9aeab3b3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"V", "(", 
    RowBox[{
     StyleBox["r",
      FontWeight->"Bold",
      FontSlant->"Plain"], ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["V", "00"], "(", "t", ")"}], "+", 
    RowBox[{
     RowBox[{
      SubsuperscriptBox[
       StyleBox["V",
        FontWeight->"Bold",
        FontSlant->"Plain"], "1", "T"], "(", "t", ")"}], 
     StyleBox["r",
      FontWeight->"Bold",
      FontSlant->"Plain"]}], "+", 
    RowBox[{
     SuperscriptBox[
      StyleBox["r",
       FontWeight->"Bold",
       FontSlant->"Plain"], "T"], 
     RowBox[{
      SubscriptBox[
       StyleBox["V",
        FontWeight->"Bold",
        FontSlant->"Plain"], "2"], "(", "t", ")"}], 
     StyleBox["r",
      FontWeight->"Bold",
      FontSlant->"Plain"]}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
   3.999605770192709*^9}, {4.000422597705011*^9, 4.0004226201274853`*^9}, {
   4.001012021168993*^9, 4.0010120298613653`*^9}, 
   4.00102299192971*^9},ExpressionUUID->"1155d481-2fee-4043-8503-\
036c50fecf2b"],

Cell["with the corresponding local restoring force", "Text",
 CellChangeTimes->{{4.001023284858498*^9, 4.0010232869051523`*^9}, {
  4.002381987990991*^9, 
  4.002381993909095*^9}},ExpressionUUID->"56808354-046d-49b0-8e9f-\
db3283c74b1d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox["F",
     FontWeight->"Bold",
     FontSlant->"Plain"], "(", 
    RowBox[{
     StyleBox["r",
      FontWeight->"Bold",
      FontSlant->"Plain"], ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"\[Del]", 
      RowBox[{"V", "(", 
       RowBox[{
        StyleBox["r",
         FontWeight->"Bold",
         FontSlant->"Plain"], ",", "t"}], ")"}]}]}], "=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{
       SubscriptBox[
        StyleBox["V",
         FontWeight->"Bold",
         FontSlant->"Plain"], "1"], "(", "t", ")"}]}], "-", 
     RowBox[{"2", 
      RowBox[{
       SubscriptBox[
        StyleBox["V",
         FontWeight->"Bold",
         FontSlant->"Plain"], "2"], "(", "t", ")"}], 
      StyleBox["r",
       FontWeight->"Bold",
       FontSlant->"Plain"]}]}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
   3.999605770192709*^9}, {4.000422597705011*^9, 4.0004226201274853`*^9}, {
   4.001012021168993*^9, 4.0010120298613653`*^9}, 4.00102299192971*^9, {
   4.0010232936861467`*^9, 
   4.0010233328574743`*^9}},ExpressionUUID->"4c0f17f2-46ab-44cf-a5b0-\
ebf73b0d1518"],

Cell[TextData[{
 "Here ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "00"], "(", "t", ")"}], TraditionalForm]],
  ExpressionUUID->"fd40aa34-48d7-48bd-843c-21612e5e0e28"],
 " is the scalar potential offset, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["V",
      FontWeight->"Bold",
      FontSlant->"Plain"], "1"], "(", "t", ")"}], TraditionalForm]],
  CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
   3.999605770192709*^9}, {4.000422597705011*^9, 4.0004226201274853`*^9}, {
   4.001012021168993*^9, 4.0010120298613653`*^9}},ExpressionUUID->
  "06f8cf04-a7d3-4a6a-88b3-2e87ec8040e5"],
 " is the linear gradient vector"
}], "Text",
 CellChangeTimes->{{4.001012004913226*^9, 4.0010120141890583`*^9}, {
  4.001013493438381*^9, 4.0010135363218927`*^9}, {4.001013567002822*^9, 
  4.001013567593649*^9}, {4.001014406186904*^9, 4.001014516117271*^9}, {
  4.00101468089563*^9, 4.001014698553543*^9}, {4.0010229974935093`*^9, 
  4.0010229974935913`*^9}, {4.0023819999815474`*^9, 
  4.0023820004421167`*^9}},ExpressionUUID->"a3d134e3-2b33-432f-983b-\
fa8a618a3d35"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["V",
      FontWeight->"Bold",
      FontSlant->"Plain"], "1"], "(", "t", ")"}], "=", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{
        SubscriptBox["V", "10"], "(", "t", ")"}]},
      {
       RowBox[{
        SubscriptBox["V", "01"], "(", "t", ")"}]}
     }], ")"}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422597705011*^9, 4.0004226201274853`*^9}, {
  4.001012021168993*^9, 4.0010120298613653`*^9}, {4.0010147046306677`*^9, 
  4.001014725417163*^9}},ExpressionUUID->"ea642c0c-55ff-433a-bcab-\
c5be55acf444"],

Cell[TextData[{
 "and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["V",
      FontWeight->"Bold",
      FontSlant->"Plain"], "2"], "(", "t", ")"}], TraditionalForm]],
  CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
   3.999605770192709*^9}, {4.000422597705011*^9, 4.0004226201274853`*^9}, {
   4.001012021168993*^9, 4.0010120298613653`*^9}},ExpressionUUID->
  "7bac1518-f57a-4ed8-88d4-2df7c22a0c2c"],
 " is symmetric ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]],ExpressionUUID->
  "4e638ad3-8755-4a24-af04-40fea0a898cf"],
 " quadratic curvature (Hessian) matrix:"
}], "Text",
 CellChangeTimes->{{4.001014684880392*^9, 4.001014688505167*^9}, {
  4.001014728264325*^9, 4.001014728742384*^9}, {4.002382015977528*^9, 
  4.00238202198348*^9}},ExpressionUUID->"299921ef-16e5-43a5-bfb4-\
c6eb32803484"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     StyleBox["V",
      FontWeight->"Bold",
      FontSlant->"Plain"], "2"], "(", "t", ")"}], "=", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{
        SubscriptBox["V", "20"], "(", "t", ")"}], 
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{
         SubscriptBox["V", "11"], "(", "t", ")"}]}]},
      {
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{
         SubscriptBox["V", "11"], "(", "t", ")"}]}], 
       RowBox[{
        SubscriptBox["V", "02"], "(", "t", ")"}]}
     }], ")"}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422597705011*^9, 4.0004226201274853`*^9}, {
  4.001012021168993*^9, 4.0010120298613653`*^9}, {4.0010147046306677`*^9, 
  4.0010147738151493`*^9}},ExpressionUUID->"39bf2a98-705c-4ae8-ab72-\
9665f4e951cb"],

Cell["\<\
Expanding the quadratic form yields the explicit polynomial potential used by \
the GWPEngine2D parameter bus:\
\>", "Text",
 CellChangeTimes->{
  4.00101469299117*^9, {4.002382044449216*^9, 
   4.002382068445484*^9}},ExpressionUUID->"714f90bf-18bd-4d4d-b60f-\
e67e77d0cbd8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"V", "(", 
    RowBox[{"x", ",", "y", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["V", "00"], "(", "t", ")"}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["V", "10"], "(", "t", ")"}], "x"}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["V", "01"], "(", "t", ")"}], "y"}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["V", "20"], "(", "t", ")"}], 
     SuperscriptBox["x", "2"]}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["V", "02"], "(", "t", ")"}], 
     SuperscriptBox["y", "2"]}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["V", "11"], "(", "t", ")"}], "x", " ", "y"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422597705011*^9, 4.0004226201274853`*^9}, {
  4.001012021168993*^9, 4.0010120298613653`*^9}, {4.001014527583581*^9, 
  4.0010146076185102`*^9}},ExpressionUUID->"10b46b41-d601-41ae-96fb-\
dd8461633d3c"]
}, Closed]],

Cell[CellGroupData[{

Cell["Coupled Matrix-Vector Equations of Motion", "Subsection",
 CellChangeTimes->{{4.00238208241984*^9, 
  4.002382089719006*^9}},ExpressionUUID->"b428016b-fb24-4d0b-a888-\
e55d1ca74a9c"],

Cell[TextData[{
 "Substituting the 2D ansatz into the TDSE and matching powers of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     StyleBox["r",
      FontWeight->"Bold",
      FontSlant->"Plain"], "-", 
     SubscriptBox[
      StyleBox["r",
       FontWeight->"Bold",
       FontSlant->"Plain"], "t"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "6373a921-9aef-45d6-90d5-e54ac50195ea"],
 " yields the coupled dynamical equations for the classical the complex shape \
matrix, and the complex phase:"
}], "Text",
 CellChangeTimes->{
  4.000422579407434*^9, {4.000422653530506*^9, 4.000422765083612*^9}, {
   4.001012397431826*^9, 4.001012411366506*^9}, {4.00101244704954*^9, 
   4.001012454324355*^9}, {4.001014793265346*^9, 4.001014903610697*^9}, {
   4.002382101519393*^9, 
   4.002382156945418*^9}},ExpressionUUID->"0dd27fff-f9f7-46ad-8081-\
a669dca53be1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["r",
      FontWeight->"Bold",
      FontSlant->"Plain"], "."], "t"], "=", 
   FractionBox[
    SubscriptBox[
     StyleBox["p",
      FontWeight->"Bold",
      FontSlant->"Plain"], "t"], "m"]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422790416041*^9, 
  4.0004228071103287`*^9}},ExpressionUUID->"29957af6-5d31-4b36-92d7-\
2f672f5777b5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["p",
      FontWeight->"Bold",
      FontSlant->"Plain"], "."], "t"], "=", 
   RowBox[{
    RowBox[{"-", 
     SubscriptBox[
      StyleBox["V",
       FontWeight->"Bold",
       FontSlant->"Plain"], "1"]}], "-", 
    RowBox[{"2", 
     SubscriptBox[
      StyleBox["V",
       FontWeight->"Bold",
       FontSlant->"Plain"], "2"], 
     SubscriptBox[
      StyleBox["r",
       FontWeight->"Bold",
       FontSlant->"Plain"], "t"]}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422790416041*^9, 
  4.0004228306632977`*^9}},ExpressionUUID->"24b8cebf-0d6b-4abc-8257-\
997320559037"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["A",
      FontWeight->"Bold",
      FontSlant->"Plain"], "."], "t"], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]"}], "m"]}], 
     SubsuperscriptBox[
      StyleBox["A",
       FontWeight->"Bold",
       FontSlant->"Plain"], "t", "2"]}], "+", 
    RowBox[{
     FractionBox["\[ImaginaryI]", "\[HBar]"], 
     SubscriptBox[
      StyleBox["V",
       FontWeight->"Bold",
       FontSlant->"Plain"], "2"]}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422790416041*^9, 
  4.000422888510758*^9}},ExpressionUUID->"b85d44c4-d3e5-432a-89b0-\
6a341cf9827e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    OverscriptBox["\[Gamma]", "."], "t"], "=", 
   RowBox[{
    FractionBox[
     RowBox[{
      SubsuperscriptBox[
       StyleBox["p",
        FontWeight->"Bold",
        FontSlant->"Plain"], "t", "T"], 
      SubscriptBox[
       StyleBox["p",
        FontWeight->"Bold",
        FontSlant->"Plain"], "t"]}], 
     RowBox[{"2", "m"}]], "-", 
    RowBox[{"V", "(", 
     SubscriptBox[
      StyleBox["r",
       FontWeight->"Bold",
       FontSlant->"Plain"], "t"], ")"}], "-", 
    RowBox[{
     FractionBox[
      SuperscriptBox["\[HBar]", "2"], "m"], 
     RowBox[{"Tr", "(", 
      SubscriptBox[
       StyleBox["A",
        FontWeight->"Bold",
        FontSlant->"Plain"], "t"], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422790416041*^9, 4.000422947641068*^9}, {
  4.001023019174439*^9, 
  4.001023024772278*^9}},ExpressionUUID->"884d2b17-b92f-4254-b542-\
c70373d75ddf"],

Cell[TextData[{
 "Here the classical centers follow Newton\[CloseCurlyQuote]s equations of \
motion under the instantaneous local force ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["F",
     FontWeight->"Bold",
     FontSlant->"Plain"], "(", 
    RowBox[{
     SubscriptBox[
      StyleBox["r",
       FontWeight->"Bold",
       FontSlant->"Plain"], "t"], ",", "t"}], ")"}], TraditionalForm]],
  ExpressionUUID->"3488321b-fd21-438f-a06f-591dff7be864"],
 ".  The complex shape matrix evolves via a symmetric ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5d7320ba-2cbc-49b4-bc61-bafbe50e1271"],
 " matrix Riccati differential equation driven by the Hessian matrix. The \
complex phase rate combines the classical Lagrangian (first two terms) with \
the complex quantum zero-point/spreading trace term.  Its real part \
accumulates the classical action and the Maslov-Guoy phase, while its \
imaginary part dynamically adjusts to preserve the unit normalization for all \
",
 Cell[BoxData[
  FormBox["t", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "083825fa-1f70-4841-a83d-7ccbf96db17d"],
 "."
}], "Text",
 CellChangeTimes->{{4.0010232632742767`*^9, 4.001023278791849*^9}, {
  4.001023365608466*^9, 4.001023509960206*^9}, {4.002382183333828*^9, 
  4.002382363275703*^9}},ExpressionUUID->"3e60047c-77ef-4b90-988c-\
7c9d38acd2bc"]
}, Closed]],

Cell[CellGroupData[{

Cell["Symplectic Linearization via Heller\[CloseCurlyQuote]s Stability \
Matrices", "Subsection",
 CellChangeTimes->{{4.0023823730249662`*^9, 
  4.002382390389196*^9}},ExpressionUUID->"aa911747-e066-4a87-a178-\
9760ae5bffe4"],

Cell[TextData[{
 "To linearize the nonlinear matrix Riccati equation for the shape matrix, we \
introduce Heller\[CloseCurlyQuote]s ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Times]", "2"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1170e4b1-c785-4901-9d21-7083606cbb67"],
 " complex stability (Jacobi) matrices ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["Z",
     FontWeight->"Bold",
     FontSlant->"Plain"], "t"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ed2ac059-1780-43df-a8cb-62ff04a3daa5"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["P",
     FontWeight->"Bold",
     FontSlant->"Plain"], "t"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2f1ad5d1-e9da-4e4f-84b6-2e0b791dbd5e"],
 " via the factorization"
}], "Text",
 CellChangeTimes->{{4.0010235343553267`*^9, 4.00102359891651*^9}, {
  4.00238239970011*^9, 
  4.002382485856984*^9}},ExpressionUUID->"aaa876d8-2dc9-4141-9f7c-\
5c74beb6914c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["A",
     FontWeight->"Bold",
     FontSlant->"Plain"], "t"], "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]"}]], 
    SubscriptBox[
     StyleBox["P",
      FontWeight->"Bold",
      FontSlant->"Plain"], "t"], 
    SubsuperscriptBox[
     StyleBox["Z",
      FontWeight->"Bold",
      FontSlant->"Plain"], "t", 
     RowBox[{"-", "1"}]]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422790416041*^9, 4.000422888510758*^9}, {
  4.00102361485701*^9, 4.001023631293838*^9}, {4.001026143291382*^9, 
  4.0010261437259693`*^9}},ExpressionUUID->"a37a336f-87c1-4148-86a3-\
3863607cea4d"],

Cell["with the initial conditions", "Text",
 CellChangeTimes->{{4.0010236338627367`*^9, 
  4.001023639401926*^9}},ExpressionUUID->"f5c2a27d-99ce-414f-8d48-\
02375d4de562"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["Z",
     FontWeight->"Bold",
     FontSlant->"Plain"], "0"], "=", 
   StyleBox["I",
    FontWeight->"Bold",
    FontSlant->"Plain"]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422790416041*^9, 4.000422888510758*^9}, {
  4.00102361485701*^9, 
  4.001023649555089*^9}},ExpressionUUID->"1ac7b71d-1f84-425e-8031-\
42444d7896f0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["P",
     FontWeight->"Bold",
     FontSlant->"Plain"], "0"], "=", " ", 
   RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]", " ", 
    SubscriptBox[
     StyleBox["A",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422790416041*^9, 4.000422888510758*^9}, {
  4.00102361485701*^9, 4.001023674283578*^9}, {4.001026281776435*^9, 
  4.001026283670167*^9}},ExpressionUUID->"2f9d8058-9318-4834-8d1d-\
30e8936e90a9"],

Cell["\<\
Differentiating with respect to time using the matrix identity\
\>", "Text",
 CellChangeTimes->{{4.0010252545352793`*^9, 4.001025266750617*^9}, {
  4.001027815327428*^9, 4.001027827659381*^9}, {4.002382499898611*^9, 
  4.002382525863645*^9}},ExpressionUUID->"f2ed8f40-fa19-466e-8dc0-\
d1c4a3be39e5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["Z",
     FontWeight->"Bold",
     FontSlant->"Plain"], "t", 
    RowBox[{"-", "1"}]], "=", 
   RowBox[{
    RowBox[{"-", 
     SubsuperscriptBox[
      StyleBox["Z",
       FontWeight->"Bold",
       FontSlant->"Plain"], "t", 
      RowBox[{"-", "1"}]]}], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["Z",
       FontWeight->"Bold",
       FontSlant->"Plain"], "."], "t"], 
    SubsuperscriptBox[
     StyleBox["Z",
      FontWeight->"Bold",
      FontSlant->"Plain"], "t", 
     RowBox[{"-", "1"}]]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422790416041*^9, 4.000422888510758*^9}, {
  4.00102361485701*^9, 4.001023674283578*^9}, {4.001026281776435*^9, 
  4.001026283670167*^9}, {4.0023825617082253`*^9, 
  4.002382581940844*^9}},ExpressionUUID->"a47189c8-893f-4378-9e8d-\
1c6bfdf3224f"],

Cell["gives the left-hand side of the Riccati equation:", "Text",
 CellChangeTimes->{{4.0023825473501873`*^9, 4.002382548213973*^9}, {
  4.002382625386039*^9, 
  4.002382635639304*^9}},ExpressionUUID->"4b6dce61-ec95-432f-abda-\
e58742028ca2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["A",
      FontWeight->"Bold",
      FontSlant->"Plain"], "."], "t"], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]"}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox[
         OverscriptBox[
          StyleBox["P",
           FontWeight->"Bold",
           FontSlant->"Plain"], "."], "t"], 
        SubsuperscriptBox[
         StyleBox["Z",
          FontWeight->"Bold",
          FontSlant->"Plain"], "t", 
         RowBox[{"-", "1"}]]}], "+", 
       RowBox[{
        SubscriptBox[
         StyleBox["P",
          FontWeight->"Bold",
          FontSlant->"Plain"], "t"], 
        RowBox[{
         FractionBox["\[DifferentialD]", 
          RowBox[{"\[DifferentialD]", "t"}]], 
         SubsuperscriptBox[
          StyleBox["Z",
           FontWeight->"Bold",
           FontSlant->"Plain"], "t", 
          RowBox[{"-", "1"}]]}]}]}], ")"}]}], "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]"}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox[
         OverscriptBox[
          StyleBox["P",
           FontWeight->"Bold",
           FontSlant->"Plain"], "."], "t"], 
        SubsuperscriptBox[
         StyleBox["Z",
          FontWeight->"Bold",
          FontSlant->"Plain"], "t", 
         RowBox[{"-", "1"}]]}], "-", 
       RowBox[{
        SubscriptBox[
         StyleBox["P",
          FontWeight->"Bold",
          FontSlant->"Plain"], "t"], 
        SubsuperscriptBox[
         StyleBox["Z",
          FontWeight->"Bold",
          FontSlant->"Plain"], "t", 
         RowBox[{"-", "1"}]], 
        SubscriptBox[
         OverscriptBox[
          StyleBox["Z",
           FontWeight->"Bold",
           FontSlant->"Plain"], "."], "t"], 
        SubsuperscriptBox[
         StyleBox["Z",
          FontWeight->"Bold",
          FontSlant->"Plain"], "t", 
         RowBox[{"-", "1"}]]}]}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422790416041*^9, 4.000422888510758*^9}, {
  4.00102361485701*^9, 4.001023631293838*^9}, {4.001025278029271*^9, 
  4.001025335103959*^9}, {4.0010262911380453`*^9, 
  4.001026299314762*^9}},ExpressionUUID->"480be027-d002-4948-a432-\
8d7b3901fa92"],

Cell["\<\
Meanwhile, substituting the factorization into the right-hand side of the \
Ricatti equation yields\
\>", "Text",
 CellChangeTimes->{{4.001025795120213*^9, 4.001025805623826*^9}, {
  4.002382663465014*^9, 
  4.0023826841793013`*^9}},ExpressionUUID->"2aa2e7ea-d614-4600-a7b9-\
8890edf18541"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]"}], "m"]}], 
     SubsuperscriptBox[
      StyleBox["A",
       FontWeight->"Bold",
       FontSlant->"Plain"], "t", "2"]}], "+", 
    RowBox[{
     FractionBox["\[ImaginaryI]", "\[HBar]"], 
     SubscriptBox[
      StyleBox["V",
       FontWeight->"Bold",
       FontSlant->"Plain"], "2"]}]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]"}], "m"]}], 
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]"}]], 
        SubscriptBox[
         StyleBox["P",
          FontWeight->"Bold",
          FontSlant->"Plain"], "t"], 
        SubsuperscriptBox[
         StyleBox["Z",
          FontWeight->"Bold",
          FontSlant->"Plain"], "t", 
         RowBox[{"-", "1"}]]}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]"}]], 
        SubscriptBox[
         StyleBox["P",
          FontWeight->"Bold",
          FontSlant->"Plain"], "t"], 
        SubsuperscriptBox[
         StyleBox["Z",
          FontWeight->"Bold",
          FontSlant->"Plain"], "t", 
         RowBox[{"-", "1"}]]}], ")"}]}], "+", 
     RowBox[{
      FractionBox["\[ImaginaryI]", "\[HBar]"], 
      SubscriptBox[
       StyleBox["V",
        FontWeight->"Bold",
        FontSlant->"Plain"], "2"]}]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", 
        RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]"}]]}], 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox[
         StyleBox["P",
          FontWeight->"Bold",
          FontSlant->"Plain"], "t"], 
        SubsuperscriptBox[
         StyleBox["Z",
          FontWeight->"Bold",
          FontSlant->"Plain"], "t", 
         RowBox[{"-", "1"}]]}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", "m"], 
        SubscriptBox[
         StyleBox["P",
          FontWeight->"Bold",
          FontSlant->"Plain"], "t"]}], ")"}], 
      SubsuperscriptBox[
       StyleBox["Z",
        FontWeight->"Bold",
        FontSlant->"Plain"], "t", 
       RowBox[{"-", "1"}]]}], "+", 
     RowBox[{
      FractionBox["\[ImaginaryI]", "\[HBar]"], 
      SubscriptBox[
       StyleBox["V",
        FontWeight->"Bold",
        FontSlant->"Plain"], "2"]}]}]}]}], TraditionalForm]], "DisplayFormula",\

 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
   3.999605770192709*^9}, {4.000422790416041*^9, 4.000422888510758*^9}, {
   4.001025811262074*^9, 4.001025834473782*^9}, {4.001026401375986*^9, 
   4.001026404091762*^9}, 
   4.002382652498513*^9},ExpressionUUID->"b9e2aa9d-0cbb-47f6-bc05-\
da7a1e5127b7"],

Cell["Combining the two side gives", "Text",
 CellChangeTimes->{{4.001026481910076*^9, 4.001026486541901*^9}, {
  4.002382728444219*^9, 
  4.002382741372493*^9}},ExpressionUUID->"2b6ec249-330b-424e-a5ad-\
b937f645cfc4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox["1", 
     RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]"}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox[
        OverscriptBox[
         StyleBox["P",
          FontWeight->"Bold",
          FontSlant->"Plain"], "."], "t"], 
       SubsuperscriptBox[
        StyleBox["Z",
         FontWeight->"Bold",
         FontSlant->"Plain"], "t", 
        RowBox[{"-", "1"}]]}], "-", 
      RowBox[{
       SubscriptBox[
        StyleBox["P",
         FontWeight->"Bold",
         FontSlant->"Plain"], "t"], 
       SubsuperscriptBox[
        StyleBox["Z",
         FontWeight->"Bold",
         FontSlant->"Plain"], "t", 
        RowBox[{"-", "1"}]], 
       SubscriptBox[
        OverscriptBox[
         StyleBox["Z",
          FontWeight->"Bold",
          FontSlant->"Plain"], "."], "t"], 
       SubsuperscriptBox[
        StyleBox["Z",
         FontWeight->"Bold",
         FontSlant->"Plain"], "t", 
        RowBox[{"-", "1"}]]}]}], ")"}]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", 
       RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]"}]]}], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["P",
         FontWeight->"Bold",
         FontSlant->"Plain"], "t"], 
       SubsuperscriptBox[
        StyleBox["Z",
         FontWeight->"Bold",
         FontSlant->"Plain"], "t", 
        RowBox[{"-", "1"}]]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       FractionBox["1", "m"], 
       SubscriptBox[
        StyleBox["P",
         FontWeight->"Bold",
         FontSlant->"Plain"], "t"]}], ")"}], 
     SubsuperscriptBox[
      StyleBox["Z",
       FontWeight->"Bold",
       FontSlant->"Plain"], "t", 
      RowBox[{"-", "1"}]]}], "+", 
    RowBox[{
     FractionBox["\[ImaginaryI]", "\[HBar]"], 
     SubscriptBox[
      StyleBox["V",
       FontWeight->"Bold",
       FontSlant->"Plain"], "2"]}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422790416041*^9, 4.000422888510758*^9}, {
  4.00102361485701*^9, 4.001023631293838*^9}, {4.001025278029271*^9, 
  4.001025335103959*^9}, {4.0010262911380453`*^9, 4.001026299314762*^9}, {
  4.001026495074299*^9, 
  4.00102650058329*^9}},ExpressionUUID->"dd91e05f-6821-4802-8530-\
4088664d70bd"],

Cell["\<\
Equating like terms across both expressions decouples the nonlinear Riccati \
equation into a linear system\
\>", "Text",
 CellChangeTimes->{{4.0010256608132973`*^9, 4.00102566565559*^9}, 
   4.002382813922921*^9, {4.002383343736348*^9, 
   4.002383348156493*^9}},ExpressionUUID->"ac52a390-2c5e-47ca-8a8a-\
da1d04015b3f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox["1", 
     RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]"}]], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["P",
       FontWeight->"Bold",
       FontSlant->"Plain"], "."], "t"], 
    SubsuperscriptBox[
     StyleBox["Z",
      FontWeight->"Bold",
      FontSlant->"Plain"], "t", 
     RowBox[{"-", "1"}]]}], "=", 
   RowBox[{
    FractionBox["\[ImaginaryI]", "\[HBar]"], 
    SubscriptBox[
     StyleBox["V",
      FontWeight->"Bold",
      FontSlant->"Plain"], "2"]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
   3.999605770192709*^9}, {4.000422790416041*^9, 4.000422888510758*^9}, 
   4.00102541112227*^9, {4.0010254665307693`*^9, 4.001025474280772*^9}, {
   4.001025506021963*^9, 4.001025521894135*^9}, {4.001025633299597*^9, 
   4.001025640358396*^9}, {4.0010265110352287`*^9, 
   4.001026511316084*^9}},ExpressionUUID->"a6609e26-6d22-45df-ad05-\
c686bf835737"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", 
      RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]"}]]}], 
    SubscriptBox[
     StyleBox["P",
      FontWeight->"Bold",
      FontSlant->"Plain"], "t"], 
    SubsuperscriptBox[
     StyleBox["Z",
      FontWeight->"Bold",
      FontSlant->"Plain"], "t", 
     RowBox[{"-", "1"}]], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["Z",
       FontWeight->"Bold",
       FontSlant->"Plain"], "."], "t"], 
    SubsuperscriptBox[
     StyleBox["Z",
      FontWeight->"Bold",
      FontSlant->"Plain"], "t", 
     RowBox[{"-", "1"}]]}], "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", 
      RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]"}]]}], 
    SubscriptBox[
     StyleBox["P",
      FontWeight->"Bold",
      FontSlant->"Plain"], "t"], 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["Z",
       FontWeight->"Bold",
       FontSlant->"Plain"], "t", 
      RowBox[{"-", "1"}]], "(", 
     RowBox[{
      FractionBox["1", "m"], 
      SubscriptBox[
       StyleBox["P",
        FontWeight->"Bold",
        FontSlant->"Plain"], "t"]}], ")"}], 
    SubsuperscriptBox[
     StyleBox["Z",
      FontWeight->"Bold",
      FontSlant->"Plain"], "t", 
     RowBox[{"-", "1"}]]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
   3.999605770192709*^9}, {4.000422790416041*^9, 4.000422888510758*^9}, 
   4.00102541112227*^9, {4.0010254665307693`*^9, 4.001025474280772*^9}, {
   4.001025506021963*^9, 4.001025521894135*^9}, {4.001025644882105*^9, 
   4.0010256548526173`*^9}, {4.001026529041923*^9, 4.001026536066615*^9}, {
   4.001026589094051*^9, 
   4.0010266074914103`*^9}},ExpressionUUID->"6220c778-3bf7-4f97-a5ee-\
758e58cd6cf7"],

Cell["\<\
that reduces to first-order Hamilton-like equations of motion\
\>", "Text",
 CellChangeTimes->{{4.001026554796564*^9, 4.001026572193965*^9}, {
  4.0023828302593527`*^9, 4.002382832548232*^9}, {4.0023833531115627`*^9, 
  4.002383362004273*^9}},ExpressionUUID->"574d2d52-11be-4d6d-b29d-\
fb3c1a8b55f0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["P",
      FontWeight->"Bold",
      FontSlant->"Plain"], "."], "t"], "=", 
   RowBox[{
    RowBox[{"-", "2"}], 
    RowBox[{
     SubscriptBox[
      StyleBox["V",
       FontWeight->"Bold",
       FontSlant->"Plain"], "2"], "(", "t", ")"}], 
    SubscriptBox[
     StyleBox["Z",
      FontWeight->"Bold",
      FontSlant->"Plain"], "t"]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422790416041*^9, 4.000422888510758*^9}, {
  4.001024711101383*^9, 
  4.001024741049609*^9}},ExpressionUUID->"ba185607-c7f3-46d6-805d-\
39fd63bf0aac"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["Z",
      FontWeight->"Bold",
      FontSlant->"Plain"], "."], "t"], "=", 
   RowBox[{
    FractionBox["1", "m"], 
    SubscriptBox[
     StyleBox["P",
      FontWeight->"Bold",
      FontSlant->"Plain"], "t"]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422790416041*^9, 4.000422888510758*^9}, {
  4.001024711101383*^9, 
  4.001024722824422*^9}},ExpressionUUID->"303e90fb-c98d-4e7f-8adf-\
574bec9a24cd"]
}, Closed]],

Cell[CellGroupData[{

Cell["Jacobi\[CloseCurlyQuote]s Determinant Formula and Exact Phase \
Integration", "Subsection",
 CellChangeTimes->{{4.002382840190946*^9, 
  4.002382856685109*^9}},ExpressionUUID->"2cef5690-e174-4797-84c1-\
b393a567a14d"],

Cell[TextData[{
 "Substituting ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["P",
      FontWeight->"Bold",
      FontSlant->"Plain"], "t"], "=", 
    RowBox[{"m", " ", 
     SubscriptBox[
      OverscriptBox[
       StyleBox["Z",
        FontWeight->"Bold",
        FontSlant->"Plain"], "."], "t"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ca14563a-a1b8-4850-abf5-02be2c091dce"],
 " back into Heller\[CloseCurlyQuote]s factorization expresses the shape \
matrix and its trace directly into terms of the logarithmic derivative of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["Z",
     FontWeight->"Bold",
     FontSlant->"Plain"], "t"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d8eb8526-6195-4d6d-88cc-e82b54f0f84e"],
 ":"
}], "Text",
 CellChangeTimes->{{4.001027806401108*^9, 4.00102780754883*^9}, {
   4.0010278410824947`*^9, 4.0010278640061417`*^9}, {4.002383450218123*^9, 
   4.0023835260580072`*^9}, 
   4.002383587059786*^9},ExpressionUUID->"8c765d62-eb85-47b4-8dab-\
b8495392186d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["A",
     FontWeight->"Bold",
     FontSlant->"Plain"], "t"], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox["1", 
       RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]"}]], 
      SubscriptBox[
       StyleBox["P",
        FontWeight->"Bold",
        FontSlant->"Plain"], "t"], 
      SubsuperscriptBox[
       StyleBox["Z",
        FontWeight->"Bold",
        FontSlant->"Plain"], "t", 
       RowBox[{"-", "1"}]]}], "="}], 
    FractionBox["m", 
     RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]"}]], 
    SubscriptBox[
     OverscriptBox[
      StyleBox["Z",
       FontWeight->"Bold",
       FontSlant->"Plain"], "."], "t"], 
    SubsuperscriptBox[
     StyleBox["Z",
      FontWeight->"Bold",
      FontSlant->"Plain"], "t", 
     RowBox[{"-", "1"}]]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
   3.999605770192709*^9}, {4.000422790416041*^9, 4.000422888510758*^9}, {
   4.00102361485701*^9, 4.001023631293838*^9}, {4.001026143291382*^9, 
   4.0010261437259693`*^9}, {4.001027865800858*^9, 4.001027880427754*^9}, 
   4.001028178729854*^9},ExpressionUUID->"2080c212-45b1-4566-ac97-\
6fe61a302f90"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Tr", "(", 
    SubscriptBox[
     StyleBox["A",
      FontWeight->"Bold",
      FontSlant->"Plain"], "t"], ")"}], "=", 
   RowBox[{
    FractionBox["m", 
     RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]"}]], 
    RowBox[{"Tr", "(", 
     RowBox[{
      SubscriptBox[
       OverscriptBox[
        StyleBox["Z",
         FontWeight->"Bold",
         FontSlant->"Plain"], "."], "t"], 
      SubsuperscriptBox[
       StyleBox["Z",
        FontWeight->"Bold",
        FontSlant->"Plain"], "t", 
       RowBox[{"-", "1"}]]}], ")"}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422790416041*^9, 4.000422888510758*^9}, {
  4.00102361485701*^9, 4.001023631293838*^9}, {4.001026143291382*^9, 
  4.0010261437259693`*^9}, {4.001027865800858*^9, 4.001027880427754*^9}, {
  4.001028178729854*^9, 
  4.001028229514818*^9}},ExpressionUUID->"2d6a8462-d52b-4b11-a3b2-\
7ef4db095acd"],

Cell[TextData[{
 "For any invertible, time-dependent matrix, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["Z",
     FontWeight->"Bold",
     FontSlant->"Plain"], "t"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e4168108-e9fb-4a69-9de9-fab7ab19da72"],
 ", Jacobi\[CloseCurlyQuote]s formula relates the time derivative of the \
determinant to the trace of "
}], "Text",
 CellChangeTimes->{{4.001028256963426*^9, 4.001028301983115*^9}, {
  4.001028366465007*^9, 
  4.001028374222509*^9}},ExpressionUUID->"b0aa8d9d-a562-49ef-9752-\
a4845ee675ee"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    FractionBox["\[DifferentialD]", 
     RowBox[{"\[DifferentialD]", "t"}]], 
    RowBox[{"det", "(", 
     SubscriptBox[
      StyleBox["Z",
       FontWeight->"Bold",
       FontSlant->"Plain"], "t"], ")"}]}], "=", 
   RowBox[{
    RowBox[{"det", "(", 
     SubscriptBox[
      StyleBox["Z",
       FontWeight->"Bold",
       FontSlant->"Plain"], "t"], ")"}], 
    RowBox[{"Tr", "(", 
     RowBox[{
      SubscriptBox[
       OverscriptBox[
        StyleBox["Z",
         FontWeight->"Bold",
         FontSlant->"Plain"], "."], "t"], 
      SubsuperscriptBox[
       StyleBox["Z",
        FontWeight->"Bold",
        FontSlant->"Plain"], "t", 
       RowBox[{"-", "1"}]]}], ")"}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422790416041*^9, 4.000422888510758*^9}, {
  4.00102361485701*^9, 4.001023631293838*^9}, {4.001026143291382*^9, 
  4.0010261437259693`*^9}, {4.001027865800858*^9, 4.001027880427754*^9}, {
  4.001028178729854*^9, 4.001028229514818*^9}, {4.0010283224283*^9, 
  4.001028346055934*^9}},ExpressionUUID->"1594f943-9ae7-4b03-a8a4-\
e3f054707a8d"],

Cell["Now divide both sides by the determinant", "Text",
 CellChangeTimes->{{4.001028483538302*^9, 4.001028496259954*^9}, {
  4.0010285856405983`*^9, 
  4.0010285890322847`*^9}},ExpressionUUID->"7e75a625-0505-4d94-b5b8-\
8abe7f04160a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Tr", "(", 
    RowBox[{
     SubscriptBox[
      OverscriptBox[
       StyleBox["Z",
        FontWeight->"Bold",
        FontSlant->"Plain"], "."], "t"], 
     SubsuperscriptBox[
      StyleBox["Z",
       FontWeight->"Bold",
       FontSlant->"Plain"], "t", 
      RowBox[{"-", "1"}]]}], ")"}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", 
      RowBox[{"det", "(", 
       SubscriptBox[
        StyleBox["Z",
         FontWeight->"Bold",
         FontSlant->"Plain"], "t"], ")"}]], 
     RowBox[{
      FractionBox["\[DifferentialD]", 
       RowBox[{"\[DifferentialD]", "t"}]], 
      RowBox[{"det", "(", 
       SubscriptBox[
        StyleBox["Z",
         FontWeight->"Bold",
         FontSlant->"Plain"], "t"], ")"}]}]}], "=", 
    RowBox[{
     FractionBox["\[DifferentialD]", 
      RowBox[{"\[DifferentialD]", "t"}]], 
     RowBox[{"ln", "(", 
      RowBox[{"det", "(", 
       SubscriptBox[
        StyleBox["Z",
         FontWeight->"Bold",
         FontSlant->"Plain"], "t"], ")"}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422790416041*^9, 4.000422888510758*^9}, {
  4.00102361485701*^9, 4.001023631293838*^9}, {4.001026143291382*^9, 
  4.0010261437259693`*^9}, {4.001027865800858*^9, 4.001027880427754*^9}, {
  4.001028178729854*^9, 4.001028229514818*^9}, {4.0010283224283*^9, 
  4.001028346055934*^9}, {4.001028506559106*^9, 4.001028511111246*^9}, {
  4.0010285527510757`*^9, 
  4.001028582695902*^9}},ExpressionUUID->"7d9933e5-db80-4f7f-87f5-\
a500ec809041"],

Cell["\<\
Thus, the quantum trace term in the phase equation becomes an exact total \
time derivative:\
\>", "Text",
 CellChangeTimes->{{4.0010286100925617`*^9, 4.001028626625287*^9}, {
  4.0023836762102947`*^9, 
  4.002383692291135*^9}},ExpressionUUID->"ce9ee5d3-7a27-4f4a-ae4a-\
fc0053bcce63"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox["\[HBar]", "2"], "m"]}], 
    RowBox[{"Tr", "(", 
     SubscriptBox[
      StyleBox["A",
       FontWeight->"Bold",
       FontSlant->"Plain"], "t"], ")"}]}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["\[HBar]", "2"], "m"]}], 
     FractionBox["m", 
      RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]"}]], 
     RowBox[{"Tr", "(", 
      RowBox[{
       SubscriptBox[
        OverscriptBox[
         StyleBox["Z",
          FontWeight->"Bold",
          FontSlant->"Plain"], "."], "t"], 
       SubsuperscriptBox[
        StyleBox["Z",
         FontWeight->"Bold",
         FontSlant->"Plain"], "t", 
        RowBox[{"-", "1"}]]}], ")"}]}], "=", 
    RowBox[{
     FractionBox[
      RowBox[{"\[ImaginaryI]", " ", "\[HBar]"}], 
      RowBox[{"2", " "}]], 
     RowBox[{
      FractionBox["\[DifferentialD]", 
       RowBox[{"\[DifferentialD]", "t"}]], 
      RowBox[{"ln", "(", 
       RowBox[{"det", "(", 
        SubscriptBox[
         StyleBox["Z",
          FontWeight->"Bold",
          FontSlant->"Plain"], "t"], ")"}], ")"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422790416041*^9, 4.000422947641068*^9}, {
  4.001023019174439*^9, 4.001023024772278*^9}, {4.001028649076908*^9, 
  4.001028692128779*^9}, {4.001028728168038*^9, 
  4.001028764817523*^9}},ExpressionUUID->"13412d42-a247-4361-951c-\
e8d2664d4ef1"],

Cell["Substituting this into the phase equation,", "Text",
 CellChangeTimes->{{4.001029270144808*^9, 4.0010292769120626`*^9}, {
  4.0010296604282827`*^9, 
  4.001029670168885*^9}},ExpressionUUID->"2863303c-77e9-4988-825d-\
92744dbe7ced"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    OverscriptBox["\[Gamma]", "."], "t"], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"L", "(", 
      RowBox[{
       SubscriptBox[
        StyleBox["r",
         FontWeight->"Bold",
         FontSlant->"Plain"], "t"], ",", 
       SubscriptBox[
        OverscriptBox[
         StyleBox["r",
          FontWeight->"Bold",
          FontSlant->"Plain"], "."], "t"], ",", "t"}], ")"}], "-", 
     RowBox[{
      FractionBox[
       SuperscriptBox["\[HBar]", "2"], "m"], 
      RowBox[{"Tr", "(", 
       SubscriptBox[
        StyleBox["A",
         FontWeight->"Bold",
         FontSlant->"Plain"], "t"], ")"}]}]}], "=", 
    RowBox[{
     RowBox[{"L", "(", 
      RowBox[{
       SubscriptBox[
        StyleBox["r",
         FontWeight->"Bold",
         FontSlant->"Plain"], "t"], ",", 
       SubscriptBox[
        OverscriptBox[
         StyleBox["r",
          FontWeight->"Bold",
          FontSlant->"Plain"], "."], "t"], ",", "t"}], ")"}], "+", 
     RowBox[{
      FractionBox[
       RowBox[{"\[ImaginaryI]", " ", "\[HBar]"}], 
       RowBox[{"2", " "}]], 
      RowBox[{
       FractionBox["\[DifferentialD]", 
        RowBox[{"\[DifferentialD]", "t"}]], 
       RowBox[{"ln", "(", 
        RowBox[{"det", "(", 
         SubscriptBox[
          StyleBox["Z",
           FontWeight->"Bold",
           FontSlant->"Plain"], "t"], ")"}], ")"}]}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422790416041*^9, 4.000422947641068*^9}, {
  4.001023019174439*^9, 4.001023024772278*^9}, {4.001029297384856*^9, 
  4.0010293351822968`*^9}, {4.0010296470030937`*^9, 
  4.0010296474578457`*^9}},ExpressionUUID->"336518e5-bf51-46b8-b4cd-\
6d3cdd67b694"],

Cell["and integrating, we have", "Text",
 CellChangeTimes->{{4.001029341501637*^9, 4.001029383285713*^9}, {
  4.001029677450321*^9, 
  4.001029684242907*^9}},ExpressionUUID->"741ceddc-cc0f-4a9a-ae2e-\
e94446c4b3d7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Gamma]", "t"], "=", 
   RowBox[{
    SubscriptBox["\[Gamma]", "0"], "+", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", "0", "t"], 
     RowBox[{
      RowBox[{"L", "(", 
       RowBox[{
        SubscriptBox["r", "t"], ",", 
        SubscriptBox[
         OverscriptBox[
          StyleBox["r",
           FontWeight->"Bold",
           FontSlant->"Plain"], "."], "t"], ",", "t"}], ")"}], 
      RowBox[{"\[DifferentialD]", "t"}]}]}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{"\[ImaginaryI]", " ", "\[HBar]"}], 
      RowBox[{"2", " "}]], 
     RowBox[{
      SubsuperscriptBox["\[Integral]", 
       RowBox[{"ln", "(", 
        RowBox[{"det", "(", 
         SubscriptBox[
          StyleBox["Z",
           FontWeight->"Bold",
           FontSlant->"Plain"], "0"], ")"}], ")"}], 
       RowBox[{"n", "(", 
        RowBox[{"det", "(", 
         SubscriptBox[
          StyleBox["Z",
           FontWeight->"Bold",
           FontSlant->"Plain"], "t"], ")"}], ")"}]], 
      RowBox[{"\[DifferentialD]", 
       RowBox[{"ln", "(", 
        RowBox[{"det", "(", 
         SubscriptBox[
          StyleBox["Z",
           FontWeight->"Bold",
           FontSlant->"Plain"], "t"], ")"}], ")"}]}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422790416041*^9, 4.000422947641068*^9}, {
  4.001023019174439*^9, 4.001023024772278*^9}, {4.001029297384856*^9, 
  4.001029464046647*^9}, {4.0010297032459393`*^9, 4.001029786148567*^9}, {
  4.001029823290483*^9, 4.001029823601612*^9}, {4.001030120288622*^9, 
  4.001030122278467*^9}},ExpressionUUID->"034623a7-48a7-47c6-9489-\
75718c185c89"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Gamma]", "t"], "=", 
   RowBox[{
    SubscriptBox["\[Gamma]", "0"], "+", 
    RowBox[{"S", "(", "t", ")"}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{"\[ImaginaryI]", " ", "\[HBar]"}], 
      RowBox[{"2", " "}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"ln", "(", 
        RowBox[{"det", "(", 
         SubscriptBox[
          StyleBox["Z",
           FontWeight->"Bold",
           FontSlant->"Plain"], "t"], ")"}], ")"}], "-", 
       RowBox[{"ln", "(", 
        RowBox[{"det", "(", 
         SubscriptBox[
          StyleBox["Z",
           FontWeight->"Bold",
           FontSlant->"Plain"], "0"], ")"}], ")"}]}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422790416041*^9, 4.000422947641068*^9}, {
  4.001023019174439*^9, 4.001023024772278*^9}, {4.001029297384856*^9, 
  4.001029464046647*^9}, {4.0010297032459393`*^9, 4.001029786148567*^9}, {
  4.0010298171025457`*^9, 4.001029859698471*^9}, {4.001030124617556*^9, 
  4.001030126716457*^9}},ExpressionUUID->"82b0f85b-e980-42b7-af17-\
4e6cebd06e6e"],

Cell[TextData[{
 "Given the initial condition (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["Z",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"], "=", 
    StyleBox["I",
     FontWeight->"Bold",
     FontSlant->"Plain"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d72f8d25-071a-44f3-9587-8aadb1f2a6a8"],
 "), this becomes"
}], "Text",
 CellChangeTimes->{{4.001029941924494*^9, 4.001029958869227*^9}, {
  4.001030143311626*^9, 
  4.0010301559058867`*^9}},ExpressionUUID->"deed824a-9696-4f6a-bbf5-\
c67a08db29a4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Gamma]", "t"], "=", 
   RowBox[{
    SubscriptBox["\[Gamma]", "0"], "+", 
    RowBox[{"S", "(", "t", ")"}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{"\[ImaginaryI]", " ", "\[HBar]"}], 
      RowBox[{"2", " "}]], 
     RowBox[{"ln", "(", 
      RowBox[{"det", "(", 
       SubscriptBox[
        StyleBox["Z",
         FontWeight->"Bold",
         FontSlant->"Plain"], "t"], ")"}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422790416041*^9, 4.000422947641068*^9}, {
  4.001023019174439*^9, 4.001023024772278*^9}, {4.001029297384856*^9, 
  4.001029464046647*^9}, {4.0010297032459393`*^9, 4.001029786148567*^9}, {
  4.0010298171025457`*^9, 4.001029859698471*^9}, {4.001029966114276*^9, 
  4.001029969555875*^9}, {4.0010302209925337`*^9, 
  4.001030222719829*^9}},ExpressionUUID->"1e5a515c-ed0b-47ac-b421-\
56f76989df0d"],

Cell["Writing the complex determinant in polar form", "Text",
 CellChangeTimes->{{4.001030189786456*^9, 4.001030209624997*^9}, {
  4.0023839002628927`*^9, 
  4.00238391365296*^9}},ExpressionUUID->"ad751731-3897-40c9-808e-\
6f3a8e9bacb8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"det", "(", 
    SubscriptBox[
     StyleBox["Z",
      FontWeight->"Bold",
      FontSlant->"Plain"], "t"], ")"}], "=", 
   RowBox[{
    RowBox[{"\[LeftBracketingBar]", 
     RowBox[{"det", "(", 
      SubscriptBox[
       StyleBox["Z",
        FontWeight->"Bold",
        FontSlant->"Plain"], "t"], ")"}], "\[RightBracketingBar]"}], 
    RowBox[{"exp", "(", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"arg", "(", 
       RowBox[{"det", "(", 
        SubscriptBox[
         StyleBox["Z",
          FontWeight->"Bold",
          FontSlant->"Plain"], "t"], ")"}], ")"}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422790416041*^9, 4.000422947641068*^9}, {
  4.001023019174439*^9, 4.001023024772278*^9}, {4.001029297384856*^9, 
  4.001029464046647*^9}, {4.0010297032459393`*^9, 4.001029786148567*^9}, {
  4.0010298171025457`*^9, 4.001029859698471*^9}, {4.001029966114276*^9, 
  4.001029969555875*^9}, {4.0010302196383457`*^9, 
  4.0010303055553093`*^9}},ExpressionUUID->"729b8a01-43a2-4ef7-bb8c-\
146f9e031c56"],

Cell["\<\
separates the logarithm into modulus and continuous phase components:\
\>", "Text",
 CellChangeTimes->{{4.001030319786024*^9, 4.001030320672202*^9}, {
  4.002383916516375*^9, 
  4.002383939080385*^9}},ExpressionUUID->"73bb7227-5100-4c95-84e2-\
ac251854ba3d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"ln", "(", 
    RowBox[{"det", "(", 
     SubscriptBox[
      StyleBox["Z",
       FontWeight->"Bold",
       FontSlant->"Plain"], "t"], ")"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], "ln", " ", 
     SuperscriptBox[
      RowBox[{"\[LeftBracketingBar]", 
       RowBox[{"det", "(", 
        SubscriptBox[
         StyleBox["Z",
          FontWeight->"Bold",
          FontSlant->"Plain"], "t"], ")"}], "\[RightBracketingBar]"}], "2"]}],
     "+", 
    RowBox[{"\[ImaginaryI]", " ", 
     RowBox[{"arg", "(", 
      RowBox[{"det", "(", 
       SubscriptBox[
        StyleBox["Z",
         FontWeight->"Bold",
         FontSlant->"Plain"], "t"], ")"}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422790416041*^9, 4.000422947641068*^9}, {
  4.001023019174439*^9, 4.001023024772278*^9}, {4.001029297384856*^9, 
  4.001029464046647*^9}, {4.0010297032459393`*^9, 4.001029786148567*^9}, {
  4.0010298171025457`*^9, 4.001029859698471*^9}, {4.001030124617556*^9, 
  4.001030126716457*^9}, {4.0010303356288137`*^9, 
  4.0010303849027576`*^9}},ExpressionUUID->"fc49ec83-610b-418b-ba96-\
3ada5a066675"],

Cell[TextData[{
 "Substituting this relation into ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "t"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "92b61fc6-2c26-4a06-b562-f33e8832894e"],
 " "
}], "Text",
 CellChangeTimes->{{4.001030457888421*^9, 4.001030462868166*^9}, {
  4.002383947703864*^9, 
  4.002383997961207*^9}},ExpressionUUID->"32c28e5b-b541-4aa9-ad3d-\
1bd4ca7e06d9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Gamma]", "t"], "=", 
   RowBox[{
    SubscriptBox["\[Gamma]", "0"], "+", 
    RowBox[{"S", "(", "t", ")"}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{"\[ImaginaryI]", " ", "\[HBar]"}], 
      RowBox[{"4", " "}]], "ln", " ", 
     SuperscriptBox[
      RowBox[{"\[LeftBracketingBar]", 
       RowBox[{"det", "(", 
        SubscriptBox[
         StyleBox["Z",
          FontWeight->"Bold",
          FontSlant->"Plain"], "t"], ")"}], "\[RightBracketingBar]"}], "2"]}],
     "-", 
    RowBox[{
     FractionBox[
      RowBox[{" ", "\[HBar]"}], 
      RowBox[{"2", " "}]], 
     RowBox[{"arg", "(", 
      RowBox[{"det", "(", 
       SubscriptBox[
        StyleBox["Z",
         FontWeight->"Bold",
         FontSlant->"Plain"], "t"], ")"}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422790416041*^9, 4.000422947641068*^9}, {
  4.001023019174439*^9, 4.001023024772278*^9}, {4.001029297384856*^9, 
  4.001029464046647*^9}, {4.0010297032459393`*^9, 4.001029786148567*^9}, {
  4.0010298171025457`*^9, 4.001029859698471*^9}, {4.001029966114276*^9, 
  4.001029969555875*^9}, {4.0010302209925337`*^9, 4.001030222719829*^9}, {
  4.00103042664386*^9, 
  4.001030453277318*^9}},ExpressionUUID->"50ae72df-7341-48d0-af3c-\
7a9b2f4a1c28"],

Cell["\<\
cleanly separates the real (Maslov-Gouy) and imaginary (normalization) phase \
parameters:\
\>", "Text",
 CellChangeTimes->{{4.00103046701164*^9, 4.001030477203608*^9}, {
  4.002384003951293*^9, 
  4.002384009101433*^9}},ExpressionUUID->"6d4e2c41-df70-443c-bc0c-\
2429443113dd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Re", "(", 
    SubscriptBox["\[Gamma]", "t"], ")"}], "=", 
   RowBox[{
    RowBox[{"Re", "(", 
     SubscriptBox["\[Gamma]", "0"], ")"}], "+", 
    RowBox[{"S", "(", "t", ")"}], "-", 
    RowBox[{
     FractionBox["\[HBar]", 
      RowBox[{"2", " "}]], 
     RowBox[{"arg", "(", 
      RowBox[{"det", "(", 
       SubscriptBox[
        StyleBox["Z",
         FontWeight->"Bold",
         FontSlant->"Plain"], "t"], ")"}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
