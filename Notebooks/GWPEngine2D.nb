625cffd83e5c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["S", "cl"], "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        RowBox[{
         SubsuperscriptBox["p", 
          RowBox[{"x", ",", "0"}], "2"], "+", 
         SubsuperscriptBox["p", 
          RowBox[{"y", ",", "0"}], "2"]}], 
        RowBox[{"2", "m"}]], "-", 
       SubscriptBox["V", "00"], "-", 
       RowBox[{
        SubscriptBox["V", "10"], 
        SubscriptBox["x", "0"]}], "-", 
       RowBox[{
        SubscriptBox["V", "01"], 
        SubscriptBox["y", "0"]}]}], ")"}], "t"}], "-", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{
        SubscriptBox["V", "10"], 
        SubscriptBox["p", 
         RowBox[{"x", ",", "0"}]]}], "+", 
       RowBox[{
        SubscriptBox["V", "01"], 
        SubscriptBox["p", 
         RowBox[{"y", ",", "0"}]]}]}], "m"], 
     SuperscriptBox["t", "2"]}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{
       SubsuperscriptBox["V", "10", "2"], "+", 
       SubsuperscriptBox["V", "01", "2"]}], 
      RowBox[{"3", "m"}]], 
     SuperscriptBox["t", "3"]}]}]}], TraditionalForm]], "DisplayFormula",
