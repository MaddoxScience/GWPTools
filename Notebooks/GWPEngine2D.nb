   4.001072664120565*^9}},ExpressionUUID->"d5601229-cf41-4f3d-b2f1-\
577afd62b720"],

Cell["The classical Lagrangian for the free particle is given by", "Text",
 CellChangeTimes->{{4.001072889934737*^9, 4.001072898674211*^9}, {
  4.001073063656773*^9, 
  4.001073066733899*^9}},ExpressionUUID->"82d220b0-3522-4501-8394-\
a888c2f9b6e6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["L", "t"], "=", 
   RowBox[{
    FractionBox[
     RowBox[{
      SubsuperscriptBox[
       StyleBox["p",
        FontWeight->"Bold",
        FontSlant->"Plain"], "0", "T"], 
      SubscriptBox[
       StyleBox["p",
        FontWeight->"Bold",
        FontSlant->"Plain"], "0"]}], 
     RowBox[{"2", "m"}]], "=", 
    FractionBox[
     RowBox[{
      SubsuperscriptBox["p", 
       RowBox[{"x", ",", "0"}], "2"], "+", 
      SubsuperscriptBox["p", 
       RowBox[{"y", ",", "0"}], "2"]}], 
     RowBox[{"2", "m"}]]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
   3.999605770192709*^9}, {4.000422790416041*^9, 4.000422888510758*^9}, {
   4.00102361485701*^9, 4.001023631293838*^9}, {4.001026143291382*^9, 
   4.0010261437259693`*^9}, {4.001027865800858*^9, 4.001027880427754*^9}, 
   4.001028178729854*^9, {4.001071950950012*^9, 4.001071973292799*^9}, {
   4.001072119706746*^9, 4.001072156511672*^9}, {4.001072199953615*^9, 
   4.001072243393709*^9}, {4.001072905950842*^9, 4.0010729320955772`*^9}, {
   4.00107302423323*^9, 
   4.0010730488515577`*^9}},ExpressionUUID->"5d4d8dfc-b510-497f-b23e-\
6b1ac9ada993"],

Cell["so that the classical action integral is ", "Text",
 CellChangeTimes->{{4.0010730735402718`*^9, 
  4.001073083400148*^9}},ExpressionUUID->"f770d2f1-ea1c-4022-a10c-\
782292732b4c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["S", "cl"], "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Integral]", "0", "t"], 
     RowBox[{
      SubscriptBox["L", 
       SuperscriptBox["t", "\[Prime]"]], 
      RowBox[{"\[DifferentialD]", 
       SuperscriptBox["t", "\[Prime]"]}]}]}], "=", 
    RowBox[{
     FractionBox[
      RowBox[{
       SubsuperscriptBox["p", 
        RowBox[{"x", ",", "0"}], "2"], "+", 
       SubsuperscriptBox["p", 
        RowBox[{"y", ",", "0"}], "2"]}], 
      RowBox[{"2", "m"}]], "t"}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
