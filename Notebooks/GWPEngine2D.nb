Cell[TextData[{
 "The linear gradient simply shifts the equilibrium center of the harmonic \
oscillator to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "eq"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2880faa8-e37a-4f56-8c9b-912bfbe13407"],
 " where the potential\[CloseCurlyQuote]s gradient is the null vector."
}], "Text",
 CellChangeTimes->{{4.001078320231494*^9, 
  4.001078364142003*^9}},ExpressionUUID->"7999f124-b7d4-44a1-8f1d-\
b07d14cfd192"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["r",
     FontWeight->"Bold",
     FontSlant->"Plain"], "eq"], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], 
     SubsuperscriptBox[
      StyleBox["V",
       FontWeight->"Bold",
       FontSlant->"Plain"], "2", 
      RowBox[{"-", "1"}]], 
     SubscriptBox[
      StyleBox["V",
       FontWeight->"Bold",
       FontSlant->"Plain"], "1"]}], "=", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "m"]}], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       SuperscriptBox[
        StyleBox["\[CapitalOmega]",
         FontWeight->"Bold"], "2"], ")"}], 
      RowBox[{"-", "1"}]], 
     SubscriptBox[
      StyleBox["V",
       FontWeight->"Bold",
       FontSlant->"Plain"], "1"]}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
