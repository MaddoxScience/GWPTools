Cell[CellGroupData[{

Cell["Harmonic oscillator", "Section",
 CellChangeTimes->{{4.0010714699253607`*^9, 
  4.001071474363842*^9}},ExpressionUUID->"f824dca4-333f-4f01-a659-\
d925d240691c"],

Cell["\<\
For the 2D coupled harmonic oscillator, the potential contains a non-zero \
symmetric quadratic curvature matrix along with an optional constant offset \
and linear gradient.\
\>", "Text",
 CellChangeTimes->{{4.001076589286689*^9, 
  4.001076666841612*^9}},ExpressionUUID->"c0437f41-d7e5-487a-b956-\
571e9891e3d2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"V", "(", 
    StyleBox["r",
     FontWeight->"Bold",
     FontSlant->"Plain"], ")"}], "=", 
   RowBox[{
    SubscriptBox["V", "00"], "+", 
    RowBox[{
     SubsuperscriptBox[
      StyleBox["V",
       FontWeight->"Bold",
       FontSlant->"Plain"], "1", "T"], 
     StyleBox["r",
      FontWeight->"Bold",
      FontSlant->"Plain"]}], "+", 
    RowBox[{
     SuperscriptBox[
      StyleBox["r",
       FontWeight->"Bold",
       FontSlant->"Plain"], "T"], 
     SubscriptBox[
      StyleBox["V",
       FontWeight->"Bold",
       FontSlant->"Plain"], "2"], 
     StyleBox["r",
      FontWeight->"Bold",
      FontSlant->"Plain"]}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGAQAWIQPTM80mPJmbeOPtVTQkD0mkDHGBCdoXI+HUQvnzyr
