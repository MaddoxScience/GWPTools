   4.001072119706746*^9, 4.001072156511672*^9}, {4.001072199953615*^9, 
   4.001072243393709*^9}},ExpressionUUID->"6ddfd0a5-7888-409c-8a4a-\
232a24ea2711"],

Cell["so that we have", "Text",
 CellChangeTimes->{{4.001072560730626*^9, 
  4.001072562623034*^9}},ExpressionUUID->"c35106a5-de99-4537-a4ba-\
c65964c7495d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["A",
     FontWeight->"Bold",
     FontSlant->"Plain"], "t"], "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"det", "(", 
      SubscriptBox[
       StyleBox["Z",
        FontWeight->"Bold",
        FontSlant->"Plain"], "t"], ")"}]], 
    RowBox[{"(", GridBox[{
       {
        RowBox[{
         SubscriptBox["\[Alpha]", 
          RowBox[{
           RowBox[{"x", " ", "x"}], ",", "0"}]], "+", 
         RowBox[{
          FractionBox[
           RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]", " ", "t"}], "m"], 
          RowBox[{"det", "(", 
           SubscriptBox[
            StyleBox["A",
             FontWeight->"Bold",
             FontSlant->"Plain"], "0"], ")"}]}]}], 
        SubscriptBox["\[Alpha]", 
         RowBox[{
          RowBox[{"x", " ", "y"}], ",", "0"}]]},
       {
        SubscriptBox["\[Alpha]", 
         RowBox[{
          RowBox[{"x", " ", "y"}], ",", "0"}]], 
        RowBox[{
         SubscriptBox["\[Alpha]", 
          RowBox[{
           RowBox[{"y", " ", "y"}], ",", "0"}]], "+", 
         RowBox[{
          FractionBox[
           RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]", " ", "t"}], "m"], 
          "det", 
          RowBox[{"(", 
           SubscriptBox[
            StyleBox["A",
             FontWeight->"Bold",
             FontSlant->"Plain"], "0"], ")"}]}]}]}
      }], ")"}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
   3.999605770192709*^9}, {4.000422790416041*^9, 4.000422888510758*^9}, {
   4.00102361485701*^9, 4.001023631293838*^9}, {4.001026143291382*^9, 
