+jrHdTDdMCtEGUSfur9CDUTLVTrqguhXVYn6IHrZXXWhAiAd9nu3KIjuUrA/
VQikZ19jvwOiYzm/PQDRK/4+eAyiF5geeQmiBYrLP4JovrhKxiIgbZOewASi
QwqtBMD8t7uFQPS/oqW7QTT/TKeDIPqAyMzvIPpN+/tfIBoA7pGxVA==
  "],ExpressionUUID->"6bcc16eb-a03c-43ea-8273-5cd7b6ed9cde"],

Cell["where", "Text",
 CellChangeTimes->{{4.001077237019656*^9, 
  4.001077237491166*^9}},ExpressionUUID->"5c9e79dd-c5d1-4389-a261-\
2eef07470bba"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"tan", " ", 
    RowBox[{"(", 
     RowBox[{"2", "\[Theta]"}], ")"}]}], "=", 
   FractionBox[
    RowBox[{"2", 
     RowBox[{"sgn", "(", 
      SubscriptBox["k", 
       RowBox[{"x", " ", "y"}]], ")"}], 
     SubsuperscriptBox["\[Omega]", 
      RowBox[{"x", " ", "y"}], "2"]}], 
    RowBox[{
     SubsuperscriptBox["\[Omega]", "x", "2"], "-", 
     SubsuperscriptBox["\[Omega]", "y", "2"]}]]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGAQBWIQPTM80mPJmbeOPtVTQkD0mkDHGBCdoXI+HUQvnzyr
