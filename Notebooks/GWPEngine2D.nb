  4.001071638443677*^9}},ExpressionUUID->"4ebc1067-41a2-4afd-8b04-\
51d11c71680a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["Z",
      FontWeight->"Bold",
      FontSlant->"Plain"], "."], "t"], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]"}], "m"], "  ", 
    SubscriptBox[
     StyleBox["A",
      FontWeight->"Bold",
      FontSlant->"Plain"], "0"]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
