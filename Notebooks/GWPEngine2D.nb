     RowBox[{"m", " ", 
      SuperscriptBox[
       StyleBox["\[CapitalOmega]",
        FontWeight->"Bold"], "2"], 
      SubscriptBox[
       StyleBox["r",
        FontWeight->"Bold",
        FontSlant->"Plain"], "t"]}]}]}]}], TraditionalForm]], "DisplayFormula",\

