   4.001073122306053*^9}},ExpressionUUID->"65391622-64d0-4183-b7f5-\
0dcfb1631273"],

Cell["So the final ", "Text",
 CellChangeTimes->{{4.001073134260459*^9, 
  4.001073136716675*^9}},ExpressionUUID->"7d4651df-6a64-4195-9fca-\
96e580c32d53"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Re", "(", 
    SubscriptBox["\[Gamma]", "t"], ")"}], "=", 
   RowBox[{
    RowBox[{"Re", "(", 
     SubscriptBox["\[Gamma]", "0"], ")"}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{
       SubsuperscriptBox[
        StyleBox["p",
         FontWeight->"Bold",
         FontSlant->"Plain"], "0", "T"], 
       SubscriptBox[
        StyleBox["p",
         FontWeight->"Bold",
         FontSlant->"Plain"], "0"]}], 
      RowBox[{"2", "m"}]], "t"}], "-", 
    RowBox[{
     FractionBox["\[HBar]", 
      RowBox[{"2", " "}]], 
     RowBox[{"arg", "(", 
      RowBox[{"det", "(", 
       SubscriptBox[
        StyleBox["Z",
         FontWeight->"Bold",
         FontSlant->"Plain"], "t"], ")"}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422790416041*^9, 4.000422947641068*^9}, {
  4.001023019174439*^9, 4.001023024772278*^9}, {4.001029297384856*^9, 
  4.001029464046647*^9}, {4.0010297032459393`*^9, 4.001029786148567*^9}, {
