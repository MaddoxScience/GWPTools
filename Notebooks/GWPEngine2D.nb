a9341283360e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Im", "(", 
    SubscriptBox["\[Gamma]", "t"], ")"}], "=", 
   RowBox[{
    RowBox[{"Im", "(", 
     SubscriptBox["\[Gamma]", "0"], ")"}], "+", 
    RowBox[{
     FractionBox["\[HBar]", 
      RowBox[{"4", " "}]], "ln", " ", 
     SuperscriptBox[
      RowBox[{"\[LeftBracketingBar]", 
       RowBox[{"det", "(", 
