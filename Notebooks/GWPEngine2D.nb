  4.001024711101383*^9, 4.001024722824422*^9}, {4.001071646914117*^9, 
  4.0010716527994967`*^9}},ExpressionUUID->"5bcd8efa-8787-4f36-bf4d-\
425df605afde"],

Cell["which can be directly integrated", "Text",
 CellChangeTimes->{{4.0010716669062967`*^9, 
  4.001071672380554*^9}},ExpressionUUID->"6e2881f4-1464-4377-a934-\
1dcdba413bf4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["Z",
     FontWeight->"Bold",
     FontSlant->"Plain"], "t"], "=", 
   RowBox[{
    RowBox[{
     StyleBox["I",
      FontWeight->"Bold",
      FontSlant->"Plain"], "+", 
     RowBox[{
      FractionBox["t", "m"], 
      SubscriptBox[
       StyleBox["P",
        FontWeight->"Bold",
        FontSlant->"Plain"], "0"]}]}], "=", 
    RowBox[{
     StyleBox["I",
      FontWeight->"Bold",
      FontSlant->"Plain"], "+", 
     RowBox[{
      FractionBox[
       RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]", " ", "t"}], "m"], "  ", 
      SubscriptBox[
       StyleBox["A",
        FontWeight->"Bold",
        FontSlant->"Plain"], "0"]}]}]}]}], TraditionalForm]], "DisplayFormula",\

 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422790416041*^9, 4.000422888510758*^9}, {
  4.001024711101383*^9, 4.001024722824422*^9}, {4.001071646914117*^9, 
  4.0010717429459047`*^9}, {4.0010717832111673`*^9, 
  4.001071783799885*^9}},ExpressionUUID->"12aab597-10e8-4001-beb1-\
fe08b91ce25b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["Z",
     FontWeight->"Bold",
     FontSlant->"Plain"], "t"], "=", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{"1", "+", 
        RowBox[{
         FractionBox[
          RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]", " ", "t"}], "m"], 
         SubscriptBox["\[Alpha]", 
          RowBox[{
           RowBox[{"x", " ", "x"}], ",", "0"}]]}]}], 
       RowBox[{
        FractionBox[
         RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]", " ", "t"}], "m"], 
        SubscriptBox["\[Alpha]", 
         RowBox[{
          RowBox[{"x", " ", "y"}], ",", "0"}]]}]},
      {
       RowBox[{
        FractionBox[
         RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]", " ", "t"}], "m"], 
        SubscriptBox["\[Alpha]", 
         RowBox[{
          RowBox[{"x", " ", "y"}], ",", "0"}]]}], 
       RowBox[{"1", "+", 
        RowBox[{
         FractionBox[
          RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]", " ", "t"}], "m"], 
         SubscriptBox["\[Alpha]", 
          RowBox[{
           RowBox[{"y", " ", "y"}], ",", "0"}]]}]}]}
     }], ")"}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
