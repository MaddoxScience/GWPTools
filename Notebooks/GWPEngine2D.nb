+jrHdTDdMCtEGUSfur9CDUTLVTrqguhXVYn6IHrZXXWhAiAd9nu3KIjuUrA/
VQikZ19jvwOiYzm/PQDRK/4+eAyiF5geeQmiBYrLP4JovrhKxiIgbZOewASi
QwqtBMD8t7uFQPS/oqW7QTT/TKeDIBoAKammtQ==
  "],ExpressionUUID->"3f5ca041-81f6-4215-a33b-37b51324d9a0"],

Cell[TextData[{
 "Because ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["\[CapitalOmega]",
     FontWeight->"Bold"], "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5a196d81-7580-4a0e-991b-b3ac45bc9c8d"],
 " is real and symmetric, an orthogonal rotation into the normal-mode frame \
decouples both the classical center equations and the matrix stability \
equations into two independent 1D harmonic oscillators."
}], "Text",
 CellChangeTimes->{{4.001077021459931*^9, 
  4.0010770533175163`*^9}},ExpressionUUID->"7682576b-ac55-4fea-a042-\
c552c63db171"],

Cell["\<\
We diagonalize the frequency-squared matrix via the orthogonal rotation\
\>", "Text",
 CellChangeTimes->{{4.001077108369022*^9, 4.001077114202248*^9}, {
  4.001077148060028*^9, 
  4.001077171064618*^9}},ExpressionUUID->"56c07ee2-24d6-40c0-aadc-\
e1e3a96e958b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox["R",
     FontWeight->"Bold",
     FontSlant->"Plain"], "(", "\[Theta]", ")"}], "=", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{"cos", " ", "\[Theta]"}], 
       RowBox[{
        RowBox[{"-", "sin"}], " ", "\[Theta]"}]},
      {
       RowBox[{
        RowBox[{"-", "sin"}], " ", "\[Theta]"}], 
       RowBox[{"cos", " ", "\[Theta]"}]}
     }], ")"}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGAQAWIQPTM80mPJmbeOPtVTQkD0mkDHGBCdoXI+HUQvnzyr
