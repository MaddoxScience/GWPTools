   4.001074769972722*^9},ExpressionUUID->"6e25089f-165e-4270-b6fb-\
184dc7761d07"],

Cell["and have the solution", "Text",
 CellChangeTimes->{{4.001074776584403*^9, 
  4.0010747791260233`*^9}},ExpressionUUID->"32784820-cb13-4dd2-80c8-\
ceaae84d35f7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["p",
     FontWeight->"Bold",
     FontSlant->"Plain"], "t"], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["p",
       FontWeight->"Bold",
       FontSlant->"Plain"], "0"], "-", 
     RowBox[{
      SubscriptBox[
       StyleBox["V",
        FontWeight->"Bold",
        FontSlant->"Plain"], "1"], "t"}]}], "=", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{
         SubscriptBox["p", 
          RowBox[{"x", ",", "0"}]], "-", 
         RowBox[{
          SubscriptBox["V", "10"], "t"}]}]},
       {
        RowBox[{
         SubscriptBox["p", 
          RowBox[{"y", ",", "0"}]], "-", 
         RowBox[{
          SubscriptBox["V", "01"], "t"}]}]}
      }], ")"}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
