eb90bfb013ea"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    OverscriptBox[
     StyleBox["p",
      FontWeight->"Bold",
      FontSlant->"Plain"], "."], "t"], "=", 
