  4.001030523046254*^9}, {4.0010712492458067`*^9, 4.0010712778744307`*^9}, {
  4.001074769972722*^9, 
  4.00107482605872*^9}},ExpressionUUID->"3bd9b216-967d-4149-bd6b-\
799ac9c381ad"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["r",
     FontWeight->"Bold",
     FontSlant->"Plain"], "t"], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox[
      StyleBox["r",
       FontWeight->"Bold",
       FontSlant->"Plain"], "0"], "+", 
     RowBox[{
      FractionBox[
       SubscriptBox[
        StyleBox["p",
         FontWeight->"Bold",
         FontSlant->"Plain"], "0"], "m"], "t"}], "-", 
     RowBox[{
      FractionBox[
       SubscriptBox[
        StyleBox["V",
         FontWeight->"Bold",
         FontSlant->"Plain"], "1"], 
       RowBox[{"2", "m"}]], 
      SuperscriptBox["t", "2"]}]}], "=", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{
         SubscriptBox["x", "0"], "+", 
         RowBox[{
          FractionBox[
           SubscriptBox["p", 
            RowBox[{"x", ",", "0"}]], "m"], "t"}], "-", 
         RowBox[{
          FractionBox[
           SubscriptBox["V", "10"], 
           RowBox[{"2", "m"}]], 
          SuperscriptBox["t", "2"]}]}]},
       {
        RowBox[{
         SubscriptBox["y", "0"], "+", 
         RowBox[{
          FractionBox[
           SubscriptBox["p", 
            RowBox[{"y", ",", "0"}]], "m"], "t"}], "-", 
         RowBox[{
          FractionBox[
           SubscriptBox["V", "01"], 
           RowBox[{"2", "m"}]], 
          SuperscriptBox["t", "2"]}]}]}
      }], ")"}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
  3.999605770192709*^9}, {4.000422790416041*^9, 4.000422947641068*^9}, {
  4.001023019174439*^9, 4.001023024772278*^9}, {4.001029297384856*^9, 
  4.001029464046647*^9}, {4.0010297032459393`*^9, 4.001029786148567*^9}, {
  4.0010298171025457`*^9, 4.001029859698471*^9}, {4.001029966114276*^9, 
  4.001029969555875*^9}, {4.0010302209925337`*^9, 4.001030222719829*^9}, {
  4.00103042664386*^9, 4.001030453277318*^9}, {4.001030506046035*^9, 
  4.001030523046254*^9}, {4.0010712492458067`*^9, 4.0010712778744307`*^9}, {
  4.001074769972722*^9, 
  4.001074912244947*^9}},ExpressionUUID->"e17a3076-f6e3-4c88-9615-\
95e9f6f30ce3"],

Cell["The classical Lagrangian is given by", "Text",
 CellChangeTimes->{{4.0010749300072603`*^9, 
  4.0010749435203257`*^9}},ExpressionUUID->"c0c5054e-5900-467d-bd65-\
cd7c10d2f6fe"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["L", "t"], "=", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{
       SubsuperscriptBox[
        StyleBox["p",
         FontWeight->"Bold",
         FontSlant->"Plain"], "t", "T"], 
       SubscriptBox[
        StyleBox["p",
         FontWeight->"Bold",
         FontSlant->"Plain"], "t"]}], 
      RowBox[{"2", "m"}]], "-", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["V", "00"], "+", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["V",
          FontWeight->"Bold",
          FontSlant->"Plain"], "1", "T"], 
        SubscriptBox[
         StyleBox["r",
          FontWeight->"Bold",
          FontSlant->"Plain"], "t"]}]}], ")"}]}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        RowBox[{
         SubsuperscriptBox[
          StyleBox["p",
           FontWeight->"Bold",
           FontSlant->"Plain"], "0", "T"], 
         SubscriptBox[
          StyleBox["p",
           FontWeight->"Bold",
           FontSlant->"Plain"], "0"]}], 
        RowBox[{"2", "m"}]], "-", 
       SubscriptBox["V", "00"], "-", 
       RowBox[{
        SubsuperscriptBox[
         StyleBox["V",
          FontWeight->"Bold",
          FontSlant->"Plain"], "1", "T"], 
        SubscriptBox[
         StyleBox["r",
          FontWeight->"Bold",
          FontSlant->"Plain"], "0"]}]}], ")"}], "-", 
     RowBox[{
      FractionBox[
       RowBox[{"2", 
        SubsuperscriptBox[
         StyleBox["V",
          FontWeight->"Bold",
          FontSlant->"Plain"], "1", "T"], 
        SubscriptBox[
         StyleBox["p",
          FontWeight->"Bold",
          FontSlant->"Plain"], "0"]}], "m"], "t"}], "+", 
     RowBox[{
      FractionBox[
       RowBox[{
        SubsuperscriptBox[
         StyleBox["V",
          FontWeight->"Bold",
          FontSlant->"Plain"], "1", "T"], 
        SubscriptBox[
         StyleBox["V",
          FontWeight->"Bold",
          FontSlant->"Plain"], "1"]}], "m"], 
      SuperscriptBox["t", "2"]}]}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
  3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
