  "],ExpressionUUID->"5068395c-9a47-46d6-81cb-8df173a515cc"],

Cell["and", "Text",
 CellChangeTimes->{{4.0010768181801033`*^9, 
  4.0010768184241323`*^9}},ExpressionUUID->"a4f1a2fa-e166-4cdd-83b2-\
3132c3eeec93"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    StyleBox["\[CapitalOmega]",
     FontWeight->"Bold"], "2"], "=", 
   RowBox[{"(", GridBox[{
      {
       SubsuperscriptBox["\[Omega]", "x", "2"], 
       RowBox[{
        RowBox[{"sgn", "(", 
         SubscriptBox["k", 
          RowBox[{"x", " ", "y"}]], ")"}], 
        SubsuperscriptBox["\[Omega]", 
         RowBox[{"x", " ", "y"}], "2"]}]},
      {
       RowBox[{"sgn", 
        RowBox[{"(", 
         SubscriptBox["k", 
          RowBox[{"x", " ", "y"}]], ")"}], 
        SubsuperscriptBox["\[Omega]", 
         RowBox[{"x", " ", "y"}], "2"]}], 
       SubsuperscriptBox["\[Omega]", "y", "2"]}
     }], ")"}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGAQBmIQPTM80mPJmbeOPtVTQkD0mkDHGBCdoXI+HUQvnzyr
Giyu5dYIok0DzhYYn3vruLC5pAVEM05NbY04/9axYZtEG4jeF6AzLRpIK9Ux
