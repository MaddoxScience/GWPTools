  4.001071837137458*^9}},ExpressionUUID->"e40b83cc-e18a-4b16-8ea4-\
2b63a6b09ad7"],

Cell["To reconstruct the shape matrix we substitute", "Text",
 CellChangeTimes->{{4.001071847554331*^9, 4.001071860587812*^9}, {
  4.001071897367051*^9, 
  4.001071898929162*^9}},ExpressionUUID->"dbedef40-7a79-464b-82a7-\
2d22a43ef3f3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["A",
     FontWeight->"Bold",
     FontSlant->"Plain"], "t"], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]"}]], 
     SubscriptBox[
      StyleBox["P",
       FontWeight->"Bold",
       FontSlant->"Plain"], "t"], 
     SubsuperscriptBox[
      StyleBox["Z",
       FontWeight->"Bold",
       FontSlant->"Plain"], "t", 
      RowBox[{"-", "1"}]]}], "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]"}]], 
     RowBox[{"(", " ", 
      RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]", " ", 
       SubscriptBox[
        StyleBox["A",
         FontWeight->"Bold",
         FontSlant->"Plain"], "0"]}], ")"}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        StyleBox["I",
         FontWeight->"Bold",
         FontSlant->"Plain"], "+", 
        RowBox[{
         FractionBox[
          RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]", " ", "t"}], "m"], "  ", 
         SubscriptBox[
          StyleBox["A",
           FontWeight->"Bold",
           FontSlant->"Plain"], "0"]}]}], ")"}], 
      RowBox[{"-", "1"}]]}]}]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
   3.999605770192709*^9}, {4.000422790416041*^9, 4.000422888510758*^9}, {
   4.00102361485701*^9, 4.001023631293838*^9}, {4.001026143291382*^9, 
   4.0010261437259693`*^9}, {4.001027865800858*^9, 4.001027880427754*^9}, 
   4.001028178729854*^9, {4.001071950950012*^9, 
   4.001071973292799*^9}},ExpressionUUID->"3ce18736-44c0-4b21-b388-\
af928826475d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["A",
     FontWeight->"Bold",
     FontSlant->"Plain"], "t"], "=", " ", 
   SuperscriptBox[
    RowBox[{
     SubscriptBox[
      StyleBox["A",
       FontWeight->"Bold",
       FontSlant->"Plain"], "0"], "(", 
     RowBox[{
      StyleBox["I",
       FontWeight->"Bold",
       FontSlant->"Plain"], "+", 
      RowBox[{
       FractionBox[
        RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]", " ", "t"}], "m"], "  ", 
       
       SubscriptBox[
        StyleBox["A",
         FontWeight->"Bold",
         FontSlant->"Plain"], "0"]}]}], ")"}], 
    RowBox[{"-", "1"}]]}], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
   3.999605770192709*^9}, {4.000422790416041*^9, 4.000422888510758*^9}, {
   4.00102361485701*^9, 4.001023631293838*^9}, {4.001026143291382*^9, 
   4.0010261437259693`*^9}, {4.001027865800858*^9, 4.001027880427754*^9}, 
   4.001028178729854*^9, {4.001071950950012*^9, 
   4.00107199080626*^9}},ExpressionUUID->"6bd15a74-e9af-45f4-8dfe-\
73403c2e41ed"],

Cell["For a standard matrix inversion we may use", "Text",
 CellChangeTimes->{{4.001072109393697*^9, 
  4.0010721409080257`*^9}},ExpressionUUID->"e24854a2-e44a-4e4a-a9b5-\
b315187bd4e0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubsuperscriptBox[
    StyleBox["Z",
     FontWeight->"Bold",
     FontSlant->"Plain"], "t", 
    RowBox[{"-", "1"}]], "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"det", "(", 
      SubscriptBox[
       StyleBox["Z",
        FontWeight->"Bold",
        FontSlant->"Plain"], "t"], ")"}]], 
    RowBox[{"adj", "(", 
     SubscriptBox[
      StyleBox["Z",
       FontWeight->"Bold",
       FontSlant->"Plain"], "t"], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
   3.999605770192709*^9}, {4.000422790416041*^9, 4.000422888510758*^9}, {
   4.00102361485701*^9, 4.001023631293838*^9}, {4.001026143291382*^9, 
   4.0010261437259693`*^9}, {4.001027865800858*^9, 4.001027880427754*^9}, 
   4.001028178729854*^9, {4.001071950950012*^9, 4.001071973292799*^9}, {
   4.001072119706746*^9, 
   4.001072156511672*^9}},ExpressionUUID->"4505c885-99cf-44c1-8e90-\
16b76c77915a"],

Cell["where", "Text",
 CellChangeTimes->{{4.001072187551037*^9, 
  4.001072187987863*^9}},ExpressionUUID->"a5c3b80f-4764-4cdc-8fac-\
0f9f39c87a3c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"det", "(", 
    SubscriptBox[
     StyleBox["Z",
      FontWeight->"Bold",
      FontSlant->"Plain"], "t"], ")"}], "=", 
   RowBox[{"1", "+", 
    RowBox[{
     FractionBox[
      RowBox[{"2", "\[ImaginaryI]", " ", "\[HBar]", " ", "t"}], "m"], 
     RowBox[{"Tr", "(", 
      SubscriptBox[
       StyleBox["A",
        FontWeight->"Bold",
        FontSlant->"Plain"], "0"], ")"}]}], "-", 
    RowBox[{
     FractionBox[
      RowBox[{"4", 
       SuperscriptBox["\[HBar]", "2"], 
       SuperscriptBox["t", "2"]}], 
      SuperscriptBox["m", "2"]], 
     RowBox[{"det", "(", 
      SubscriptBox[
       StyleBox["A",
        FontWeight->"Bold",
        FontSlant->"Plain"], "0"], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{3.999605314791943*^9, 3.999605412640051*^9}, {
   3.9996054740412197`*^9, 3.999605566473194*^9}, {3.999605724830524*^9, 
   3.999605770192709*^9}, {4.000422790416041*^9, 4.000422888510758*^9}, {
   4.00102361485701*^9, 4.001023631293838*^9}, {4.001026143291382*^9, 
   4.0010261437259693`*^9}, {4.001027865800858*^9, 4.001027880427754*^9}, 
