Cell[CellGroupData[{

Cell["1D-MATH-PARAM", "Subsection",
 CellChangeTimes->{{3.996335738629848*^9, 3.9963357454370737`*^9}, 
   3.996672469810019*^9, {3.996753015752389*^9, 3.996753019402701*^9}, {
   3.997449729000279*^9, 3.997449729794985*^9}, {3.997459077297525*^9, 
   3.997459081772183*^9}, 3.997460083381266*^9, {3.997476400985552*^9, 
   3.997476401204702*^9}},ExpressionUUID->"0e258174-d65d-441d-932c-\
c3dd0bb05990"],

Cell["\<\
The 1D-MATH-PARAM test suite verifies the foundational data-routing integrity \
of the framework. It systematically proves that the GWP1DPARAM constructor \
correctly parses its overloaded positional arguments and successfully hands \
them off to the underlying GWP1D486 parameter engine. By evaluating a wide \
range of input configurations\[LongDash]from partial, single-parameter \
definitions to fully specified states with custom rule-based options\
\[LongDash]these tests guarantee that the parameter bus robustly validates, \
formats, and transmits user inputs to the core physics engine without data \
loss or assignment errors.\
\>", "Text",
 CellChangeTimes->{
  3.996753975952414*^9, {3.997460104690283*^9, 3.997460107766304*^9}, {
   4.000409574732004*^9, 
   4.000409588044057*^9}},ExpressionUUID->"c24553e7-9815-4a52-bc6c-\
8024eb643f8c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"report", "=", 
  RowBox[{"GWPTestReport", "[", "\"\<1D-MATH-PARAM\>\"", "]"}]}], "\n", 
 RowBox[{"GWPFormatReport", "[", 
  RowBox[{"report", ",", 
   RowBox[{"\"\<ReportFormat\>\"", "->", "\"\<Summary\>\""}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"GWPFormatReport", "[", 
  RowBox[{"report", ",", 
   RowBox[{"\"\<ReportFormat\>\"", "->", "\"\<Detailed\>\""}]}], 
  "]"}]}], "Input",
