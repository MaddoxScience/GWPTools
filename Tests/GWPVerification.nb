 RowBox[{"report", "=", 
  RowBox[{"GWPTestReport", "[", "\"\<1D-HYDRO-XSPACE\>\"", "]"}]}], "\n", 
 RowBox[{"GWPFormatReport", "[", 
  RowBox[{"report", ",", 
   RowBox[{"\"\<ReportFormat\>\"", "->", "\"\<Summary\>\""}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"GWPFormatReport", "[", 
  RowBox[{"report", ",", 
