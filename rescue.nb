Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Set", " ", "your", " ", "source", " ", "documentation", " ", "path"}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"docDir", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ParentDirectory", "[", 
         RowBox[{"NotebookDirectory", "[", "]"}], "]"}], 
        ",", "\"\<Documentation\>\""}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Find", " ", "all", " ", "notebook", " ", "files"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"docFiles", "=", 
     RowBox[{"FileNames", "[", 
      RowBox[{"\"\<*.nb\>\"", ",", "docDir", ",", "Infinity"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Perform", " ", "string", " ", "replacement", " ", "across", " ", "all", " ",
      "documentation", " ", "notebooks"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"text", "=", 
        RowBox[{"ReadString", "[", "file", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"StringContainsQ", "[", 
          RowBox[{"text", ",", "\"\<paclet:GWPTools/\>\""}], "]"}], ",", 
         RowBox[{
          RowBox[{"updatedText", "=", 
           RowBox[{"StringReplace", "[", 
            RowBox[{"text", ",", 
             
             RowBox[{"\"\<paclet:GWPTools/\>\"", 
              "->", "\"\<paclet:MaddoxScience/GWPTools/\>\""}]}], "]"}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"WriteString", "[", 
           RowBox[{"file", ",", "updatedText"}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Updated: \>\"", ",", 
            RowBox[{"FileNameTake", "[", "file", "]"}]}], "]"}], ";"}]}], 
        "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"file", ",", "docFiles"}], "}"}]}], "]"}], ";"}]}]}]], "Input",\

