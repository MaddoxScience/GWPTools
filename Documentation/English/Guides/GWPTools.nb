Notebook[{
Cell["GWPTools", "GuideTitle",
 CellID->225533653,ExpressionUUID->"3146e473-8838-4c9c-a3f5-49ac234ee0b7"],

Cell[CellGroupData[{

Cell["", "GuideFunctionsSection",
 CellID->1862874138,ExpressionUUID->"c9bf837f-c46b-422b-a8dc-e02de08b8340"],

Cell["\<\
An exact, object-oriented analytical framework for simulating the quantum \
dynamics of generalized Gaussian wavepackets. By leveraging exact algebraic \
algorithms rather than numerical quadrature, GWPTools evaluates \
time-dependent wavefunctions, probability densities, arbitrary-order \
expectation values, and quantum trajectories across multiple representational \
domains.\
\>", "GuideAbstract",
 CellChangeTimes->{{3.995569551366997*^9, 3.995569568639702*^9}, {
   3.995569603238872*^9, 3.995569700984435*^9}, {3.995569754309477*^9, 
   3.995569867651362*^9}, {3.995569943845188*^9, 3.995569944025754*^9}, {
   3.995570366188736*^9, 3.9955703686249743`*^9}, {3.995580858324786*^9, 
   3.995580903456266*^9}, {3.995655602128751*^9, 3.995655736428872*^9}, {
   3.995656236550815*^9, 3.9956562397457113`*^9}, 3.998844409294488*^9},
 CellID->235469016,ExpressionUUID->"b75a9f8c-b18d-4670-8415-fe7cf3a4cd59"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["GWP",
   BaseStyle->"Link",
   ButtonData->"paclet:MaddoxScience/GWPTools/ref/GWP"]], 
  "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},
  CellTags->"c40ac8e4-27e1-4161-a8df-4d4f38357a23",ExpressionUUID->
  "972cf9ec-26b7-4070-8a5b-e0b0de2bf315"],
 " \[LongDash] Instantiates a physical wavepacket state and serves as the \
primary entry point for the framework's self-documenting introspection \
registry."
}], "GuideText",
 CellChangeTimes->{{3.9955699177901793`*^9, 3.995569940975917*^9}, {
   3.995569975905608*^9, 3.9955699761554527`*^9}, 3.995580951631892*^9, 
   3.9978328510587473`*^9, 3.998844426701746*^9, {3.9988457732873793`*^9, 
   3.998845773287438*^9}, {4.000844769715803*^9, 4.0008447697158403`*^9}},
 CellID->1161547753,ExpressionUUID->"24d58da3-fe00-46c3-90e6-67a54e7e1b6a"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["GWPObject",
   BaseStyle->"Link",
   ButtonData->"paclet:MaddoxScience/GWPTools/ref/GWPObject"]], 
  "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},
  CellTags->"c5c6736a-1ff4-4e4e-8fcf-2d9846cbae62",ExpressionUUID->
  "ccea7836-22dd-468b-b4a0-bb10ec104317"],
 " \[LongDash] Represents a dynamic wavepacket state, evaluating its exact \
time-dependent fields, physical observables, and statistical moments."
}], "GuideText",
 CellChangeTimes->{{3.9955699803332157`*^9, 3.995570014467952*^9}, 
   3.995580966034631*^9, 3.997832877528357*^9, 3.998844436825832*^9, {
   3.998845800285293*^9, 3.998845800285323*^9}, {4.000844787451116*^9, 
   4.0008447874511347`*^9}},
 CellID->1506733441,ExpressionUUID->"ec51e7ce-a3f3-4d6d-a68b-728faa301321"]
}, Open  ]],

